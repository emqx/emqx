emqx_mq_api.topic_filter.desc = "主題過濾器"
emqx_mq_schema.auto_create.desc = "當訂閱佇列主題時，如果訊息佇列不存在，自動建立的設定"
emqx_mq_schema.auto_create.label = "自動建立設定"
emqx_mq_schema.auto_create_lastvalue.desc = "自動建立最後值訊息佇列的設定"
emqx_mq_schema.auto_create_lastvalue.label = "自動建立最後值設定"
emqx_mq_schema.auto_create_regular.desc = "自動建立常規訊息佇列的設定"
emqx_mq_schema.auto_create_regular.label = "自動建立常規設定"
emqx_mq_schema.busy_session_retry_interval.desc = "訊息佇列訊息重試傳送到 MQTT 用戶端的間隔時間，當其飛行視窗已滿時。"
emqx_mq_schema.busy_session_retry_interval.label = "忙碌會話重試間隔"
emqx_mq_schema.consumer_max_inactive.desc = "消費者在最後一個訂閱者斷開連線後等待任何訊息佇列訂閱者的最長持續時間。"
emqx_mq_schema.consumer_max_inactive.label = "消費者最長不活躍時間"
emqx_mq_schema.consumer_persistence_interval.desc = "訊息佇列消費狀態持久化的間隔時間。"
emqx_mq_schema.consumer_persistence_interval.label = "消費者持久化間隔"
emqx_mq_schema.data_retention_period.desc = "訊息佇列中資料保留的時間段。"
emqx_mq_schema.data_retention_period.label = "資料保留期"
emqx_mq_schema.dispatch_strategy.desc = "用於將訊息從訊息佇列分發到佇列訂閱者的策略。"
emqx_mq_schema.dispatch_strategy.label = "分發策略"
emqx_mq_schema.enable.desc = "是否啟用訊息佇列。如果設定為 `auto`，訊息佇列預設停用，僅在已有訊息佇列時啟用。"
emqx_mq_schema.enable.label = "啟用"
emqx_mq_schema.find_queue_retry_interval.desc = "訂閱者在訂閱佇列主題時未找到佇列時重試查詢佇列的間隔時間。"
emqx_mq_schema.find_queue_retry_interval.label = "查詢佇列重試間隔"
emqx_mq_schema.gc_interval.desc = "訊息佇列清理過期訊息的間隔時間。"
emqx_mq_schema.gc_interval.label = "垃圾回收間隔"
emqx_mq_schema.is_lastvalue.desc = "指示訊息佇列是否具有最後值語義。最後值語義意味著訊息覆寫同一主題中具有相同佇列鍵的先前訊息。"
emqx_mq_schema.is_lastvalue.label = "是否為最後值"
emqx_mq_schema.key_expression.desc = "用於確定最後值訊息佇列中訊息鍵的表示式。"
emqx_mq_schema.key_expression.label = "鍵表示式"
emqx_mq_schema.local_max_inflight.desc = "從訊息佇列到 MQTT 用戶端的最大飛行訊息數。"
emqx_mq_schema.local_max_inflight.label = "本地最大飛行"
emqx_mq_schema.max_queue_count.desc = "可以建立的最大訊息佇列數。"
emqx_mq_schema.max_queue_count.label = "最大佇列數"
emqx_mq_schema.max_shard_message_bytes.desc = "訊息佇列分片的最大位元組數。分片數量在持久儲存設定中為所有訊息佇列設定。請注意，此限制不考慮複製因子。因此，訊息佇列的總位元組限制為 `n_shards * replication_factor * max_shard_message_bytes`。"
emqx_mq_schema.max_shard_message_bytes.label = "最大分片訊息位元組數"
emqx_mq_schema.max_shard_message_count.desc = "訊息佇列分片的最大訊息數。分片數量在持久儲存設定中為所有訊息佇列設定。訊息佇列的總計數限制為 `n_shards * max_shard_message_count`。"
emqx_mq_schema.max_shard_message_count.label = "最大分片訊息數"
emqx_mq_schema.mq.desc = "訊息佇列的全域設定。"
emqx_mq_schema.mq.label = "訊息佇列設定"
emqx_mq_schema.mq_individual_limits.desc = "單個訊息佇列的位元組大小和計數限制。"
emqx_mq_schema.mq_individual_limits.label = "訊息佇列限制"
emqx_mq_schema.name.desc = "訊息佇列的名稱。"
emqx_mq_schema.name.label = "名稱"
emqx_mq_schema.ping_interval.desc = "訂閱者和消費者行程之間相互 ping 以確保連線的間隔時間。"
emqx_mq_schema.ping_interval.label = "ping 間隔"
emqx_mq_schema.redispatch_interval.desc = "訊息被拒絕後重新分發的間隔時間。"
emqx_mq_schema.redispatch_interval.label = "重新分發間隔"
emqx_mq_schema.regular_queue_retention_period.desc = "常規訊息佇列中訊息的最大保留期。單個訊息佇列可以設定更短的保留期。"
emqx_mq_schema.regular_queue_retention_period.label = "常規佇列保留期"
emqx_mq_schema.stream_max_buffer_size.desc = "訊息佇列消費者緩衝的 DS 流中最大訊息數。"
emqx_mq_schema.stream_max_buffer_size.label = "流最大緩衝區大小"
emqx_mq_schema.stream_max_unacked.desc = "當 DS 停止向訊息佇列消費者流傳送訊息時的閾值，因為其緩衝區已滿。"
emqx_mq_schema.stream_max_unacked.label = "流最大未確認"
emqx_mq_schema.topic_filter.desc = "用於確定哪些訊息進入訊息佇列的過濾器。"
emqx_mq_schema.topic_filter.label = "主題過濾器"
emqx_mqttsn_schema.mqttsn.desc = "MQTT-SN 閘道設定。目前實現僅支援 v1.2 版本"
emqx_mqttsn_schema.mqttsn_broadcast.desc = "是否週期性廣播 ADVERTISE 訊息"
emqx_mqttsn_schema.mqttsn_enable_qos3.desc = "是否允許無連線的用戶端傳送 QoS 等於 -1 的訊息。\n該功能主要用於支援輕量的 MQTT-SN 用戶端實現，它不會向閘道建立連線，註冊主題，也不會發起訂閱；它只使用 QoS 為 -1 來發布訊息"
emqx_mqttsn_schema.mqttsn_gateway_id.desc = "MQTT-SN 閘道 ID。\n當 <code>broadcast</code> 開啟時，MQTT-SN 閘道會使用該 ID 來廣播 ADVERTISE 訊息"
emqx_mqttsn_schema.mqttsn_predefined.desc = "預定義主題列表。\n預定義的主題列表，是一組 主題 ID 和 主題名稱 的對映關係。使用預先定義的主題列表，可以減少 MQTT-SN 用戶端和閘道對於固定主題的註冊請求"
emqx_mqttsn_schema.mqttsn_predefined_id.desc = "主題 ID。範圍：1-65535"
emqx_mqttsn_schema.mqttsn_predefined_topic.desc = "主題名稱。注：不支援萬用字元"
emqx_mqttsn_schema.mqttsn_subs_resume.desc = "在會話被重用後，閘道是否主動向用戶端註冊對已訂閱主題名稱"
emqx_mt_api.bulk_config_bad_request.desc = "無效的設定"
emqx_mt_api.bulk_config_bad_request.label = "無效的設定"
emqx_mt_api.bulk_delete_ns.desc = "批次刪除命名空間"
emqx_mt_api.bulk_delete_ns.label = "批次刪除命名空間"
emqx_mt_api.bulk_export_ns_configs.desc = "匯出一個或多個命名空間設定。"
emqx_mt_api.bulk_export_ns_configs.label = "批次匯出命名空間設定"
emqx_mt_api.bulk_import_configs.desc = "批次更新或插入命名空間的設定。"
emqx_mt_api.bulk_import_configs.label = "批次匯入命名空間設定"
emqx_mt_api.bulk_import_ns_configs.desc = "匯入一個或多個命名空間設定。"
emqx_mt_api.bulk_import_ns_configs.label = "批次匯入命名空間設定"
emqx_mt_api.client_count.desc = "統計命名空間中的所有用戶端數量。"
emqx_mt_api.client_count.label = "用戶端數量統計"
emqx_mt_api.client_count_desc.desc = "用戶端數量"
emqx_mt_api.client_count_desc.label = "用戶端數量"
emqx_mt_api.client_list.desc = "列出命名空間中的所有用戶端。\n當存在更多頁面時，回應將攜帶\n`Link: <?last_clientid=...&limit=...>; rel=\"next\"` 頭（RFC 8288），\n其 URI 引用將相對於請求 URL 解析。\n若無該標頭，表示目前頁面為最後一頁。"
emqx_mt_api.client_list.label = "用戶端列表"
emqx_mt_api.clients_being_kicked.desc = "來自此命名空間的用戶端仍在被踢出。"
emqx_mt_api.clients_being_kicked.label = "正在踢出的用戶端"
emqx_mt_api.create_managed_ns.desc = "建立託管命名空間。`multi_tenancy.deny_namespaces` 中列出的命名空間名稱（預設為 `global`、`undefined`、`null`、`none`）不可使用。"
emqx_mt_api.create_managed_ns.label = "建立命名空間"
emqx_mt_api.cursor_conflict.desc = "請求同時攜帶了包含式（`first_*`）與排他式（`last_*`）鍵集遊標。它們互斥；最多使用一個。"
emqx_mt_api.cursor_conflict.label = "遊標參數衝突"
emqx_mt_api.delete_ns.desc = "刪除命名空間。這將導致該命名空間下的所有用戶端被非同步踢出。"
emqx_mt_api.delete_ns.label = "刪除命名空間"
emqx_mt_api.example_list.desc = "列表回應範例。"
emqx_mt_api.example_list.label = "列表範例"
emqx_mt_api.first_clientid_in_query.desc = "包含式鍵集遊標：回傳字典序大於或等於該值的用戶端 ID。適用於精確匹配查詢（如 `first_clientid=foo&limit=1`）。與 `last_clientid` 互斥。"
emqx_mt_api.first_clientid_in_query.label = "首個用戶端 ID"
emqx_mt_api.first_ns_in_query.desc = "包含式鍵集遊標：回傳字典序大於或等於該值的命名空間。適用於精確匹配查詢（如 `first_ns=foo&limit=1`）。與 `last_ns` 互斥。"
emqx_mt_api.first_ns_in_query.label = "首個命名空間"
emqx_mt_api.get_managed_ns_config.desc = "取得顯式建立的命名空間設定"
emqx_mt_api.get_managed_ns_config.label = "取得命名空間設定"
emqx_mt_api.invalid_configuration.desc = "無效的設定。"
emqx_mt_api.invalid_configuration.label = "無效的設定"
emqx_mt_api.invalid_configurations.desc = "無效的設定。"
emqx_mt_api.invalid_configurations.label = "無效的設定"
emqx_mt_api.kick_all_clients.desc = "踢出命名空間中的所有用戶端（非同步）"
emqx_mt_api.kick_all_clients.label = "踢出命名空間中的所有用戶端（非同步）"
emqx_mt_api.kick_process_started.desc = "踢出行程已啟動。"
emqx_mt_api.kick_process_started.label = "踢出行程已啟動"
emqx_mt_api.kick_process_underway.desc = "踢出行程已在進行中。"
emqx_mt_api.kick_process_underway.label = "踢出行程進行中"
emqx_mt_api.last_client_in_query.desc = "上一頁的最後一個用戶端。\n對於第一頁，請使用空字串。"
emqx_mt_api.last_client_in_query.label = "最後一個用戶端 ID"
emqx_mt_api.last_clientid_in_query.desc = "排他式鍵集遊標：回傳字典序大於該值的用戶端 ID。第一頁請省略或使用空字串。與 `first_clientid` 互斥。"
emqx_mt_api.last_clientid_in_query.label = "最後一個用戶端 ID"
emqx_mt_api.last_ns_in_query.desc = "排他式鍵集遊標：回傳字典序大於該值的命名空間。第一頁請省略或使用空字串。與 `first_ns` 互斥。"
emqx_mt_api.last_ns_in_query.label = "最後一個命名空間"
emqx_mt_api.limit_in_query.desc = "要回傳的專案數量。"
emqx_mt_api.limit_in_query.label = "回傳限制"
emqx_mt_api.managed_ns_list.desc = "列出所有託管命名空間。\n命名空間按字典序排序，因此該 API 可用於基於字首的模糊搜尋。\n當存在更多頁面時，回應將攜帶\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 頭（RFC 8288），\n其 URI 引用將相對於請求 URL 解析。\n若無該標頭，表示目前頁面為最後一頁。"
emqx_mt_api.managed_ns_list.label = "列出命名空間"
emqx_mt_api.managed_ns_list_details.desc = "列出所有託管命名空間及其詳細資訊，包括命名空間設定（會話與限流）。\n命名空間按字典序排序，因此該 API 可用於基於字首的模糊搜尋。\n當存在更多頁面時，回應將攜帶\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 頭（RFC 8288），\n其 URI 引用將相對於請求 URL 解析。\n若無該標頭，表示目前頁面為最後一頁。"
emqx_mt_api.managed_ns_list_details.label = "列出託管命名空間及其詳細資訊"
emqx_mt_api.max_configurations_reached.desc = "已達到最大設定數量。"
emqx_mt_api.max_configurations_reached.label = "已達到最大設定數量"
emqx_mt_api.metrics.desc = "取得命名空間指標。"
emqx_mt_api.metrics.label = "指標"
emqx_mt_api.namespace_not_found.desc = "未找到命名空間。"
emqx_mt_api.namespace_not_found.label = "未找到命名空間"
emqx_mt_api.ns_list.desc = "列出所有命名空間。\n命名空間按字典序排序，因此該 API 可用於基於字首的模糊搜尋。\n當存在更多頁面時，回應將攜帶\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 頭（RFC 8288），\n其 URI 引用將相對於請求 URL 解析。\n若無該標頭，表示目前頁面為最後一頁。"
emqx_mt_api.ns_list.label = "列出命名空間"
emqx_mt_api.ns_list_details.desc = "列出所有命名空間及其詳細資訊。\n命名空間按字典序排序，因此該 API 可用於基於字首的模糊搜尋。\n當存在更多頁面時，回應將攜帶\n`Link: <?last_ns=...&limit=...>; rel=\"next\"` 頭（RFC 8288），\n其 URI 引用將相對於請求 URL 解析。\n若無該標頭，表示目前頁面為最後一頁。"
emqx_mt_api.ns_list_details.label = "列出命名空間及其詳細資訊"
emqx_mt_api.param_path_ns.desc = "路徑參數中的命名空間。`multi_tenancy.deny_namespaces` 中列出的命名空間名稱（預設為 `global`、`undefined`、`null`、`none`）不可使用。"
emqx_mt_api.param_path_ns.label = "命名空間"
emqx_mt_api.side_effects_failed.desc = "一些副作用未能執行。"
emqx_mt_api.side_effects_failed.label = "副作用執行失敗"
emqx_mt_api.update_managed_ns_config.desc = "更新命名空間設定"
emqx_mt_api.update_managed_ns_config.label = "更新命名空間設定"
emqx_mt_schema.allow_only_managed_namespaces.desc = "如果啟用該選項，來自自動建立的命名空間的用戶端將被拒絕連線。\n無法解析命名空間的用戶端也將被拒絕連線。"
emqx_mt_schema.allow_only_managed_namespaces.label = "僅允許顯式建立的命名空間"
emqx_mt_schema.config.desc = "多租戶（Multi-Tenancy）設定。"
emqx_mt_schema.config.label = "多租戶"
emqx_mt_schema.default_max_sessions.desc = "每個命名空間預設允許的最大活動會話數。\n如果達到上限，新用戶端的存取將被拒絕。\n線上修改設定不會影響正在執行的會話。"
emqx_mt_schema.default_max_sessions.label = "預設最大會話數"
emqx_mt_schema.deny_namespaces.desc = "不能用作命名空間識別碼的名稱——\n既不能用作管理命名空間（儀表板角色、API key、\n多租戶管理 API），也不能用作各用戶端的\n<code>client_attrs.tns</code>；<code>tns</code> 解析為被拒絕名稱的用戶端將被拒絕連線。\n預設條目與內部哨兵值衝突，會導致日誌和控制台輸出含義不明確。設定為空列表可停用該限制。"
emqx_mt_schema.deny_namespaces.label = "拒絕的命名空間名稱"
emqx_mt_schema.post_auth_tns_expression.desc = "認證鏈完成後評估的表示式，其渲染結果將寫回 `client_attrs.tns`，這是多租戶配額與路由決策使用的租戶命名空間鍵。\n留空則停用（預設）。為空時，多租戶僅從 `mqtt.client_attrs_init` 解析 `tns`（在認證前評估）。\n設定後，表示式可引用 `mqtt.client_attrs_init` 可用的任意繫結（如 <code>username</code>、<code>clientid</code>、<code>cert_common_name</code>），以及 <code>client_attrs.*</code>（合併了認證前與認證回應屬性）。例如：<code>client_attrs.tag</code> 使多租戶應用將認證伺服器提供的 <code>tag</code> 屬性作為租戶命名空間。帶回退的範例：\n<code>coalesce(client_attrs.tag, username)</code>。\n如果表示式渲染為空字串，將保留已有的 <code>tns</code> 值（若有）。如果表示式出錯，會記錄警告日誌，並將用戶端視為沒有 <code>tns</code>。\n<code>deny_namespaces</code> 中列出的名稱不可用作命名空間；解析為其中之一的用戶端將被拒絕。"
emqx_mt_schema.post_auth_tns_expression.label = "認證後 tns 表示式"
emqx_mysql.server.desc = "用於連線的 IPv4 或 IPv6 地址或主機名。<br/>\n主機條目的格式如下：主機[:連接埠]。<br/>\n如果未指定[:連接埠]，將使用 MySQL 的預設連接埠3306。"
emqx_mysql.server.label = "伺服器主機"
emqx_nats_schema.authn_jwt.desc = "透過 NATS 風格的 JWT 憑據對用戶端進行認證。可選。該模式與 NATS Server 帳號 JWT 工作流相容，可與 token 和 nkey 認證一起使用。"
emqx_nats_schema.authn_nkeys.desc = "透過允許的 NKEY 公鑰進行認證（以 “U...” 開頭的 NATS nkey）。可選。設定後，僅允許具有匹配 NKEY 的用戶端連線，並透過簽名挑戰/回應完成認證（建議使用 nkeys 工具生成金鑰）。可與 authn_token 一起使用；若兩者都未設定，則預設使用使用者名稱/密碼認證。\n可設定多個 NKEY，每行一個公鑰。"
emqx_nats_schema.authn_token.desc = "認證 Token。可選。可以同時設定 Token 認證和使用者名稱/密碼認證。"
emqx_nats_schema.default_heartbeat_interval.desc = "伺服器到用戶端 PING 訊息的預設心跳間隔。預設：30。"
emqx_nats_schema.heartbeat_wait_timeout.desc = "心跳逾時閾值。如果在此期間未收到心跳回應，伺服器將標記用戶端為離線。預設：5s。"
emqx_nats_schema.internal_authn.desc = "NATS 用戶端的內部認證方法。方法按陣列順序評估，並在首次成功匹配時停止。"
emqx_nats_schema.internal_authn_jwt.desc = "NATS JWT 認證方法。"
emqx_nats_schema.internal_authn_nkey.desc = "NKEY 挑戰/回應認證方法。"
emqx_nats_schema.internal_authn_token.desc = "基於 Token 的認證方法。"
emqx_nats_schema.jwt.desc = "與帳號公鑰關聯的帳號 JWT 內容。"
emqx_nats_schema.jwt_resolver.desc = "用於取得用戶端認證所需帳號 JWT 的解析器設定。"
emqx_nats_schema.jwt_resolver_memory.desc = "記憶體中的 JWT 解析器設定。"
emqx_nats_schema.jwt_resolver_preload_entry.desc = "一個預載入的帳號 JWT 條目。"
emqx_nats_schema.max_payload_size.desc = "每個 NATS PUB/HPUB 訊息允許的最大 Payload 位元組數。"
emqx_nats_schema.nats.desc = "NATS 閘道為 EMQX 提供了接受 NATS 用戶端連線的能力。"
emqx_nats_schema.protocol.desc = "NATS 伺服器協定的一組設定。"
emqx_nats_schema.pubkey.desc = "在解析器預載入中作為查詢鍵的帳號公鑰。"
emqx_nats_schema.resolver.desc = "帳號 JWT 解析器設定。目前僅支援 `memory`。"
emqx_nats_schema.resolver_preload.desc = "記憶體解析器的預載入帳號 JWT 條目。"
emqx_nats_schema.server_id.desc = "伺服器 ID。"
emqx_nats_schema.server_name.desc = "伺服器名稱。"
emqx_nats_schema.tcp_ws_listeners.desc = "閘道的 Websocket 監聽器採用與 MQTT Websocket 監聽器相同的結構。"
emqx_nats_schema.trusted_operators.desc = "受信任的 operator 公鑰列表。解析器僅接受可由這些 operator 驗證的帳號 JWT。"
emqx_nats_schema.type.desc = "解析器類型。僅支援 `memory`。"
emqx_nats_schema.verify_exp.desc = "是否驗證 JWT `exp`（過期）宣告。"
emqx_nats_schema.verify_nbf.desc = "是否驗證 JWT `nbf`（生效前）宣告。"
emqx_nats_schema.websocket.desc = "Websocket 選項。"
emqx_nats_schema.ws_listener.desc = "Websocket 監聽器。"
emqx_nats_schema.wss_listener.desc = "Websocket over TLS 監聽器。"
emqx_node_rebalance_api.abs_conn_threshold.desc = "目前節點上的連線數與遷入節點上的平均連線數的最大期望差值，低於此比例是重平衡過程的目的。"
