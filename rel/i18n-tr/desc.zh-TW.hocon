emqx_bridge_influxdb.ping_with_auth.desc = "控制 EMQX 是否在 `/ping` 健康檢查請求中包含連接器憑據。如果你的 InfluxDB 服務在 `/ping` 上要求認證，請啟用此選項。預設值為 `false`，保持之前的行為並在不認證的情況下傳送 `/ping`。"
emqx_bridge_influxdb.ping_with_auth.label = "攜帶認證 Ping"
emqx_bridge_influxdb.write_syntax.desc = "使用 InfluxDB API Line Protocol 寫入 InfluxDB 的資料，支援佔位符<br/>\n參考 [InfluxDB 2.3 Line Protocol](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) 及\n[InfluxDB 1.8 Line Protocol](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\nTLDR: <br/>\n\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n注意，整形數值佔位符後需要新增一個字元 `i` 類型識別。例如 `${payload.int_value}i`"
emqx_bridge_influxdb.write_syntax.label = "寫語句"
emqx_bridge_influxdb_connector.bucket.desc = "InfluxDB bucket 名稱。"
emqx_bridge_influxdb_connector.bucket.label = "Bucket"
emqx_bridge_influxdb_connector.database.desc = "InfluxDB 資料庫。"
emqx_bridge_influxdb_connector.database.label = "資料庫"
emqx_bridge_influxdb_connector.influxdb_api_v1.desc = "InfluxDB HTTP API 協定。支援 Influxdb v1.8 以及之前的版本。"
emqx_bridge_influxdb_connector.influxdb_api_v1.label = "HTTP API 協定"
emqx_bridge_influxdb_connector.influxdb_api_v2.desc = "InfluxDB 的協定。支援 InfluxDB v2.0 到 v3.0。"
emqx_bridge_influxdb_connector.influxdb_api_v2.label = "HTTP API V2 協定"
emqx_bridge_influxdb_connector.influxdb_api_v3.desc = "InfluxDB 的協定。支援 InfluxDB v3.0 及之後的版本。"
emqx_bridge_influxdb_connector.influxdb_api_v3.label = "HTTP API V3 協定"
emqx_bridge_influxdb_connector.influxdb_parameters.desc = "給定版本的 InfluxDB 連接器的參數集，`influxdb_type` 可以是 `influxdb_api_v1` 或 `influxdb_api_v2`。"
emqx_bridge_influxdb_connector.influxdb_parameters.label = "InfluxDB 特定參數"
emqx_bridge_influxdb_connector.org.desc = "InfluxDB 組織名稱。"
emqx_bridge_influxdb_connector.org.label = "組織"
emqx_bridge_influxdb_connector.password.desc = "InfluxDB 密碼。"
emqx_bridge_influxdb_connector.password.label = "密碼"
emqx_bridge_influxdb_connector.ping_with_auth.desc = "控制 EMQX 是否在 `/ping` 健康檢查請求中包含連接器憑據。如果你的 InfluxDB 服務在 `/ping` 上要求認證，請啟用此選項。預設值為 `false`，保持之前的行為並在不認證的情況下傳送 `/ping`。"
emqx_bridge_influxdb_connector.ping_with_auth.label = "攜帶認證 Ping"
emqx_bridge_influxdb_connector.pool_size.desc = "連線池的大小，指向橋接目標服務的連線池大小。"
emqx_bridge_influxdb_connector.pool_size.label = "連線池大小"
emqx_bridge_influxdb_connector.precision.desc = "InfluxDB 時間精度。"
emqx_bridge_influxdb_connector.precision.label = "時間精度"
emqx_bridge_influxdb_connector.protocol.desc = "InfluxDB 協定。HTTP API 或 HTTP API V2。"
emqx_bridge_influxdb_connector.protocol.label = "協定"
emqx_bridge_influxdb_connector.server.desc = "將要連線的 IPv4 或 IPv6 地址，或者主機名。<br/>\n主機名具有以下形式：`Host[:Port]`。<br/>\n如果未指定 `[:Port]`，則使用 InfluxDB 預設連接埠 8086。"
emqx_bridge_influxdb_connector.server.label = "伺服器地址"
emqx_bridge_influxdb_connector.token.desc = "InfluxDB token。"
emqx_bridge_influxdb_connector.token.label = "Token"
emqx_bridge_influxdb_connector.username.desc = "InfluxDB 使用者名稱。"
emqx_bridge_influxdb_connector.username.label = "使用者名稱"
