emqx_bridge_snowflake_aggregated_action_schema.aggreg_parameters.desc = "聚合模式下動作的參數集。"
emqx_bridge_snowflake_aggregated_action_schema.aggreg_parameters.label = "Snowflake 聚合模式動作參數"
emqx_bridge_snowflake_aggregated_action_schema.aggregated_mode.desc = "啟用傳入事件的基於時間的聚合，並將其作為單個物件上傳到 Snowflake。此聚合由叢集中的每個節點獨立完成。"
emqx_bridge_snowflake_aggregated_action_schema.aggregated_mode.label = "聚合 Snowflake 上傳"
emqx_bridge_snowflake_aggregated_action_schema.aggregation.desc = "管理聚合過程的參數集。"
emqx_bridge_snowflake_aggregated_action_schema.aggregation.label = "聚合參數"
emqx_bridge_snowflake_aggregated_action_schema.aggregation_interval.desc = "在上傳之前，每個節點上事件將被聚合到單個檔案中的時間量。"
emqx_bridge_snowflake_aggregated_action_schema.aggregation_interval.label = "時間間隔"
emqx_bridge_snowflake_aggregated_action_schema.aggregation_max_records.desc = "每個聚合檔案允許的記錄（事件）數量。每次聚合上傳將包含不超過該數量的事件，但可能包含更少。\n如果事件速率足夠高，顯然在同一時間間隔內可能會有多個聚合上傳。這些上傳將具有不同但連續的序列號，這將是 Snowflake 暫存檔名的一部分。"
emqx_bridge_snowflake_aggregated_action_schema.aggregation_max_records.label = "最大記錄數"
emqx_bridge_snowflake_aggregated_action_schema.connect_timeout.desc = "連線到 HTTP 伺服器時的逾時時間。"
emqx_bridge_snowflake_aggregated_action_schema.connect_timeout.label = "連線逾時"
emqx_bridge_snowflake_aggregated_action_schema.database.desc = "包含 Snowflake 資源的資料庫名稱。"
emqx_bridge_snowflake_aggregated_action_schema.database.label = "資料庫"
emqx_bridge_snowflake_aggregated_action_schema.max_retries.desc = "傳送 HTTP 請求時出現錯誤的最大重試次數。"
emqx_bridge_snowflake_aggregated_action_schema.max_retries.label = "最大重試次數"
emqx_bridge_snowflake_aggregated_action_schema.parameters.desc = "動作的參數集。"
emqx_bridge_snowflake_aggregated_action_schema.parameters.label = "Snowflake 動作參數"
emqx_bridge_snowflake_aggregated_action_schema.pipe.desc = "用於將資料攝取到表中的管道名稱。"
emqx_bridge_snowflake_aggregated_action_schema.pipe.label = "管道"
emqx_bridge_snowflake_aggregated_action_schema.pipe_user.desc = "具有對要使用的管道的權限的角色的使用者名稱。最低權限為 `operate` 和 `monitor`。"
emqx_bridge_snowflake_aggregated_action_schema.pipe_user.label = "管道使用者"
emqx_bridge_snowflake_aggregated_action_schema.pipelining.desc = "一個正整數。是否連續傳送 HTTP 請求，當設定為 1 時，表示每次傳送 HTTP 請求後，需要等待伺服器回傳，然後繼續傳送下一個請求。"
emqx_bridge_snowflake_aggregated_action_schema.pipelining.label = "HTTP 管道化"
emqx_bridge_snowflake_aggregated_action_schema.pool_size.desc = "池大小。"
emqx_bridge_snowflake_aggregated_action_schema.pool_size.label = "池大小"
emqx_bridge_snowflake_aggregated_action_schema.private_key.desc = "為管道使用者設定的私鑰。支援以下輸入格式：\n- 純文字金鑰：直接作為字串值輸入 PEM 格式的私鑰內容。\n- 檔案路徑：指定包含私鑰的檔案路徑。確保路徑以 <code>file://</code> 開頭。檔案路徑在叢集中的所有節點上必須相同。"
emqx_bridge_snowflake_aggregated_action_schema.private_key.label = "私鑰"
emqx_bridge_snowflake_aggregated_action_schema.private_key_password.desc = "用於解密私鑰的密碼。如果私鑰未加密，請勿設定此值。"
emqx_bridge_snowflake_aggregated_action_schema.private_key_password.label = "私鑰密碼"
emqx_bridge_snowflake_aggregated_action_schema.proxy_config.desc = "Proxy 設定。目前僅支援普通 HTTP Proxy（不支援 HTTPS）。"
emqx_bridge_snowflake_aggregated_action_schema.proxy_config.label = "Proxy"
