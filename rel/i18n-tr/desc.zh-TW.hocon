emqx_ocpp_schema.dnstream_topic.desc = "用於接收來自第三方系統的請求/控制訊息的下載流主題。\n此值是每個連線的充電樁都訂閱的萬用字元主題名稱。"
emqx_ocpp_schema.heartbeat_checking_times_backoff.desc = "用於心跳檢查次數的退避時間"
emqx_ocpp_schema.json_schema_dir.desc = "OCPP 訊息定義的 JSON Schema 目錄。\n預設值：${application}/priv/schemas"
emqx_ocpp_schema.json_schema_id_prefix.desc = "OCPP 訊息 Schema 的 ID 字首。"
emqx_ocpp_schema.message_format_checking.desc = "是否啟用訊息格式合法性檢查。\nEMQX 會根據 json-schema 中定義的格式檢查上傳流和下載流的訊息格式。\n當檢查失敗時，EMQX 將回復相應的答覆訊息。\n\n檢查策略可以是以下值之一：\n- <code>all</code>：檢查所有訊息\n- <code>upstream_only</code>：僅檢查上傳流訊息\n- <code>dnstream_only</code>：僅檢查下載流訊息\n- <code>disable</code>：不檢查任何訊息"
emqx_ocpp_schema.upstream_error_topic.desc = "上傳流錯誤主題。"
emqx_ocpp_schema.upstream_reply_topic.desc = "上傳流回復訊息主題。"
emqx_ocpp_schema.upstream_topic.desc = "上傳流呼叫請求訊息主題。"
emqx_ocpp_schema.upstream_topic_override_mapping.desc = "透過訊息名稱進行的上傳流主題覆寫對映。"
emqx_ocpp_schema.ws.desc = "WebSocket 監聽器。"
emqx_ocpp_schema.wss.desc = "WebSocket over TLS 監聽器。"
emqx_oracle.role.desc = "選擇用於連線到 Oracle 資料庫的角色。<br/>- <code>normal</code>: 不使用任何特殊角色<br/>- <code>sysdba</code>: 系統資料庫管理員角色，具有高階權限"
emqx_oracle.role.label = "角色"
emqx_oracle.server.desc = "將要連線的 IPv4 或 IPv6 地址，或者主機名。<br/>主機名具有以下形式：`Host[:Port]`。<br/>如果未指定 `[:Port]`，則使用 Oracle Database 預設連接埠 1521。"
