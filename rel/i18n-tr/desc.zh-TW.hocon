emqx_mgmt_api_trace.trace_log_formatter.desc = "用於格式化追蹤日誌條目的格式處理器。設定為 text 將日誌條目格式化為純文字（預設）。設定為 json 將每個日誌條目格式化為 JSON 物件。"
