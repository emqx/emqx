emqx_dashboard_api.role.desc = "使用者角色。命名空間角色寫作 `ns:<namespace>::<role>`。`multi_tenancy.deny_namespaces` 中列出的命名空間名稱（預設為 `global`、`undefined`、`null`、`none`）不可使用。"
emqx_dashboard_api.token.desc = "Dashboard 認證 Token"
emqx_dashboard_api.update_user_api.desc = "更新 Dashboard 使用者備註"
emqx_dashboard_api.update_user_api.label = "更新 Dashboard 使用者備註"
emqx_dashboard_api.update_user_api200.desc = "更新 Dashboard 使用者成功"
emqx_dashboard_api.user_description.desc = "Dashboard 使用者備註"
emqx_dashboard_api.user_scopes_request.desc = "儀表板使用者作用域：在使用者角色之外額外應用的細粒度存取列表。\n\n如果建立使用者時省略該欄位，伺服器會採用角色的預設作用域。administrator 獲得所有管理作用域加四個僅登入作用域；viewer 獲得所有管理作用域；publisher（如適用）僅獲得 `publish` 作用域。傳送顯式空列表 `[]` 可建立拒絕所有的使用者；僅可存取如 `/status` 等匿名端點。\n\n在寫入（建立或更新）時，該欄位還接受字面字串 `unset`；與角色隱式預設集合相同的作用域列表也會被同樣處理：兩者都儲存為“無顯式作用域”，因此使用者會保留可向前相容的角色預設值，而不是固定的列表。這使得讀取-修改-寫入（例如僅編輯描述）可以原樣回傳 `GET` 回傳的 `unset` 值或展開後的作用域列表而不會出錯。\n\n登入使用者可分配 API key 目錄中的任意作用域以及四個僅登入作用域：`user_management`、`mfa_management`、`sso_management`、`api_key_management`。這四個中，`user_management`、`sso_management`、`api_key_management` 僅限管理員；`mfa_management` 也可分配給非管理員使用者。對非管理員使用者，它僅作為自我豁免鍵，允許使用者對自身 MFA 繞過 `force_mfa` 和 `admin_required` 鎖。"
emqx_dashboard_api.user_scopes_response.desc = "儀表板使用者 scope：在使用者角色之外應用的細粒度存取列表。\n\n字面量字串 `unset` 是僅用於歷史記錄的哨兵值，表示從不支援儀表板使用者 scope 的版本升級而來的記錄。在執行時，這類記錄會回退為該角色的預設 scope。用戶端應將 `unset` 視為“尚未設定顯式 scope 策略”。空列表 `[]` 表示拒絕全部存取；此時僅可存取諸如 `/status` 等匿名端點。\n\n登入使用者可被分配任意 API key 目錄中的 scope 以及四個僅登入的 scope：`user_management`、`mfa_management`、`sso_management` 和 `api_key_management`。其中 `user_management`、`sso_management`、`api_key_management` 僅限管理員。`mfa_management` 也可分配給非管理員使用者；對非管理員而言，它僅作為自我豁免鍵，允許使用者繞過其自身 MFA 的 `force_mfa` 與 `admin_required` 鎖。"
emqx_dashboard_api.username.desc = "Dashboard 使用者名稱"
emqx_dashboard_api.users_api404.desc = "Dashboard 使用者不存在"
emqx_dashboard_api.version.desc = "EMQX 版本"
