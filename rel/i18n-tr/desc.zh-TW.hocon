emqx_bridge_greptimedb_connector.greptimedb.desc = "GreptimeDB 的行協定。支援 GreptimeDB v1.8 以及之前的版本。"
emqx_bridge_greptimedb_connector.greptimedb.label = "HTTP API 協定"
emqx_bridge_greptimedb_connector.password.desc = "GreptimeDB 密碼。"
