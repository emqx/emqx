emqx_dashboard_sso_api.mfa_action_setup.desc = "MFA 動作指示：mfa_setup。當使用者必須完成 TOTP 設定後才能簽發會話 JWT 時，SSO 登入回傳該值。"
emqx_dashboard_sso_api.mfa_action_setup.label = "MFA 動作：設定"
