emqx_bridge_gcp_pubsub.attributes_template.desc = "格式化出站訊息屬性的模板。未定義的值將被呈現為空字串值。屬性對映中的空鍵將被移除。"
emqx_bridge_gcp_pubsub.attributes_template.label = "屬性模版"
emqx_bridge_gcp_pubsub.connect_timeout.desc = "連線 HTTP 伺服器的逾時時間。"
emqx_bridge_gcp_pubsub.connect_timeout.label = "連線逾時"
emqx_bridge_gcp_pubsub.consumer.desc = "GCP PubSub 消費者設定。"
emqx_bridge_gcp_pubsub.consumer.label = "GCP PubSub 消費者"
emqx_bridge_gcp_pubsub.consumer_ack_deadline.desc = "Pub/Sub 在重新傳送訊息之前，等待訂閱者確認收到訊息的大致時間（盡力而為）。更多資訊請參閱 [GCP 官方文件](https://docs.cloud.google.com/pubsub/docs/reference/rest/v1/projects.subscriptions/create)。"
emqx_bridge_gcp_pubsub.consumer_ack_deadline.label = "確認期限"
emqx_bridge_gcp_pubsub.consumer_mqtt_payload.desc = "轉換傳入 GCP PubSub 訊息格式的模板。預設情況下，它將使用 JSON 格式序列化來自 GCP PubSub 訊息的輸入。可用欄位包括：\n<code>message_id</code>：由 GCP PubSub 分配的訊息 ID。\n<code>publish_time</code>：GCP PubSub 分配的訊息時間戳。\n<code>topic</code>：GCP PubSub 主題。\n<code>value</code>：GCP PubSub 訊息的有效載荷。如果沒有有效載荷，則省略。\n<code>attributes</code>：包含字串鍵值對的物件。如果沒有屬性，則省略。\n<code>ordering_key</code>：GCP PubSub 訊息排序鍵。如果沒有，則省略。"
emqx_bridge_gcp_pubsub.consumer_mqtt_payload.label = "載荷模版"
emqx_bridge_gcp_pubsub.consumer_mqtt_qos.desc = "從 GCP PubSub 消費的訊息發布時應用的 MQTT QoS。"
emqx_bridge_gcp_pubsub.consumer_mqtt_qos.label = "QoS"
emqx_bridge_gcp_pubsub.consumer_mqtt_topic.desc = "指定從 GCP PubSub 消費的訊息被發布到的本地 MQTT 主題。"
