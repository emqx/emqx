emqx_dashboard_sso_api.list_running.label = "正在執行的後端"
emqx_dashboard_sso_api.login.desc = "取得 Dashboard 認證權杖。"
emqx_dashboard_sso_api.login.label = "取得 Dashboard 認證權杖"
