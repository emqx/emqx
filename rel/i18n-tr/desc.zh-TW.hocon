emqx_dashboard_sso_api.mfa_mechanism.label = "MFA 機制"
emqx_dashboard_sso_api.redirect.desc = "重定向到 IDP SSO 登入頁面"
emqx_dashboard_sso_api.running.desc = "後端是否正在執行"
emqx_dashboard_sso_api.running.label = "正在執行"
emqx_dashboard_sso_api.saml_sso_acs.desc = "SAML SSO ACS URL"
emqx_dashboard_sso_api.saml_sso_acs.label = "SAML SSO ACS"
emqx_dashboard_sso_api.setup_token_response.desc = "用於 MFA 繫結的臨時設定 token。一次性、短時有效（5 分鐘）。"
emqx_dashboard_sso_api.setup_token_response.label = "設定 Token"
emqx_dashboard_sso_api.sp_saml_metadata.desc = "SP SAML Metadata"
emqx_dashboard_sso_api.sp_saml_metadata.label = "SP SAML 後設資料"
emqx_dashboard_sso_api.sso_backend.desc = "SSO 後端類型（如 saml、oidc）。"
emqx_dashboard_sso_api.sso_backend.label = "SSO 後端"
emqx_dashboard_sso_api.sso_code.desc = "從 IdP 重定向回呼獲得的一次性 SSO code。僅可使用一次；在 token 交換時被消費。"
emqx_dashboard_sso_api.sso_code.label = "SSO Code"
emqx_dashboard_sso_api.sso_username.desc = "來自登入後設資料的 SSO 使用者名稱。"
emqx_dashboard_sso_api.sso_username.label = "SSO 使用者名稱"
emqx_dashboard_sso_api.token_exchange.desc = "將一次性 SSO code 交換為實際登入結果（JWT token 或 MFA 後設資料）。該 code 在單次使用後即被消費。"
emqx_dashboard_sso_api.token_exchange.label = "SSO Token 交換"
emqx_dashboard_sso_api.update_backend.desc = "更新一個後端"
emqx_dashboard_sso_api.update_backend.label = "更新後端"
emqx_dashboard_sso_api.verify_token_response.desc = "用於 MFA 驗證的臨時驗證 token。一次性、短時有效（5 分鐘）。"
emqx_dashboard_sso_api.verify_token_response.label = "驗證 Token"
emqx_dashboard_sso_ldap.LDAP.desc = "LDAP（輕量目錄存取協定）是一種用於透過網路存取和管理目錄資訊服務的協定。它可以用作單點登入（SSO）提供者，透過繫結到 LDAP 伺服器來認證使用者。"
emqx_dashboard_sso_ldap.LDAP.label = "LDAP"
emqx_dashboard_sso_ldap.filter.desc = "LDAP 中匹配使用者的篩選器預設為 `(&(objectClass=person)(uid=${username}))`。 對於 Active Directory，預設篩選器是 `(&(objectClass=user)(sAMAccountName=${username}))`。更多詳細內容，請參考 [LDAP Filters](https://ldap.com/ldap-filters/)。"
emqx_dashboard_sso_ldap.filter.label = "過濾器"
emqx_dashboard_sso_ldap.ldap_bind.desc = "使用 LDAP 繫結操作作為認證方式的認證器設定。"
emqx_dashboard_sso_ldap.query_timeout.desc = "LDAP 查詢逾時。"
emqx_dashboard_sso_ldap.query_timeout.label = "查詢逾時"
emqx_dashboard_sso_mfa_api.bad_request.desc = "錯誤請求。欄位缺失或無效。"
emqx_dashboard_sso_mfa_api.mfa_mechanism.desc = "MFA 機制類型（如 totp）。"
emqx_dashboard_sso_mfa_api.mfa_mechanism.label = "MFA 機制"
emqx_dashboard_sso_mfa_api.mfa_setup.desc = "完成 SSO MFA TOTP 設定：繫結 TOTP 認證器並簽發 JWT 會話 token。"
emqx_dashboard_sso_mfa_api.mfa_setup.label = "MFA 設定"
emqx_dashboard_sso_mfa_api.mfa_setup_info.desc = "取得用於二維碼展示的 TOTP 設定資訊（金鑰、機制）。請求體中需包含有效的設定 token。"
emqx_dashboard_sso_mfa_api.mfa_setup_info.label = "MFA 設定資訊"
emqx_dashboard_sso_mfa_api.mfa_verify.desc = "驗證 SSO MFA TOTP 碼並簽發 JWT 會話 token。"
emqx_dashboard_sso_mfa_api.mfa_verify.label = "MFA 驗證"
emqx_dashboard_sso_mfa_api.setup_token.desc = "來自 SSO 登入流程的臨時設定 token。"
emqx_dashboard_sso_mfa_api.setup_token.label = "設定 Token"
emqx_dashboard_sso_mfa_api.sso_backend.desc = "SSO 後端類型（如 saml、oidc）。"
emqx_dashboard_sso_mfa_api.sso_backend.label = "SSO 後端"
emqx_dashboard_sso_mfa_api.sso_username.desc = "來自登入後設資料的 SSO 使用者名稱。"
emqx_dashboard_sso_mfa_api.sso_username.label = "SSO 使用者名稱"
emqx_dashboard_sso_mfa_api.totp_code.desc = "來自認證器 App 的 TOTP 碼。"
emqx_dashboard_sso_mfa_api.totp_code.label = "TOTP 碼"
emqx_dashboard_sso_mfa_api.totp_secret.desc = "用於二維碼生成的 TOTP 金鑰。"
emqx_dashboard_sso_mfa_api.totp_secret.label = "TOTP 金鑰"
emqx_dashboard_sso_mfa_api.unauthorized.desc = "未授權。Token 無效或已過期。"
emqx_dashboard_sso_mfa_api.verify_token.desc = "來自 SSO 登入流程的臨時驗證 token。"
emqx_dashboard_sso_mfa_api.verify_token.label = "驗證 Token"
emqx_dashboard_sso_oidc.OIDC.desc = "OpenID Connect（OIDC）是建立在 OAuth 2.0 協定之上的身分層。它允許用戶端根據授權伺服器執行的身分驗證來驗證終端使用者的身分。"
emqx_dashboard_sso_oidc.OIDC.label = "OIDC"
emqx_dashboard_sso_oidc.client_file_jwks.desc = "從檔案中設定 JWKS。"
emqx_dashboard_sso_oidc.client_file_jwks_file.desc = "JWKS 的內容。"
emqx_dashboard_sso_oidc.client_file_jwks_type.desc = "JWKS 的來源類型。"
emqx_dashboard_sso_oidc.client_jwks.desc = "在此處設定 JWK 或 JWKS 以啟用 `private_key_jwt` 授權或 `DPoP` 擴充套件。"
emqx_dashboard_sso_oidc.clientid.desc = "此後端的 clientId。"
emqx_dashboard_sso_oidc.dashboard_addr.desc = "EMQX Dashboard 的地址。"
emqx_dashboard_sso_oidc.fallback_methods.desc = "一些身分提供者在提供者設定中沒有提供所有方法項，將此值設定為這些項的回退。"
emqx_dashboard_sso_oidc.issuer.desc = "OIDC 發行者的 URL。"
emqx_dashboard_sso_oidc.name_var.desc = "將 OIDC 使用者資訊對映到 Dashboard 名稱的模板，預設值是 `${sub}`。"
emqx_dashboard_sso_oidc.name_var_source.desc = "從哪個來源提取資訊以構建 Dashboard 使用者名稱。預設為 `userinfo`。\n\n- `userinfo`: 使用 `/userinfo` 端點的回應。\n- `id_token`: 使用存取權杖中包含的宣告。"
emqx_dashboard_sso_oidc.namespace_expr.desc = "用於構造 Dashboard 使用者命名空間的 [`jq`](https://jqlang.org/manual/) 程式。\n\n該表示式必須恰好回傳一個字串，可以是現有命名空間名稱的字串，或 `null` 值，表示全域命名空間。\n\n任何不符合上述要求的結果都會禁止建立使用者。\n\n如未設定，將在全域命名空間建立使用者，或在使用者已存在時保留其現有命名空間。"
emqx_dashboard_sso_oidc.namespace_source.desc = "從哪個來源提取資訊以構造 Dashboard 使用者命名空間。預設值為 `userinfo`。\n\n- `userinfo`：使用 `/userinfo` 端點的回應。\n- `id_token`：使用存取權杖中的宣告。\n\n注意：設定變更不會立即反映到 EMQX DB 中使用者的命名空間，使用者命名空間會在成功登入後對映到 EMQX 記錄。"
emqx_dashboard_sso_oidc.preferred_auth_methods.desc = "設定有效的身分驗證方法及其優先順序。"
emqx_dashboard_sso_oidc.provider.desc = "支援 OIDC 協定的身分服務提供者。"
emqx_dashboard_sso_oidc.require_pkce.desc = "取得 token 時是否需要 PKCE。"
emqx_dashboard_sso_oidc.role_expr.desc = "用於構造 Dashboard 使用者角色的 [`jq`](https://jqlang.org/manual/) 程式。\n\n該表示式必須恰好回傳一個字串，且必須為有效角色。目前有效角色為：\n- `\"viewer\"`\n- `\"administrator\"`\n\n任何不符合上述要求的結果都會禁止建立使用者。\n\n如未設定，將建立 viewer 使用者，或在使用者已存在時保留其現有角色。"
emqx_dashboard_sso_oidc.role_source.desc = "從哪個來源提取資訊以構造 Dashboard 使用者角色。預設值為 `userinfo`。\n\n- `userinfo`：使用 `/userinfo` 端點的回應。\n- `id_token`：使用存取權杖中的宣告。\n\n注意：設定變更不會立即反映到 EMQX DB 中使用者的角色，使用者角色會在成功登入後對映到 EMQX 記錄。"
emqx_dashboard_sso_oidc.scopes.desc = "作用域，預設值是 `[\"openid\"]`."
emqx_dashboard_sso_oidc.secret.desc = "用戶端金鑰。<br/>\n如需從檔案載入金鑰而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為金鑰使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_dashboard_sso_oidc.session_expiry.desc = "OIDC `state` 的有效時間範圍，預設為 `30s`，如果授權伺服器回傳的程式碼回應超過此時間範圍，將視為無效。"
emqx_dashboard_sso_oidc.skip_login_cookie_check.desc = "啟用此選項需自行承擔風險。設定為 `true` 時，EMQX 不會在 SSO 回呼時檢查登入 Cookie，因此登入不再與發起登入的瀏覽器繫結。僅當瀏覽器無法保留該 Cookie 並導致 SSO 登入失敗時才啟用此選項，例如使用者透過 `dashboard_addr` 以外的地址存取 Dashboard。預設值為 `false`。"
emqx_dashboard_sso_oidc_api.backend_not_found.desc = "未找到後端"
emqx_dashboard_sso_oidc_api.backend_not_found.label = "未找到後端"
emqx_dashboard_sso_oidc_api.bad_request.desc = "錯誤請求"
emqx_dashboard_sso_oidc_api.bad_request.label = "錯誤請求"
emqx_dashboard_sso_oidc_api.code_callback.desc = "OIDC 授權伺服器的回呼路徑。"
emqx_dashboard_sso_oidc_api.code_callback.label = "程式碼回呼"
emqx_dashboard_sso_oidc_api.forbidden.desc = "此登入並非由目前瀏覽器發起"
emqx_dashboard_sso_oidc_api.forbidden.label = "禁止存取"
emqx_dashboard_sso_saml.dashboard_addr.desc = "EMQX Dashboard 的地址。"
emqx_dashboard_sso_saml.dashboard_addr.label = "Dashboard 地址"
emqx_dashboard_sso_saml.idp_metadata_url.desc = "身分提供者的後設資料地址。"
emqx_dashboard_sso_saml.idp_metadata_url.label = "IdP 後設資料 URL"
emqx_dashboard_sso_saml.idp_signs_assertions.desc = "是否要求 IDP 對 SAML Assertion 進行簽名（內部簽名）。在所有安全設定檔下預設為 `true`。若要完全停用簽名驗證，需將本項與 `idp_signs_envelopes` 同時設為 `false`；這樣做不安全，僅應用於測試。"
emqx_dashboard_sso_saml.idp_signs_assertions.label = "要求 IDP 對 Assertion 簽名"
emqx_dashboard_sso_saml.idp_signs_envelopes.desc = "是否要求 IDP 對 SAML Response 信封進行簽名（外部簽名）。在所有安全設定檔下預設為 `true`。若要完全停用簽名驗證，需將本項與 `idp_signs_assertions` 同時設為 `false`；這樣做不安全，僅應用於測試。"
emqx_dashboard_sso_saml.idp_signs_envelopes.label = "要求 IDP 對回應信封簽名"
emqx_dashboard_sso_saml.sign_request.desc = "是否簽署 SAML 請求。"
emqx_dashboard_sso_saml.sign_request.label = "簽署 SAML 請求"
emqx_dashboard_sso_saml.skip_login_cookie_check.desc = "啟用此選項需自行承擔風險。設定為 `true` 時，EMQX 不會在 Assertion Consumer Service 處檢查登入 Cookie，因此登入不再與發起登入的瀏覽器繫結。僅當瀏覽器無法保留該 Cookie 並導致 SSO 登入失敗時才啟用此選項，例如 `dashboard_addr` 使用明文 HTTP 時。預設值為 `false`。"
emqx_dashboard_sso_saml.skip_login_cookie_check.label = "跳過登入 Cookie 檢查（不安全）"
emqx_dashboard_sso_saml.sp_private_key.desc = "SP 的私鑰。"
emqx_dashboard_sso_saml.sp_private_key.label = "SP 私鑰"
emqx_dashboard_sso_saml.sp_public_key.desc = "SP 的公鑰。"
emqx_dashboard_sso_saml.sp_public_key.label = "SP 公鑰"
emqx_dashboard_sso_saml_api.backend_not_found.desc = "未找到指定的 SAML 後端。"
emqx_dashboard_sso_saml_api.backend_not_found.label = "未找到後端"
emqx_dashboard_sso_saml_api.login_failed401.desc = "因憑據無效而登入失敗。"
emqx_dashboard_sso_saml_api.login_failed401.label = "登入失敗"
emqx_dashboard_sso_saml_api.redirect.desc = "重定向到 IdP 登入頁面的 URL。"
emqx_dashboard_sso_saml_api.redirect.label = "重定向 URL"
emqx_dashboard_sso_saml_api.saml_sso_acs.desc = "SAML Assertion Consumer Service URL。"
emqx_dashboard_sso_saml_api.saml_sso_acs.label = "SAML SSO ACS"
emqx_dashboard_sso_saml_api.sp_saml_metadata.desc = "Service Provider SAML 後設資料。"
emqx_dashboard_sso_saml_api.sp_saml_metadata.label = "SP SAML 後設資料"
emqx_dashboard_sso_schema.backend.desc = "後端類型。"
emqx_dashboard_sso_schema.backend.label = "後端類型"
emqx_dashboard_sso_schema.backend_enable.desc = "是否啟用該後端"
emqx_dashboard_sso_schema.force_mfa.desc = "是否對 SSO 使用者強制啟用 MFA（TOTP）。啟用後，SSO 使用者必須完成 MFA 設定或驗證後才能取得儀表板 token。"
emqx_dashboard_sso_schema.force_mfa.label = "強制 MFA"
emqx_dashboard_sso_schema.password.desc = "基於密碼的後端（如 LDAP）的 SSO 管理員密碼。長度最多 100 個字元。"
emqx_dashboard_sso_schema.password.label = "密碼"
emqx_dashboard_sso_schema.sso_struct.desc = "Dashboard 單點登入（SSO）。"
emqx_dashboard_sso_schema.sso_struct.label = "Dashboard 單點登入"
emqx_dashboard_sso_schema.username.desc = "基於密碼的後端（如 LDAP）的 SSO 管理員使用者名稱。長度最多 100 個字元。"
emqx_dashboard_sso_schema.username.label = "使用者名稱"
emqx_dashboard_swagger.bad_request.desc = "無效請求。"
emqx_dashboard_swagger.bad_request.label = "錯誤請求"
emqx_dashboard_swagger.count.desc = "匹配查詢條件的記錄總數。\n注意：僅當查詢能夠最佳化且不需要全表掃描時，此欄位才會存在。"
emqx_dashboard_swagger.count.label = "總數"
emqx_dashboard_swagger.cursor.desc = "表示目前迭代狀態的不透明值。"
emqx_dashboard_swagger.cursor.label = "遊標"
emqx_dashboard_swagger.cursor_response.desc = "表示目前迭代狀態的不透明值。"
emqx_dashboard_swagger.cursor_response.label = "遊標"
emqx_dashboard_swagger.error_codes.desc = "無效請求的可能錯誤原因程式碼。"
emqx_dashboard_swagger.error_codes.label = "錯誤程式碼"
emqx_dashboard_swagger.hasnext.desc = "指示是否還有更多結果可用於下一頁。"
emqx_dashboard_swagger.hasnext.label = "是否有下一頁"
emqx_dashboard_swagger.limit.desc = "每頁回傳的結果數量。"
emqx_dashboard_swagger.limit.label = "每頁限制"
emqx_dashboard_swagger.page.desc = "要取得的結果所在頁碼。"
emqx_dashboard_swagger.page.label = "頁碼"
emqx_dashboard_swagger.position.desc = "在 `meta.position` 中回傳的不透明 token，可用於後續請求以取得下一批結果：`?position={prev_response.meta.position}`。\n用於替代 `page` 參數以走訪高度動態的資料。可以省略或設定為 `none` 以取得第一批資料。\n如果 `meta.position` 為 `end_of_data`，表示沒有更多結果。不要在後續請求中傳送 `end_of_data`。"
emqx_dashboard_swagger.position.label = "位置"
emqx_dashboard_swagger.start.desc = "目前資料集合中第一個元素的位置。"
emqx_dashboard_swagger.start.label = "起始位置"
emqx_delayed_api.bad_msgid_format.desc = "訊息 ID 格式錯誤"
emqx_delayed_api.bad_msgid_format.label = "訊息 ID 格式錯誤"
emqx_delayed_api.bad_topic_name.desc = "錯誤的主題名稱"
emqx_delayed_api.bad_topic_name.label = "錯誤的主題名稱"
emqx_delayed_api.count.desc = "延遲訊息總數"
emqx_delayed_api.count.label = "延遲訊息總數"
emqx_delayed_api.delayed_interval.desc = "延遲時間(秒)"
emqx_delayed_api.delayed_interval.label = "延遲時間(秒)"
emqx_delayed_api.delayed_remaining.desc = "剩餘時間(秒)"
emqx_delayed_api.delayed_remaining.label = "剩餘時間(秒)"
emqx_delayed_api.delete_api.desc = "刪除延遲訊息"
emqx_delayed_api.delete_api.label = "刪除延遲訊息"
emqx_delayed_api.expected_at.desc = "期望的傳送時間, RFC 3339 格式"
emqx_delayed_api.expected_at.label = "期望的傳送時間"
emqx_delayed_api.from_clientid.desc = "訊息的 ClientID"
emqx_delayed_api.from_clientid.label = "訊息的 ClientID"
emqx_delayed_api.from_username.desc = "訊息的 Username"
emqx_delayed_api.from_username.label = "訊息的 Username"
emqx_delayed_api.get_message_api.desc = "檢視延遲訊息"
emqx_delayed_api.get_message_api.label = "檢視延遲訊息"
emqx_delayed_api.illegality_limit.desc = "數量上限不合法"
emqx_delayed_api.illegality_limit.label = "數量上限不合法"
emqx_delayed_api.list_api.desc = "檢視延遲訊息列表"
emqx_delayed_api.list_api.label = "檢視延遲訊息列表"
emqx_delayed_api.msgid.desc = "延遲訊息 ID"
emqx_delayed_api.msgid.label = "延遲訊息 ID"
emqx_delayed_api.msgid_not_found.desc = "未找到對應訊息"
emqx_delayed_api.msgid_not_found.label = "未找到對應訊息"
emqx_delayed_api.no_delayed_message.desc = "此主題下沒有找到延遲訊息"
emqx_delayed_api.no_delayed_message.label = "未找到延遲訊息"
emqx_delayed_api.node.desc = "訊息來源節點"
emqx_delayed_api.node.label = "訊息來源節點"
emqx_delayed_api.payload.desc = "訊息內容, base64 格式。如果訊息的大小超過 2048 位元組，則訊息原始內容不予回傳，請求將回傳 'PAYLOAD_TO_LARGE'"
emqx_delayed_api.payload.label = "訊息內容"
emqx_delayed_api.publish_at.desc = "訊息發布時間，即延遲訊息的建立時間, RFC 3339 格式"
emqx_delayed_api.publish_at.label = "訊息發布時間"
emqx_delayed_api.qos.desc = "QoS"
emqx_delayed_api.qos.label = "QoS"
emqx_delayed_api.topic.desc = "主題"
emqx_delayed_api.topic.label = "主題"
emqx_delayed_api.update_api.desc = "開啟或者關閉功能，或者設定延遲訊息數量上限"
emqx_delayed_api.update_api.label = "更新設定"
emqx_delayed_api.update_success.desc = "設定更新成功"
emqx_delayed_api.update_success.label = "設定更新成功"
emqx_delayed_api.view_limit.desc = "每頁回傳資料條目"
emqx_delayed_api.view_limit.label = "分頁大小"
emqx_delayed_api.view_page.desc = "特定頁的頁碼"
emqx_delayed_api.view_page.label = "分頁頁碼"
emqx_delayed_api.view_status_api.desc = "檢視慢訂閱狀態"
emqx_delayed_api.view_status_api.label = "檢視慢訂閱狀態"
emqx_ds_schema.backend_type.desc = "持久化儲存後端。\n\n請注意，無法在不遺失資料的情況下更改現有持久化儲存的後端。"
emqx_ds_schema.backend_type.label = "後端類型"
emqx_ds_schema.builtin_data_dir.desc = "內建儲存後端相關資料的根目錄。\n\n預設情況下，它等於 `node.data_dir/ds/`。"
emqx_ds_schema.builtin_data_dir.label = "資料庫位置"
emqx_ds_schema.builtin_layout.desc = "儲存佈局是一種在磁碟上排列來自各種主題和用戶端訊息的方法。\n\n根據工作負載類型和主題結構的不同，可以採用不同的資料儲存策略，以最大化地提高從持久儲存中讀取訊息的效率。"
emqx_ds_schema.builtin_layout.label = "儲存佈局"
emqx_ds_schema.builtin_local.desc = "沒有網路功能的嵌入式持久化儲存後端。\n\n此後端不支援叢集，但其開銷低於 `builtin_raft`。\n建議在嚴格的單節點部署中使用。"
emqx_ds_schema.builtin_local.label = "內建本地"
emqx_ds_schema.builtin_n_shards.desc = "持久化儲存將資料分成多個分片。\n此設定參數定義分片的數量。\n請注意，它僅在持久化儲存資料庫初始化期間生效。\n在資料庫已經建立後更改此設定參數將不會產生任何效果。"
emqx_ds_schema.builtin_n_shards.label = "分片數量"
emqx_ds_schema.builtin_optimistic_transaction.desc = "交易設定。"
emqx_ds_schema.builtin_optimistic_transaction.label = "交易設定"
emqx_ds_schema.builtin_raft.desc = "支援資料複製的嵌入式持久化儲存後端。\n\n此後端旨在用於叢集化的 EMQX 部署。\n它在多個 EMQX 節點上覆制每個持久化儲存分片的資料。"
emqx_ds_schema.builtin_raft.label = "內建 Raft"
emqx_ds_schema.builtin_raft_max_retries.desc = "遇到可恢復的間歇性故障時的最大重試次數。"
emqx_ds_schema.builtin_raft_max_retries.label = "最大重試次數"
emqx_ds_schema.builtin_raft_n_sites.desc = "需要共享儲存分片集責任的儲存站點數量。\n在此上下文中，站點是啟用了訊息永續性的 EMQX 節點。\n請注意，這僅在持久儲存資料庫初始化期間生效。\n在此階段，至少需要上線這麼多站點以在它們之間分配分片，否則訊息儲存將不可用。\n初始化完成後，站點可能會下線，這將根據下線站點的數量和複製因子影響可用性。"
emqx_ds_schema.builtin_raft_n_sites.label = "初始站點數量"
emqx_ds_schema.builtin_raft_replication_factor.desc = "每個分片應有的相同副本數量。\n增加此數字可以提高永續性和可用性，但會消耗更多資源。\n複製工作需要健康的副本仲裁，因此一般情況下選擇奇數個副本是一個好選擇。\n請注意，這僅在持久儲存資料庫初始化期間生效。\n在資料庫已建立後更改此設定參數不會生效。"
emqx_ds_schema.builtin_raft_replication_factor.label = "複製因子"
emqx_ds_schema.builtin_raft_retry_interval.desc = "重試嘗試之間的休眠時間。"
emqx_ds_schema.builtin_raft_retry_interval.label = "重試間隔"
emqx_ds_schema.db_group.desc = "將持久儲存分配給具有給定名稱的資料庫組。某些資源（例如磁碟使用配額）將在組的所有成員之間共享。\n\n資料庫組的後端應與儲存的後端匹配。"
emqx_ds_schema.db_group.label = "資料庫組"
emqx_ds_schema.db_group_backend.desc = "分配給組的所有資料庫使用的後端。"
emqx_ds_schema.db_group_backend.label = "組後端"
emqx_ds_schema.db_group_name.desc = "組的唯一識別碼"
emqx_ds_schema.db_group_name.label = "組名稱"
emqx_ds_schema.db_group_record.desc = "使用內建後端的持久儲存組相關的設定。"
emqx_ds_schema.db_group_record.label = "資料庫組"
emqx_ds_schema.db_group_rocksdb_threads.desc = "每個持久儲存組的 RocksDB 後台執行緒數。\n\nRocksDB 使用兩個執行緒池：高優先順序和低優先順序。\n前者用於將記憶體錶轉儲到磁碟，\n後者用於壓縮。\n\n預設情況下，兩個池的大小都設定為髒 IO 排程器的數量。"
emqx_ds_schema.db_group_rocksdb_threads.label = "RocksDB 執行緒池大小"
emqx_ds_schema.db_group_storage_quota.desc = "分配給組的所有持久儲存的總磁碟空間限額。\n\n當持久儲存的總大小超過配額時，\n嘗試寫入新資料將失敗，直到釋放一些磁碟空間。\n\n內建後端將此值視為軟配額：\n即使從資料庫中刪除資料，磁碟空間利用率也可能增加，\n直到資料庫被壓縮。\n\n對於 `builtin_raft` 後端，配額檢查由領導節點執行。\n只有擁有本地副本的分片才計入配額。\n\n當配額超出時，會觸發 `db_storage_quota_exceeded:<DB>` 警報。\n\n超出配額的後果取決於資料庫：\n- `messages`：持久會話無法接收新訊息。\n  緩解措施：\n  + 減少 `durable_sessions.message_retention_period` 設定參數。\n  + 使用 `mqtt.subscription_max_qos_rules` 將某些主題的訂閱 QoS 設定為 0。\n    向 QoS 0 訂閱傳遞訊息不使用磁碟空間。\n- `sessions`：持久會話從 broker 斷開連線。\n  緩解措施：\n  + 踢出離線會話。\n  + 限制最大會話數量。"
emqx_ds_schema.db_group_storage_quota.label = "儲存配額"
emqx_ds_schema.db_group_write_buffer_size.desc = "為資料庫寫入緩衝區分配的最大總 RAM。"
emqx_ds_schema.db_group_write_buffer_size.label = "寫入緩衝區大小"
emqx_ds_schema.db_groups_root.desc = "資料庫組設定的對映。\n\n資料庫組用於在持久儲存資料庫之間共享某些資源。\n例如，`storage_quota` 參數設定分配給組的所有持久儲存的總磁碟使用限額。"
emqx_ds_schema.db_groups_root.label = "資料庫組"
emqx_ds_schema.layout_builtin_wildcard_optimized.desc = "萬用字元最佳化 佈局旨在最大化涵蓋大量主題的萬用字元訂閱的吞吐量。\n\n例如，它可以處理大量用戶端將資料發布到包含其用戶端 ID 的主題的場景，如：sensor/%device-version%/%clientid%/temperature、sensor/%device-version%/%clientid%/pressure 等。\n此佈局將自動將此類主題分組到單個流中，因此訂閱包含萬用字元的主題過濾器（如 sensor/+/+/temperature）的用戶端將能夠以單個批次消費所有裝置發布的訊息。\n\n此佈局對非萬用字元訂閱也是有效的。"
emqx_ds_schema.layout_builtin_wildcard_optimized.label = "萬用字元最佳化儲存佈局"
emqx_ds_schema.layout_builtin_wildcard_optimized_type.desc = "萬用字元最佳化佈局類型。"
emqx_ds_schema.layout_builtin_wildcard_optimized_type.label = "佈局類型"
emqx_ds_schema.lts_wildcard_thresholds.desc = "不同主題級別的萬用字元閾值陣列。\n\nEMQX 可以自動將相似的主題分組在一起，以提高訊息儲存和檢索的效率。\n\n要理解此設定的含義，可以將 MQTT 主題視為一棵樹。\n當特定樹節點的子節點數量達到閾值時，EMQX 會執行分組。\n\n當主題結構已知時，調整此參數會有所幫助。\n例如，在多個用戶端向包含其用戶端 ID 的主題發布訊息的情況下，\n如 `sensor/<clientid>/temperature/<room>`。\n由於主題的 `<clientid>` 和 `<room>` 部分是可變的，可以透過將此參數設定為 `[100, 0, 100, 0, 100]` 來降低主題級別 2 和 4 的萬用字元閾值。\n\n陣列的每個元素對應於主題的特定級別。\n\n陣列的最後一個元素也對應於所有剩餘級別。\n\n陣列不能為空。"
emqx_ds_schema.lts_wildcard_thresholds.label = "萬用字元閾值"
emqx_ds_schema.messages.desc = "MQTT 訊息持久化儲存的設定。"
emqx_ds_schema.messages.label = "MQTT 訊息儲存"
emqx_ds_schema.mq_messages.desc = "包含訊息佇列訊息的持久儲存的設定。"
emqx_ds_schema.mq_messages.label = "訊息佇列訊息"
emqx_ds_schema.mq_states.desc = "包含訊息佇列狀態的持久儲存的設定。"
emqx_ds_schema.mq_states.label = "訊息佇列狀態"
emqx_ds_schema.optimistic_transaction.desc = "內建持久儲存後端的交易設定。"
emqx_ds_schema.optimistic_transaction.label = "交易"
emqx_ds_schema.otx_conflict_window.desc = "內建持久儲存後端在稱為衝突追蹤視窗的時間段內追蹤最近的更新。\n\n早於視窗開始的交易將被自動拒絕。\n因此，實際上，此參數限制了交易可以執行的時間。\n\n較高的值可以減少因長時間執行而拒絕交易的風險，但可能會增加 RAM 需求。\n\n此值應大於重新整理間隔。"
emqx_ds_schema.otx_conflict_window.label = "衝突追蹤視窗"
emqx_ds_schema.otx_flush_interval.desc = "指定操作在提交到儲存之前可能在緩衝區中停留的最長時間。\n參數的較大值可能會提高吞吐量，但會對延遲產生負面影響。"
emqx_ds_schema.otx_flush_interval.label = "交易重新整理間隔"
emqx_ds_schema.otx_idle_flush_interval.desc = "如果分片在此期間未收到新交易，則緩衝區會提前重新整理。"
emqx_ds_schema.otx_idle_flush_interval.label = "空閒交易重新整理間隔"
emqx_ds_schema.otx_max_pending.desc = "指定可以在緩衝區中保留的最大運算元。\n當此值被超過時，無論其他因素如何，緩衝區都會被重新整理。"
emqx_ds_schema.otx_max_pending.label = "最大待處理操作"
emqx_ds_schema.rocksdb_allow_fallocate.desc = "如果 OS 和檔案系統支援，允許 RocksDB 透過 `fallocate` 進行檔案空間預分配。\n檔案空間預分配用於提升檔案寫入/追加效能，但會以每個分片顯著的磁碟佔用為代價，尤其是在空或稀疏的 DB 中。\n\n如果啟用，請確保資料目錄所在卷有足夠的可用空間，例如至少數 GB。\n\n如果資料目錄使用 `btrfs` 檔案系統，建議保持停用。\n在 `btrfs` 上，額外分配的空間無法釋放。對於 DS 資料庫這可能很顯著，因為在單個站點上擁有大量分片很常見。\n\n更多細節請參考 RocksDB C++ API 文件中的 `allow_fallocate` 標誌。"
emqx_ds_schema.rocksdb_allow_fallocate.label = "允許檔案空間預分配"
emqx_ds_schema.rocksdb_cache_size.desc = "RocksDB 塊快取的大小。\n\n請注意，增加此值不一定會減少 I/O，因為壓縮資料可能駐留在作業系統的頁面快取中，但可以在犧牲記憶體使用的情況下減少 CPU 負載。\n\n資料庫的每個分片都有自己的快取。"
emqx_ds_schema.rocksdb_cache_size.label = "RocksDB 快取大小"
emqx_ds_schema.rocksdb_max_open_files.desc = "每個分片的最大開啟檔案描述符數。"
emqx_ds_schema.rocksdb_max_open_files.label = "最大開啟檔案數"
emqx_ds_schema.rocksdb_options.desc = "有關內建持久儲存後端使用的 RocksDB 資料庫行為的選項。"
emqx_ds_schema.rocksdb_options.label = "RocksDB 選項"
emqx_ds_schema.rocksdb_write_buffer_size.desc = "RocksDB 記憶體表的最大大小。\n\n記憶體表是一個緩衝區，新寫入的資料在重新整理到磁碟之前儲存在其中。\n\n資料庫的每個分片都有自己的記憶體表。"
emqx_ds_schema.rocksdb_write_buffer_size.label = "RocksDB 寫入緩衝區大小"
emqx_ds_schema.sessions.desc = "包含持久會話狀態和後設資料的持久儲存的設定。"
emqx_ds_schema.sessions.label = "MQTT 會話儲存"
emqx_ds_schema.shared_subs.desc = "包含後設資料和共享訂閱的主題重放進度的持久儲存的設定。"
emqx_ds_schema.shared_subs.label = "持久共享訂閱"
emqx_ds_schema.streams_messages.desc = "包含訊息流訊息的持久儲存設定。"
emqx_ds_schema.streams_messages.label = "訊息流訊息"
emqx_ds_schema.timers.desc = "包含定時器的持久儲存的設定。"
emqx_ds_schema.timers.label = "持久定時器儲存"
emqx_ds_shared_sub_schema.enable.desc = "啟用共享訂閱功能。"
emqx_ds_shared_sub_schema.enable.label = "啟用共享訂閱"
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.desc = "Leader 執行週期性操作的時間間隔（毫秒）。"
emqx_ds_shared_sub_schema.leader_periodical_actions_interval.label = "Leader 週期性操作間隔"
emqx_ds_shared_sub_schema.leader_renew_streams_interval.desc = "Leader 重新整理流的時間間隔（毫秒）。"
emqx_ds_shared_sub_schema.leader_renew_streams_interval.label = "Leader 重新整理資料流時間間隔"
emqx_ds_shared_sub_schema.session_find_leader_timeout.desc = "會話查詢 Leader 的逾時時間（毫秒）。\n如果會話在此時間內無法找到 Leader，會話將重試。"
emqx_ds_shared_sub_schema.session_find_leader_timeout.label = "會話查詢 Leader 逾時時間"
emqx_ds_shared_sub_schema.session_ping_leader_interval.desc = "會話（Session）向 Leader 傳送 ping 的時間間隔（毫秒）。"
emqx_ds_shared_sub_schema.session_ping_leader_interval.label = "會話 Ping Leader 間隔"
emqx_ds_shared_sub_schema.session_ping_leader_timeout.desc = "會話等待主節點回應 ping 的逾時時間（單位：毫秒）。\n如果主節點在此時間內未回應 ping，\n會話將認為主節點已遺失，並嘗試尋找新的主節點。"
emqx_ds_shared_sub_schema.session_ping_leader_timeout.label = "會話 Ping 主節點逾時"
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.desc = "會話等待資料流達到一致狀態並報告給主節點的逾時時間（單位：毫秒）。\n如果逾時時間到達，會話將向主節點傳送最新已知的一致狀態。"
emqx_ds_shared_sub_schema.session_unsubscribe_timeout.label = "會話取消訂閱逾時"
emqx_eviction_agent_api.node_eviction_status_get.desc = "取得節點驅逐狀態"
emqx_eviction_agent_api.node_eviction_status_get.label = "節點驅逐狀態"
emqx_exhook_api.add_server.desc = "新增 ExHook 伺服器"
emqx_exhook_api.add_server.label = "新增 ExHook 伺服器"
emqx_exhook_api.already_exists.desc = "已存在"
emqx_exhook_api.already_exists.label = "已存在"
emqx_exhook_api.bad_request.desc = "錯誤請求"
emqx_exhook_api.bad_request.label = "錯誤請求"
emqx_exhook_api.bad_rpc.desc = "錯誤的 RPC"
emqx_exhook_api.bad_rpc.label = "錯誤的 RPC"
emqx_exhook_api.delete_server.desc = "刪除 Exhook 伺服器"
emqx_exhook_api.delete_server.label = "刪除 Exhook 伺服器"
