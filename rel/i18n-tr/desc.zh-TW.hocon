emqx_bridge_iotdb_connector.auth_basic.label = "基本認證參數"
emqx_bridge_iotdb_connector.config_auth_password.desc = "在 IoTDB/Thrift REST 介面中設定的密碼。"
emqx_bridge_iotdb_connector.config_auth_password.label = "認證密碼"
emqx_bridge_iotdb_connector.config_auth_username.desc = "在 IoTDB REST/Thrift 介面中設定的使用者名稱。"
emqx_bridge_iotdb_connector.config_auth_username.label = "認證使用者名稱"
emqx_bridge_iotdb_connector.config_authentication.desc = "認證設定"
