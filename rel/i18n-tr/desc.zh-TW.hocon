emqx_modules_schema.enable.desc = "是否啟用"
emqx_modules_schema.max_delayed_messages.desc = "延遲訊息的數量上限(0 代表不限數量)"
emqx_modules_schema.rewrite.desc = "EMQX 的主題重寫功能支援根據使用者設定的規則在用戶端訂閱主題、發布訊息、取消訂閱的時候將 A 主題重寫為 B 主題。\n重寫規則分為 Pub 規則和 Sub 規則，Pub 規則匹配 PUSHLISH 封包攜帶的主題，Sub 規則匹配 SUBSCRIBE、UNSUBSCRIBE 封包攜帶的主題。\n每條重寫規則都由主題過濾器、正規表示式、目標表示式三部分組成。\n在主題重寫功能開啟的前提下，EMQX 在收到諸如 PUBLISH 封包等帶有主題的 MQTT 封包時，將使用封包中的主題去依次匹配設定檔中規則的主題過濾器部分，一旦成功匹配，則使用正規表示式提取主題中的資訊，然後替換至目標表示式以構成新的主題。\n目標表示式中可以使用 `$N` 這種格式的變數匹配正則表達中提取出來的元素，`$N` 的值為正規表示式中提取出來的第 N 個元素，例如 `$1` 即為正規表示式提取的第一個元素。\n需要注意的是，EMQX 使用倒序讀取設定檔中的重寫規則，當一條主題可以同時匹配多條主題重寫規則的主題過濾器時，EMQX 僅會使用它匹配到的第一條規則進行重寫，如果該條規則中的正規表示式與 MQTT 封包主題不匹配，則重寫失敗，不會再嘗試使用其他的規則進行重寫。\n因此使用者在使用時需要謹慎的設計 MQTT 封包主題以及主題重寫規則。"
emqx_modules_schema.rewrite.label = "主題重寫"
emqx_modules_schema.tr_action.desc = "主題重寫在哪種操作上生效：\n  - `subscribe`：訂閱時重寫主題；\n  - `publish`：發布時重寫主題；\n  - `all`：在發布與訂閱時重寫主題"
emqx_modules_schema.tr_action.label = "重寫動作"
emqx_modules_schema.tr_dest_topic.desc = "目標主題。"
emqx_modules_schema.tr_dest_topic.label = "目標主題"
emqx_modules_schema.tr_re.desc = "正規表示式"
emqx_modules_schema.tr_source_topic.desc = "源主題，用戶端業務指定的主題"
emqx_modules_schema.tr_source_topic.label = "源主題"
emqx_mongodb.auth_source.desc = "與使用者認證資訊關聯的資料庫名稱。"
emqx_mongodb.auth_source.label = "認證源"
emqx_mongodb.connect_timeout.desc = "在逾時之前嘗試連線的持續時間。"
emqx_mongodb.connect_timeout.label = "連線逾時"
emqx_mongodb.desc_rs.desc = "副本集的設定。"
emqx_mongodb.desc_rs.label = "設定副本集"
emqx_mongodb.desc_sharded.desc = "分片叢集的設定。"
emqx_mongodb.desc_sharded.label = "設定分片叢集"
emqx_mongodb.desc_single.desc = "單個 MongoDB 實例的設定"
emqx_mongodb.desc_single.label = "設定單個 MongoDB"
emqx_mongodb.desc_topology.desc = "MongoDB 的拓撲結構。"
emqx_mongodb.desc_topology.label = "設定拓撲結構"
emqx_mongodb.heartbeat_period.desc = "控制驅動程式何時檢查 MongoDB 部署的狀態。指定檢查之間的時間間隔，從上次檢查結束到下次檢查開始計算。如果連線數增加（例如，如果增加了池大小），則可能需要增加此時間間隔，以避免在 MongoDB 日誌檔案中建立過多的日誌條目。"
emqx_mongodb.heartbeat_period.label = "心跳週期"
emqx_mongodb.local_threshold.desc = "用於在多個合適的 MongoDB 實例中進行選擇的延遲視窗的大小。"
emqx_mongodb.local_threshold.label = "本地閾值"
emqx_mongodb.max_overflow.desc = "在池中的所有工作執行緒都繁忙時，可以建立的附加工作執行緒的最大數量。這有助於透過允許更多併發連線到 MongoDB 伺服器來管理工作負載的暫時性波動。"
emqx_mongodb.max_overflow.label = "最大溢位工作執行緒"
emqx_mongodb.min_heartbeat_period.desc = "控制心跳之間等待的最短時間。"
emqx_mongodb.min_heartbeat_period.label = "最小心跳週期"
emqx_mongodb.overflow_check_period.desc = "檢查是否存在多餘工作執行緒（\"溢位\"）的週期。"
emqx_mongodb.overflow_check_period.label = "溢位檢查週期"
emqx_mongodb.overflow_ttl.desc = "超出設定的池大小（\"溢位\"）的工作執行緒在終止之前的時間段。"
emqx_mongodb.overflow_ttl.label = "溢位 TTL"
emqx_mongodb.r_mode.desc = "讀取模式。"
emqx_mongodb.r_mode.label = "讀取模式"
emqx_mongodb.replica_set_name.desc = "副本集的名稱。"
emqx_mongodb.replica_set_name.label = "副本集名稱"
emqx_mongodb.rs_mongo_type.desc = "副本集。當MongoDB伺服器以`副本集`模式執行時，必須設定為`rs`。"
emqx_mongodb.rs_mongo_type.label = "副本集"
emqx_mongodb.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>主機條目具有以下形式：主機[:連接埠]。<br/>如果未指定[:連接埠]，則使用MongoDB的預設連接埠27017。"
emqx_mongodb.server.label = "伺服器主機"
emqx_mongodb.server_selection_timeout.desc = "指定在丟擲異常之前進行伺服器選擇的阻塞時間。"
emqx_mongodb.server_selection_timeout.label = "伺服器選擇逾時"
emqx_mongodb.servers.desc = "叢集連線的節點列表。節點應使用逗號分隔，例如：節點[,節點]。\n對於每個節點，應該是要連線的 IPv4 或 IPv6 地址或主機名。\n主機條目具有以下形式：主機[:連接埠]。\n如果未指定[:連接埠]，則使用 MongoDB 的預設連接埠27017。"
emqx_mongodb.servers.label = "伺服器"
emqx_mongodb.sharded_mongo_type.desc = "分片叢集。當 MongoDB 伺服器以`分片`模式執行時，必須設定為`sharded`。"
emqx_mongodb.sharded_mongo_type.label = "分片叢集"
emqx_mongodb.single_mongo_type.desc = "獨立實例。當MongoDB伺服器以獨立模式執行時，必須設定為`single`。"
emqx_mongodb.single_mongo_type.label = "獨立實例"
emqx_mongodb.socket_timeout.desc = "在套接字上嘗試傳送或接收逾時之前的持續時間。"
emqx_mongodb.socket_timeout.label = "套接字逾時"
emqx_mongodb.srv_record.desc = "使用 DNS SRV 記錄。"
emqx_mongodb.srv_record.label = "Srv 記錄"
