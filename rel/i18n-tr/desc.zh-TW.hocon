emqx_bridge_http_schema.config_headers.desc = "HTTP 請求標頭。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_http_schema.config_headers.label = "HTTP 請求標頭"
emqx_bridge_http_schema.config_max_retries.desc = "如果傳送請求時出錯，最大的重試次數。"
emqx_bridge_http_schema.config_max_retries.label = "HTTP 請求最大重試次數"
emqx_bridge_http_schema.config_method.desc = "HTTP 請求的方法。所有可用的方法包括：post、put、get、delete。<br/>\n允許使用帶有變數的模板。"
