emqx_telemetry_api.update_telemetry_status_api.label = "更新遙測狀態"
emqx_telemetry_api.uuid.desc = "UUID"
emqx_telemetry_schema.enable.desc = "設定為 `false` 可以關閉資料傳送。"
emqx_telemetry_schema.telemetry_root_doc.desc = "是否啟用遙測功能，以允許 EMQX 收集相關的使用資訊，並將其共享給 EMQ，用於提升您的產品體驗。\nEMQX 在任何情況下都不會收集您的個人資訊，例如 MAC 地址、IP 地址或傳送的訊息內容。\n\n詳情請參閱：https://docs.emqx.com/zh/emqx/latest/telemetry/telemetry.html。"
emqx_topic_metrics2_api.bad_request_resp.desc = "集合名稱或主題過濾器無效。"
emqx_topic_metrics2_api.bad_request_resp.label = "錯誤請求"
emqx_topic_metrics2_api.collection_created_resp.desc = "剛建立的主題指標集合。"
emqx_topic_metrics2_api.collection_created_resp.label = "已建立"
emqx_topic_metrics2_api.collection_view_resp.desc = "包含目前計數器的主題指標集合。"
emqx_topic_metrics2_api.collection_view_resp.label = "主題指標集合"
emqx_topic_metrics2_api.conflict_resp.desc = "集合名稱已存在，或已達到叢集級集合配額。"
emqx_topic_metrics2_api.conflict_resp.label = "衝突"
emqx_topic_metrics2_api.create_collection.desc = "建立由名稱識別的新主題指標集合，並在有命名空間時作用於呼叫者的命名空間。\n\n命名空間管理員：租戶命名空間中的用戶端會在掛載點字首下發布（例如命名空間 `acme` 的用戶端發布到 `t/x` 時，broker 上顯示為 `acme/t/x`）。`topic_filter` 會匹配掛載點應用後的主題，因此命名空間管理員編寫的集合過濾器必須包含掛載點字首才能匹配自身用戶端的流量。"
emqx_topic_metrics2_api.create_collection.label = "建立主題指標集合"
emqx_topic_metrics2_api.delete_collection.desc = "按名稱刪除單個主題指標集合。"
emqx_topic_metrics2_api.delete_collection.label = "刪除主題指標集合"
emqx_topic_metrics2_api.delete_collections.desc = "刪除呼叫者可見的所有主題指標集合。"
emqx_topic_metrics2_api.delete_collections.label = "刪除所有可見主題指標集合"
emqx_topic_metrics2_api.field_name.desc = "集合名稱，在其命名空間內唯一。允許字元：字母、數字、連字元和下劃線。最多 64 個字元。在全域並不唯一——相同名稱可在不同命名空間中重複使用，因此消費者必須以 `(namespace, name)` 作為鍵，而非僅用 `name`。"
emqx_topic_metrics2_api.field_name.label = "集合名稱"
emqx_topic_metrics2_api.field_namespace.desc = "集合所屬命名空間。全域（全叢集）集合為 null。"
emqx_topic_metrics2_api.field_namespace.label = "所屬命名空間"
emqx_topic_metrics2_api.field_topic_filter.desc = "用於匹配訊息的 MQTT 主題過濾器。允許萬用字元（`+`、`#`）。\n\n不允許使用共享訂閱主題過濾器（`$share/<group>/...` 及其別名 `$queue/...`）：共享字首存在於訂閱上，而不在發布的訊息上，因此這類過濾器永遠不會匹配，該集合將無法統計到任何資料。請改用普通主題過濾器（例如使用 `sensor/1` 而不是 `$share/group/sensor/1`）——投遞給該主題共享訂閱者的訊息仍會計入其中。\n\n對於命名空間集合，過濾器會匹配應用租戶掛載點後的發布主題——因此 `acme` 命名空間管理員想追蹤 `t/x` 時，必須使用包含掛載點的過濾器（如 `acme/t/x`）。"
emqx_topic_metrics2_api.field_topic_filter.label = "主題過濾器"
emqx_topic_metrics2_api.forbidden_ns_resp.desc = "命名空間管理員嘗試透過 `ns` 查詢參數存取其他命名空間的集合。只有全域管理員才能指定任意命名空間。"
emqx_topic_metrics2_api.forbidden_ns_resp.label = "禁止存取"
emqx_topic_metrics2_api.get_collection.desc = "讀取單個主題指標集合。計數器在叢集內聚合。"
emqx_topic_metrics2_api.get_collection.label = "取得主題指標集合"
emqx_topic_metrics2_api.list_collections.desc = "列出呼叫者可見的所有主題指標集合。"
emqx_topic_metrics2_api.list_collections.label = "列出主題指標集合"
emqx_topic_metrics2_api.not_found_resp.desc = "不存在給定名稱的集合。"
emqx_topic_metrics2_api.not_found_resp.label = "未找到"
emqx_topic_metrics2_api.reset_collection.desc = "在叢集範圍內重置單個集合的計數器。"
emqx_topic_metrics2_api.reset_collection.label = "重置主題指標集合"
