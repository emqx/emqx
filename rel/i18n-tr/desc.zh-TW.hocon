emqx_gateway_schema.dtls_listener_acceptors.desc = "Acceptor 行程池大小。"
emqx_gateway_schema.dtls_listener_dtls_opts.desc = "DTLS Socket 設定"
emqx_gateway_schema.fields_ws_opts_allow_origin_absence.desc = "如果設定為<code>false</code>，且<code>check_origin_enable</code>為<code>true</code>，伺服器將拒絕沒有<code>origin</code> HTTP 請求標頭的請求。"
emqx_gateway_schema.fields_ws_opts_allow_origin_absence.label = "允許缺少 origin"
emqx_gateway_schema.fields_ws_opts_check_origin_enable.desc = "如果設定為<code>true</code>，將驗證<code>origin</code> HTTP 請求標頭是否在<code>check_origins</code>參數中設定的允許來源列表中。"
emqx_gateway_schema.fields_ws_opts_check_origin_enable.label = "檢查 origin"
emqx_gateway_schema.fields_ws_opts_check_origins.desc = "允許來源的列表。<br/>參見<code>check_origin_enable</code>。"
emqx_gateway_schema.fields_ws_opts_check_origins.label = "允許的來源"
emqx_gateway_schema.fields_ws_opts_compress.desc = "如果設定為<code>true</code>，將使用<code>zlib</code>壓縮 WebSocket 訊息。<br/>\n<code>deflate_opts</code>下的設定項屬於與壓縮相關的參數設定。"
emqx_gateway_schema.fields_ws_opts_compress.label = "WebSocket 壓縮"
emqx_gateway_schema.fields_ws_opts_fail_if_no_subprotocol.desc = "如果設定為<code>true</code>，當用戶端不攜帶<code>Sec-WebSocket-Protocol</code>欄位時，伺服器將回傳錯誤。\n<br/>注意：小程式需要停用此驗證。"
emqx_gateway_schema.fields_ws_opts_fail_if_no_subprotocol.label = "如果沒有子協定則失敗"
emqx_gateway_schema.fields_ws_opts_idle_timeout.desc = "等待 WebSocket 升級請求的逾時時間。逾時後，連線將被關閉。"
emqx_gateway_schema.fields_ws_opts_idle_timeout.label = "WebSocket 升級逾時"
emqx_gateway_schema.fields_ws_opts_max_frame_size.desc = "單個 MQTT 資料包的最大長度。"
emqx_gateway_schema.fields_ws_opts_max_frame_size.label = "最大幀大小"
emqx_gateway_schema.fields_ws_opts_path.desc = "WebSocket 的M QTT 協定路徑。因此，EMQX Broker 的 WebSocket 地址是：<code>ws://{ip}:{port}/mqtt</code>"
emqx_gateway_schema.fields_ws_opts_path.label = "WS MQTT 路徑"
emqx_gateway_schema.fields_ws_opts_piggyback.desc = "WebSocket 訊息是否允許包含多個 MQTT 資料包。"
emqx_gateway_schema.fields_ws_opts_piggyback.label = "MQTT 搭載"
emqx_gateway_schema.fields_ws_opts_proxy_address_header.desc = "用於傳遞用戶端 IP 地址資訊的 HTTP 請求標頭。\n當 EMQX 叢集部署在負載均衡器後面時相關。\n\n設定為空字串（<code>\"\"</code>）可停用此選項，此時始終使用 WebSocket 連線的源 IP 地址。"
emqx_gateway_schema.fields_ws_opts_proxy_address_header.label = "Proxy 地址請求標頭"
emqx_gateway_schema.fields_ws_opts_proxy_port_header.desc = "用於傳遞用戶端連接埠資訊的 HTTP 請求標頭。\n當 EMQX 叢集部署在負載均衡器後面時相關。\n\n設定為空字串（<code>\"\"</code>）可停用此選項，此時始終使用 WebSocket 連線的源連接埠。"
emqx_gateway_schema.fields_ws_opts_proxy_port_header.label = "Proxy 連接埠請求標頭"
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.desc = "逗號分隔的支援的子協定列表。"
emqx_gateway_schema.fields_ws_opts_supported_subprotocols.label = "支援的子協定"
emqx_gateway_schema.gateway_common_authentication.desc = "閘道的認證器設定，對該閘道下所以的監聽器生效。如果每個監聽器需要設定不同的認證器，需要設定監聽器下的 <code>authentication</code> 欄位"
emqx_gateway_schema.gateway_common_clientinfo_override.desc = "ClientInfo 重寫。"
emqx_gateway_schema.gateway_common_clientinfo_override_clientid.desc = "clientid 重寫模板"
emqx_gateway_schema.gateway_common_clientinfo_override_password.desc = "password 重寫模板"
emqx_gateway_schema.gateway_common_clientinfo_override_username.desc = "username 重寫模板"
emqx_gateway_schema.gateway_common_enable.desc = "是否啟用該閘道"
emqx_gateway_schema.gateway_common_enable_stats.desc = "是否開啟用戶端統計"
emqx_gateway_schema.gateway_common_idle_timeout.desc = "用戶端連線過程的空閒時間。該設定用於：\n  1. 一個新建立的用戶端行程如果在該時間間隔內沒有收到任何用戶端請求，將被直接關閉。\n  2. 一個正在執行的用戶端行程如果在這段時間後沒有收到任何用戶端請求，將進入休眠狀態以節省資源。"
emqx_gateway_schema.gateway_common_listener_access_rules.desc = "一個包含字串規則的存取規則列表，用於限制或允許來自某些地址的存取。\n列表中較早出現的規則優先匹配。\n格式為 allow | deny <address> | <CIDR> | all。\n\n例如：\n\n[\"deny 192.168.1.1\", \"allow 192.168.1.0/24\", \"deny all\"]"
emqx_gateway_schema.gateway_common_listener_bind.desc = "監聽器繫結的 IP 地址或連接埠。"
emqx_gateway_schema.gateway_common_listener_enable.desc = "是否啟用該監聽器。"
emqx_gateway_schema.gateway_common_listener_enable_authn.desc = "設定 <code>true</code> （預設值）啟用用戶端進行身分認證。\n設定 <code>false</code> 時，將不對用戶端做任何認證。"
emqx_gateway_schema.gateway_common_listener_max_conn_rate.desc = "監聽器支援的最大連線速率。"
emqx_gateway_schema.gateway_common_listener_max_connections.desc = "監聽器支援的最大連線數。"
emqx_gateway_schema.gateway_mountpoint.desc = "發布或訂閱時，在所有主題前增加字首字串。\n當訊息投遞給訂閱者時，字首字串將從主題名稱中移除。掛載點是使用者可以用來實現不同監聽器之間的訊息路由隔離的一種方式。\n例如，如果用戶端 A 在 `listeners.tcp.\\<name>.mountpoint` 設定為 `some_tenant` 的情況下訂閱 `t`，\n則用戶端實際上訂閱了 `some_tenant/t` 主題。\n類似地，如果另一個用戶端 B（連線到與用戶端 A 相同的偵聽器）向主題 `t` 傳送訊息，\n則該訊息被路由到所有訂閱了 `some_tenant/t` 的用戶端，因此用戶端 A 將收到該訊息，帶有 主題名稱`t`。 設定為 `\"\"` 以停用該功能。\n掛載點字串中可用的變數：<br/>\n   - <code>${clientid}</code>：clientid<br/>\n   - <code>${username}</code>：使用者名稱"
emqx_gateway_schema.listener_name_to_settings_map.desc = "從監聽器名稱到設定參數的對映。"
emqx_gateway_schema.ssl_listener_options.desc = "SSL Socket 設定。"
emqx_gateway_schema.tcp_listener_acceptors.desc = "Acceptor 行程池大小。"
emqx_gateway_schema.tcp_listener_proxy_protocol.desc = "如果為 EMQX 部署了反向 Proxy，並且在 Proxy 上啟用了 Proxy 協定以傳遞用戶端的真實 IP，\n則需要開啟此選項，以便 EMQX 能夠從 Proxy 協定標頭中提取用戶端的真實 IP。\nEMQX 將自動檢測 Proxy 協定的版本，並支援 V1 和 V2。\n\n有關 Proxy 協定的詳細描述，請參考：https://www.haproxy.com/blog/haproxy/proxy-protocol/。"
emqx_gateway_schema.tcp_listener_proxy_protocol_timeout.desc = "接收 Proxy 協定封包標頭的逾時時間。如果在逾時內沒有收到 Proxy 協定包，EMQX 將關閉 TCP 連線。"
emqx_gateway_schema.tcp_listener_tcp_opts.desc = "TCP Socket 設定。"
emqx_gateway_schema.tcp_listeners.desc = "設定 TCP 類型的監聽器。"
emqx_gateway_schema.tcp_udp_listeners.desc = "監聽器設定。"
emqx_gateway_schema.udp_health_check.desc = "一些雲平台使用“請求-回覆”機制來檢查 UDP 連接埠是否健康，這裡可以設定這對內容。"
emqx_gateway_schema.udp_health_check_reply.desc = "回覆的內容。"
emqx_gateway_schema.udp_health_check_request.desc = "請求的內容。"
emqx_gateway_schema.udp_listener_active_n.desc = "為 Socket 指定 {active, N} 選項。\n參見：https://erlang.org/doc/man/inet.html#setopts-2"
emqx_gateway_schema.udp_listener_buffer.desc = "Socket 在使用者空間的緩衝區大小。"
emqx_gateway_schema.udp_listener_recbuf.desc = "Socket 在核心空間接收緩衝區的大小。"
emqx_gateway_schema.udp_listener_reuseaddr.desc = "允許重用本地處於 TIME_WAIT 的連接埠號。"
emqx_gateway_schema.udp_listener_sndbuf.desc = "Socket 在核心空間傳送緩衝區的大小。"
emqx_gateway_schema.udp_listener_udp_opts.desc = "UDP Socket 設定。"
emqx_gateway_schema.udp_listeners.desc = "設定 UDP 類型的監聽器。"
emqx_gbt32960_schema.max_retry_times.desc = "最大重新傳送次數"
emqx_gbt32960_schema.message_queue_len.desc = "最大訊息佇列長度"
emqx_gbt32960_schema.retry_interval.desc = "重新傳送時間間隔"
emqx_jt808_schema.authentication_url.desc = "JT/T 808 裝置認證中心的 URL。"
emqx_jt808_schema.ignore_unsupported_frames.desc = "是否忽略不支援的 JT/T 808 資料幀。<br/>\n- <code>true</code>，閘道會記錄不支援的幀並忽略。 <br/>\n- <code>false</code>，閘道在收到不支援的幀時將斷開用戶端連線。<br/>\n預設值為 true。"
emqx_jt808_schema.jt808_allow_anonymous.desc = "允許匿名存取 JT/T 808 閘道。"
emqx_jt808_schema.jt808_auth.desc = "JT/T 808 閘道的認證設定。"
emqx_jt808_schema.jt808_dn_topic.desc = "JT/T 808 協定下行訊息的主題，相對於閘道掛載點。"
emqx_jt808_schema.jt808_frame_max_length.desc = "JT/T 808 幀的最大長度。"
emqx_jt808_schema.jt808_up_topic.desc = "JT/T 808 協定上行訊息的主題，相對於閘道掛載點。"
emqx_jt808_schema.max_retry_times.desc = "最大重發次數"
emqx_jt808_schema.message_queue_len.desc = "最大訊息佇列長度"
emqx_jt808_schema.parse_unknown_message.desc = "是否處理並轉發無法識別的 Message ID。<br/>\n- <code>true</code>：處理無法識別的 Message ID，其訊息體以 Base64 編碼後轉發。<br/>\n- <code>false</code>：收到無法識別的 Message ID 時報告並記錄錯誤。<br/>\n預設值為 true。"
emqx_jt808_schema.registry_url.desc = "JT/T 808 裝置註冊中心的 URL。"
emqx_jt808_schema.retry_interval.desc = "重發時間間隔"
emqx_jt808_schema.string_encoding.desc = "JT/T 808 線協定中 STRING 型別欄位的字元編碼。<br/>\n- <code>utf8</code>：字串按 UTF-8 編碼處理（相容舊行為，預設）。<br/>\n- <code>gbk</code>：字串按 JT/T 808 規範的 GBK 編碼處理；與 MQTT 負載之間轉換為 UTF-8。<br/>\n注意：無論此設定如何，MQTT 負載始終使用 UTF-8。如果中文文字出現亂碼（Mojibake），請設為 <code>gbk</code>。"
emqx_ldap.base_dn.desc = "與基本物件條目（或根）相關的名稱。\n搜尋使用者的起點。"
emqx_ldap.base_dn.label = "基本 DN"
emqx_ldap.filter.desc = "定義哪些條件必須被依次滿足的篩選器\n用於搜尋匹配一條給定的條目.<br>\n篩選器的語法遵循 RFC 4515，並且還支援佔位符。"
emqx_ldap.filter.label = "過濾器"
emqx_ldap.request_timeout.desc = "設定每個單獨請求所使用的最長時間（以毫秒為單位）。"
emqx_ldap.request_timeout.label = "請求逾時"
emqx_ldap.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>\n主機名條目的格式為：`主機[:連接埠]`。<br/>\n如果 `[:連接埠]` 未指定， 將使用 LDAP 預設連接埠 389。"
emqx_ldap.server.label = "伺服器地址"
emqx_license_http_api.bad_license_key.desc = "錯誤的授權金鑰"
emqx_license_http_api.bad_license_key.label = "錯誤的授權金鑰"
emqx_license_http_api.bad_setting_value.desc = "錯誤的設定值"
emqx_license_http_api.bad_setting_value.label = "錯誤的設定值"
emqx_license_http_api.desc_license_info_api.desc = "取得授權資訊"
emqx_license_http_api.desc_license_info_api.label = "授權資訊"
emqx_license_http_api.desc_license_key_api.desc = "更新一個授權金鑰"
emqx_license_http_api.desc_license_key_api.label = "更新授權"
emqx_license_http_api.desc_license_setting_api.desc = "更新授權設定"
emqx_license_http_api.desc_license_setting_api.label = "更新授權設定"
emqx_license_http_api.desc_session_hwm_history_api.desc = "取得會話高水位線歷史。回傳按天或按月的會話峰值計數。"
emqx_license_http_api.desc_session_hwm_history_api.label = "會話高水位線歷史"
emqx_license_http_api.example_license_key_string.desc = "用於更新授權金鑰的請求範例。"
emqx_license_http_api.example_license_key_string.label = "授權金鑰字串範例"
emqx_license_http_api.param_history_limit.desc = "回傳的最大行數。`daily` 預設 30，`monthly` 預設 24（匹配 24 個月保留視窗）。"
emqx_license_http_api.param_history_limit.label = "限制"
emqx_license_http_api.param_history_period.desc = "聚合週期：`daily` 每天一行，`monthly` 將每日峰值摺疊為月級最大值。預設 `monthly`。"
emqx_license_http_api.param_history_period.label = "週期"
emqx_license_http_api.resp_count.desc = "回傳的資料行數。"
emqx_license_http_api.resp_count.label = "數量"
emqx_license_http_api.resp_data.desc = "高水位線記錄陣列，按時間從新到舊。"
emqx_license_http_api.resp_data.label = "資料"
emqx_license_http_api.resp_period.desc = "此回應使用的聚合週期（`daily` 或 `monthly`）。"
emqx_license_http_api.resp_period.label = "週期"
emqx_license_http_api.resp_row_hwm.desc = "該週期內觀察到的會話峰值計數。"
emqx_license_http_api.resp_row_hwm.label = "高水位線"
emqx_license_http_api.resp_row_observed_at.desc = "觀察到峰值的時間戳（RFC 3339）。"
emqx_license_http_api.resp_row_observed_at.label = "觀察時間"
emqx_license_http_api.resp_row_period.desc = "日曆週期標籤，例如按日為 `2026-04-18`，按月為 `2026-04`。"
emqx_license_http_api.resp_row_period.label = "週期標籤"
emqx_license_schema.connection_high_watermark_field.desc = "連線數超過該值時，系統會觸發授權連線配額使用警報"
emqx_license_schema.connection_high_watermark_field.label = "連線高水位線"
emqx_license_schema.connection_low_watermark_field.desc = "連線數低於此值是，系統會清除連線配額使用警報"
emqx_license_schema.connection_low_watermark_field.label = "連線低水位線"
emqx_license_schema.dynamic_max_connections.desc = "僅適用於 BC 授權類型。此設定目前叢集的授權配額。\n此值不能超過授權金鑰中指定的連線限制。"
emqx_license_schema.dynamic_max_connections.label = "動態連線限制"
emqx_license_schema.high_watermark_timezone.desc = "用於確定會話高水位線歷史的本地日界時區。\n使用 `system` 表示跟隨節點主機本地時區，或提供顯式偏移，如 `+02:00`。"
emqx_license_schema.high_watermark_timezone.label = "會話高水位線時區"
emqx_license_schema.key_field.desc = "該設定項用於設定授權金鑰，支援以下輸入格式：\n\n- **直接金鑰**：直接以字串形式輸入金鑰內容；\n- **檔案路徑**：指定包含金鑰的檔案路徑，路徑需以 file:// 開頭；\n- **\"default\"**：使用字串值 default，應用預設的單節點社群授權；\n- **\"evaluation\"**：使用字串值 evaluation，應用限制為 25 個連線的評估授權。\n\n注意：無效的授權金鑰或錯誤的檔案路徑可能會導致 EMQX 啟動失敗。\n如果使用檔案路徑，EMQX 將每隔 2 分鐘嘗試重新載入該檔案中的授權金鑰。\n如果重新載入失敗，EMQX 會記錄一條錯誤級別日誌，並繼續使用之前成功載入的授權。"
emqx_license_schema.key_field.label = "授權金鑰"
emqx_license_schema.license_root.desc = "用於設定 EMQX Enterprise 的授權。\n\nEMQX 預設提供一個單節點社群授權。\n該預設授權不允許用於商業用途。\n\n您可以在此申請正式授權：https://www.emqx.com/apply-licenses/emqx?version=5。"
emqx_license_schema.license_root.label = "授權"
emqx_limiter_schema.bytes_burst.desc = "可以突發傳送的位元組數，超出常規的 `bytes_rate`。\n\n例如：`100MB/60m`：每 60 分鐘內，可以在短時間內傳送最多 100MB 的資料。"
emqx_limiter_schema.bytes_burst.label = "資料發布突發量"
emqx_limiter_schema.bytes_rate.desc = "限制單個用戶端每個節點可以向 broker 傳送的位元組數。\n\n一旦達到限制，EMQX 將丟棄 QoS 0 訊息並拒絕 QoS 1 和 QoS 2 訊息，\n回傳“配額超出”錯誤程式碼 (0x97)。\n\n位元組的單位可以是：B、KB、MB、GB。\n\n例如：\n\n- `500KB/s`：每秒鐘只接收 500 千位元組，剩餘位元組將被丟棄/拒絕。\n- `500MB/10s`：每 10 秒只接收 500 兆位元組，剩餘位元組將被丟棄/拒絕。"
emqx_limiter_schema.bytes_rate.label = "資料發布速率"
emqx_limiter_schema.delivery_bytes_burst.desc = "每個節點在常規 `delivery_bytes_rate` 之上，允許突發傳送的位元組數。\n\n僅在使用記憶體會話時生效（即 `durable_sessions.enable = false`）。\n\n例如：`100MB/60m`：每 60 分鐘一次，短時間內最多可傳送 100 MB。"
emqx_limiter_schema.delivery_bytes_burst.label = "資料投遞突發"
emqx_limiter_schema.delivery_bytes_rate.desc = "限制每個節點 broker 向單個用戶端傳送的位元組數。注意，這與 `bytes_rate` 的方向相反。\n\n僅在使用記憶體會話時生效（即 `durable_sessions.enable = false`）。\n\n達到限制後，EMQX 將丟棄 QoS 0 訊息，並將 QoS 1 和 QoS 2 訊息放入用戶端內部佇列，稍後重試。\n\n位元組單位可以是：B、KB、MB、GB。\n\n例如：\n\n- `500KB/s`：每秒只接收 500 KB，其餘位元組將被丟棄/拒絕/入隊。\n- `500MB/10s`：每 10 秒只接收 500 MB，其餘位元組將被丟棄/拒絕/入隊。"
emqx_limiter_schema.delivery_bytes_rate.label = "資料投遞速率"
emqx_limiter_schema.delivery_messages_burst.desc = "每個節點在常規 `delivery_messages_rate` 之上，允許突發傳送的訊息數。\n\n僅在使用記憶體會話時生效（即 `durable_sessions.enable = false`）。\n\n例如：`10000/60m`：每 60 分鐘一次，短時間內最多可傳送 10000 條訊息。"
emqx_limiter_schema.delivery_messages_burst.label = "訊息投遞突發"
emqx_limiter_schema.delivery_messages_rate.desc = "限制每個節點 broker 向單個用戶端傳送的訊息數。注意，這與 `messages_rate` 的方向相反。\n\n僅在使用記憶體會話時生效（即 `durable_sessions.enable = false`）。\n\n達到限制後，EMQX 將丟棄 QoS 0 訊息，並將 QoS 1 和 QoS 2 訊息放入用戶端內部佇列，稍後重試。\n\n例如：\n\n- `500/s`：每秒只接收 500 條訊息，其餘訊息將被丟棄/拒絕/入隊。\n- `500/10s`：每 10 秒只接收 500 條訊息，其餘訊息將被丟棄/拒絕/入隊。"
emqx_limiter_schema.delivery_messages_rate.label = "訊息投遞速率"
emqx_limiter_schema.max_conn_burst.desc = "可以突發接受的連線數，超出常規速率，每個節點。\n\n例如：`10000/60m`：每 60 分鐘內，可以在短時間內接受最多 10000 個連線。"
emqx_limiter_schema.max_conn_burst.label = "最大連線突發量"
emqx_limiter_schema.max_conn_rate.desc = "限制此監聽器每個節點接受連線的速度。\n\n當達到限制後，EMQX 會在新連線被接受後立即關閉它們，從而有效清空等待被接受的連線佇列。\n\n例如：\n\n- `1000/s`：每秒只接受 1000 個連線。\n- `1000/10s`：每 10 秒只接受 1000 個連線。"
emqx_limiter_schema.max_conn_rate.label = "最大連線速率"
emqx_limiter_schema.messages_burst.desc = "可以突發傳送的訊息數，超出常規的 `messages_rate`，每個節點。\n\n例如：`10000/60m`：每 60 分鐘內，可以在短時間內傳送最多 10000 條訊息。"
emqx_limiter_schema.messages_burst.label = "訊息發布突發量"
emqx_limiter_schema.messages_rate.desc = "限制單個用戶端每個節點可以向 broker 傳送的訊息數量。\n\n一旦達到限制，EMQX 將丟棄 QoS 0 訊息並拒絕 QoS 1 和 QoS 2 訊息，\n回傳“配額超出”錯誤程式碼 (0x97)。\n\n例如：\n\n- `500/s`：每秒只接收 500 條訊息，剩餘訊息將被丟棄/拒絕。\n- `500/10s`：每 10 秒只接收 500 條訊息，剩餘訊息將被丟棄/拒絕。"
emqx_limiter_schema.messages_rate.label = "訊息發布速率"
emqx_limiter_schema.mqtt.desc = "MQTT 相關限流器。"
emqx_limiter_schema.subscribes_burst.desc = "限制單個用戶端在每個節點上一次性向 broker 傳送的訂閱包數量。"
emqx_limiter_schema.subscribes_burst.label = "訂閱突發"
emqx_limiter_schema.subscribes_rate.desc = "限制單個用戶端在每個節點上向 broker 傳送的訂閱包速率。\n\n達到限制後，EMQX 將不處理該包，並回復帶有 `SUBACK` 與 \"Quota Exceeded\" 錯誤碼（0x97）的回應。"
emqx_limiter_schema.subscribes_rate.label = "訂閱速率"
emqx_lwm2m_api.client_not_found.desc = "未找到用戶端"
emqx_lwm2m_api.client_not_found.label = "未找到用戶端"
emqx_lwm2m_api.dataType.desc = "資料型別"
emqx_lwm2m_api.lookup_resource.desc = "檢視指定資源狀態"
emqx_lwm2m_api.lookup_resource.label = "查詢資源"
emqx_lwm2m_api.name.desc = "資源名稱"
emqx_lwm2m_api.no_content.desc = "無內容"
emqx_lwm2m_api.no_content.label = "無內容"
emqx_lwm2m_api.observe_resource.desc = "Observe/Un-Observe 指定資源"
emqx_lwm2m_api.observe_resource.label = "觀察資源"
emqx_lwm2m_api.operations.desc = "資源可用操作列表"
emqx_lwm2m_api.path.desc = "資源路徑"
emqx_lwm2m_api.read_resource.desc = "傳送讀指令到某資源"
emqx_lwm2m_api.read_resource.label = "讀取資源"
emqx_lwm2m_api.write_resource.desc = "傳送寫指令到某資源"
emqx_lwm2m_api.write_resource.label = "寫入資源"
emqx_lwm2m_schema.lwm2m.desc = "LwM2M 閘道設定（v1.0.1）。\n先使用預設值，再調整 lifetime 和主題對映。"
emqx_lwm2m_schema.lwm2m_auto_observe.desc = "從 REGISTER 物件列表自動建立 Observe 訂閱。\n支援的值：<br/>\n  - false / \"off\"：停用自動 observe<br/>\n  - true / \"on\"：observe REGISTER 物件列表中的所有路徑<br/>\n  - \"/3/0,/3/0/1\" 或 [\"/3/0\", \"/3/0/1\"]：僅 observe 指定路徑"
emqx_lwm2m_schema.lwm2m_blockwise.desc = "大負載傳輸設定。\n分塊傳輸將一個大負載拆分為更小的 CoAP 塊。\n除非遇到負載大小或丟包問題，否則使用預設值即可。"
emqx_lwm2m_schema.lwm2m_blockwise_enable.desc = "啟用大負載的分塊傳輸。\n除非所有負載都很小且固定，否則保持啟用。"
emqx_lwm2m_schema.lwm2m_blockwise_exchange_lifetime.desc = "臨時分塊狀態的保留時長。\n過短可能導致慢速傳輸中斷；過長會佔用更多記憶體。"
emqx_lwm2m_schema.lwm2m_blockwise_max_block_size.desc = "每個 CoAP 塊的大小（位元組）。\n較大的值：更少的資料包，但丟包時重傳代價更高。\n較小的值：更多的資料包，但丟包影響更小。"
emqx_lwm2m_schema.lwm2m_blockwise_max_body_size.desc = "重組後的最終負載最大大小。\n超過此大小的訊息將被拒絕以保護記憶體。"
emqx_lwm2m_schema.lwm2m_coap_max_block_size.desc = "自 6.1.0 起已棄用。請使用 `blockwise.max_block_size` 代替。"
emqx_lwm2m_schema.lwm2m_lifetime_max.desc = "閘道接受的用戶端 lifetime 上限。\n用於防止裝置設定過長的保活間隔。"
emqx_lwm2m_schema.lwm2m_lifetime_min.desc = "閘道接受的用戶端 lifetime 下限。\n用於防止裝置產生過於頻繁的更新流量。"
emqx_lwm2m_schema.lwm2m_qmode_time_window.desc = "在 QMode 下，這是 UPDATE 之後的“鏈路仍有效”視窗。\n視窗內：直接傳送訊息。\n視窗外：將訊息快取在記憶體中，直到用戶端可達。"
emqx_lwm2m_schema.lwm2m_translators.desc = "LwM2M 事件與 MQTT 命令之間的主題對映。"
emqx_lwm2m_schema.lwm2m_translators_command.desc = "傳送下行命令到 LwM2M 用戶端的 MQTT 主題。\n方向：MQTT -> LwM2M 裝置。"
emqx_lwm2m_schema.lwm2m_translators_notify.desc = "發布來自 LwM2M 用戶端的 NOTIFY 事件的 MQTT 主題。\n方向：LwM2M 裝置 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_register.desc = "發布 REGISTER 事件的 MQTT 主題。\n方向：LwM2M 裝置 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_response.desc = "發布命令回應/ACK 事件的 MQTT 主題。\n方向：LwM2M 裝置 -> MQTT。"
emqx_lwm2m_schema.lwm2m_translators_update.desc = "發布 UPDATE 事件的 MQTT 主題。\n方向：LwM2M 裝置 -> MQTT。"
emqx_lwm2m_schema.lwm2m_update_msg_publish_condition.desc = "何時發布 UPDATE 事件。<br/>\n  - always：發布每個 UPDATE 請求<br/>\n  - contains_object_list：僅當 UPDATE 包含 Object 列表時發布<br/>\n使用 <code>contains_object_list</code> 可以減少無意義的更新事件。"
emqx_lwm2m_schema.lwm2m_xml_dir.desc = "LwM2M 資源定義 XML 檔案的目錄。\n請設定為本地 XML 目錄（必需）。"
emqx_lwm2m_schema.translator.desc = "一個主題對映項（主題 + QoS），對應一種事件類型。"
emqx_lwm2m_schema.translator_qos.desc = "發布此事件主題時使用的 QoS。"
emqx_lwm2m_schema.translator_topic.desc = "MQTT 主題名稱/模板。"
