emqx_bridge_iotdb_connector.config_base_url.desc = "外部 IoTDB 服務的 REST 介面的基礎 URL。"
emqx_bridge_iotdb_connector.config_base_url.label = "伺服器地址"
emqx_bridge_iotdb_connector.config_database.desc = "要連線的 IoTDB 資料庫名稱。"
emqx_bridge_iotdb_connector.config_database.label = "資料庫"
emqx_bridge_iotdb_connector.config_driver.desc = "IoTDB 連接器使用的驅動程式，可以是：\n- rest\n- thrift"
emqx_bridge_iotdb_connector.config_max_retries.desc = "當 HTTP 請求失敗時的最大重試次數。"
emqx_bridge_iotdb_connector.config_max_retries.label = "HTTP 請求最大重試次數"
emqx_bridge_iotdb_connector.config_protocol_version.desc = "IoTDB Thrift 協定的版本。"
emqx_bridge_iotdb_connector.config_sql_dialect.desc = "IoTDB 支援兩種時序資料模型（SQL 方言），\n均用於管理裝置和測點。\n- Tree：以層級路徑方式管理資料，一個路徑對應裝置的一個測點。\n- Table：以關係表方式管理資料，一個表對應一類裝置。"
emqx_bridge_iotdb_connector.config_sql_dialect.label = "SQL 方言"
emqx_bridge_iotdb_connector.config_zoneId.desc = "IoTDB Thrift 會話的時區。"
emqx_bridge_iotdb_connector.connect_timeout.desc = "連線到 IoTDB Thrift 伺服器的逾時時間。"
emqx_bridge_iotdb_connector.desc_config.desc = "Apache IoTDB 連接器的設定。"
emqx_bridge_iotdb_connector.desc_config.label = "IoTDB 連接器設定"
emqx_bridge_iotdb_connector.pool_size.desc = "IoTDB Thrift 連線池的大小。"
emqx_bridge_iotdb_connector.recv_timeout.desc = "IoTDB Thrift 伺服器回應的逾時時間。"
emqx_bridge_iotdb_connector.server.desc = "IoTDB Thrift 伺服器的地址（主機:連接埠）。"
emqx_bridge_kafka.allow_auto_topic_creation.desc = "設定為 true 以允許透過後設資料取得請求自動建立 Kafka 主題。"
emqx_bridge_kafka.allow_auto_topic_creation.label = "允許自動建立主題"
emqx_bridge_kafka.auth_gssapi_kerberos.desc = "使用 GSSAPI/Kerberos 認證。"
emqx_bridge_kafka.auth_gssapi_kerberos.label = "GSSAPI/Kerberos"
emqx_bridge_kafka.auth_kerberos_keytab_file.desc = "SASL GSSAPI 認證方法的 Kerberos keytab 檔案。注意：該檔案需要上傳到 EMQX 伺服器中，且執行 EMQX 服務的系統帳戶需要有讀取權限。"
emqx_bridge_kafka.auth_kerberos_keytab_file.label = "Kerberos keytab 檔案"
emqx_bridge_kafka.auth_kerberos_principal.desc = "SASL GSSAPI 認證方法的 Kerberos 主體，例如 <code>kafka/node1.example.com@EXAMPLE.COM</code>，注意：這裡使用的 realm 需要設定在 EMQX 伺服器的預設設定檔 krb5.conf 中（通常位於 `/etc`）。"
emqx_bridge_kafka.auth_kerberos_principal.label = "Kerberos 主體"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_endpoint.desc = "AWS IAM Roles Anywhere 憑據行程提供其 API 的端點。"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_endpoint.label = "端點"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_region.desc = "MSK 叢集執行所在的 AWS 區域。"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_region.label = "區域"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_type.desc = "MSK IAM Roles Anywhere"
emqx_bridge_kafka.auth_msk_iam_roles_anywhere_type.label = "MSK IAM Roles Anywhere"
emqx_bridge_kafka.auth_oauth_client_credentials.desc = "基於 OAuth 的認證（用戶端憑證流程）。"
emqx_bridge_kafka.auth_oauth_client_credentials.label = "OAuth（用戶端憑證）認證"
emqx_bridge_kafka.auth_sasl_mechanism.desc = "SASL 認證方法名稱。"
emqx_bridge_kafka.auth_sasl_mechanism.label = "認證方法"
emqx_bridge_kafka.auth_sasl_password.desc = "SASL 認證的密碼。"
emqx_bridge_kafka.auth_sasl_password.label = "密碼"
emqx_bridge_kafka.auth_sasl_username.desc = "SASL 認證的使用者名稱。"
emqx_bridge_kafka.auth_sasl_username.label = "使用者名稱"
emqx_bridge_kafka.auth_username_password.desc = "基於使用者名稱密碼的認證。"
emqx_bridge_kafka.auth_username_password.label = "使用者名稱密碼認證"
emqx_bridge_kafka.authentication.desc = "認證設定。\n- <code>none</code>：無認證。\n- <code>msk_iam</code>：使用 [MSK IAM 認證](https://docs.aws.amazon.com/msk/latest/developerguide/security-iam.html)。注意：這僅在 EMQX 執行在 EC2 實例上時有效。\n- <code>basic auth</code>：簡單的使用者名稱和密碼認證。\n- <code>kerberos</code>：使用 Kerberos GSSAPI 認證。"
emqx_bridge_kafka.authentication.label = "認證"
emqx_bridge_kafka.bootstrap_hosts.desc = "用逗號分隔的 <code>host[:port]</code> 主機列表。預設連接埠號為 9092。"
emqx_bridge_kafka.bootstrap_hosts.label = "主機列表"
emqx_bridge_kafka.buffer_memory_overload_protection.desc = "快取模式是 <code>memory</code> 或 <code>hybrid</code> 時適用。當系統處於高記憶體壓力時，從佇列中丟棄舊的訊息以減緩記憶體增長。注意，該設定僅在 Linux 系統中有效。"
emqx_bridge_kafka.buffer_memory_overload_protection.label = "記憶體過載保護"
emqx_bridge_kafka.buffer_mode.desc = "訊息快取模式。\n<code>memory</code>: 所有的訊息都快取在記憶體裡。如果 EMQX 服務重啟，快取的訊息會遺失。\n<code>disk</code>: 快取到磁碟上。EMQX 重啟後會繼續傳送重啟前未傳送完成的訊息。\n<code>hybrid</code>: 先將訊息快取在記憶體中，當記憶體中的訊息堆積超過一定限制（設定項 <code>segment_bytes</code> 描述了該限制）後，後續的訊息會快取到磁碟上。與 <code>memory</code> 模式一樣，如果 EMQX 服務重啟，快取的訊息會遺失。"
emqx_bridge_kafka.buffer_mode.label = "快取模式"
emqx_bridge_kafka.buffer_per_partition_limit.desc = "為每個 Kafka 分割區設定的最大快取位元組數。當超過這個上限之後，老的訊息會被丟棄，為新的訊息騰出空間。"
emqx_bridge_kafka.buffer_per_partition_limit.label = "Kafka 分割區快取上限"
emqx_bridge_kafka.buffer_segment_bytes.desc = "當快取模式是 <code>disk</code> 或 <code>hybrid</code> 時適用。該設定用於指定快取到磁碟上的檔案的大小。"
emqx_bridge_kafka.buffer_segment_bytes.label = "快取檔案大小"
emqx_bridge_kafka.compression.desc = "壓縮方法。"
emqx_bridge_kafka.compression.label = "壓縮"
emqx_bridge_kafka.config_enable.desc = "啟用（true）或停用該（false）Kafka 資料橋接。"
emqx_bridge_kafka.config_enable.label = "啟用或停用"
emqx_bridge_kafka.connect_timeout.desc = "建立 TCP 連線時的最長等待時長（若啟用認證，這個等待時長也包含完成認證所需時間）。"
emqx_bridge_kafka.connect_timeout.label = "連線逾時"
emqx_bridge_kafka.consumer_kafka_opts.desc = "Kafka 消費者設定。"
emqx_bridge_kafka.consumer_kafka_opts.label = "Kafka 消費者"
emqx_bridge_kafka.consumer_kafka_topic.desc = "指定從哪個 Kafka 主題消費訊息。"
emqx_bridge_kafka.consumer_kafka_topic.label = "Kafka 主題"
emqx_bridge_kafka.consumer_key_encoding_mode.desc = "透過 MQTT 轉發之前，如何處理 Kafka 訊息的 Key。<code>none</code> 使用 Kafka 訊息中的 Key 原始值，不進行編碼。注意：在這種情況下，Key 必須是一個有效的 UTF-8 字串。\n<code>base64</code> 對收到的 Key 或值使用 base-64 編碼。"
emqx_bridge_kafka.consumer_key_encoding_mode.label = "Key 編碼模式"
emqx_bridge_kafka.consumer_max_batch_bytes.desc = "設定每次從 Kafka 拉取資料的位元組數。\n訊息由消費者批次拉取，如果第一個非空\n分割區中的第一個記錄批次大於此值，記錄批次仍將被回傳，以確保\n消費者能夠繼續行程。因此，這不是絕對的最大值。設定為 1 可實現最低延遲。"
emqx_bridge_kafka.consumer_max_batch_bytes.label = "拉取位元組數"
emqx_bridge_kafka.consumer_max_rejoin_attempts.desc = "消費組成員允許重新加入小組的最大次數。如超過該設定次數後仍未能成功加入消費組，則會在等待一段時間後重試。"
emqx_bridge_kafka.consumer_max_rejoin_attempts.label = "最大的重新加入嘗試"
emqx_bridge_kafka.consumer_mqtt_opts.desc = "本地 MQTT 訊息轉發。"
emqx_bridge_kafka.consumer_mqtt_opts.label = "MQTT 轉發"
emqx_bridge_kafka.consumer_mqtt_payload.desc = "用於轉換收到的 Kafka 訊息的模板。預設情況下，它將使用 JSON 格式來序列化來自 Kafka 的所有欄位。這些欄位包括：<code>headers</code>：一個包含字串鍵值對的 JSON 物件。\n<code>key</code>：Kafka 訊息的鍵（使用選擇的編碼方式編碼）。\n<code>offset</code>：訊息的偏移量。\n<code>topic</code>：Kafka 主題。\n<code>ts</code>: 訊息的時間戳。\n<code>ts_type</code>：訊息的時間戳類型，值可能是： <code>create</code>， <code>append</code> 或 <code>undefined</code>。\n<code>value</code>: Kafka 訊息值（使用選擇的編碼方式編碼）。"
emqx_bridge_kafka.consumer_mqtt_payload.label = "MQTT 載荷模板"
emqx_bridge_kafka.consumer_mqtt_qos.desc = "轉發 MQTT 訊息時使用的 QoS。"
emqx_bridge_kafka.consumer_mqtt_qos.label = "QoS"
emqx_bridge_kafka.consumer_mqtt_topic.desc = "設定 Kafka 訊息向哪個本地 MQTT 主題轉發訊息。"
emqx_bridge_kafka.consumer_mqtt_topic.label = "MQTT 主題"
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.desc = "指定 Kafka 消費組偏移量提交的時間間隔。"
emqx_bridge_kafka.consumer_offset_commit_interval_seconds.label = "偏移提交間隔"
emqx_bridge_kafka.consumer_offset_reset_policy.desc = "如不存在偏移量歷史記錄或歷史記錄失效，消費者應使用哪個偏移量開始消費。"
emqx_bridge_kafka.consumer_offset_reset_policy.label = "偏移重置策略"
emqx_bridge_kafka.consumer_opts.desc = "本地 MQTT 轉發 和 Kafka 消費者設定。"
emqx_bridge_kafka.consumer_opts.label = "MQTT 到 Kafka"
emqx_bridge_kafka.consumer_value_encoding_mode.desc = "透過 MQTT 轉發之前，如何處理 Kafka 訊息的 Value。<code>none</code> 使用 Kafka 訊息中的 Value 原始值，不進行編碼。  注意：在這種情況下，Value 必須是一個有效的 UTF-8 字串。\n<code>base64</code> 對收到的 Value 使用 base-64 編碼。"
emqx_bridge_kafka.consumer_value_encoding_mode.label = "Value 編碼模式"
emqx_bridge_kafka.desc_config.desc = "一個 Kafka 生產者用戶端的設定項"
emqx_bridge_kafka.desc_config.label = "Kafka 生產者用戶端設定"
emqx_bridge_kafka.desc_name.desc = "橋接名字，可讀描述"
emqx_bridge_kafka.desc_name.label = "橋接名字"
emqx_bridge_kafka.desc_type.desc = "橋接類型"
emqx_bridge_kafka.desc_type.label = "橋接類型"
emqx_bridge_kafka.kafka_consumer.desc = "Kafka 消費者設定。"
emqx_bridge_kafka.kafka_consumer.label = "Kafka 消費者"
emqx_bridge_kafka.kafka_header_value_encode_mode.desc = "Kafka 標頭值編碼模式<br/>\n - None: 僅將二進位制值新增到 Kafka 標頭；<br/>\n - JSON: 僅將 JSON 值新增到 Kafka 標頭，並在傳送前對其進行 JSON 字串編碼。"
emqx_bridge_kafka.kafka_header_value_encode_mode.label = "Kafka 標頭值編碼模式"
emqx_bridge_kafka.kafka_headers.desc = "請提供要用作 Kafka 標頭的佔位符<br/>\n例如：<code>${pub_props}</code><br/>\n請注意，佔位符的值必須是物件形式的：<code>{\"foo\": \"bar\"}</code>\n或者是鍵值對的陣列形式：<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>。"
emqx_bridge_kafka.kafka_headers.label = "Kafka 標頭"
emqx_bridge_kafka.kafka_message.desc = "用於生成 Kafka 訊息的模版。"
emqx_bridge_kafka.kafka_message.label = "Kafka 訊息模版"
emqx_bridge_kafka.kafka_message_key.desc = "生成 Kafka 訊息 Key 的模版。如果模版生成後為空值，則會使用 Kafka 的 <code>NULL</code> ，而非空字串。"
emqx_bridge_kafka.kafka_message_key.label = "訊息的 Key"
emqx_bridge_kafka.kafka_message_timestamp.desc = "生成 Kafka 訊息時間戳的模版。該時間必需是一個整型數值（可以是字串格式）例如 <code>1661326462115</code> 或 <code>'1661326462115'</code>。當所需的輸入欄位不存在，或不是一個整型時，則會使用目前系統時間。"
emqx_bridge_kafka.kafka_message_timestamp.label = "訊息的時間戳"
emqx_bridge_kafka.kafka_message_value.desc = "生成 Kafka 訊息 Value 的模版。如果模版生成後為空值，則會使用 Kafka 的 <code>NULL</code>，而非空字串。"
emqx_bridge_kafka.kafka_message_value.label = "訊息的 Value"
emqx_bridge_kafka.kafka_producer.desc = "Kafka 生產者設定。"
emqx_bridge_kafka.kafka_producer.label = "Kafka 生產者"
emqx_bridge_kafka.kafka_producer_action.desc = "Kafka 生產者動作"
emqx_bridge_kafka.kafka_producer_action.label = "Kafka 生產者動作"
emqx_bridge_kafka.kafka_topic.desc = "Kafka 主題名稱。支援使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_kafka.kafka_topic.label = "Kafka 主題名稱"
emqx_bridge_kafka.max_batch_age.desc = "訊息在生產者緩衝區中停留的最長時間，超過該時間後訊息將被丟棄而不再傳送到 Kafka。\n只有當一個訊息批次中的所有訊息在緩衝區中的停留時間都超過該時長時，該批次才會被丟棄；這既適用於仍在排隊的訊息（包括連線斷開期間），也適用於連線遺失時正在等待確認的訊息。\n每條被丟棄的訊息都會計入 <code>dropped.expired</code> 指標。\n設定為 <code>infinity</code> 時，訊息永不過期（將一直保留直到傳送成功，或緩衝區溢位）。"
emqx_bridge_kafka.max_batch_age.label = "最長批次存留時間"
emqx_bridge_kafka.max_batch_bytes.desc = "最大訊息批次位元組數。大多數 Kafka 環境的預設最低值是 1 MB，EMQX 的預設值比 1 MB 更小是因為需要補償 Kafka 訊息編碼所需要的額外位元組（尤其是當每條訊息都很小的情況下）。當單個訊息的大小超過該限制時，它仍然會被傳送，（相當於該批次中只有單個訊息）。"
emqx_bridge_kafka.max_batch_bytes.label = "最大批次位元組數"
emqx_bridge_kafka.max_inflight.desc = "設定 Kafka 生產者（每個分割區一個）在收到 Kafka 的確認前最多傳送多少個請求（批次）。調大這個值通常可以增加吞吐量，但是，當該值設定大於 1 時存在訊息亂序的風險。"
emqx_bridge_kafka.max_inflight.label = "飛行視窗"
emqx_bridge_kafka.max_linger_bytes.desc = "每個分割區生產者在等待期間最多累積的位元組數，達到該值後將停止等待併傳送該批次。"
emqx_bridge_kafka.max_linger_bytes.label = "最大等待位元組數"
emqx_bridge_kafka.max_linger_time.desc = "每個分割區生產者為了將更多訊息累積成更大批次而等待的最長時間。\n預設值 `0` 表示不等待（訊息到達後立即傳送），以最佳化訊息延遲。\n如果可以接受少量延遲，建議設定一個等待時間，以幫助降低每秒向 Kafka 傳送的請求數。\n一旦累積的資料達到一個完整批次，等待就會提前結束，因此繁忙的生產者不會被額外延遲。\n當緩衝到磁碟時，等待發生在寫入緩衝區之前；此時建議設定至少 `5ms` 以減少磁碟 IOPS。"
emqx_bridge_kafka.max_linger_time.label = "最長等待時間"
emqx_bridge_kafka.max_retries.desc = "在 Kafka 回傳可重試錯誤（例如分割區 leader 已變更）後，重試傳送訊息批次的最大次數。\n當首次嘗試和所有重試均失敗後，該批次將被丟棄，其中每條訊息都會計入 <code>failed</code> 指標。\n只有當 Kafka 明確回傳錯誤碼時重試計數器才會遞增；由連線斷開觸發的重發不會遞增該計數器（這類重發由 <code>max_batch_age</code> 限制）。\n設定為 <code>infinity</code> 時，重試次數不受限制。"
emqx_bridge_kafka.max_retries.label = "最大重試次數"
emqx_bridge_kafka.metadata_request_timeout.desc = "重新整理後設資料時最長等待時長。"
emqx_bridge_kafka.metadata_request_timeout.label = "後設資料請求逾時"
emqx_bridge_kafka.min_metadata_refresh_interval.desc = "重新整理 Kafka broker 和 Kafka 主題後設資料段最短時間間隔。設定太小可能會增加 Kafka 壓力。"
emqx_bridge_kafka.min_metadata_refresh_interval.label = "後設資料重新整理最小間隔"
emqx_bridge_kafka.mqtt_topic.desc = "MQTT 主題資料來源由橋接指定，或留空由規則動作指定。"
emqx_bridge_kafka.mqtt_topic.label = "源 MQTT 主題"
emqx_bridge_kafka.oauth_client_credentials_client_id.desc = "用於從 OAuth 伺服器請求權杖的用戶端 ID。"
emqx_bridge_kafka.oauth_client_credentials_client_id.label = "OAuth 用戶端 ID"
emqx_bridge_kafka.oauth_client_credentials_client_secret.desc = "用於從 OAuth 伺服器請求權杖的用戶端金鑰。"
emqx_bridge_kafka.oauth_client_credentials_client_secret.label = "OAuth 用戶端金鑰"
emqx_bridge_kafka.oauth_client_credentials_endpoint_uri.desc = "生成存取權杖的 OAuth 權杖端點的 URI。"
emqx_bridge_kafka.oauth_client_credentials_endpoint_uri.label = "OAuth 權杖端點 URI"
emqx_bridge_kafka.oauth_client_credentials_extensions.desc = "如果需要，指定要傳遞到 SASL 握手的擴充套件。"
emqx_bridge_kafka.oauth_client_credentials_extensions.label = "SASL 擴充套件"
emqx_bridge_kafka.oauth_client_credentials_grant_type.desc = "OAuth 授權類型"
emqx_bridge_kafka.oauth_client_credentials_grant_type.label = "OAuth 授權類型"
emqx_bridge_kafka.oauth_client_credentials_mechanism.desc = "SASL 認證機制"
emqx_bridge_kafka.oauth_client_credentials_mechanism.label = "SASL 認證機制"
emqx_bridge_kafka.oauth_client_credentials_scope.desc = "如果需要，指定在請求 OAuth 存取權杖時提供的 `scope`。"
emqx_bridge_kafka.oauth_client_credentials_scope.label = "OAuth 請求作用域"
emqx_bridge_kafka.partition_count_refresh_interval.desc = "設定 Kafka 重新整理分割區數量的時間間隔。\nEMQX 發現 Kafka 分割區數量增加後，會開始按 <code>partition_strategy<code> 設定，把訊息傳送到新的分割區中。"
emqx_bridge_kafka.partition_count_refresh_interval.label = "分割區數量重新整理間隔"
emqx_bridge_kafka.partition_strategy.desc = "設定訊息發布時應該如何選擇 Kafka 分割區。\n\n<code>random</code>: 為每個訊息隨機選擇一個分割區。\n<code>key_dispatch</code>: Hash Kafka message key to a partition number"
emqx_bridge_kafka.partition_strategy.label = "分割區選擇策略"
emqx_bridge_kafka.partitions_limit.desc = "限制為給定主題生產資料的分割區數量。\n特殊值 all_partitions 用於利用該主題的所有分割區。\n將此設定為大於分割區總數的值將不會產生任何效果。"
emqx_bridge_kafka.partitions_limit.label = "最大分割區數"
emqx_bridge_kafka.producer_buffer.desc = "設定訊息快取的相關參數。\n\n當 EMQX 需要傳送的訊息超過 Kafka 處理能力，或者當 Kafka 臨時下線時，EMQX 內部會將訊息快取起來。"
emqx_bridge_kafka.producer_buffer.label = "訊息快取"
emqx_bridge_kafka.producer_health_check_topic.desc = "專用於更精確的連接器健康檢查的主題名稱。"
emqx_bridge_kafka.producer_health_check_topic.label = "連接器健康檢查主題"
emqx_bridge_kafka.producer_kafka_ext_header_key.desc = "Kafka 標頭的鍵。支援格式為 ${var} 的佔位符。"
emqx_bridge_kafka.producer_kafka_ext_header_key.label = "額外的 Kafka 標頭鍵"
emqx_bridge_kafka.producer_kafka_ext_header_value.desc = "Kafka 標頭的值。支援格式為 ${var} 的佔位符。"
emqx_bridge_kafka.producer_kafka_ext_header_value.label = "值"
emqx_bridge_kafka.producer_kafka_ext_headers.desc = "請提供更多的 Kafka 標頭鍵值對<br/>\n這裡的鍵值對將與 <code>kafka_headers</code> 欄位的值合併，然後傳送到 Kafka。"
emqx_bridge_kafka.producer_kafka_ext_headers.label = "額外的 Kafka 標頭"
emqx_bridge_kafka.producer_kafka_opts.desc = "Kafka 生產者參數。"
emqx_bridge_kafka.producer_kafka_opts.label = "生產者參數"
emqx_bridge_kafka.query_mode.desc = "查詢模式。可選 'sync/async'，預設 'async'。"
emqx_bridge_kafka.query_mode.label = "查詢模式"
emqx_bridge_kafka.reconnect_delay.desc = "連線斷開後，生產者嘗試重新連線到 Kafka 之前的延遲時間。\n斷開期間，訊息會繼續在緩衝區中累積，受緩衝區限制和 <code>max_batch_age</code> 約束。"
emqx_bridge_kafka.reconnect_delay.label = "重連延遲"
emqx_bridge_kafka.request_timeout.desc = "等待 Kafka 對待處理請求作出回應的最長時間。\n超過該時間後，連線被視為失效並會重新建立。\n注意：如果設定得太小，Kafka 可能已經接收了某個生產請求但確認被延遲；EMQX 重連後會重發這個已被接受的批次，可能導致訊息重複，並給下游消費者帶來過大的資料量。"
emqx_bridge_kafka.request_timeout.label = "請求逾時"
emqx_bridge_kafka.required_acks.desc = "設定 Kafka leader 在回傳給 EMQX 確認之前需要等待多少個 follower 的確認。\n\n<code>all_isr</code>: 需要所有的線上複製者都確認。\n<code>leader_only</code>: 僅需要分割區 leader 確認。\n<code>none</code>: 無需 Kafka 回覆任何確認。"
emqx_bridge_kafka.required_acks.label = "Kafka 確認數量"
emqx_bridge_kafka.resource_opts.desc = "資源選項。"
emqx_bridge_kafka.resource_opts.label = "資源選項"
emqx_bridge_kafka.server_name_indication.desc = "TLS 握手的 Server Name Indication (SNI) 設定。<br/>\n- <code>auto</code>：用戶端將使用 <code>\"servicebus.windows.net\"</code> 作為 SNI。<br/>\n- <code>disable</code>：如果您希望阻止用戶端傳送 SNI。<br/>\n- 其他字串值將按原樣傳送。"
emqx_bridge_kafka.server_name_indication.label = "SNI"
emqx_bridge_kafka.socket_nodelay.desc = "設定‘true’讓系統核心立即傳送。否則當需要傳送的內容很少時，可能會有一定延遲（預設 40 毫秒）。"
emqx_bridge_kafka.socket_nodelay.label = "是否關閉延遲傳送"
emqx_bridge_kafka.socket_opts.desc = "更多 Socket 參數設定。"
emqx_bridge_kafka.socket_opts.label = "Socket 參數"
emqx_bridge_kafka.socket_receive_buffer.desc = "TCP socket 的收包快取調優。預設值是針對高吞吐量的一個推薦值。"
emqx_bridge_kafka.socket_receive_buffer.label = "Socket 收包快取大小"
emqx_bridge_kafka.socket_send_buffer.desc = "TCP socket 的傳送快取調優。預設值是針對高吞吐量的一個推薦值。"
emqx_bridge_kafka.socket_send_buffer.label = "Socket 傳送快取大小"
emqx_bridge_kafka.ssl_client_opts.desc = "Kafka 用戶端的 TLS/SSL 選項"
emqx_bridge_kafka.ssl_client_opts.label = "TLS/SSL 選項"
emqx_bridge_kafka.sync_query_timeout.desc = "該參數定義同步查詢的逾時限制。僅當橋接查詢模式設定為'sync'時才適用。"
emqx_bridge_kafka.sync_query_timeout.label = "同步查詢逾時"
emqx_bridge_kafka_consumer_schema.config_connector.desc = "Kafka 消費者用戶端的設定。"
emqx_bridge_kafka_consumer_schema.config_connector.label = "Kafka 消費者用戶端設定"
emqx_bridge_kafka_consumer_schema.consumer_source.desc = "Source 設定。"
emqx_bridge_kafka_consumer_schema.consumer_source.label = "Source"
emqx_bridge_kafka_consumer_schema.group_id.desc = "用於此 Source 的消費者組識別碼。如果省略，將自動生成一個基於 Source 名稱的識別碼。"
emqx_bridge_kafka_consumer_schema.group_id.label = "自訂消費者組 ID"
emqx_bridge_kafka_consumer_schema.max_wait_time.desc = "等待 Kafka broker 傳送拉取回應的最長時間。"
emqx_bridge_kafka_consumer_schema.max_wait_time.label = "最長等待時間"
emqx_bridge_kafka_consumer_schema.source_parameters.desc = "針對 Source 的詳細設定。"
emqx_bridge_kafka_consumer_schema.source_parameters.label = "Source 詳細設定"
