emqx_dashboard_api.logout_api.label = "Dashboard 使用者退出登入"
emqx_dashboard_api.mfa_status.desc = "多重身分認證（MFA）狀態。\n- `none`：未啟用 MFA\n- `disabled`：使用者的 MFA 已停用\n- 其他值：正在使用的 MFA 機制，例如 `totp`。"
