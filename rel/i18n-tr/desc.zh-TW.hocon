emqx_mgmt_api_trace.stream_trace_log.label = "流式追蹤日誌"
emqx_mgmt_api_trace.support_wildcard.desc = "如果過濾器類型為 'topic' 則該欄位可以指定用於匹配的 MQTT 主題或主題過濾器。"
emqx_mgmt_api_trace.support_wildcard.label = "MQTT 主題或主題過濾器"
emqx_mgmt_api_trace.time_format.desc = "rfc3339 或者 epoch 時間戳格式"
