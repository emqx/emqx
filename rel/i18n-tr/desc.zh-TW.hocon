emqx_bridge_iotdb.action_resource_opts.label = "動作資源選項"
emqx_bridge_iotdb.auth_basic.desc = "基本認證（basic auth）的參數。"
emqx_bridge_iotdb.auth_basic.label = "基本認證(basic auth)"
emqx_bridge_iotdb.config_auth_basic_password.desc = "Basic auth 密碼。類似 IoTDB REST 介面中的密碼。"
emqx_bridge_iotdb.config_auth_basic_password.label = "Basic auth 密碼"
emqx_bridge_iotdb.config_auth_basic_username.desc = "Basic auth 使用者名稱。類似 IoTDB REST 介面中的使用者名稱。"
emqx_bridge_iotdb.config_auth_basic_username.label = "Basic auth 使用者名稱"
emqx_bridge_iotdb.config_authentication.desc = "認證資訊"
emqx_bridge_iotdb.config_authentication.label = "認證資訊"
emqx_bridge_iotdb.config_base_url.desc = "IoTDB REST 服務的 URL。"
emqx_bridge_iotdb.config_base_url.label = "REST 服務 URL"
emqx_bridge_iotdb.config_device_id.desc = "IoTDB 的裝置 ID（DeviceID）。可以使用一個佔位符。如果留空則 MQTT 訊息體中必須有一個 `device_id` 欄位，\n或者 EMQX 規則引擎的 SQL 必須輸出一個 `device_id` 欄位。"
emqx_bridge_iotdb.config_device_id.label = "Device ID"
emqx_bridge_iotdb.config_enable.desc = "啟用或停用該橋接"
emqx_bridge_iotdb.config_enable.label = "啟用或停用"
emqx_bridge_iotdb.config_iotdb_version.desc = "IoTDB 版本。"
emqx_bridge_iotdb.config_iotdb_version.label = "IoTDB 版本"
emqx_bridge_iotdb.config_is_aligned.desc = "是否對齊時間序列。"
emqx_bridge_iotdb.config_is_aligned.label = "對齊時間序列"
emqx_bridge_iotdb.config_max_retries.desc = "HTTP 請求的最大重試次數。"
emqx_bridge_iotdb.config_max_retries.label = "最大重試次數"
emqx_bridge_iotdb.config_parameters_column_category.desc = "列類別，用於構建對 IoTDB 表的插入請求。有效值包括：\n- <code>tag</code>\n- <code>field</code>\n- <code>attribute</code>"
emqx_bridge_iotdb.config_parameters_column_category.label = "列類別"
emqx_bridge_iotdb.config_parameters_data_type.desc = "資料型別，可以是：\n\n- test\n- boolean\n- int32\n- int64\n- float\n- double"
emqx_bridge_iotdb.config_parameters_data_type.label = "資料型別"
emqx_bridge_iotdb.config_parameters_measurement.desc = "也稱 Measurement，支援使用 ${var} 格式的佔位符。"
emqx_bridge_iotdb.config_parameters_measurement.label = "欄位"
emqx_bridge_iotdb.config_parameters_timestamp.desc = "時間戳。支援格式為 ${var} 的佔位符，最終值可以是：\n\n- now: 使用目前時間（毫秒）\n- now_ms: 同上\n- now_us: 使用目前時間（微秒）\n- now_ns: 使用目前時間（納秒）\n- 任何整數: 直接使用該值作為時間戳\n- 佔位符: 使用 payload 中的值作為時間戳"
emqx_bridge_iotdb.config_parameters_timestamp.label = "時間戳"
emqx_bridge_iotdb.config_parameters_value.desc = "值。支援格式為 ${var} 的佔位符"
emqx_bridge_iotdb.config_parameters_value.label = "值"
emqx_bridge_iotdb.config_table_name.desc = "要寫入資料的 IoTDB 表名。"
emqx_bridge_iotdb.config_table_name.label = "表名"
emqx_bridge_iotdb.config_write_to_table.desc = "是否將資料寫入 IoTDB 表或時序。\n注意：當為 true 時，連接器還必須將 \"SQL Dialect\" 設定為 \"table\"。"
emqx_bridge_iotdb.config_write_to_table.label = "寫入表"
emqx_bridge_iotdb.creation_opts.desc = "建立選項"
emqx_bridge_iotdb.creation_opts.label = "建立選項"
