emqx_bridge_redis.desc_name.label = "動作名稱"
emqx_bridge_redis.desc_type.desc = "動作的類型"
emqx_bridge_redis.desc_type.label = "動作類型"
emqx_bridge_redis.redis_type.desc = "單一模式。當 Redis 伺服器在單一模式下執行時，必須設定為 'single'。\n哨兵模式。當 Redis 伺服器在哨兵模式下執行時，必須設定為 'sentinel'。\n叢集模式。當Redis伺服器在叢集模式下執行時，必須設定為 'cluster'。"
emqx_bridge_redis.redis_type.label = "Redis 類型"
emqx_bridge_redis_schema.batch_size.desc = "這個參數定義了批處理計數的上限。\n將這個值設定為1將有效地停用批處理，因為它表示每個批處理將只處理一個專案。\n關於 Redis 叢集模式的注意事項：\n在 Redis 叢集模式的情況下不支援批處理。\n因此，batch_size 總是設定為1，\n反映了該模式對於批處理操作固有的限制。"
emqx_bridge_redis_schema.batch_size.label = "批處理大小"
emqx_bridge_redis_schema.batch_time.desc = "在低訊息速率下積累批處理時的最長等待間隔，以實現更高效的資源使用。"
emqx_bridge_redis_schema.batch_time.label = "最長批處理等待時間，在 Redis Cluster 模式下停用"
emqx_bridge_redis_schema.producer_action.desc = "動作的參數。"
emqx_bridge_redis_schema.producer_action.label = "動作參數"
emqx_bridge_redis_schema.redis_action.desc = "與 Redis 連接器互動的動作。"
emqx_bridge_redis_schema.redis_action.label = "Redis 動作"
emqx_bridge_redis_schema.redis_parameters.desc = "特定於某個 Redis 連接器類型的參數集，`redis_type`可以是`single`，`cluster`或`sentinel`之一。"
emqx_bridge_redis_schema.redis_parameters.label = "Redis 類型特定參數"
