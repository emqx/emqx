emqx_ft_schema.assemble_timeout.desc = "檔案拼接逾時。<br/>\n在收到 'fin' 訊息後 EMQX 會對檔案進行拼接，如果發生逾時（例如系統過載），則會給 'fin' 的 PUBACK 中包含一個錯誤碼（0x80）。"
emqx_ft_schema.backend_enable.desc = "是否啟用該後端"
emqx_ft_schema.enable.desc = "啟用檔案傳輸（File Transfer）服務。<br/>\n檔案傳輸服務允許用戶端使用 `$file` 主題將分片上傳到 EMQX。\n啟用檔案傳輸服務表示 `$file` 主題字首已被預留，用於提供檔案傳輸服務。<br/>\n這個開關也會影響檔案傳輸 REST API 的可用性，以及依賴儲存的後台任務（例如垃圾回收）。"
emqx_ft_schema.init_timeout.desc = "指定檔案傳輸初始化的時間限制。在<br/>\nEMQX 伺服器過載時可能發生初始化逾時。逾時後給 `init` 的 PUBACK 中包含一個錯誤碼 （0x80）。"
emqx_ft_schema.local_storage.desc = "EMQX 節點本地用檔案系統於儲存檔案分片的相關設定。"
emqx_ft_schema.local_storage_exporter.desc = "將檔案匯出到本地儲存。"
emqx_ft_schema.local_storage_exporter_backend.desc = "將檔案匯出到本地儲存<br/>\n該設定項指定所有分片都傳輸完成了的檔案進行匯出到本地儲存的相關行為。"
emqx_ft_schema.local_storage_exporter_root.desc = "匯出到本地檔案時使用的根目錄。"
emqx_ft_schema.local_storage_segments.desc = "本地檔案系統儲存設定，包括已上傳的檔案分片和臨時資料。"
emqx_ft_schema.local_storage_segments_gc.desc = "檔案系統中臨時檔案的垃圾回收設定。"
emqx_ft_schema.local_storage_segments_root.desc = "檔案分片儲存的根目錄。"
emqx_ft_schema.s3_exporter.desc = "將檔案匯出到 AWS s3 API 相容的物件儲存服務。"
emqx_ft_schema.storage_backend.desc = "檔案後端儲存設定"
emqx_ft_schema.storage_gc_interval.desc = "執行垃圾回收的時間間隔。"
emqx_ft_schema.storage_gc_max_segments_ttl.desc = "分片的臨時儲存的最大 TTL。<br/>\n該設定為系統全域上限，所有的分片都不會超過這個 TTL，即使某些檔案傳輸指定了一個更大的 TTL。"
emqx_ft_schema.storage_gc_min_segments_ttl.desc = "分片的臨時儲存的最小 TTL。<br/>\n分片在超過這個 TTL 之前不被垃圾回收。\n該設定為系統全域下限，所有的分片都不會低於這個 TTL，即使某些檔案傳輸指定了一個更小的 TTL。"
emqx_ft_schema.store_segment_timeout.desc = "檔案片段儲存逾時。<br/>\nEMQX 收到檔案分片後，會對它進行儲存，如果發生逾時（例如系統過載），則會給這個發布訊息的 PUBACK 中包含一個錯誤碼（0x80）。"
emqx_ft_storage_exporter_fs_api.file_get.desc = "根據檔案 ID 下載指定檔案"
emqx_ft_storage_exporter_fs_api.file_get.label = "取得檔案"
emqx_ft_storage_exporter_fs_api.file_reference.desc = "檔案引用"
emqx_ft_storage_exporter_fs_api.file_reference.label = "檔案引用"
