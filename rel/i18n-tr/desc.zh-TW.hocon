emqx_mgmt_api_clients.mailbox_len.label = "郵箱長度"
emqx_mgmt_api_clients.max_payload_bytes.desc = "用戶端的未確認訊息（inflight）/ 訊息佇列（mqueue）訊息 payload 限制。\n回傳的所有訊息總負載大小不會超過此值。\n達到該限制時，回應中包含的訊息數量可能少於 `limit`；`meta.position` 指向最後一條回傳的訊息，因此可以從該位置請求下一頁來取得被省略的訊息。\n唯一的例外是當第一條訊息的負載已超過限制時，在這種情況下，回應中僅回傳該第一條訊息。"
emqx_mgmt_api_clients.max_payload_bytes.label = "最大負載位元組數"
