emqx_bridge_mongodb.enable.desc = "啟用或停用該 MongoDB 動作"
emqx_bridge_mongodb.enable.label = "啟用或停用"
emqx_bridge_mongodb.mongodb_action.desc = "與 MongoDB 連接器互動的動作"
emqx_bridge_mongodb.mongodb_action.label = "MongoDB 動作"
emqx_bridge_mongodb.mongodb_parameters.desc = "特定於此 MongoDB 連接器類型的一組參數，mongo_type 可以是 single（獨立）、sharded（分片）或 rs（副本集）之一。"
emqx_bridge_mongodb.mongodb_parameters.label = "MongoDB 類型特定參數"
emqx_bridge_mongodb.mongodb_rs_conf.desc = "MongoDB (Replica Set) 設定"
emqx_bridge_mongodb.mongodb_rs_conf.label = "MongoDB (Replica Set) 設定"
emqx_bridge_mongodb.mongodb_sharded_conf.desc = "MongoDB (Sharded) 設定"
emqx_bridge_mongodb.mongodb_sharded_conf.label = "MongoDB (Sharded) 設定"
emqx_bridge_mongodb.mongodb_single_conf.desc = "MongoDB (Standalone) 設定"
emqx_bridge_mongodb.mongodb_single_conf.label = "MongoDB (Standalone) 設定"
emqx_bridge_mongodb.mqtt_topic.desc = "MQTT 主題或主題過濾器作為資料來源（動作輸入）。如果將規則動作用作資料來源，則此設定應保留為空，否則訊息將在 MongoDB 中重複。"
emqx_bridge_mongodb.mqtt_topic.label = "源 MQTT 主題"
emqx_bridge_mongodb.payload_template.desc = "用於格式化傳送訊息的模板。如果未定義，規則引擎將使用 JSON 格式序列化所有可見輸入，例如 clientid、主題、有效載荷等。"
emqx_bridge_mongodb.payload_template.label = "有效載荷模版"
emqx_bridge_mqtt_connector_schema.bridge_mode.desc = "如果啟用橋接模式。\n注意：此設定僅適用於 MQTT 協定版本早於5.0的情況，遠端 MQTT\nbroker 必須支援此功能。\n如果將 bridge_mode 設定為true，則橋接將指示遠端 broker 它是一個橋接而不是普通用戶端。\n這意味著迴圈檢測將更加有效，並且保留的訊息將被正確傳遞。"
emqx_bridge_mqtt_connector_schema.bridge_mode.label = "橋接模式"
emqx_bridge_mqtt_connector_schema.clean_start.desc = "在重新連線到入口動作時是否啟動新會話"
emqx_bridge_mqtt_connector_schema.clean_start.label = "新會話"
emqx_bridge_mqtt_connector_schema.clientid_prefix.desc = "附加到 egress 動作使用的 clientid 字首（可選）。"
emqx_bridge_mqtt_connector_schema.clientid_prefix.label = "Clientid 字首"
emqx_bridge_mqtt_connector_schema.config_connector.desc = "MQTT connector 的設定。"
emqx_bridge_mqtt_connector_schema.config_connector.label = "MQTT 連接器"
emqx_bridge_mqtt_connector_schema.connect_timeout.desc = "連線遠端 broker 的逾時時間。在嘗試建立初始連線時，連線的工作行程會暫停，直到達到設定的逾時時間為止。"
emqx_bridge_mqtt_connector_schema.connect_timeout.label = "連線逾時時間"
emqx_bridge_mqtt_connector_schema.egress_desc.desc = "egress 設定定義了此動作如何將訊息從本地 broker 轉發到遠端 broker。<br/>\n允許在'remote.topic'、'local.qos'、'local.retain'、'local.payload'中使用帶有變數的模板。<br/>\n注意：如果將此動作用作規則的動作，並且還設定了'local.topic'，則從規則取得的資料和與\n'local.topic'匹配的 MQTT 訊息都將被轉發。"
emqx_bridge_mqtt_connector_schema.egress_desc.label = "Egress 設定"
emqx_bridge_mqtt_connector_schema.egress_local.desc = "關於從本地 broker 接收訊息的設定。"
emqx_bridge_mqtt_connector_schema.egress_local.label = "本地設定"
emqx_bridge_mqtt_connector_schema.egress_local_topic.desc = "要轉發到遠端 broker 的本地主題"
emqx_bridge_mqtt_connector_schema.egress_local_topic.label = "本地主題"
emqx_bridge_mqtt_connector_schema.egress_pool_size.desc = "將發布訊息到遠端 broker 的 MQTT 用戶端池的大小。<br/>\n每個 MQTT 用戶端都將分配'clientid'，格式為'${clientid_prefix}:${bridge_name}:egress:${node}:${n}'\n其中'n'是池中用戶端的編號。\n\n如果 `static_clientids` 不為空，則此選項無效。當使用靜態用戶端 ID 時，池的大小始終根據每個節點分配的 ID 數量來確定。"
emqx_bridge_mqtt_connector_schema.egress_pool_size.label = "用戶端池大小"
emqx_bridge_mqtt_connector_schema.egress_remote.desc = "關於向遠端 broker 傳送訊息的設定。"
emqx_bridge_mqtt_connector_schema.egress_remote.label = "遠端設定"
emqx_bridge_mqtt_connector_schema.egress_remote_qos.desc = "要傳送的 MQTT 訊息的 QoS 級別。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.egress_remote_qos.label = "遠端 QoS"
emqx_bridge_mqtt_connector_schema.egress_remote_topic.desc = "要轉發到遠端 broker 的主題。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.egress_remote_topic.label = "遠端主題"
emqx_bridge_mqtt_connector_schema.ingress_desc.desc = "ingress 設定定義了此動作如何從遠端 MQTT broker 接收訊息，然後將它們傳送到本地 broker。<br/>\n允許在'remote.qos'、'local.topic'、'local.qos'、'local.retain'、'local.payload'中使用帶有變數的模板。<br/>\n注意：如果將此動作用作規則的輸入，並且還設定了'local.topic'，則從遠端 broker 取得的訊息將傳送到'local.topic'和規則。"
emqx_bridge_mqtt_connector_schema.ingress_desc.label = "Ingress 設定"
emqx_bridge_mqtt_connector_schema.ingress_local.desc = "關於向本地 broker 傳送訊息的設定。"
emqx_bridge_mqtt_connector_schema.ingress_local.label = "Local 設定"
emqx_bridge_mqtt_connector_schema.ingress_local_qos.desc = "要傳送的 MQTT 訊息的 QoS 級別。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.ingress_local_qos.label = "本地 QoS"
emqx_bridge_mqtt_connector_schema.ingress_local_topic.desc = "要傳送到本地 broker 的主題。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.ingress_local_topic.label = "本地主題"
emqx_bridge_mqtt_connector_schema.ingress_pool_size.desc = "將從遠端 broker 接收訊息的 MQTT 用戶端池的大小。<br/>\n僅當'remote.topic'是共享訂閱主題或主題過濾器時才會尊重此值，\n（例如$share/name1/topic1或$share/name2/topic2/#），否則只會使用一個 MQTT 用戶端。\n每個 MQTT 用戶端都將分配'clientid'，格式為'${clientid_prefix}:${bridge_name}:ingress:${node}:${n}'\n其中'n'是池中用戶端的編號。\n注意：當 EMQX 進行叢集化時，非共享訂閱將無法正常工作。\n\n如果 `static_clientids` 不為空，則此選項無效。當使用靜態用戶端 ID 時，池的大小始終根據每個節點分配的 ID 數量來確定。"
emqx_bridge_mqtt_connector_schema.ingress_pool_size.label = "用戶端池大小"
emqx_bridge_mqtt_connector_schema.ingress_remote.desc = "關於向遠端 broker 訂閱的設定。"
emqx_bridge_mqtt_connector_schema.ingress_remote.label = "Remote 設定"
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.desc = "訂閱遠端 broker 時要使用的 QoS 級別."
emqx_bridge_mqtt_connector_schema.ingress_remote_qos.label = "遠端 QoS"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.desc = "從遠端 broker 接收訊息的主題"
emqx_bridge_mqtt_connector_schema.ingress_remote_topic.label = "遠端主題"
emqx_bridge_mqtt_connector_schema.max_inflight.desc = "MQTT 協定的最大 inflight（已傳送但未確認）訊息數"
emqx_bridge_mqtt_connector_schema.max_inflight.label = "最大 inflight 訊息數"
emqx_bridge_mqtt_connector_schema.mode.desc = "MQTT 動作的模式。<br/>\n- cluster_shareload：在 emqx 叢集中的每個節點上建立一個 MQTT 連線。<br/>\n在'cluster_shareload'模式下，來自遠端 broker 的傳入負載透過\n使用共享訂閱進行共享。<br/>\n請注意，'clientid'將以節點名稱作為字尾，以避免\n不同節點之間的 clientid 衝突。並且我們只能使用共享訂閱\n作為入口連線的'remote.topic'的主題過濾器。"
emqx_bridge_mqtt_connector_schema.mode.label = "MQTT 動作模式"
emqx_bridge_mqtt_connector_schema.password.desc = "MQTT 協定的密碼。使用靜態 clientid 時，如果定義了該值且該靜態 clientid 沒有關聯特定密碼，則使用此值。<br/>\n如需從檔案載入密碼而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為密碼使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_bridge_mqtt_connector_schema.password.label = "密碼"
emqx_bridge_mqtt_connector_schema.payload.desc = "要傳送的 MQTT 訊息的有效載荷。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.payload.label = "有效載荷"
emqx_bridge_mqtt_connector_schema.proto_ver.desc = "MQTT協定版本"
emqx_bridge_mqtt_connector_schema.proto_ver.label = "協定版本"
emqx_bridge_mqtt_connector_schema.retain.desc = "要傳送的 MQTT 訊息的'retain'標誌。<br/>\n允許使用帶有變數的模板。"
emqx_bridge_mqtt_connector_schema.retain.label = "保留訊息標誌"
emqx_bridge_mqtt_connector_schema.retry_interval.desc = "在未收到 ACK 的情況下，MQTT 橋接器重試傳送 QoS1/QoS2 訊息的延遲。"
emqx_bridge_mqtt_connector_schema.retry_interval.label = "重試間隔"
emqx_bridge_mqtt_connector_schema.server.desc = "遠端 MQTT broker 的主機和連接埠"
emqx_bridge_mqtt_connector_schema.server.label = "broker IP 和連接埠"
emqx_bridge_mqtt_connector_schema.server_configs.desc = "與伺服器相關的設定。"
emqx_bridge_mqtt_connector_schema.server_configs.label = "伺服器設定。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry.desc = "將 EMQX 節點名稱對映到靜態用戶端 ID 的條目。\n\n如果定義了任何條目，則只有與這些條目匹配的 EMQX 節點才會啟動具有相應 clientid 的 MQTT 用戶端。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry.label = "靜態 ClientId 條目"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_clientid.desc = "分配給此節點的靜態用戶端 ID。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_clientid.label = "靜態 clientid"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.desc = "分配給此節點的靜態用戶端 ID 陣列。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_ids.label = "靜態 clientids"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_node.desc = "節點名稱（例如：`emqx@10.0.0.1`）。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_node.label = "節點名稱"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_password.desc = "與靜態 clientid 關聯的密碼。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_password.label = "密碼"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_username.desc = "與靜態 clientid 關聯的使用者名稱。"
emqx_bridge_mqtt_connector_schema.static_clientid_entry_username.label = "使用者名稱"
emqx_bridge_mqtt_connector_schema.tcp_opts.desc = "用於出站 MQTT 用戶端連線的 TCP socket 選項。\n所有欄位均為可選；未設定的欄位將保留 OS / `gen_tcp` 預設值。"
emqx_bridge_mqtt_connector_schema.tcp_opts.label = "TCP 選項"
emqx_bridge_mqtt_connector_schema.username.desc = "MQTT 協定的使用者名稱。使用靜態 clientid 時，如果定義了該值且該靜態 clientid 沒有關聯特定使用者名稱，則使用此值。"
emqx_bridge_mqtt_connector_schema.username.label = "使用者名稱"
emqx_bridge_mqtt_pubsub_schema.action_parameters.desc = "動作的具體設定。"
emqx_bridge_mqtt_pubsub_schema.action_parameters.label = "動作"
emqx_bridge_mqtt_pubsub_schema.ingress_parameters.desc = "Source 的具體設定"
emqx_bridge_mqtt_pubsub_schema.ingress_parameters.label = "Source"
emqx_bridge_mqtt_pubsub_schema.mqtt_publisher_action.desc = "發布動作的設定。"
emqx_bridge_mqtt_pubsub_schema.mqtt_publisher_action.label = "動作"
emqx_bridge_mqtt_pubsub_schema.mqtt_subscriber_source.desc = "訂閱 Source 的設定。"
emqx_bridge_mqtt_pubsub_schema.mqtt_subscriber_source.label = "Source"
emqx_bridge_mqtt_pubsub_schema.source_no_local.desc = "在訂閱遠端主題時是否設定 no-local 標誌。如果設定為 true，並且你使用相同的連接器向你也訂閱的主題發布訊息，則此設定可防止伺服器將你自己發布的訊息轉發回你。僅在使用 MQTT 協定版本 5 時生效。請注意，如果你使用的工作執行緒池大小大於 1，你仍然會收到重複的訊息。"
emqx_bridge_mqtt_pubsub_schema.source_no_local.label = "No Local"
emqx_bridge_mqtt_pubsub_schema.source_parameters.desc = "Source 特定參數。"
emqx_bridge_mqtt_pubsub_schema.source_parameters.label = "Source 參數"
emqx_bridge_mqtt_pubsub_schema.source_retain_as_published.desc = "是否在遠端訂閱上設定 MQTT 5.0 的 Retain As Published 訂閱選項。設定為 true（預設）時，上游 broker 會保留轉發到該訂閱的訊息 `retain` 標誌；設定為 false 時，上游會清除 `retain` 標誌。僅在連接器的 `proto_ver` 為 `v5` 時生效。"
emqx_bridge_mqtt_pubsub_schema.source_retain_as_published.label = "按發布保留"
