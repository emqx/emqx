emqx_bridge_kinesis.aws_access_key_id.label = "AWS 存取金鑰 ID"
emqx_bridge_kinesis.aws_secret_access_key.desc = "連線到 Amazon Kinesis 的 AWS 秘密存取金鑰。"
emqx_bridge_kinesis.aws_secret_access_key.label = "AWS 秘密存取金鑰"
