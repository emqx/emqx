emqx_exhook_api.get_detail.label = "檢視 Exhook 伺服器詳細資訊"
emqx_exhook_api.get_hooks.desc = "取得 Exhook 伺服器的鉤子資訊"
emqx_exhook_api.get_hooks.label = "取得 Exhook 伺服器的鉤子資訊"
emqx_exhook_api.hook_metrics.desc = "目前節點中該鉤子的指標資訊"
emqx_exhook_api.hook_metrics.label = "鉤子的指標資訊"
emqx_exhook_api.hook_name.desc = "鉤子的名稱"
emqx_exhook_api.hook_name.label = "鉤子的名稱"
emqx_exhook_api.hook_params.desc = "鉤子註冊時使用的參數"
emqx_exhook_api.hook_params.label = "鉤子參數"
emqx_exhook_api.list_all_servers.desc = "檢視 ExHook 伺服器列表"
emqx_exhook_api.list_all_servers.label = "檢視 ExHook 伺服器列表"
emqx_exhook_api.metric_failed.desc = "鉤子執行失敗的次數"
emqx_exhook_api.metric_failed.label = "鉤子執行失敗的次數"
emqx_exhook_api.metric_max_rate.desc = "鉤子的最大呼叫速率"
emqx_exhook_api.metric_max_rate.label = "鉤子的最大呼叫速率"
emqx_exhook_api.metric_rate.desc = "鉤子的呼叫速率"
emqx_exhook_api.metric_rate.label = "鉤子的呼叫速率"
emqx_exhook_api.metric_succeed.desc = "鉤子執行成功的次數"
emqx_exhook_api.metric_succeed.label = "鉤子執行成功的次數"
emqx_exhook_api.metrics.desc = "指標資訊"
emqx_exhook_api.metrics.label = "指標資訊"
emqx_exhook_api.move_api.desc = "移動 Exhook 伺服器順序。\n注意: 移動的參數只能是：front | rear | before:{name} | after:{name}"
emqx_exhook_api.move_api.label = "改變已註冊的 Exhook 伺服器的執行順序"
emqx_exhook_api.move_position.desc = "移動的方向"
emqx_exhook_api.move_position.label = "移動的方向"
emqx_exhook_api.node.desc = "節點名稱"
emqx_exhook_api.node.label = "節點名稱"
emqx_exhook_api.node_hook_metrics.desc = "所有節點中該鉤子的指標資訊"
emqx_exhook_api.node_hook_metrics.label = "所有節點中該鉤子的指標資訊"
emqx_exhook_api.node_metrics.desc = "所有節點中該伺服器的指標資訊"
emqx_exhook_api.node_metrics.label = "所有節點中該伺服器的指標資訊"
emqx_exhook_api.node_status.desc = "所有節點中該伺服器的狀態資訊"
emqx_exhook_api.node_status.label = "所有節點中該伺服器的狀態資訊"
emqx_exhook_api.server_metrics.desc = "目前節點中該伺服器的指標資訊"
emqx_exhook_api.server_metrics.label = "目前節點中該伺服器的指標資訊"
emqx_exhook_api.server_name.desc = "Exhook 伺服器的名稱"
emqx_exhook_api.server_name.label = "Exhook 伺服器的名稱"
emqx_exhook_api.server_not_found.desc = "未找到伺服器"
emqx_exhook_api.server_not_found.label = "未找到伺服器"
emqx_exhook_api.status.desc = "Exhook 伺服器的狀態。<br/>\nconnected: 連線成功<br/>\nconnecting: 連線失敗，重連中<br/>\ndisconnected: 連線失敗，且未設定自動重連<br/>\ndisabled: 該伺服器未開啟<br/>\nerror: 檢視該伺服器狀態時發生錯誤"
emqx_exhook_api.status.label = "Exhook 伺服器的狀態"
emqx_exhook_api.update_server.desc = "更新 Exhook 伺服器"
emqx_exhook_api.update_server.label = "更新 Exhook 伺服器"
emqx_exhook_schema.auto_reconnect.desc = "自動重連到 gRPC 伺服器的設定。\n當 gRPC 伺服器不可用時，Exhook 將會按照這裡設定的間隔時間進行重連，並重新初始化註冊的鉤子"
emqx_exhook_schema.enable.desc = "開啟這個 Exhook 伺服器"
emqx_exhook_schema.failed_action.desc = "當 gRPC 請求失敗後的操作"
emqx_exhook_schema.keepalive.desc = "當沒有其他資料交換時，是否向連線的對端套接字定期的傳送探測包。如果另一端沒有回應，則認為連線斷開，並向控制行程傳送錯誤訊息。"
emqx_exhook_schema.name.desc = "ExHook 伺服器名稱"
emqx_exhook_schema.nodelay.desc = "如果為 true，則為套接字設定 TCP_NODELAY 選項，這意味著會立即傳送資料包"
emqx_exhook_schema.pool_size.desc = "gRPC 用戶端行程池大小"
emqx_exhook_schema.recbuf.desc = "套接字的最小接收緩衝區大小"
emqx_exhook_schema.request_timeout.desc = "gRPC 伺服器請求逾時"
