emqx_bridge_redis.command_template.desc = "用於匯出訊息的 Redis 命令模板。每個列表元素代表一個命令名稱或其參數。\n例如，要將有效負載推送到 Redis 列表中的鍵 msgs，元素應該如下所示：\nrpush，msgs，${payload}。"
emqx_bridge_redis.command_template.label = "Redis 命令模版"
emqx_bridge_redis.config_enable.desc = "啟用或停用該動作"
