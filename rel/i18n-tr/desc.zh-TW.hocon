emqx_mgmt_api_alarms.activate_at.desc = "警報開始時間，使用 rfc3339 標準時間格式。"
emqx_mgmt_api_alarms.deactivate_at.desc = "警報結束時間，使用 rfc3339 標準時間格式。"
emqx_mgmt_api_alarms.delete_alarms_api.desc = "移除所有歷史警報。"
emqx_mgmt_api_alarms.delete_alarms_api.label = "移除所有歷史警報"
emqx_mgmt_api_alarms.delete_alarms_api_response204.desc = "歷史警報已成功清除。"
emqx_mgmt_api_alarms.details.desc = "警報詳情，提供了更多的警報資訊，主要提供給程式處理。"
emqx_mgmt_api_alarms.duration.desc = "表明警報已經持續了多久，單位：毫秒。"
emqx_mgmt_api_alarms.force_deactivate_alarm_api.desc = "強制停用警報。此操作將強制停用活動警報。"
