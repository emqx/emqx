emqx_rule_engine_schema.desc_builtin_action_console.desc = "設定列印到控制台"
emqx_rule_engine_schema.desc_builtin_action_console.label = "設定列印到控制台"
emqx_rule_engine_schema.desc_builtin_action_republish.desc = "設定重新發布。"
emqx_rule_engine_schema.desc_builtin_action_republish.label = "設定重新發布"
emqx_rule_engine_schema.desc_republish_args.desc = "內建 'republish' 動作的參數。\n可以在參數中使用變數。\n變數是規則中選擇的欄位。 例如規則 SQL 定義如下：\n<code>\n    SELECT clientid, qos, payload FROM \"t/1\"\n</code>\n然後有 3 個變數可用：<code>clientid</code>、<code>qos</code> 和 <code>payload</code>。 如果我們將參數設定為：\n<code>\n    {\n        topic = \"t/${clientid}\"\n        qos = \"${qos}\"\n        payload = \"msg: ${payload}\"\n    }\n</code>\n當收到一條訊息 payload = `hello`, qos = 1, clientid = `Steve` 時，將重新發布一條新的 MQTT 訊息到主題 `t/Steve`\n訊息內容為 payload = `msg: hello`, and `qos = 1"
emqx_rule_engine_schema.desc_republish_args.label = "重新發布參數"
emqx_rule_engine_schema.desc_rule_engine.desc = "設定 EMQX 規則引擎。"
emqx_rule_engine_schema.desc_rule_engine.label = "設定規則引擎"
emqx_rule_engine_schema.desc_rules.desc = "設定規則"
emqx_rule_engine_schema.desc_rules.label = "設定規則"
emqx_rule_engine_schema.desc_user_provided_function.desc = "設定使用者函式"
emqx_rule_engine_schema.desc_user_provided_function.label = "設定使用者函式"
emqx_rule_engine_schema.limit_selects_in_namespace.desc = "啟用後，規則僅會在與規則自身同一命名空間的用戶端發布訊息時觸發。"
emqx_rule_engine_schema.limit_selects_in_namespace.label = "限制命名空間內的 Select"
emqx_rule_engine_schema.republish_args_direct_dispatch.desc = "啟用直接分發到訂閱者，而無需啟動新的訊息發布事件。\n當設定為 `true` 時，可以防止同一動作遞迴處理訊息，適用於輸出訊息不需要進一步處理的情況。\n\n然而，啟用此功能有幾個限制：\n\n- 此動作的輸出訊息不會被保留。\n- 它不會觸發基於此動作的輸出主題執行的其他規則。\n- 它不會啟用選擇 `$events/message_publish` 的規則。\n- 它不會觸發使用 `'message.publish'` 鉤子的外掛。\n- 不會收集此動作輸出訊息的主題指標。\n- 不會應用訊息 schema 驗證（EMQX Enterprise 的功能）。\n- 不會應用訊息轉換過程（EMQX Enterprise 的功能）。"
emqx_rule_engine_schema.republish_args_direct_dispatch.label = "Direct Dispatch"
emqx_rule_engine_schema.republish_args_mqtt_properties.desc = "從訊息中應該取得哪個變數作為訊息的 MQTT 發布屬性。\n可以使用像<code>${.payload.content_type}</code>這樣的佔位符。"
emqx_rule_engine_schema.republish_args_mqtt_properties.label = "MQTT 屬性"
emqx_rule_engine_schema.republish_args_payload.desc = "要重新發布的訊息的有效負載。允許使用帶有變數的模板，請參閱“republish_args”的描述。\n預設為 ${payload}。 如果從所選結果中未找到變數 ${payload}，則使用字串 \"undefined\"。"
emqx_rule_engine_schema.republish_args_payload.label = "訊息負載"
emqx_rule_engine_schema.republish_args_qos.desc = "要重新發布的訊息的 qos。允許使用帶有變數的模板，請參閱“republish_args”的描述。\n預設為 ${qos}。 如果從規則的選擇結果中沒有找到變數 ${qos}，則使用 0。"
emqx_rule_engine_schema.republish_args_qos.label = "訊息 QoS 等級"
emqx_rule_engine_schema.republish_args_retain.desc = "要重新發布的訊息的“保留”標誌。允許使用帶有變數的模板，請參閱“republish_args”的描述。\n預設為 ${retain}。 如果從所選結果中未找到變數 ${retain}，則使用 false。"
emqx_rule_engine_schema.republish_args_retain.label = "保留訊息標誌"
emqx_rule_engine_schema.republish_args_topic.desc = "重新發布訊息的目標主題。\n允許使用帶有變數的模板，請參閱“republish_args”的描述。"
emqx_rule_engine_schema.republish_args_topic.label = "目標主題"
emqx_rule_engine_schema.republish_args_user_properties.desc = "指定使用哪個變數來填充 MQTT 訊息的 User-Property 列表。這個變數的值必須是一個 map 類型。\n可以設定成 <code>${pub_props.'User-Property'}</code> 或者\n使用 <code>SELECT *,pub_props.'User-Property' as user_properties</code> 來把源 MQTT 訊息\n的 User-Property 列表用於填充。\n也可以使用 <code>map_put</code> 函式來新增新的 User-Property，\n<code>map_put('my-prop-name', 'my-prop-value', user_properties) as user_properties</code>\n注意：MQTT 協定允許一個訊息中出現多次同一個 property 名，但是 EMQX 的規則引擎不允許。"
emqx_rule_engine_schema.republish_args_user_properties.label = "使用者屬性"
emqx_rule_engine_schema.republish_function.desc = "將訊息重新發布為新的 MQTT 訊息"
emqx_rule_engine_schema.republish_function.label = "重新發布函式"
emqx_rule_engine_schema.republish_mqtt_properties_prop.desc = "在訊息重發布時可設定的 MQTT 屬性。"
emqx_rule_engine_schema.rule_engine_ignore_sys_message.desc = "當設定為“true”（預設）時，規則引擎將忽略發布到 $SYS 主題的訊息。"
emqx_rule_engine_schema.rule_engine_ignore_sys_message.label = "忽略系統訊息"
emqx_rule_engine_schema.rule_engine_jq_function_default_timeout.desc = "規則引擎內建函式 `jq` 預設時間限制"
emqx_rule_engine_schema.rule_engine_jq_function_default_timeout.label = "規則引擎 jq 函式時間限制"
emqx_rule_engine_schema.rule_engine_jq_implementation_module.desc = "jq 規則引擎功能的實現模組。可用的兩個選項是 jq_nif 和 jq_port。jq_nif 使用 Erlang NIF 庫存取 jq 庫，而 jq_port 使用基於 Erlang Port 的實現。jq_nif 方式（預設選項）是這兩個選項中最快的實現，但 jq_port 方式更安全，因為這種情況下 jq 程式不會在 Erlang VM 行程中執行。"
emqx_rule_engine_schema.rule_engine_jq_implementation_module.label = "JQ 實現模組"
emqx_rule_engine_schema.rule_engine_rules.desc = "規則"
emqx_rule_engine_schema.rule_engine_rules.label = "規則"
emqx_rule_engine_schema.rules_actions.desc = "規則的動作列表。\n動作可以是指向 EMQX 資料橋接的引用，也可以是一個指向函式的物件。\n我們支援一些內建函式，如“republish”和“console”，我們還支援使用者提供的函式，它的格式為：“{module}:{function}”。\n列表中的動作按順序執行。這意味著如果其中一個動作執行緩慢，則以下所有動作都不會被執行直到它回傳。\n如果其中一個動作崩潰，在它之後的所有動作仍然會被按照原始順序執行。\n如果執行動作時出現任何錯誤，則會出現錯誤訊息，並且相應的計數器會增加。"
emqx_rule_engine_schema.rules_actions.label = "動作列表"
emqx_rule_engine_schema.rules_description.desc = "規則的描述"
emqx_rule_engine_schema.rules_description.label = "規則描述"
emqx_rule_engine_schema.rules_enable.desc = "啟用或停用規則引擎"
emqx_rule_engine_schema.rules_enable.label = "啟用或停用規則引擎"
emqx_rule_engine_schema.rules_metadata.desc = "規則的後設資料，不要手動修改"
emqx_rule_engine_schema.rules_metadata.label = "規則的後設資料"
emqx_rule_engine_schema.rules_name.desc = "規則名字"
emqx_rule_engine_schema.rules_name.label = "規則名字"
emqx_rule_engine_schema.rules_sql.desc = "用於處理訊息的 SQL 。\n範例：<code>SELECT * FROM \"test/topic\" WHERE payload.x = 1</code>"
emqx_rule_engine_schema.rules_sql.label = "規則 SQL"
emqx_rule_engine_schema.ssrf.desc = "針對透過規則引擎連接器、橋接和動作設定的出站目標地址的 SSRF 防護。<br/>\n啟用後，先拒絕與 `deny_hosts` 精確匹配的目標，再在解析出的目標 IP 上先檢查 `allow_cidrs`，隨後檢查 `deny_cidrs`。<br/>\n這僅是設定驗證階段的防護層：無法防止驗證透過後發生的惡意 DNS 變更。<br/>\n請結合防火牆、`iptables` 或 `nftables` 等網路層出站控制使用。"
emqx_rule_engine_schema.ssrf.label = "SSRF 防護"
emqx_rule_engine_schema.ssrf_allow_cidrs.desc = "在檢查拒絕列表之前顯式允許的 CIDR 範圍列表。<br/>\n用於在不全域關閉 SSRF 防護的情況下，允許受信任的內部目標。<br/>\n預設為空。"
emqx_rule_engine_schema.ssrf_allow_cidrs.label = "允許的 CIDR 範圍"
emqx_rule_engine_schema.ssrf_deny_cidrs.desc = "被視為私有或不安全的出站目標 CIDR 範圍列表。<br/>\n預設涵蓋迴環、鏈路本地（含雲 IMDS）、RFC1918、ULA、未指定地址和組播範圍，以及已知的雲後設資料 IP（阿里雲 100.100.100.200 和 AWS 69.254.169.253）。<br/>\n如確有需要，請使用 `allow_cidrs` 新增顯式例外。"
emqx_rule_engine_schema.ssrf_deny_cidrs.label = "拒絕的 CIDR 範圍"
emqx_rule_engine_schema.ssrf_deny_hosts.desc = "按精確匹配（不區分大小寫）拒絕的主機名列表。<br/>\n預設涵蓋雲後設資料主機名：metadata.tencentyun.com、metadata.google.internal、metadata.azure.internal。"
emqx_rule_engine_schema.ssrf_deny_hosts.label = "拒絕的主機名"
emqx_rule_engine_schema.ssrf_enable.desc = "為出站連接器/橋接/動作目標應用 `rule_engine.ssrf` 下的 SSRF 策略。<br/>\n僅在設定更新時檢查——執行時 DNS 重新解析不會被阻止。<br/>\n對於驗證後的 DNS 變更，請使用網路層出站控制作為執行層。"
emqx_rule_engine_schema.ssrf_enable.label = "啟用 SSRF 防護"
emqx_rule_engine_schema.user_provided_function_args.desc = "使用者提供的參數將作為函式 module:function/3 的第三個參數，\n請檢查原始檔：<code>apps/emqx_rule_engine/src/emqx_rule_actions.erl</code> 中的範例函式 <code>console</code> 和<code>republish</code> 。"
emqx_rule_engine_schema.user_provided_function_args.label = "使用者提供函式的參數"
emqx_rule_engine_schema.user_provided_function_function.desc = "使用者提供的函式。 格式應為：'{module}:{function}'。\n其中 {module} 是 Erlang 回呼模組， {function} 是 Erlang 函式。\n要編寫自己的函式，請檢查原始檔：<code>apps/emqx_rule_engine/src/emqx_rule_actions.erl</code> 中的範例函式 <code>console</code> 和<code>republish</code> 。"
emqx_rule_engine_schema.user_provided_function_function.label = "使用者提供的函式"
emqx_s3_schema.access_key_id.desc = "S3 桶的存取金鑰 ID。"
emqx_s3_schema.acl.desc = "上傳物件使用的 ACL。"
emqx_s3_schema.bucket.desc = "S3 桶的名稱。"
emqx_s3_schema.bucket.label = "儲存桶"
emqx_s3_schema.bucket_access_method.desc = "透過 HTTP API 存取儲存桶的 HTTP 請求方法。"
emqx_s3_schema.bucket_access_method.label = "儲存桶存取方法"
emqx_s3_schema.host.desc = "S3 端點的主機。"
emqx_s3_schema.ipv6_probe.desc = "是否探測 IPv6 支援。"
emqx_s3_schema.key.desc = "S3 物件的鍵。"
emqx_s3_schema.key.label = "物件鍵"
emqx_s3_schema.max_part_size.desc = "多部分上傳的最大部分大小。<br/>\nS3 上傳器不會嘗試上傳超過此大小的部分。"
emqx_s3_schema.min_part_size.desc = "多部分上傳的最小部分大小。<br/>\n上傳的資料將在記憶體中累積，直到達到此大小。"
emqx_s3_schema.port.desc = "S3 端點的連接埠。"
emqx_s3_schema.secret_access_key.desc = "S3 桶的 Secret Access Key。<br/>\n如需從檔案載入金鑰而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為金鑰使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_s3_schema.transport_options.desc = "S3 用戶端使用的 HTTP 傳輸層選項。"
emqx_s3_schema.upload_headers.desc = "包含在 S3 物件上傳請求中的 HTTP 請求標頭，用於指定 S3 物件的內容類型、內容編碼以及其他屬性。"
emqx_s3_schema.upload_headers.label = "S3 物件 HTTP 請求標頭"
emqx_s3_schema.url_expire_time.desc = "S3 物件的簽名 URL 有效時間（秒）。"
emqx_schema.alarm_actions.desc = "警報啟用時觸發的動作。<br/>目前，支援以下操作：<code>log</code> 和 <code>publish</code>.\n<code>log</code> 將警報寫入日誌 (控制台或者檔案).\n<code>publish</code> 將警報作為 MQTT 訊息發布到系統主題:\n<code>$SYS/brokers/emqx@xx.xx.xx.x/alarms/activate</code> and\n<code>$SYS/brokers/emqx@xx.xx.xx.x/alarms/deactivate</code>"
emqx_schema.alarm_actions.label = "警報動作"
emqx_schema.alarm_size_limit.desc = "最多可以儲存的歷史警報數量。\n\n當達到最大數量時，將刪除最舊的歷史警報以儲存新的歷史警報。"
emqx_schema.alarm_size_limit.label = "警報總數限制"
emqx_schema.alarm_validity_period.desc = "歷史警報的有效期。從歷史警報啟用的時間開始計算，而不是取消的時間。\n\n如果警報存在的時間超過了有效期，該警報將被刪除。"
emqx_schema.alarm_validity_period.label = "警報有效期"
emqx_schema.authz_include_mountpoint.desc = "啟用後，目標主題和主題過濾器在與 ACL 規則或授權後端匹配之前，會被主題掛載點字首。"
emqx_schema.authz_include_mountpoint.label = "授權的掛載字首"
emqx_schema.banned_bootstrap_file.desc = "引導檔案是一個 CSV 檔案，用於在初始化單節點或叢集時批次載入被禁止的資料，換句話說，只有在資料庫中沒有資料時才執行匯入操作。\n\n此檔案的分隔符是 `,`。\n\n此檔案的第一行必須是標題行。所有有效的標題如下所示：\n- as :: 必填\n- who :: 必填\n- by  :: 可選\n- reason :: 可選\n- at :: 可選\n- until :: 可選\n\n有關每個欄位的詳細資訊，請參閱文件。\n\n此檔案其餘行中的每一行必須包含與標題行相同數量的列，\n如果列可以省略，則其值將為 `undefined`。"
emqx_schema.base_listener_acceptors.desc = "監聽器接收池的大小。"
emqx_schema.base_listener_acceptors.label = "接收器數量"
emqx_schema.base_listener_allow_log_packet_data_from.desc = "允許記錄原始 MQTT 封包資料的用戶端 IP 地址和 CIDR 網段允許列表，以逗號分隔。\n來自其他地址的封包資料將被脫敏。此選項可能在日誌中暴露憑據及其他敏感資料，僅應在診斷期間為可信用戶端地址臨時啟用。\n\n例如：\n\n```\nlisteners.tcp.default.allow_log_packet_data_from = \"127.0.0.1, 192.168.1.0/24, 2001:db8::/32\"\n```"
emqx_schema.base_listener_allow_log_packet_data_from.label = "允許記錄封包資料的來源"
emqx_schema.base_listener_bind.desc = "監聽套接字的 IP 地址和連接埠。<br/>\n僅指定連接埠時（例如 <code>1883</code>），將繫結所有網路介面，或繫結 <code>node.default_listener_address</code> 中設定的地址。<br/>\n執行時透過 API 或 CLI 修改的監聽器設定會複製到每個節點，因此形如 <code>10.1.2.3:1883</code> 的主機專屬地址只能在擁有該地址的節點上繫結成功，在其他所有節點上都會失敗。當設定被複制或恢復到另一臺主機時，這類地址同樣會失效。若要繫結主機專屬地址，請在此處僅設定連接埠，並在每個節點上設定 <code>node.default_listener_address</code>。"
emqx_schema.base_listener_bind.label = "IP 地址和連接埠"
emqx_schema.base_listener_enable_authn.desc = "設定 <code>true</code> （預設值）啟用用戶端進行身分認證，透過檢查認設定的認認證器鏈來決定是否允許接入。\n設定 <code>false</code> 時，將不對用戶端做任何認證，任何用戶端，不論是不是攜帶使用者名稱等認證資訊，都可以接入。\n設定 <code>quick_deny_anonymous</code> 時，行為跟 <code>true</code> 類似，但是會對匿名\n用戶端直接拒絕，不做使用任何認證器對用戶端進行身分檢查。"
emqx_schema.base_listener_enable_authn.label = "啟用身分認證"
emqx_schema.base_listener_limiter.desc = "速率限制類型"
emqx_schema.base_listener_limiter.label = "速率限制類型"
emqx_schema.base_listener_max_connections.desc = "監聽器允許的最大併發連線數。"
emqx_schema.base_listener_max_connections.label = "最大併發連線數"
emqx_schema.base_listener_mountpoint.desc = "在用戶端的 SUBSCRIBE 和 UNSUBSCRIBE 請求、`PUBLISH` 訊息以及遺囑訊息（如果在 `CONNECT` 資料包中提供）中，為主題新增靜態或模板化的字首（例如，`n1/` 或 `${username}/`）。\n- 從發布到相應訂閱的訊息的主題中移除此字首。\n\n支援的佔位符有：\n- `${username}`\n- `${clientid}`\n- `${zone}`\n- `${client_attrs.NAME}`\n\n例如，使用 `mountpoint=\"${username}/\"` 設定時，使用 `u1` 作為使用者名稱的用戶端將具有：\n- 用戶端 `SUBSCRIBE sensors/#` 在伺服器內部為 `u1/sensors/#`。\n- 伺服器發布 `PUBLISH u1/sensors/data` -> 傳送給用戶端的主題為 `sensors/data`。\n\n字首掛載/解除安裝適用於：\n- `CONNECT` 中的遺囑訊息\n- `PUBLISH`\n- `SUBSCRIBE`\n- `UNSUBSCRIBE`\n\n注意：掛載操作發生在**授權/ACL 檢查之後**。"
emqx_schema.base_listener_mountpoint.label = "掛載點"
emqx_schema.base_listener_zone.desc = "監聽器所屬的設定 zone。\n連線到此監聽器的用戶端將繼承在此 zone 名稱下建立的 zone 設定。\n\n一個 zone 可以覆寫以下根名稱下的設定：\n- `mqtt`\n- `force_shutdown`\n- `force_gc`\n- `flapping_detect`\n- `durable_sessions`"
emqx_schema.base_listener_zone.label = "Zone"
emqx_schema.broker.desc = "broker 相關設定項。"
emqx_schema.broker_enable_session_registry.desc = "是否啟用 Session Registry"
emqx_schema.broker_perf_async_fanout_shard_dispatch.desc = "啟用後，高擴充套件主題中位於訂閱者分片的訂閱者將透過 broker 池非同步併發分發。"
emqx_schema.broker_perf_route_lock_type.desc = "萬用字元主題訂閱/取消訂閱效能調優。\n建議僅當萬用字元主題較多時才更改此參數。\n\n注：當從 `global` 鎖更改或更改為 `gloabal` 鎖時，它要求叢集中的所有節點在更改之前停止。\n  - `key`：為 mnesia 交易涉及到的每個 key 上鎖，建議單節點時使用。\n  - `tab`：為 mnesia 交易涉及到的表上鎖，建議在叢集中使用。\n  - `global`：所以更新操作都被全域的鎖保護，僅建議在超大規模叢集中使用。"
emqx_schema.broker_perf_trie_compaction.desc = "是否開啟主題表壓縮儲存。\n啟用它會顯著提高萬用字元主題訂閱率，如果萬用字元主題具有唯一字首，例如：'sensor/{{id}}/+/'，其中每個訂閱者的 ID 是唯一的。\n如果訊息主要發布到具有大量級別的主題，則主題匹配效能（發布時）可能會降低。\n\n注意：這是一個叢集範圍的設定。 它要求在更改之前停止所有節點。"
emqx_schema.broker_routing_batch_sync_enable_on.desc = "啟用一個專門的行程池，能夠批次地將訂閱資訊與全域路由表同步。\n特別適用於減少可能由於網路延遲導致的跨節點通訊的減慢，還可能在其他場景下減輕 broker 池的負載，從而最大限度地減少了過載的風險。\n選定的值決定哪些節點在叢集中將啟用此功能。\n- <code>all</code>: 在每個節點上無條件啟用，\n- <code>replicant</code>: 僅在複製節點上啟用（例如那些<code>node.role = replicant</code>的節點），\n- <code>core</code>: 僅在核心節點上啟用，\n- <code>none</code>: 完全停用此功能。"
emqx_schema.broker_routing_storage_schema.desc = "路由儲存模式。\n設定為 <code>v1</code> 以保留預設設定。\n<code>v2</code> 在版本 5.2 中引入。它允許透過兩個單獨的表進行路由，一個用於主題過濾，一個用於常規主題訂閱。這個模式會同時提高訂閱和路由效能，但會略微增加每個訂閱的記憶體消耗。\n注意：模式 <code>v2</code> 仍然處於實驗階段。\n注意：更改此選項後，需要進行完整的非滾動叢集重啟才能生效。"
emqx_schema.broker_session_history_retain.desc = "保留會話註冊歷史記錄的持續時間。將此值設定為大於 0s 的值會增加記憶體使用並影響效能。\n這個保留的歷史記錄可以用來監控過去設定的持續時間內註冊了多少會話。\n注意：如果 enable_session_registry 設定為 false，則此設定無效。<br/>\n注意：如果用戶端使用隨機用戶端 ID，則不建議啟用此功能，至少不是長時間保留。<br/>\n注意：在叢集中，叢集內節點中的最低（但大於 0s）值將生效。"
emqx_schema.broker_session_locking_strategy.desc = "Session 在叢集中的鎖策略。\n  - `loca`：僅鎖本節點的 Session；\n  - `one`：任選一個其它節點加鎖；\n  - `quorum`：選擇叢集中半數以上的節點加鎖；\n  - `all`：選擇所有節點加鎖。"
emqx_schema.broker_shared_dispatch_ack_enabled.desc = "該設定項已廢棄。\n啟用/停用 QoS 1 和 QoS 2 訊息的共享派發確認。\n該設定最初設計用於避免將訊息派發給用戶端離線狀態下的會話中去。\n但新版本中，已做增強：在一個會話結束時，會話中的訊息會重新派發到組內的其他會話中 -- 使這個老設定失去存在的意義。"
emqx_schema.ciphers_schema_common.desc = "此設定儲存由逗號分隔的 TLS 密碼套件名稱，或作為字串陣列。例如\n<code>\"TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256\"</code>或\n<code>[\"TLS_AES_256_GCM_SHA384\",\"TLS_AES_128_GCM_SHA256\"]</code>。\n<br/>\n密碼（及其順序）定義了用戶端和伺服器透過網路連線加密資訊的方式。\n選擇一個好的密碼套件對於應用程式的資料安全性、機密性和效能至關重要。\n\n名稱應為 OpenSSL 字串格式（而不是 RFC 格式）。\nEMQX 設定文件提供的所有預設值和範例都是 OpenSSL 格式<br/>\n注意：某些密碼套件僅與特定的 TLS <code>版本</code>相容（'tlsv1.1'、'tlsv1.2'或'tlsv1.3'）。\n不相容的密碼套件將被自動刪除。\n\n例如，如果只有 <code>versions</code> 僅設定為 <code>tlsv1.3</code>。為其他版本設定密碼套件將無效。\n\n<br/>\n注：PSK 的 Ciphers 不支援 tlsv1.3<br/>\n如果打算使用 PSK 密碼套件, <code>tlsv1.3</code> 應在<code>ssl.versions</code>中停用。\n\n<br/>\nPSK 密碼套件：\n<code>\"RSA-PSK-AES256-GCM-SHA384,RSA-PSK-AES256-CBC-SHA384,\nRSA-PSK-AES128-GCM-SHA256,RSA-PSK-AES128-CBC-SHA256,\nRSA-PSK-AES256-CBC-SHA,RSA-PSK-AES128-CBC-SHA,\nRSA-PSK-DES-CBC3-SHA,RSA-PSK-RC4-SHA\"</code>"
emqx_schema.ciphers_schema_common.label = ""
emqx_schema.ciphers_schema_quic.desc = "此設定儲存由逗號分隔的 TLS 密碼套件名稱，或作為字串陣列。例如\n<code>\"TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256\"</code>或\n<code>[\"TLS_AES_256_GCM_SHA384\",\"TLS_AES_128_GCM_SHA256\"]</code>。\n<br/>\n密碼（及其順序）定義了用戶端和伺服器透過網路連線加密資訊的方式。\n選擇一個好的密碼套件對於應用程式的資料安全性、機密性和效能至關重要。\n\n名稱應為 OpenSSL 字串格式（而不是 RFC 格式）。\nEMQX 設定文件提供的所有預設值和範例都是 OpenSSL 格式。<br/>\n注意：某些密碼套件僅與特定的 TLS <code>版本</code>相容（'tlsv1.1'、'tlsv1.2'或'tlsv1.3'）。\n不相容的密碼套件將被自動刪除。\n\n例如，如果只有 <code>versions</code> 僅設定為 <code>tlsv1.3</code>。為其他版本設定密碼套件將無效。\n\n<br/>\n注：PSK 的 Ciphers 不支援 tlsv1.3。<br/>\n如果打算使用 PSK 密碼套件，<code>tlsv1.3</code> 應在 <code>ssl.versions</code> 中停用。\n\n<br/>\nPSK 密碼套件：\n<code>\"RSA-PSK-AES256-GCM-SHA384,RSA-PSK-AES256-CBC-SHA384,\nRSA-PSK-AES128-GCM-SHA256,RSA-PSK-AES128-CBC-SHA256,\nRSA-PSK-AES256-CBC-SHA,RSA-PSK-AES128-CBC-SHA,\nRSA-PSK-DES-CBC3-SHA,RSA-PSK-RC4-SHA\"</code><br/>\n\n注：QUIC 監聽器只支援 tlsv1.3 的 ciphers。"
emqx_schema.ciphers_schema_quic.label = ""
emqx_schema.client_attrs_init.desc = "指定如何初始化用戶端屬性。每個屬性可被初始化為 `client_attrs.{NAME}` ，其中 `{NAME}` 是在設定欄位 `set_as_attr` 中指定的屬性名稱。初始化的用戶端屬性將以指定的名稱儲存在 `client_attrs` 屬性中，並使用指定的名稱，可以作為變數來渲染掛載點、身分認證和授權請求的模板。例如，當 `set_as_attr = alias` 時，使用 `${client_attrs.alias}` 來渲染 HTTP POST 請求體，或者為主題命名空間渲染監聽器設定 `moutpoint = devices/${client_attrs.alias}/`。"
emqx_schema.client_attrs_init.label = "用戶端屬性初始化"
emqx_schema.client_attrs_init_expression.desc = "單行表示式，用於解析一組預定義的字串函式（類似規則引擎 SQL 語句中的函式）。\n表示式可以是帶有巢狀呼叫的函式呼叫，或直接變數引用。\n目前，它不提供使用者定義的變數繫結（如 `var a=1`）或使用者定義的函式。\n例如，提取以點分隔的用戶端 ID 的字首：`nth(1, tokens(clientid, '.'))`。\n\n預繫結的變數包括：\n- `clientid`：MQTT 用戶端 ID。\n- `username`：MQTT 用戶端的使用者名稱。\n- `user_property.{NAME}`：CONNECT 包中的使用者屬性。\n- `zone`：監聽器的設定區域。\n- `listener`：用戶端連線的監聽器 ID（如 `tcp:default`）。\n對於 TLS 用戶端，直接連線或透過啟用 Proxy 協定（v2）負載均衡器連線時，\n還可以使用一些額外的變數：\n- `cn`：用戶端的 TLS 憑證公共名稱。\n- `cert_common_name`：`cn` 的別名。\n- `dn`：用戶端的 TLS 憑證區分名稱（主體）。\n- `cert_subject`：`dn` 的別名。\n對於直接連線的 TLS 用戶端，可使用用戶端憑證中的主題備用名稱：\n- `cert_san.dns`：用戶端憑證中的 DNS 名稱。\n- `cert_san.ip`：用戶端憑證中的 IP 地址。\n- `cert_san.email`：用戶端憑證中的郵箱地址。\n- `cert_san.uri`：用戶端憑證中的 URI。\n- `peersni`：用戶端傳送的 TLS 伺服器名稱指示。\n\n您可以在 EMQX 文件中閱讀更多關於變數表示式的資訊。"
emqx_schema.client_attrs_init_expression.label = "用戶端屬性提取正規表示式"
emqx_schema.client_attrs_init_set_as_attr.desc = "從用戶端資料中提取的用戶端屬性的名稱。\n提取的屬性將以此名稱儲存在 `client_attrs` 屬性中。"
emqx_schema.client_attrs_init_set_as_attr.label = "命名提取的屬性"
emqx_schema.client_ssl_opts_schema_enable.desc = "啟用 TLS。"
emqx_schema.client_ssl_opts_schema_enable.label = "啟用 TLS"
emqx_schema.client_ssl_opts_schema_middlebox_comp_mode.desc = "設定 TLS-1.3 連線的中間盒相容模式。\n\n大量中間盒在協商 TLS-1.3 連線時表現不佳。透過將 TLS-1.3 握手調整為類似於 TLS-1.2 握手的方式，可以增加透過這些中間盒建立連線的機會。"
emqx_schema.client_ssl_opts_schema_middlebox_comp_mode.label = "中間盒相容模式"
emqx_schema.client_ssl_opts_schema_server_name_indication.desc = "指定要在 TLS 伺服器名稱指示擴充套件中使用的主機名。<br/>\n例如，當連線到 \"server.example.net\" 時，接受連線並執行 TLS 握手的真正伺服器可能與 TLS 用戶端最初連線到的主機不同，\n例如，當連線到 IP 地址時，或者當主機具有多個可解析的 DNS 記錄時<br/>\n如果未指定，它將預設為使用的主機名字串\n建立連線，除非使用 IP 地址<br/>\n然後，主機名也用於對等機的主機名驗證憑證<br/>\n特殊值 <code>disable</code> 阻止傳送伺服器名稱指示擴充套件，並停用主機名驗證檢查。"
emqx_schema.client_ssl_opts_schema_server_name_indication.label = "伺服器名稱指示"
emqx_schema.client_tcp_opts.desc = "用於出站 MQTT 用戶端連線的 TCP socket 選項。\n所有欄位均為可選；未設定的欄位將保留作業系統或 `gen_tcp` 預設值。"
emqx_schema.client_tcp_opts.label = "用戶端 TCP 選項"
emqx_schema.clientid_override.desc = "使用 Variform 表示式覆寫用戶端 ID。\n例如：`concat(client_attrs.tns, '-', clientid)` 新增命名空間作為字首。\n這允許不同命名空間的用戶端使用相同的用戶端 ID 連線而不衝突。\n當表示式渲染失敗或渲染結果為空字串時，該連線將被拒絕。\n有關表示式語法，請參閱 EMQX 文件。"
emqx_schema.clientid_override.label = "用戶端 ID 覆寫表示式"
emqx_schema.common_ssl_opts_schema_cacertfile.desc = "受信任的 PEM 格式 CA  憑證捆綁檔案<br/>\n此檔案中的憑證用於驗證 TLS 對等方的憑證。\n如果要信任新 CA，請將新憑證附加到檔案中。\n無需重啟 EMQX 即可載入更新的檔案，因為系統會定期檢查檔案是否已更新（並重新載入）<br/>\n注意：從檔案中失效（刪除）憑證不會影響已建立的連線。"
emqx_schema.common_ssl_opts_schema_cacertfile.label = "CA 憑證檔案"
emqx_schema.common_ssl_opts_schema_certfile.desc = "PEM 格式憑證鏈檔案<br/>\n此檔案中的憑證應與憑證頒發鏈的順序相反。也就是說，主機的憑證應該放在檔案的開頭，\n然後是直接頒發者 CA 憑證，依此類推，一直到根 CA 憑證。\n根 CA 憑證是可選的，如果想要新增，應加到檔案到最末端。"
emqx_schema.common_ssl_opts_schema_certfile.label = "憑證檔案"
emqx_schema.common_ssl_opts_schema_depth.desc = "在有效的憑證路徑中，可以跟隨對等憑證的非自頒發中間憑證的最大數量。\n因此，如果深度為 0，則對等方必須由受信任的根 CA 直接簽名；<br/>\n如果是 1，路徑可以是 PEER、中間 CA、ROOT-CA；<br/>\n如果是 2，則路徑可以是 PEER、中間 CA1、中間 CA2、ROOT-CA。"
emqx_schema.common_ssl_opts_schema_depth.label = "CA 憑證深度"
emqx_schema.common_ssl_opts_schema_hibernate_after.desc = "指定 SSL 行程在空閒後休眠的時間，從而減少其記憶體佔用。\n\n當有新訊息到達時，休眠的行程將被喚醒。\n過於頻繁地休眠和喚醒可能會導致 CPU 使用率增加，因為這兩個操作都會對行程進行垃圾回收。"
emqx_schema.common_ssl_opts_schema_hibernate_after.label = "休眠時間為"
emqx_schema.common_ssl_opts_schema_keyfile.desc = "PEM 格式的私鑰檔案。"
emqx_schema.common_ssl_opts_schema_keyfile.label = "私鑰檔案"
emqx_schema.common_ssl_opts_schema_log_level.desc = "SSL 握手的日誌級別。預設值是 'notice'，可以設定為 'debug' 用來調查 SSL 握手的問題。"
emqx_schema.common_ssl_opts_schema_log_level.label = "SSL 日誌級別"
emqx_schema.common_ssl_opts_schema_managed_certs.desc = "EMQX 管理的憑證檔案捆綁包的引用。\n\n如果使用此選項，`cacertfile`、`certfile`、`keyfile` 和 `password` 將被忽略。"
emqx_schema.common_ssl_opts_schema_managed_certs.label = "託管憑證"
emqx_schema.common_ssl_opts_schema_partial_chain.desc = "啟用或停用使用 partial_chain 的對等驗證。\n在 x509 路徑驗證過程中，本地驗證對等憑證時，它會構建一個從對等憑證開始到信任錨結束的憑證鏈。\n預設情況下，如果設定為 `false`，信任錨是根 CA，憑證鏈必須完整。\n但是，如果設定為 `true` 或 `cacert_from_cacertfile`，則 `cacertfile` 中的最後一個憑證將用作信任錨憑證（中間 CA）。這在路徑驗證中建立了一個部分鏈。\n或者，如果設定為 `two_cacerts_from_cacertfile`，則 `cacertfile` 中的最後兩個憑證之一將用作信任錨憑證，形成部分鏈。此選項特別適用於中間 CA 憑證輪換。\n但是，請注意，這會產生一些額外的開銷，因此應僅用於憑證輪換目的。"
emqx_schema.common_ssl_opts_schema_partial_chain.label = "部分鏈"
emqx_schema.common_ssl_opts_schema_password.desc = "包含使用者密碼的字串。僅在私鑰檔案受密碼保護時使用。<br/>\n如需從檔案載入密碼而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式。檔案內容（去除末尾空白）將作為密碼使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_schema.common_ssl_opts_schema_password.label = "金鑰檔案密碼"
emqx_schema.common_ssl_opts_schema_reuse_sessions.desc = "啟用 TLS 會話重用。"
emqx_schema.common_ssl_opts_schema_reuse_sessions.label = "TLS 會話重用"
emqx_schema.common_ssl_opts_schema_secure_renegotiate.desc = "SSL 參數重新協商是一種允許用戶端和伺服器動態重新協商 SSL 連線參數的功能。\nRFC 5746 定義了一種更安全的方法。透過啟用安全的重新協商，您就失去了對不安全的重新協商的支援，從而容易受到 MitM 攻擊。"
emqx_schema.common_ssl_opts_schema_secure_renegotiate.label = "SSL 重新協商"
emqx_schema.common_ssl_opts_schema_verify.desc = "啟用或停用對等驗證。"
emqx_schema.common_ssl_opts_schema_verify.label = "對等驗證"
emqx_schema.common_ssl_opts_schema_versions.desc = "支援所有 TLS/DTLS 版本<br/>\n注：PSK 的 Ciphers 無法在 <code>tlsv1.3</code> 中使用，如果打算使用 PSK 密碼套件，請確保這裡設定為 <code>[\"tlsv1.2\",\"tlsv1.1\"]</code>。"
emqx_schema.common_ssl_opts_schema_versions.label = "SSL 版本"
emqx_schema.common_ssl_opts_verify_peer_ext_key_usage.desc = "驗證對等憑證中的擴充套件金鑰用法\n為了額外的對等憑證驗證，這裡定義的值必須出現在對等憑證的 '擴充套件金鑰用法' 中，\n如 [rfc5280](https://www.rfc-editor.org/rfc/rfc5280#section-4.2.1.12) 中定義。\n\n允許的值有\n- `clientAuth`\n- `serverAuth`\n- `codeSigning`\n- `emailProtection`\n- `timeStamping`\n- `ocspSigning`\n- 原始 OID，例如：\"OID:1.3.6.1.5.5.7.3.2\" 表示 `id-pk 2`，相當於 `clientAuth`\n\n也支援用逗號分隔的字串來驗證多個金鑰用法。\n\n例如，`\"serverAuth,OID:1.3.6.1.5.5.7.3.2\"`"
emqx_schema.common_ssl_opts_verify_peer_ext_key_usage.label = "驗證憑證中的 KeyUsage"
emqx_schema.config_backup_interval.desc = "備份 `cluster.hocon` 設定檔的時間間隔。即使在該時間間隔內進行了多次設定更新，也只會建立一次備份，包含目前的最新設定。"
emqx_schema.config_backup_interval.label = "設定備份間隔"
emqx_schema.conn_congestion_enable_alarm.desc = "啟用或者停用連線阻塞警報功能。"
emqx_schema.conn_congestion_enable_alarm.label = "啟用/停用阻塞警報"
emqx_schema.conn_congestion_min_alarm_sustain_duration.desc = "清除警報前的最短時間。<br/>只有當佇列中沒有待處理的資料，並且連線至少被堵塞了 <code>min_alarm_sustain_duration</code> 毫秒時，<br/>報警才會被清除。這是為了避免太頻繁地清除和再次發出警報。"
emqx_schema.conn_congestion_min_alarm_sustain_duration.label = "警報維持時間"
emqx_schema.crl_cache_capacity.desc = "快取中可容納的 CRL URL 的最大數量。 如果快取的大小已滿，並且必須取得一個新的 URL，那麼它將驅逐快取中插入的最老的 URL。"
emqx_schema.crl_cache_capacity.label = "CRL 快取大小"
emqx_schema.crl_cache_failure_threshold.desc = "失敗閾值"
emqx_schema.crl_cache_failure_threshold.label = "指定當某個 URL 持續重新整理失敗達到設定時間後，系統將其從快取中移除。"
emqx_schema.crl_cache_refresh_http_timeout.desc = "取得 CRLs 時 HTTP 請求的逾時。 該設定對所有啟用 CRL 檢查的監聽器監聽器有效。"
emqx_schema.crl_cache_refresh_http_timeout.label = "CRL 快取重新整理 HTTP 逾時"
emqx_schema.crl_cache_refresh_interval.desc = "從伺服器重新整理 CRL 的週期。 該設定對所有 URL 和監聽器有效。"
emqx_schema.crl_cache_refresh_interval.label = "CRL 快取重新整理間隔"
emqx_schema.description.desc = "描述性文字。"
emqx_schema.description.label = "描述"
emqx_schema.ds_shared_sub_checkpoint_interval.desc = "共享訂閱領導者定期將主題重放的進度提交到資料庫。\n此參數指定此類提交之間的最小間隔。"
emqx_schema.ds_shared_sub_checkpoint_interval.label = "檢查點間隔"
emqx_schema.ds_shared_sub_realloc_interval.desc = "共享訂閱領導者在此期間積累對組的更改（例如訂閱者加入或離開組）\n然後在訂閱者之間重新分配工作。\n\n這樣做是為了避免在多個訂閱者短時間內加入或離開組時進行不必要的工作。"
emqx_schema.ds_shared_sub_realloc_interval.label = "重新分配間隔"
emqx_schema.ds_shared_sub_revocation_timeout.desc = "給共享訂閱者完成最後一批訊息處理的最長時間。\n\n共享訂閱組的重新平衡可能涉及從一個訂閱者那裡取得工作並將其轉移給另一個訂閱者。\n在此期間，允許第一個訂閱者完成被撤銷任務的剩餘工作。\n\n如果訂閱者未能及時回覆，則會被踢出組，其所有工作將被重新分配。"
emqx_schema.ds_shared_sub_revocation_timeout.label = "撤銷逾時"
emqx_schema.durable_sessions.desc = "會話持久化功能的相關設定。"
emqx_schema.durable_sessions.label = "會話持久化"
emqx_schema.durable_sessions_enable.desc = "使用持久儲存來持久化用戶端會話。\n如果啟用，會話和相應的訊息將被持久儲存，並在伺服器停機時保留。\n\n::: warning\n傳送到持久會話的訊息會被儲存在磁碟上。\n這不可避免地限制了系統的總體吞吐量。\n:::"
emqx_schema.durable_sessions_enable.label = "啟用會話持久化"
emqx_schema.durable_shared_subs.desc = "與持久會話的共享訂閱相關的設定。"
emqx_schema.durable_shared_subs.label = "持久共享訂閱"
emqx_schema.durable_storage.desc = "與 EMQX 持久儲存相關的設定。\n\nEMQX 使用持久儲存來解除安裝各種資料到磁碟，如 MQTT 訊息。"
emqx_schema.durable_storage.label = "持久儲存"
emqx_schema.duration.desc = "時間間隔是一個包含數字和時間單位的字串：\n  - `ms` 表示毫秒\n  - `s` 表示秒\n  - `m` 表示分鐘\n  - `h` 表示小時\n或其組合：`1h5m0s`"
emqx_schema.duration.label = "持續時間"
emqx_schema.fields_authorization_deny_action.desc = "授權檢查拒絕操作時的操作。"
emqx_schema.fields_authorization_deny_action.label = "授權檢查拒絕操作時的操作"
emqx_schema.fields_authorization_no_match.desc = "如果使用者或用戶端不匹配 ACL 規則，或者從可設定授權源(例如內建資料庫、HTTP API 或 PostgreSQL 等。)內未找\n到此類使用者或用戶端時，模式的認存取控制操作。\n在“授權”中查詢更多詳細資訊。"
emqx_schema.fields_authorization_no_match.label = "未匹時的預設授權動作"
emqx_schema.fields_authz_cache_excludes.desc = "排除主題列表，列表內的主題將不會生成授權快取。"
emqx_schema.fields_authz_cache_excludes.label = "排除主題列表"
emqx_schema.fields_cache_enable.desc = "啟用或停用授權快取。"
emqx_schema.fields_cache_enable.label = "啟用或停用授權快取"
emqx_schema.fields_cache_max_size.desc = "快取項的最大數量。"
emqx_schema.fields_cache_max_size.label = "快取項的最大數量"
emqx_schema.fields_cache_ttl.desc = "快取資料的生存時間。"
emqx_schema.fields_cache_ttl.label = "快取資料的生存時間。"
emqx_schema.fields_client_tcp_opts_buffer.desc = "Erlang VM 為出站 MQTT 連線使用的使用者態緩衝區大小。"
emqx_schema.fields_client_tcp_opts_buffer.label = "使用者態緩衝區"
emqx_schema.fields_client_tcp_opts_delay_send.desc = "啟用後，`gen_tcp` 可能會短暫排隊小寫入，將其合併為更大的 TCP 段。\n可提升傳送大量小訊息的發布端吞吐量，但會增加少量延遲。\n預設值：`false`。"
emqx_schema.fields_client_tcp_opts_delay_send.label = "延遲傳送"
emqx_schema.fields_client_tcp_opts_keepalive.desc = "為出站 MQTT 連線啟用 TCP `SO_KEEPALIVE` socket 選項。\n這是 OS 級 TCP 保活探測，獨立於 MQTT 層的 keepalive。"
emqx_schema.fields_client_tcp_opts_keepalive.label = "TCP SO_KEEPALIVE"
emqx_schema.fields_client_tcp_opts_nodelay.desc = "出站 TCP 連線的 `TCP_NODELAY` 標誌。\n設定為 `true` 時，資料將立即傳送，不論大小。"
emqx_schema.fields_client_tcp_opts_nodelay.label = "停用延遲"
emqx_schema.fields_client_tcp_opts_recbuf.desc = "出站 MQTT 連線的 TCP 接收緩衝區（OS 核心）大小。"
emqx_schema.fields_client_tcp_opts_recbuf.label = "TCP 接收緩衝區"
emqx_schema.fields_client_tcp_opts_sndbuf.desc = "出站 MQTT 連線的 TCP 傳送緩衝區（OS 核心）大小。"
emqx_schema.fields_client_tcp_opts_sndbuf.label = "TCP 傳送緩衝區"
emqx_schema.fields_deflate_opts_client_context_takeover.desc = "接管意味著在用戶端訊息之間保留壓縮狀態。"
emqx_schema.fields_deflate_opts_client_context_takeover.label = "用戶端上下文接管"
emqx_schema.fields_deflate_opts_client_max_window_bits.desc = "指定用戶端壓縮上下文的大小。"
emqx_schema.fields_deflate_opts_client_max_window_bits.label = "壓縮視窗大小"
emqx_schema.fields_deflate_opts_level.desc = "壓縮級別"
emqx_schema.fields_deflate_opts_level.label = "壓縮級別"
emqx_schema.fields_deflate_opts_mem_level.desc = "指定壓縮狀態的大小<br/>\n較低的值會減少每個連線的記憶體使用。"
emqx_schema.fields_deflate_opts_mem_level.label = "壓縮狀態大小"
emqx_schema.fields_deflate_opts_server_context_takeover.desc = "接管意味著在伺服器訊息之間保留壓縮狀態。"
emqx_schema.fields_deflate_opts_server_context_takeover.label = "服務上下文接管"
emqx_schema.fields_deflate_opts_server_max_window_bits.desc = "指定伺服器壓縮上下文的大小。"
emqx_schema.fields_deflate_opts_server_max_window_bits.label = "伺服器壓縮視窗大小"
emqx_schema.fields_deflate_opts_strategy.desc = "指定壓縮策略。"
emqx_schema.fields_deflate_opts_strategy.label = "指定壓縮策略"
emqx_schema.fields_listener_enabled.desc = "啟停監聽器。"
emqx_schema.fields_listener_enabled.label = "啟停監聽器"
emqx_schema.fields_listeners_quic.desc = "QUIC 監聽器。"
emqx_schema.fields_listeners_quic.label = "QUIC 監聽器"
emqx_schema.fields_listeners_ssl.desc = "SSL 監聽器。"
emqx_schema.fields_listeners_ssl.label = "SSL 監聽器"
emqx_schema.fields_listeners_tcp.desc = "TCP 監聽器。"
emqx_schema.fields_listeners_tcp.label = "TCP 監聽器"
emqx_schema.fields_listeners_ws.desc = "HTTP websocket 監聽器。"
emqx_schema.fields_listeners_ws.label = "HTTP websocket 監聽器"
emqx_schema.fields_listeners_wss.desc = "HTTPS websocket 監聽器。"
emqx_schema.fields_listeners_wss.label = "HTTPS websocket 監聽器"
emqx_schema.fields_mqtt_opts_parse_unit.desc = "此設定指定 MQTT 解析時的資料處理粒度，決定從位元組流中提取和解析 MQTT 幀的方式：\n\n- `chunk`：按傳輸層資料包級別處理幀。此方式使用原始位元組塊作為解析單位，需要應用邏輯自行組裝和解析 MQTT 幀。每個資料塊的大小不確定，受傳輸速率、socket 緩衝區大小及其他核心設定影響。\n- `frame`：按完整的 MQTT 訊息處理幀。此方式確保應用邏輯僅接收完整的 MQTT 幀進行處理。在大多數情況下，它比 `chunk` 選項具有更好的效能。\n\n請注意，`parse_unit` 的選擇會影響 `active_n` 設定的解釋方式：它決定了傳遞到連線行程的是原始位元組塊的數量還是完整的 MQTT 訊息數量。"
emqx_schema.fields_mqtt_opts_parse_unit.label = "MQTT 訊息解析單位"
emqx_schema.fields_mqtt_opts_tcp_backend.desc = "指示監聽器應使用哪個 TCP 後端。\n\n- `socket`：自 6.3.0 起（在 Unix/Linux 上）的預設後端，可改善訊息延遲和計算資源使用。\n    部分 `tcp_options` 在不同後端下行為不同。例如，`high_watermark` 由 EMQX 用於傳送佇列擁塞處理，而 `send_timeout_close` 在此後端下無效。\n\n- `gen_tcp`：非 Unix 系統上的預設後端。\n\n更改後端需要重啟監聽器，這將終止其所有活動連線。"
emqx_schema.fields_mqtt_opts_tcp_backend.label = "TCP 後端"
emqx_schema.fields_mqtt_quic_listener_certfile.desc = "憑證檔案。在 5.1 中會被廢棄，使用 .ssl_options.certfile 代替。"
emqx_schema.fields_mqtt_quic_listener_certfile.label = "憑證檔案"
emqx_schema.fields_mqtt_quic_listener_conn_flow_control_window.desc = "連線的流控視窗。預設：16777216"
emqx_schema.fields_mqtt_quic_listener_conn_flow_control_window.label = "流控視窗"
emqx_schema.fields_mqtt_quic_listener_datagram_receive_enabled.desc = "宣傳對 QUIC Datagram 擴充套件的支援。為將來保留。預設為 0（FALSE）"
emqx_schema.fields_mqtt_quic_listener_datagram_receive_enabled.label = "啟用 Datagram 接收"
emqx_schema.fields_mqtt_quic_listener_disconnect_timeout_ms.desc = "在判定路徑無效和斷開連線之前，要等待多長時間的 ACK。預設：16000"
emqx_schema.fields_mqtt_quic_listener_disconnect_timeout_ms.label = "斷開連線逾時 毫秒"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout.desc = "一個握手在被丟棄之前可以空閒多長時間。"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout.label = "握手空閒逾時時間"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout_ms.desc = "一個握手在被丟棄之前可以空閒多長時間"
emqx_schema.fields_mqtt_quic_listener_handshake_idle_timeout_ms.label = "握手空閒逾時 毫秒"
emqx_schema.fields_mqtt_quic_listener_idle_timeout.desc = "一個連線在被關閉之前可以空閒多長時間。0 表示停用。"
emqx_schema.fields_mqtt_quic_listener_idle_timeout.label = "空閒逾時時間"
emqx_schema.fields_mqtt_quic_listener_idle_timeout_ms.desc = "一個連線在被優雅地關閉之前可以空閒多長時間。0 表示停用逾時"
emqx_schema.fields_mqtt_quic_listener_idle_timeout_ms.label = "空閒逾時 毫秒"
emqx_schema.fields_mqtt_quic_listener_initial_rtt_ms.desc = "初始 RTT 估計"
emqx_schema.fields_mqtt_quic_listener_initial_rtt_ms.label = "Initial RTT 毫秒"
emqx_schema.fields_mqtt_quic_listener_initial_window_packets.desc = "一個連線的初始擁堵視窗的大小（以包為單位）。預設值：10"
emqx_schema.fields_mqtt_quic_listener_initial_window_packets.label = "初始視窗資料包"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval.desc = "傳送 PING 幀的頻率，以保活連線. 設為 0 表示停用。"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval.label = "Keep Alive 間隔"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval_ms.desc = "多長時間傳送一次 PING 幀以保活連線。"
emqx_schema.fields_mqtt_quic_listener_keep_alive_interval_ms.label = "Keep Alive 間隔毫秒"
emqx_schema.fields_mqtt_quic_listener_keyfile.desc = "私鑰檔案。在 5.1 中會被廢棄，使用 .ssl_options.keyfile 代替。"
emqx_schema.fields_mqtt_quic_listener_keyfile.label = "私鑰檔案"
emqx_schema.fields_mqtt_quic_listener_load_balancing_mode.desc = "0: 停用, 1: SERVER_ID_IP, 2: SERVER_ID_FIXED. 預設: 0"
emqx_schema.fields_mqtt_quic_listener_load_balancing_mode.label = "負載平衡模式"
emqx_schema.fields_mqtt_quic_listener_max_ack_delay_ms.desc = "在收到資料後要等待多長時間才能傳送一個 ACK。預設值：25"
emqx_schema.fields_mqtt_quic_listener_max_ack_delay_ms.label = "最大應答延遲 毫秒"
emqx_schema.fields_mqtt_quic_listener_max_binding_stateless_operations.desc = "在任何時候可以在一個繫結上排隊的無狀態操作的最大數量。預設值：100"
emqx_schema.fields_mqtt_quic_listener_max_binding_stateless_operations.label = "最大繫結無狀態操作"
emqx_schema.fields_mqtt_quic_listener_max_bytes_per_key.desc = "在啟動金鑰更新之前，用單個 1-RTT 加密金鑰加密的最大位元組數。預設值：274877906944"
emqx_schema.fields_mqtt_quic_listener_max_bytes_per_key.label = "每個金鑰的最大位元組數"
emqx_schema.fields_mqtt_quic_listener_max_operations_per_drain.desc = "每個連線操作的最大耗費運算元。預設：16"
emqx_schema.fields_mqtt_quic_listener_max_operations_per_drain.label = "每次操作最大運算元"
emqx_schema.fields_mqtt_quic_listener_max_stateless_operations.desc = "無狀態操作的最大數量，在任何時候都可以在一個工作者上排隊。預設值：16"
emqx_schema.fields_mqtt_quic_listener_max_stateless_operations.label = "最大無狀態運算元"
emqx_schema.fields_mqtt_quic_listener_maximum_mtu.desc = "一個連線所支援的最大 MTU。這將是最大的探測值。預設值：1500"
emqx_schema.fields_mqtt_quic_listener_maximum_mtu.label = "最大 MTU"
emqx_schema.fields_mqtt_quic_listener_migration_enabled.desc = "開啟用戶端地址遷移功能。需要一個支援的負載平衡器，或者沒有負載平衡器。預設值：1（已啟用）"
emqx_schema.fields_mqtt_quic_listener_migration_enabled.label = "啟用地址遷移"
emqx_schema.fields_mqtt_quic_listener_minimum_mtu.desc = "一個連線所支援的最小 MTU。這將被作為起始 MTU 使用。預設值：1248"
emqx_schema.fields_mqtt_quic_listener_minimum_mtu.label = "最小 MTU"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_missing_probe_count.desc = "在任何時候都可以在一個繫結上排隊的無狀態操作的最大數量。預設值：3"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_missing_probe_count.label = "MTU 發現遺失的探針數量"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_search_complete_timeout_us.desc = "如果沒有達到 max ，在重新嘗試 MTU 探測之前要等待的時間，單位是微秒。預設值：600000000"
emqx_schema.fields_mqtt_quic_listener_mtu_discovery_search_complete_timeout_us.label = "MTU 發現搜尋完成逾時（微秒）"
emqx_schema.fields_mqtt_quic_listener_pacing_enabled.desc = "有節奏的傳送，以避免路徑上的緩衝區過度填充。預設值：1（已啟用）"
emqx_schema.fields_mqtt_quic_listener_pacing_enabled.label = "啟用節奏傳送"
emqx_schema.fields_mqtt_quic_listener_peer_bidi_stream_count.desc = "允許對端開啟的雙向流的數量"
emqx_schema.fields_mqtt_quic_listener_peer_bidi_stream_count.label = "對端雙向流的數量"
emqx_schema.fields_mqtt_quic_listener_peer_unidi_stream_count.desc = "允許對端開啟的單向流的數量"
emqx_schema.fields_mqtt_quic_listener_peer_unidi_stream_count.label = "對端單向流的數量"
emqx_schema.fields_mqtt_quic_listener_retry_memory_limit.desc = "在使用無狀態重試之前，可用於握手連線的可用記憶體的百分比。計算為`N/65535`。預設值：65"
emqx_schema.fields_mqtt_quic_listener_retry_memory_limit.label = "重試記憶體限制"
emqx_schema.fields_mqtt_quic_listener_send_buffering_enabled.desc = "緩衝傳送資料，而不是保留應用緩衝區，直到傳送資料被確認。預設值：1（啟用）"
emqx_schema.fields_mqtt_quic_listener_send_buffering_enabled.label = "啟用傳送緩衝功能"
emqx_schema.fields_mqtt_quic_listener_send_idle_timeout_ms.desc = "在閒置一定時間後重置擁堵控制。預設值：1000"
emqx_schema.fields_mqtt_quic_listener_send_idle_timeout_ms.label = "傳送空閒逾時毫秒"
emqx_schema.fields_mqtt_quic_listener_server_resumption_level.desc = "連線恢復 和/或 0-RTT 伺服器支援。預設值：0（無恢復功能）"
emqx_schema.fields_mqtt_quic_listener_server_resumption_level.label = "服務端連線恢復支援"
emqx_schema.fields_mqtt_quic_listener_ssl_options.desc = "QUIC 傳輸層的 TLS 選項"
emqx_schema.fields_mqtt_quic_listener_ssl_options.label = "TLS 選項"
emqx_schema.fields_mqtt_quic_listener_sslkeylogfile.desc = "指定本地檔案系統中檔案的路徑，監聽器將在該檔案中寫入每個連線的 TLS 會話金鑰，從而實現流量解密。此設定無法在執行時更改。"
emqx_schema.fields_mqtt_quic_listener_sslkeylogfile.label = "SSLKEYLOGFILE"
emqx_schema.fields_mqtt_quic_listener_stateless_operation_expiration_ms.desc = "同一個對端的操作之間的時間限制，單位是毫秒。 預設：100"
emqx_schema.fields_mqtt_quic_listener_stateless_operation_expiration_ms.label = "無狀態操作過期 毫秒"
emqx_schema.fields_mqtt_quic_listener_stream_recv_buffer_default.desc = "流的初始緩衝區大小。預設：4096"
emqx_schema.fields_mqtt_quic_listener_stream_recv_buffer_default.label = "流媒體接收緩衝區預設值"
emqx_schema.fields_mqtt_quic_listener_stream_recv_window_default.desc = "初始流接收視窗大小。 預設值：32678"
emqx_schema.fields_mqtt_quic_listener_stream_recv_window_default.label = "流接收視窗預設"
emqx_schema.fields_mqtt_quic_listener_tls_server_max_send_buffer.desc = "緩衝多少 TLS 資料。 預設值：8192"
emqx_schema.fields_mqtt_quic_listener_tls_server_max_send_buffer.label = "TLS 伺服器最大傳送緩衝區"
emqx_schema.fields_rate_limit_conn_bytes_in.desc = "限制 MQTT 連線接收資料包的速率。 速率以每秒的資料包位元組數計算。"
emqx_schema.fields_rate_limit_conn_bytes_in.label = "資料包速率"
emqx_schema.fields_rate_limit_conn_messages_in.desc = "外部 MQTT 連線的訊息限制。"
emqx_schema.fields_rate_limit_conn_messages_in.label = "外部 MQTT 連線的訊息限制"
emqx_schema.fields_rate_limit_max_conn_rate.desc = "每秒最大連線數。"
emqx_schema.fields_rate_limit_max_conn_rate.label = "每秒最大連線數"
emqx_schema.fields_tcp_opts_active_n.desc = "為此套接字指定{active，N}選項<br/>\nSee: https://erlang.org/doc/man/inet.html#setopts-2\n\n使用 `socket` TCP 後端時，此值僅設定訊息投遞的批次大小，以及兩次記憶體檢查之間傳送的封包數。\n\n超出 1-1000 範圍的值不會被拒絕；為相容現有設定，實際生效值會被靜默限制在該範圍內。"
emqx_schema.fields_tcp_opts_active_n.label = "active_n"
emqx_schema.fields_tcp_opts_backlog.desc = "TCP backlog 定義了待處理連線佇列可以增長到的最大長度。"
emqx_schema.fields_tcp_opts_backlog.label = "TCP 連線佇列長度"
emqx_schema.fields_tcp_opts_buffer.desc = "驅動程式使用的使用者空間緩衝區的大小。\n\n小於 5 位元組（MQTT 固定標頭的最大長度）的值不會被拒絕；為相容現有設定，實際生效的緩衝區大小會被靜默提升到 5 位元組。"
emqx_schema.fields_tcp_opts_buffer.label = "TCP 使用者態緩衝區"
emqx_schema.fields_tcp_opts_high_watermark.desc = "控制在 EMQX 將連線視為擁塞之前，可以排隊的待傳送資料量。\n\n該值越小，EMQX 越早對慢速用戶端作出反應；該值越大，則允許排隊更多資料後才判定連線擁塞。當連線處於擁塞狀態時，EMQX 會減慢對該用戶端的 QoS 0 投遞，以幫助連線恢復。\n\n對於預設的 `socket` TCP 後端，該值控制 EMQX 的內部傳送佇列。如果排隊資料持續增長並超過該限制，`send_timeout` 的計時將開始。\n\n對於 `gen_tcp` 後端，該值同時控制 Erlang 的套接字忙碌閾值。如果 Erlang 內部套接字緩衝區增長超過 `high_watermark`，傳送行程可能被暫停，直到套接字不再忙碌或 `send_timeout` 逾時。行程被暫停期間，其訊息佇列可能會累積，詳見 `max_mailbox_len`。"
emqx_schema.fields_tcp_opts_high_watermark.label = "TCP 高水位線"
emqx_schema.fields_tcp_opts_keepalive.desc = "為透過 TCP 或 SSL 建立的 MQTT 連線啟用 TCP keepalive。\n使用三個逗號分隔的數字（單位：秒）進行設定： 'Idle,Interval,Probes'\n - Idle: 在伺服器開始傳送 keepalive 探測包之前，連線需要處於空閒狀態的秒數（Linux 預設為 7200 秒）。\n - Interval: 每次傳送 TCP keepalive 探測包之間的間隔時間（Linux 預設 75 秒）。\n - Probes: 在未收到回應的情況下，最多傳送多少次探測包後放棄並關閉連線（Linux 預設 9 次）。\n例如 \"240,30,5\" 表示：在連線空閒 240 秒後傳送 TCP keepalive 探測，每隔 30 秒傳送一次，直到收到回應，如果連續遺失 5 個回應，連線應該被關閉。\n預設值為：'none'，設定為 'none' 時將使用作業系統的預設 keepalive 設定（仍然啟用，並非停用）。"
emqx_schema.fields_tcp_opts_keepalive.label = "TCP keepalive 選項"
emqx_schema.fields_tcp_opts_nodelay.desc = "連線的 `TCP_NODELAY` 標誌。\n當設定為 `true` 時，無論資料大小，都會立即傳送資料。"
emqx_schema.fields_tcp_opts_nodelay.label = "無延遲"
emqx_schema.fields_tcp_opts_nolinger.desc = "啟用時，`SO_LINGER` 標誌設定為 `(onoff=1, linger=0)`，這意味著 TCP socket 將立即關閉，傳送 TCP-RST 包，丟棄任何未傳送的資料，並跳過正常關閉步驟，包括 CLOSE_WAIT、FIN_WAIT 和 TIME_WAIT。"
emqx_schema.fields_tcp_opts_nolinger.label = "無延遲關閉"
emqx_schema.fields_tcp_opts_recbuf.desc = "連線的 TCP 接收緩衝區（OS 核心）。"
emqx_schema.fields_tcp_opts_recbuf.label = "TCP 接收緩衝區"
emqx_schema.fields_tcp_opts_reuseaddr.desc = "連線的 SO_REUSEADDR 旗標。"
emqx_schema.fields_tcp_opts_reuseaddr.label = "SO_REUSEADDR"
emqx_schema.fields_tcp_opts_send_timeout.desc = "在將連線判定為傳送逾時之前，EMQX 等待已排隊的待傳送資料取得進展的最長時間。\n\n對於預設的 `socket` TCP 後端，該逾時從 EMQX 內部傳送佇列增長超過 `high_watermark` 之後開始計時。\n\n對於 `gen_tcp` 後端，該逾時適用於 Erlang 因套接字忙碌而暫停行程的期間。只有當排隊資料從 `high_watermark` 降至低水位線後，行程才會恢復。"
emqx_schema.fields_tcp_opts_send_timeout.label = "TCP 傳送逾時"
emqx_schema.fields_tcp_opts_send_timeout_close.desc = "如果傳送逾時，則關閉連線。"
emqx_schema.fields_tcp_opts_send_timeout_close.label = "TCP 傳送逾時關閉連線"
emqx_schema.fields_tcp_opts_sndbuf.desc = "連線的 TCP 傳送緩衝區（OS 核心）。"
emqx_schema.fields_tcp_opts_sndbuf.label = "TCP 傳送緩衝區"
emqx_schema.fields_trace_max_file_size.desc = "指定每個追蹤檔案可以達到的最大大小。\n一旦追蹤檔案達到此大小，即使追蹤仍然處於活動狀態，也不會記錄其他事件。"
emqx_schema.fields_trace_max_file_size.label = "最大追蹤檔案大小"
emqx_schema.fields_trace_max_traces.desc = "指定允許同時存在的追蹤數量，無論其狀態如何。"
emqx_schema.fields_trace_max_traces.label = "最大追蹤數"
emqx_schema.fields_trace_payload_encode.desc = "確定追蹤檔案中有效負載格式的格式。<br/>\n`text`：基於文字的協定或純文字協定。\n建議在有效負載為 JSON 編碼時使用<br/>\n`hex`：二進位制十六進位制編碼。當有效負載是自訂二進位制協定時，建議使用此選項<br/>\n`hidden`：有效負載被模糊化為 `******`"
emqx_schema.fields_trace_payload_encode.label = "有效負載編碼"
emqx_schema.fields_ws_opts_allow_origin_absence.desc = "如果設定為 <code>false</code> 並且 <code>check_origin_enable</code> 為 <code>true</code>，伺服器將拒絕沒有 <code>origin</code> HTTP 標頭的請求。"
emqx_schema.fields_ws_opts_allow_origin_absence.label = "允許 origin 缺失"
emqx_schema.fields_ws_opts_check_origin_enable.desc = "如果<code>true</code>，<code>origin</code>HTTP 標頭將根據<code>check_origins</code>參數中設定的允許來源列表進行驗證。"
emqx_schema.fields_ws_opts_check_origin_enable.label = "檢查 origin"
emqx_schema.fields_ws_opts_check_origins.desc = "允許的 origins 列表"
emqx_schema.fields_ws_opts_check_origins.label = "允許的 origins"
emqx_schema.fields_ws_opts_compress.desc = "如果 <code>true</code>，則使用 <code>zlib</code> 壓縮 WebSocket 訊息<br/>\n<code>deflate_opts</code> 下的設定項屬於壓縮相關參數設定。"
emqx_schema.fields_ws_opts_compress.label = "Ws 壓縮"
emqx_schema.fields_ws_opts_fail_if_no_subprotocol.desc = "如果<code>true</code>，當用戶端未攜帶<code>Sec WebSocket Protocol</code>欄位時，伺服器將回傳一個錯誤。\n<br/>注意：微信小程式需要停用此驗證。"
emqx_schema.fields_ws_opts_fail_if_no_subprotocol.label = "無 subprotocol 則失敗"
emqx_schema.fields_ws_opts_idle_timeout.desc = "關閉在此間隔內未傳送 MQTT CONNECT 訊息的用戶端的傳輸層連線。"
emqx_schema.fields_ws_opts_idle_timeout.label = "WS 空閒時間"
emqx_schema.fields_ws_opts_max_frame_size.desc = "單個 MQTT 資料包的最大長度。"
emqx_schema.fields_ws_opts_max_frame_size.label = "最大資料包長度"
emqx_schema.fields_ws_opts_mqtt_path.desc = "WebSocket 的 MQTT 協定路徑。因此，EMQX Broker 的 WebSocket 地址為：\n<code>ws://{ip}:{port}/mqtt</code>"
emqx_schema.fields_ws_opts_mqtt_path.label = "WS MQTT 路徑"
emqx_schema.fields_ws_opts_mqtt_piggyback.desc = "WebSocket 訊息是否允許包含多個 MQTT 資料包。"
emqx_schema.fields_ws_opts_mqtt_piggyback.label = "MQTT Piggyback"
emqx_schema.fields_ws_opts_proxy_address_header.desc = "攜帶原始用戶端 IP 地址的 HTTP 請求標頭，EMQX 會取該請求標頭中最左側的 IP 作為原始用戶端 IP。\n\n此選項通常在 EMQX 部署在 WebSocket Proxy 後面時使用。\n\n設定為空字串（<code>\"\"</code>）可停用此選項，此時始終使用 WebSocket 連線的源 IP 地址。"
emqx_schema.fields_ws_opts_proxy_address_header.label = "Proxy 地址請求標頭"
emqx_schema.fields_ws_opts_proxy_port_header.desc = "攜帶原始用戶端源連接埠的 HTTP 請求標頭，EMQX 會取該請求標頭中最左側的連接埠作為原始用戶端的源連接埠。\n\n此選項通常在 EMQX 部署在 WebSocket Proxy 後面時使用。\n\n設定為空字串（<code>\"\"</code>）可停用此選項，此時始終使用 WebSocket 連線的源連接埠。"
emqx_schema.fields_ws_opts_proxy_port_header.label = "Proxy 連接埠請求標頭"
emqx_schema.fields_ws_opts_supported_subprotocols.desc = "逗號分隔的 subprotocols 支援列表。"
emqx_schema.fields_ws_opts_supported_subprotocols.label = "Subprotocols 支援列表"
emqx_schema.fields_ws_opts_validate_utf8.desc = "設定為 <code>false</code> 可以停用 WebSocket 幀 UTF-8 驗證以提高效能。"
emqx_schema.fields_ws_opts_validate_utf8.label = "啟用/停用 WebSocket 幀 utf8 驗證"
emqx_schema.flapping_detect_ban_time.desc = "自 6.3.0 起廢棄。請改用 `by_clientid.ban_time`。"
emqx_schema.flapping_detect_ban_time.label = "禁止登入時長"
emqx_schema.flapping_detect_by_clientid.desc = "以連線用戶端的用戶端 ID 為鍵的抖動檢測。\n超過閾值時，該用戶端 ID 將被臨時封鎖：\n使用該用戶端 ID 的新連線嘗試會在認證之前被拒絕，\n而已連線的用戶端不受影響。\n設定為 `none`（預設）可停用。"
emqx_schema.flapping_detect_by_clientid.label = "按用戶端 ID 的抖動檢測"
emqx_schema.flapping_detect_by_peerhost.desc = "以連線用戶端的源 IP 地址為鍵的抖動檢測。\n來自同一 IP 地址的用戶端會被合併計數，與其用戶端 ID 無關。\n超過閾值時，該 IP 地址將被臨時封鎖：\n來自該 IP 地址的新連線嘗試會在認證之前被拒絕，\n而已連線的用戶端不受影響。\n設定為 `none`（預設）可停用。"
emqx_schema.flapping_detect_by_peerhost.label = "按源 IP 地址的抖動檢測"
emqx_schema.flapping_detect_by_username.desc = "以連線用戶端的使用者名稱為鍵的抖動檢測。\n共用同一使用者名稱的用戶端會被合併計數，與其用戶端 ID 無關。\n超過閾值時，該使用者名稱將被臨時封鎖：\n使用該使用者名稱的新連線嘗試會在認證之前被拒絕，\n而已連線的用戶端不受影響。\n設定為 `none`（預設）可停用。"
emqx_schema.flapping_detect_by_username.label = "按使用者名稱的抖動檢測"
emqx_schema.flapping_detect_dimension_ban_time.desc = "觸發檢測的用戶端 ID、使用者名稱或源 IP 地址將被封鎖多長時間。"
emqx_schema.flapping_detect_dimension_ban_time.label = "封鎖時長"
emqx_schema.flapping_detect_dimension_max_count.desc = "在 `window_time` 時間內允許的最大連線嘗試次數，超過該次數後，觸發檢測的用戶端 ID、使用者名稱或源 IP 地址將被封鎖。"
emqx_schema.flapping_detect_dimension_max_count.label = "最大次數"
emqx_schema.flapping_detect_dimension_window_time.desc = "抖動檢測的時間視窗。"
emqx_schema.flapping_detect_dimension_window_time.label = "時間視窗"
emqx_schema.flapping_detect_enable.desc = "自 6.3.0 起廢棄。請改用 `by_clientid`。"
emqx_schema.flapping_detect_enable.label = "已廢棄。啟用按用戶端 ID 的抖動檢測"
emqx_schema.flapping_detect_max_count.desc = "自 6.3.0 起廢棄。請改用 `by_clientid.max_count`。"
emqx_schema.flapping_detect_max_count.label = "最大斷開次數"
emqx_schema.flapping_detect_window_time.desc = "自 6.3.0 起廢棄。請改用 `by_clientid.window_time`。"
emqx_schema.flapping_detect_window_time.label = "時間視窗"
emqx_schema.force_gc_bytes.desc = "在行程處理過多少個位元組之後，對此行程執行垃圾回收。"
emqx_schema.force_gc_bytes.label = "垃圾回收位元組數"
emqx_schema.force_gc_count.desc = "在行程收到多少訊息之後，對此行程執行垃圾回收。"
emqx_schema.force_gc_count.label = "垃圾回收訊息數"
emqx_schema.force_gc_enable.desc = "啟用強制垃圾回收。"
emqx_schema.force_gc_enable.label = "啟用強制垃圾回收"
emqx_schema.force_shutdown_enable.desc = "啟用 `force_shutdown` 功能。"
emqx_schema.force_shutdown_enable.label = "啟用 `force_shutdown` 功能"
emqx_schema.force_shutdown_max_heap_size.desc = "Heap 的總大小。"
emqx_schema.force_shutdown_max_heap_size.label = "Heap 的總大小"
emqx_schema.force_shutdown_max_mailbox_size.desc = "每個線上用戶端在 EMQX 伺服器中都是獨立的一個行程。該設定可以設為單個行程的郵箱訊息佇列設定最大長度，當超過該上限時，用戶端會被強制下線。"
emqx_schema.force_shutdown_max_mailbox_size.label = "行程郵箱訊息數上限"
emqx_schema.listeners_root_doc.desc = "監聽器設定按傳輸類型進行定義。\n每種傳輸類型都包含一個將監聽器名稱與其設定關聯的對映。\n預設情況下，每種傳輸類型都包含一個名為 `default` 的監聽器，該監聽器不會在設定檔中顯式宣告。\n若要移除 `default` 監聽器，可顯式設定其設定為：`listeners.ws.default = marked_for_deletion`。\n\n另外，若希望停用某個監聽器但保留其設定內容，可將隱藏欄位 `enable` 設定為 `false`，例如：`listeners.tcp.my_listener.enable = false`。"
emqx_schema.listeners_root_doc.label = "設定 MQTT 監聽器"
emqx_schema.managed_certs_bundle_name.desc = "託管憑證檔案捆綁包的名稱。"
emqx_schema.managed_certs_bundle_name.label = "託管憑證捆綁包名稱"
emqx_schema.managed_certs_ns.desc = "憑證檔案捆綁包所在的命名空間。省略此欄位以定位全域命名空間。"
emqx_schema.managed_certs_ns.label = "託管憑證命名空間"
emqx_schema.managed_certs_server.desc = "EMQX 管理的一個或多個憑證檔案捆綁包的引用。\n\n當使用引用陣列時，監聽器根據用戶端請求的 SNI 動態選擇憑證。每個託管憑證引用都有一個可選的 SNI 欄位，用於表示該引用的 SNI。如果用戶端請求的 SNI 在設定中沒有匹配項，則陣列中的第一個引用將用作預設憑證捆綁包。\n\n如果使用此選項，`cacertfile`、`certfile`、`keyfile` 和 `password` 將被忽略。"
emqx_schema.managed_certs_server.label = "託管憑證"
emqx_schema.managed_certs_server_sni.desc = "如果設定了此項，則在基於用戶端傳送的 SNI 進行動態憑證選擇時使用。"
emqx_schema.managed_certs_server_sni.label = "伺服器名稱指示"
emqx_schema.mqtt.desc = "全域的 MQTT 設定項。\nmqtt 下所有的設定作為全域的預設值存在，它可以被 <code>zone</code> 中的設定覆寫"
emqx_schema.mqtt_await_rel_timeout.desc = "用戶端發布 QoS 2 訊息時，伺服器等待 `PUBREL` 的最長時延。超過該時長後伺服器會放棄等待，該 PACKET ID 會被釋放，從而允許後續新的 PUBLISH 訊息使用。如果逾時後收到 PUBREL，伺服器將會產生一條警報日誌。注意，向訂閱用戶端轉發訊息的動作發生在進入等待之前。"
emqx_schema.mqtt_await_rel_timeout.label = "PUBREL 最長等待時間"
emqx_schema.mqtt_exclusive_subscription.desc = "是否啟用對 MQTT 排它訂閱的支援。"
emqx_schema.mqtt_exclusive_subscription.label = "排它訂閱"
emqx_schema.mqtt_idle_timeout.desc = "設定連線被斷開或進入休眠狀態前的等待時間，空閒逾時後，\n  - 如暫未收到用戶端的 CONNECT 封包，連線將斷開；\n  - 如已收到用戶端的 CONNECT 封包，連線將進入休眠模式以節省系統資源。\n\n注意：請合理設定該參數值，如等待時間設定過長，可能造成系統資源的浪費。"
emqx_schema.mqtt_idle_timeout.label = "空閒逾時"
emqx_schema.mqtt_ignore_loop_deliver.desc = "設定由 MQTT v3.1.1/v3.1.0 用戶端發布的訊息是否將轉發給其本身；類似 MQTT 5.0 協定中的 <code>No Local</code> 選項。"
emqx_schema.mqtt_ignore_loop_deliver.label = "忽略迴圈投遞"
emqx_schema.mqtt_keepalive_check_interval.desc = "檢查傳入 MQTT 資料包的頻率，決定伺服器檢查新 MQTT 資料包的頻率。\n如果在沒有用戶端傳送任何資料包的情況下經過了一定時間，這段時間將累加起來。\n一旦累積時間超過 `keepalive-interval * keepalive-multiplier`，連線將被終止。\n預設設定為 30 秒，最小值為 1 秒，最大值為 `keepalive-interval / 2`。"
emqx_schema.mqtt_keepalive_check_interval.label = "Keep Alive 檢查間隔"
emqx_schema.mqtt_keepalive_multiplier.desc = "Keep-Alive 逾時 = Keep-Alive 間隔 × Keep-Alive 倍數。預設值 1.5 遵循 MQTT 5.0 規範。此倍數可調整，為系統管理員提供根據特定需求進行定製的靈活性。例如，如果用戶端的 10 秒 Keep-Alive 間隔的 PINGREQ 因為額外的 10 秒延遲，將倍數更改為 2 可以讓 EMQX 容忍此延遲。"
emqx_schema.mqtt_keepalive_multiplier.label = "Keep Alive 倍數"
emqx_schema.mqtt_limiter.desc = "MQTT 相關的限流器設定。"
emqx_schema.mqtt_listener_access_rules.desc = "此監聽器的存取控制規則。"
emqx_schema.mqtt_listener_access_rules.label = "存取控制規則"
emqx_schema.mqtt_listener_proxy_protocol.desc = "如果 EMQX 叢集部署在 HAProxy 或 Nginx 之後，請啟用 Proxy 協定 V1/2 <br/>\n詳情見: https://www.haproxy.com/blog/haproxy/proxy-protocol/"
emqx_schema.mqtt_listener_proxy_protocol.label = "Proxy 協定"
emqx_schema.mqtt_listener_proxy_protocol_timeout.desc = "Proxy 協定逾時。如果在逾時時間內未收到 Proxy 協定資料包，EMQX 將關閉 TCP 連線。"
emqx_schema.mqtt_listener_proxy_protocol_timeout.label = "Proxy 協定逾時"
emqx_schema.mqtt_max_awaiting_rel.desc = "每個發布者的會話中，都存在一個佇列來處理用戶端傳送的 QoS 2 訊息。該佇列會儲存 QoS 2 訊息的封包 ID 直到收到用戶端的 PUBREL 或逾時，達到佇列長度的限制後，新的 QoS 2 訊息發布會被拒絕，並回傳 `147(0x93)` 錯誤。"
emqx_schema.mqtt_max_awaiting_rel.label = "PUBREL 等待佇列長度"
emqx_schema.mqtt_max_clientid_len.desc = "允許的最大 MQTT 用戶端 ID 長度。\n此限制適用於所有 MQTT 版本（3.1、3.1.1 和 5.0）。EMQX 不會單獨執行 MQTT 3.1 協定規定的 23 位元組限制；如需執行該限制，請將此值設定為 23。`strict_mode` 設定不會改變用戶端 ID 長度檢查。"
emqx_schema.mqtt_max_clientid_len.label = "最大用戶端 ID 長度"
emqx_schema.mqtt_max_inflight.desc = "允許在完成應答前同時投遞的 QoS 1 和 QoS 2 訊息的最大數量。"
emqx_schema.mqtt_max_inflight.label = "最大飛行視窗"
emqx_schema.mqtt_max_mqueue_len.desc = "訊息佇列最大長度。持久用戶端斷開連線或飛行視窗已滿時排隊的訊息長度。"
emqx_schema.mqtt_max_mqueue_len.label = "最大訊息佇列長度"
emqx_schema.mqtt_max_packet_size.desc = "允許的最大 MQTT 封包大小。"
emqx_schema.mqtt_max_packet_size.label = "最大封包大小"
emqx_schema.mqtt_max_qos_allowed.desc = "允許的最大 QoS 等級。"
emqx_schema.mqtt_max_qos_allowed.label = "最大 QoS"
emqx_schema.mqtt_max_session_expiry_interval.desc = "限制 MQTT 5.0 用戶端透過 `Session-Expiry-Interval` CONNECT 屬性請求的最長會話過期間隔。若用戶端請求更長值，伺服器會靜默將其限制到該上限（並按 MQTT 5.0 規範 3.2.2.3.2 在 CONNACK 的 `Session-Expiry-Interval` 屬性中回傳該限制值）。對 MQTT 3.1.1 / 3.1 用戶端無影響，它們的會話過期完全由 `session_expiry_interval` 伺服器端控制。預設值：`infinity`（不限制）。"
emqx_schema.mqtt_max_session_expiry_interval.label = "最長會話過期間隔"
emqx_schema.mqtt_max_subscriptions.desc = "允許每個用戶端建立的最大訂閱數量。"
emqx_schema.mqtt_max_subscriptions.label = "最大訂閱數量"
emqx_schema.mqtt_max_topic_alias.desc = "允許的最大主題別名數，0 表示不支援主題別名。"
emqx_schema.mqtt_max_topic_alias.label = "最大主題別名"
emqx_schema.mqtt_max_topic_levels.desc = "允許的最大主題層級。"
emqx_schema.mqtt_max_topic_levels.label = "最大主題層級"
emqx_schema.mqtt_message_expiry_interval.desc = "MQTT 訊息的過期間隔。對於 MQTT 5.0 用戶端，此設定僅在訊息中未設定 Message-Expiry-Interval 屬性時生效；否則，將使用 Message-Expiry-Interval 屬性的值。對於 5.0 之前的 MQTT 版本，此設定將始終生效。請注意，將 message_expiry_interval 設定為大於 session_expiry_interval 是沒有意義的，因為會話過期時所有訊息將被清除。"
emqx_schema.mqtt_message_expiry_interval.label = "訊息過期間隔"
emqx_schema.mqtt_mqueue_default_priority.desc = "預設的主題優先順序，不在 <code>主題優先順序</code>（<code>mqueue_priorities</code>） 中的主題將會使用該優先順序。"
emqx_schema.mqtt_mqueue_default_priority.label = "預設主題優先順序"
emqx_schema.mqtt_mqueue_priorities.desc = "主題優先順序。取值範圍 [1-255]\n預設優先順序表為空，即所有的主題優先順序相同。\n\n注：優先主題名稱中不支援使用逗號和等號。\n注：不在此列表中的主題，被視為最高/最低優先順序，這取決於<code>mqtt.mqueue_default_priority</code> 的設定。\n\n範例：\n設定 <code>\"topic/1\" > \"topic/2\"</code>:\n<code>mqueue_priorities: {\"topic/1\": 10, \"topic/2\": 8}</code>"
emqx_schema.mqtt_mqueue_priorities.label = "主題優先順序"
emqx_schema.mqtt_mqueue_store_qos0.desc = "控制在用戶端斷開連線或連線擁塞期間，是否將 QoS 0 訊息快取到會話的訊息佇列中。\n- 啟用時，當飛行視窗已滿，QoS 0 訊息也可能排在 QoS 1 和 QoS 2 訊息之後入隊，以保持投遞順序。\n- 停用時，不儲存 QoS 0 訊息。\n佇列限制和訊息過期仍然適用。\n此設定僅適用於非持久會話。"
emqx_schema.mqtt_mqueue_store_qos0.label = "儲存 QoS 0 訊息"
emqx_schema.mqtt_peer_cert_as_clientid.desc = "使用對端憑證中的 CN、DN 欄位或整個憑證內容來作為用戶端 ID。僅適用於 TLS 連線；\n目前支援：\n- <code>cn</code>: 取憑證的 CN 欄位\n- <code>dn</code>: 取憑證的 DN 欄位\n- <code>crt</code>: 取 <code>DER</code> 或 <code>PEM</code> 憑證的內容\n- <code>pem</code>: 將 <code>DER</code> 憑證內容轉換為 <code>PEM</code> 格式作為用戶端 ID\n- <code>md5</code>: 取 <code>DER</code> 或 <code>PEM</code> 憑證內容的 MD5 值"
emqx_schema.mqtt_peer_cert_as_clientid.label = "對端憑證作為用戶端 ID"
emqx_schema.mqtt_peer_cert_as_username.desc = "使用對端憑證中的 CN、DN 欄位或整個憑證內容來作為使用者名稱；僅適用於 TLS 連線。\n目前支援：\n- <code>cn</code>: 取憑證的 CN 欄位\n- <code>dn</code>: 取憑證的 DN 欄位\n- <code>crt</code>: 取 <code>DER</code> 或 <code>PEM</code> 的憑證內容\n- <code>pem</code>: 將 <code>DER</code> 憑證轉換為 <code>PEM</code> 格式作為使用者名稱\n- <code>md5</code>: 取 <code>DER</code> 或 <code>PEM</code> 憑證內容的 MD5 值"
emqx_schema.mqtt_peer_cert_as_username.label = "對端憑證作為使用者名稱"
emqx_schema.mqtt_response_information.desc = "UTF-8 字串，用於建立回應主題，例如，如果設定為 <code>reqrsp/</code>，發布者/訂閱者將使用主題字首 <code>reqrsp/</code> 進行通訊。\n要停用此功能，請在下方的文字框中留空。僅適用於 MQTT 5.0 用戶端。"
emqx_schema.mqtt_response_information.label = "回應資訊"
emqx_schema.mqtt_retain_available.desc = "是否啟用對 MQTT 保留訊息的支援。"
emqx_schema.mqtt_retain_available.label = "保留訊息可用"
emqx_schema.mqtt_retry_interval.desc = "QoS 1/2 訊息的重新投遞間隔。"
emqx_schema.mqtt_retry_interval.label = "重試間隔"
emqx_schema.mqtt_server_keepalive.desc = "EMQX 要求的保活時間，如設為 disabled，則將使用用戶端指定的保持連線時間；僅適用於 MQTT 5.0 用戶端。"
emqx_schema.mqtt_server_keepalive.label = "服務端保活時間"
emqx_schema.mqtt_session_expiry_interval.desc = "指定用戶端斷開連線後，EMQX 保留會話的時長。\n適用於以 `Clean Session = false` 連線的 MQTT 3.1 和 3.1.1 用戶端。\nMQTT 5.0 用戶端透過 CONNECT 封包的 `Session-Expiry-Interval` 屬性自行設定該值。\n\n使用預設的記憶體會話儲存時，斷開的會話會在整個時長內駐留在記憶體中。請為此預留記憶體，或使用將會話狀態儲存到磁碟的持久會話。"
emqx_schema.mqtt_session_expiry_interval.label = "會話過期間隔"
emqx_schema.mqtt_shared_subscription.desc = "是否啟用對 MQTT 共享訂閱的支援。"
emqx_schema.mqtt_shared_subscription.label = "共享訂閱可用"
emqx_schema.mqtt_shared_subscription_initial_sticky_pick.desc = "當 shared_subscription_strategy 為 `sticky` 時，初始訂閱者選擇的策略。\n - `random`: 隨機選擇訂閱者；\n - `local`: 隨機選擇目前節點上的訂閱者，如果目前節點上沒有訂閱者，則在叢集中隨機選擇；\n - `hash_clientid`: 根據發布者的用戶端 ID 進行雜湊，選擇訂閱者；\n - `hash_topic`: 根據發布的主題進行雜湊，選擇訂閱者。"
emqx_schema.mqtt_shared_subscription_strategy.desc = "共享訂閱的分發策略。\nEMQX 將 **分發狀態**（如隨機種子、輪詢位置和粘性訂閱者選擇）作為 **發布用戶端連線狀態** 的一部分進行維護。\n如果發布用戶端斷開連線並重新連線，則此狀態會遺失，必須重新初始化。\n\n- `random`：隨機選擇一個訂閱者進行分發。\n- `round_robin`：在每個共享訂閱組內依次將訊息分發給訂閱者。輪詢進度按發布用戶端各自維護，因此來自不同發布者的訊息可能會被連續分發給同一訂閱者。\n- `round_robin_per_group`：與 `round_robin` 類似，但輪詢進度在每個節點上獨立記錄。這意味著從叢集中不同節點發布的訊息可能會被分發給同一訂閱者。\n- `local`：隨機選擇目前節點上的一個訂閱者，如果目前節點沒有訂閱者，則在叢集內隨機選擇。\n- `sticky`：持續將訊息分發給最初選擇的訂閱者，直到其會話結束。初始訂閱者基於 `mqtt_shared_subscription_initial_sticky_pick` 選擇。\n- `hash_clientid`：雜湊發布者的用戶端 ID 以選擇訂閱者。\n- `hash_topic`：雜湊發布主題以選擇訂閱者。"
emqx_schema.mqtt_strict_mode.desc = "是否以嚴格模式解析 MQTT 訊息。\n嚴格模式下，用戶端 ID、主題名等中的無效 UTF-8 字串、保留位以及其他格式錯誤的封包結構會導致用戶端斷開連線。\n自 6.3 版本起預設值為 `true`——若需相容不符合規範的用戶端，請設定為 `false` 以恢復舊的寬鬆行為。\n嚴格模式僅檢查封包格式是否正確，不執行特定協定版本的語義限制，例如 MQTT 3.1 的用戶端 ID 長度；用戶端 ID 長度由 `max_clientid_len` 控制。"
emqx_schema.mqtt_strict_mode.label = "嚴格模式"
emqx_schema.mqtt_subscription_max_qos_rules.desc = "最大訂閱 QoS 允許規則。用於限制用戶端在 `SUBSCRIBE` 資料包中請求的 QoS 級別。優先於 `max_qos_allowed` 選項，該選項在沒有規則適用時充當預設值。\n\n例如，此規則列表可用於強制對主題過濾器 `#` 和與 `notification/+/#` 主題過濾器匹配的任何主題過濾器（例如 `notification/foo/bar/#`）強制使用 QoS 0：\n```\n[ { topic = { equals = \"#\" }, qos = 0 }\n  { topic = { matches = \"notification/+/#\" }, qos = 0 }\n]\n```"
emqx_schema.mqtt_subscription_max_qos_rules.label = "最大訂閱 QoS 規則"
emqx_schema.mqtt_subscription_message_filter.desc = "是否啟用對在主題過濾器中以 `?` 附加的 EMQX 訂閱訊息過濾器的支援。"
emqx_schema.mqtt_subscription_message_filter.label = "訂閱訊息過濾器"
emqx_schema.mqtt_upgrade_qos.desc = "投遞訊息時，是否根據訂閱主題時的 QoS 等級來強制提升派發的訊息的 QoS 等級。"
emqx_schema.mqtt_upgrade_qos.label = "升級 QoS"
emqx_schema.mqtt_use_username_as_clientid.desc = "是否使用使用者名稱作為用戶端 ID。\n此設定的作用時間晚於 <code>對端憑證作為使用者名稱</code> 和 <code>對端憑證作為用戶端 ID</code>。"
emqx_schema.mqtt_use_username_as_clientid.label = "使用者名稱作為用戶端 ID"
emqx_schema.mqtt_wildcard_subscription.desc = "是否啟用對 MQTT 萬用字元訂閱的支援。"
emqx_schema.mqtt_wildcard_subscription.label = "萬用字元訂閱可用"
emqx_schema.namespace_as_mountpoint.desc = "使用用戶端的命名空間作為主題掛載點。如果監聽器已經設定了 `mountpoint`，則忽略此設定。\n啟用後，EMQX 透過以下方式隔離主題：\n  - 在 PUBLISH、SUBSCRIBE、UNSUBSCRIBE 和 Will 訊息中將命名空間作為字首新增到主題。\n  - 從傳送給用戶端的訊息中去除此字首。\n範例（命名空間 `n1`）：\n  - 用戶端訂閱 `sensors/#` -> broker 註冊 `n1/sensors/#`。\n  - broker 路由 `n1/sensors/data` -> 用戶端接收 `sensors/data`。"
emqx_schema.namespace_as_mountpoint.label = "使用命名空間作為主題掛載點"
emqx_schema.overload_protection_backoff_delay.desc = "高負載時，一些不重要的任務可能會延遲執行，在這裡設定允許延遲的時間。"
emqx_schema.overload_protection_backoff_delay.label = "延遲時間"
emqx_schema.overload_protection_backoff_gc.desc = "高負載時，跳過強制 GC。"
emqx_schema.overload_protection_backoff_gc.label = "跳過 GC"
emqx_schema.overload_protection_backoff_hibernation.desc = "高負載時，跳過行程休眠。"
emqx_schema.overload_protection_backoff_hibernation.label = "跳過休眠"
emqx_schema.overload_protection_backoff_new_conn.desc = "高負載時，拒絕新進來的用戶端連線。"
emqx_schema.overload_protection_backoff_new_conn.label = "關閉新連線"
emqx_schema.overload_protection_enable.desc = "是否對系統過載做出反應。"
emqx_schema.overload_protection_enable.label = "是否對系統過載做出反應"
emqx_schema.resource_tags.desc = "連接器的標籤"
emqx_schema.resource_tags.label = "標籤"
emqx_schema.server_ssl_opts_schema_client_renegotiation.desc = "在支援用戶端發起的重新協商的協定中，這種操作的資源成本對於伺服器來說高於用戶端。\n這可能會成為拒絕服務攻擊的載體。\nSSL 應用程式已經採取措施來反擊此類嘗試，但透過將此選項設定為 false，可以嚴格停用用戶端發起的重新協商。\n預設值為 true。請注意，由於基礎密碼套件可以加密的訊息數量有限，停用重新協商可能會導致長期連線變得不可用。"
emqx_schema.server_ssl_opts_schema_client_renegotiation.label = "SSL 用戶端衝協商"
emqx_schema.server_ssl_opts_schema_dhfile.desc = "如果協商使用 Diffie-Hellman 金鑰交換的密碼套件，則伺服器將使用包含 PEM 編碼的 Diffie-Hellman 參數的檔案的路徑。如果未指定，則使用預設參數。<br/>\n注意：TLS 1.3 不支援<code>dhfile</code>選項。"
emqx_schema.server_ssl_opts_schema_dhfile.label = "SSL dhfile"
emqx_schema.server_ssl_opts_schema_enable_crl_check.desc = "是否為該監聽器啟用 CRL 檢查。"
emqx_schema.server_ssl_opts_schema_enable_crl_check.label = "啟用 CRL 檢查"
emqx_schema.server_ssl_opts_schema_enable_ocsp_stapling.desc = "是否為監聽器啟用 OCSP Stapling 功能。 如果設定為 true，需要定義 OCSP Responder 的 URL 和憑證籤發者的 PEM 檔案路徑。"
emqx_schema.server_ssl_opts_schema_enable_ocsp_stapling.label = "啟用 OCSP Stapling"
emqx_schema.server_ssl_opts_schema_fail_if_no_peer_cert.desc = "TLS/DTLS 伺服器與 {verify，verify_peer} 一起使用。\n如果設定為 true，則如果用戶端沒有要傳送的憑證，即傳送空憑證，伺服器將失敗。\n如果設定為 false，則僅當用戶端傳送無效憑證（空憑證被視為有效憑證）時才會失敗。"
emqx_schema.server_ssl_opts_schema_fail_if_no_peer_cert.label = "沒有憑證則 SSL 失敗"
emqx_schema.server_ssl_opts_schema_gc_after_handshake.desc = "記憶體使用調優。如果啟用，將在 TLS/SSL 握手完成後立即執行垃圾回收。TLS/SSL 握手建立後立即進行 GC。"
emqx_schema.server_ssl_opts_schema_gc_after_handshake.label = "握手後執行 GC"
emqx_schema.server_ssl_opts_schema_handshake_timeout.desc = "握手完成所允許的最長時間"
emqx_schema.server_ssl_opts_schema_handshake_timeout.label = "握手逾時時間"
emqx_schema.server_ssl_opts_schema_honor_cipher_order.desc = "一個重要的安全設定，它強制根據伺服器指定的順序而不是用戶端指定的順序設定密碼，從而強制伺服器管理員執行（通常設定得更正確）安全順序。"
emqx_schema.server_ssl_opts_schema_honor_cipher_order.label = "SSL honor cipher order"
emqx_schema.server_ssl_opts_schema_ocsp_issuer_pem.desc = "伺服器憑證的 OCSP 簽發者的 PEM 編碼憑證。"
emqx_schema.server_ssl_opts_schema_ocsp_issuer_pem.label = "OCSP 簽發者憑證"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_http_timeout.desc = "檢查 OCSP 回應時，HTTP 請求的逾時。"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_http_timeout.label = "OCSP 重新整理 HTTP 逾時"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_interval.desc = "為伺服器重新整理 OCSP 回應的週期。"
emqx_schema.server_ssl_opts_schema_ocsp_refresh_interval.label = "OCSP 重新整理間隔"
emqx_schema.server_ssl_opts_schema_ocsp_responder_url.desc = "用於檢查伺服器憑證的 OCSP Responder 的 URL。"
emqx_schema.server_ssl_opts_schema_ocsp_responder_url.label = "OCSP Responder 的 URL"
emqx_schema.server_ssl_opts_schema_session_tickets.desc = "啟用使用無狀態會話票據的 TLS 1.3 會話恢復。\n\n可能的值：\n\n- `disabled`：停用會話票據（預設）。\n- `stateless`：啟用無狀態會話票據。伺服器傳送加密票據，用戶端可以使用這些票據恢復會話，而無需在伺服器上儲存會話狀態。\n- `stateless_with_cert`：啟用包含憑證資訊的無狀態會話票據。這允許即使伺服器憑證更改也能恢復會話，但會增加網路頻寬使用，因為每個票據都包含憑證資料。\n\n注意：EMQX 僅支援無狀態會話票據，不支援用戶端早期資料（0-RTT）。\n完全握手後傳送的票據數量由設定 `node.tls_server_session_tickets_amount` 控制。\n種子金鑰在 `node.tls_stateless_tickets_seed` 中設定。"
emqx_schema.server_ssl_opts_schema_session_tickets.label = "TLS 1.3 會話票據"
emqx_schema.server_ssl_opts_schema_user_lookup_fun.desc = "EMQX 內部回呼，用於查詢預共享金鑰（PSK）身分。<br/>\n當 TLS 版本設定（或協商）為 1.3 時無效。"
emqx_schema.server_ssl_opts_schema_user_lookup_fun.label = "SSL PSK 使用者查詢功能"
emqx_schema.session_ds_batch_size.desc = "此值影響持久會話的流量控制。\n持久會話以批次查詢持久訊息儲存。\n此值指定批次的大小。\n\n注意：較大的批次通常提高系統的吞吐量和整體效能，但會增加每個用戶端的 RAM 使用量。"
emqx_schema.session_ds_batch_size.label = "批次大小"
emqx_schema.session_ds_checkpoint_interval.desc = "持久會話定期將其狀態備份到磁碟。\n這在每個檢查點間隔發生。"
emqx_schema.session_ds_checkpoint_interval.label = "持久會話檢查點間隔"
emqx_schema.session_ds_commit_timeout.desc = "將持久會話狀態提交到儲存的交易逾時。"
emqx_schema.session_ds_commit_timeout.label = "持久會話提交逾時"
emqx_schema.session_ds_message_retention_period.desc = "broker 會在此時間段內保留傳送到持久會話的訊息。"
emqx_schema.session_ds_message_retention_period.label = "訊息保留期"
emqx_schema.shared_subscription_group_strategy.desc = "設定共享訂閱組為單位的分發策略。該設定是一個從組名到\n策略名的一個 map，組名不得包含 `[A-Za-z0-9]` 之外的特殊字元。"
emqx_schema.shared_subscription_initial_sticky_pick_enum.desc = "當共享訂閱策略為 sticky 時，初始訂閱者選擇的策略。\n - `random`: 隨機選擇訂閱者；\n - `local`: 隨機選擇目前節點上的訂閱者，如果目前節點上沒有訂閱者，則在叢集中隨機選擇；\n - `hash_clientid`: 根據發布者的用戶端 ID 進行雜湊，選擇訂閱者；\n - `hash_topic`: 根據發布的主題進行雜湊，選擇訂閱者。"
emqx_schema.shared_subscription_strategy_enum.desc = "共享訂閱的分發策略。\nEMQX 將 **分發狀態**（如隨機種子、輪詢位置和粘性訂閱者選擇）作為 **發布用戶端連線狀態** 的一部分進行維護。\n如果發布用戶端斷開連線並重新連線，則此狀態會遺失，必須重新初始化。\n\n- `random`：隨機選擇一個訂閱者進行分發；\n- `round_robin`：共享訂閱組中的用戶端將依次消費訊息，每個發布者獨立記錄迴圈進度，因此來自**不同發布者**的兩個相鄰訊息可能會被訂閱組中的同一用戶端消費；\n- `round_robin_per_group`：共享訂閱組中的用戶端將依次消費訊息，每個節點獨立記錄迴圈進度，因此來自**不同節點**的兩個相鄰訊息可能會被訂閱組中的同一用戶端消費；\n- `local`：隨機選擇目前節點上的一個訂閱者，如果目前節點沒有訂閱者，則在叢集內隨機選擇；\n- `sticky`：持續將訊息分發給最初選擇的訂閱者，直到他們的會話結束。初始選擇基於 `initial_sticky_pick` 的值；\n- `hash_clientid`：雜湊發布者的用戶端 ID 以選擇訂閱者；\n- `hash_topic`：雜湊發布主題以選擇訂閱者。"
emqx_schema.socket_tcp_keepalive.desc = "啟用 TCP Keepalive（保持連線）。\n該值由三個以逗號分隔的數字組成，格式為 'Idle,Interval,Probes'：\n - Idle：連線空閒多長時間（秒）後，伺服器開始傳送 Keepalive 探測封包（Linux 預設值 7200）。\n - Interval：每次 TCP Keepalive 探測之間的間隔時間（秒）（Linux 預設值 75）。\n - Probes：如果未從對端收到回應，在放棄連線並關閉之前，最多傳送的 TCP Keepalive 探測封包次數（Linux 預設值 9）。\n例如，設定為 \"240,30,5\" 意味著：當連線空閒 240 秒後，EMQX 將開始傳送探測封包，每 30 秒傳送一次直到收到回應，如果連續 5 沒有收到回應，則關閉該連線。\n預設值：'none'。"
emqx_schema.socket_tcp_keepalive.label = "TCP keepalive 選項"
emqx_schema.stats_enable.desc = "啟用/停用統計資料收集功能。"
emqx_schema.stats_enable.label = "啟用/停用統計資料收集功能"
emqx_schema.sys_event_client_connected.desc = "是否開啟用戶端已連線事件訊息。"
emqx_schema.sys_event_client_disconnected.desc = "是否開啟用戶端已斷開連線事件訊息。"
emqx_schema.sys_event_client_subscribed.desc = "是否開啟用戶端已成功訂閱主題事件訊息。"
emqx_schema.sys_event_client_unsubscribed.desc = "是否開啟用戶端已成功取消訂閱主題事件訊息。"
emqx_schema.sys_event_messages.desc = "用戶端事件訊息。"
emqx_schema.sys_heartbeat_interval.desc = "傳送心跳系統訊息的間隔時間，它包括：\n  - `$SYS/brokers/<node>/uptime`\n  - `$SYS/brokers/<node>/datetime`"
emqx_schema.sys_msg_interval.desc = "傳送 `$SYS` 主題的間隔時間。"
emqx_schema.sys_topics.desc = "系統主題設定。"
emqx_schema.sysmon_broker_pool_mailbox_size_alarm_threshold.desc = "當 broker 池的最大郵箱大小超過該閾值時，會觸發警報。broker 池負責處理新增和移除訂閱，以及路由資訊的複製。\n\n可能導致此警報觸發的原因有多種。以下是一些需要檢查或考慮的事項：\n- 增加 EMQX 的 CPU / RAM 資源；\n- 審查用戶端的訂閱情況，例如，嘗試壓縮主題過濾器；\n- 檢查叢集內部網路頻寬是否已達到最大值。"
emqx_schema.sysmon_broker_pool_mailbox_size_alarm_threshold.label = "郵箱大小警報"
emqx_schema.sysmon_mnesia_tm_mailbox_size_alarm_threshold.desc = "當 mnesia 交易管理器的郵箱大小超過該閾值時，會觸發警報。該行程負責處理 EMQX 內部資料庫 mnesia 中的所有交易。\n\n可能導致此警報觸發的原因有多種。以下是一些需要檢查或考慮的事項：\n- 降低 `max_conn_rate`，以便用戶端以較慢的速度加入；\n- 增加 EMQX 的 CPU / RAM 資源；\n- 降低用戶端側的保留訊息速率；\n- 檢查叢集內部網路頻寬是否已達到最大值。"
emqx_schema.sysmon_mnesia_tm_mailbox_size_alarm_threshold.label = "mnesia 交易管理器郵箱大小警報"
emqx_schema.sysmon_os_cpu_check_interval.desc = "定期 CPU 檢查的時間間隔。"
emqx_schema.sysmon_os_cpu_check_interval.label = "定期 CPU 檢查的時間間隔"
emqx_schema.sysmon_os_cpu_high_watermark.desc = "在發出相應警報之前可以使用多少系統 CPU 的閾值，以系統 CPU 負載的百分比表示。"
emqx_schema.sysmon_os_cpu_high_watermark.label = "CPU 高水位線"
emqx_schema.sysmon_os_cpu_low_watermark.desc = "在解除相應警報之前可以使用多少系統 CPU 的閾值，以系統 CPU 負載的百分比表示。"
emqx_schema.sysmon_os_cpu_low_watermark.label = "CPU 低水位線"
emqx_schema.sysmon_os_mem_check_interval.desc = "定期記憶體檢查的時間間隔。"
emqx_schema.sysmon_os_mem_check_interval.label = "記憶體檢查間隔"
emqx_schema.sysmon_os_procmem_high_watermark.desc = "在發出相應警報之前，一個 Erlang 行程可以分配多少系統記憶體的閾值，以系統記憶體的百分比表示。"
emqx_schema.sysmon_os_procmem_high_watermark.label = "行程記憶體高水位線"
emqx_schema.sysmon_os_sysmem_high_watermark.desc = "在發出相應報警之前可以分配多少系統記憶體的閾值，以系統記憶體的百分比表示。"
emqx_schema.sysmon_os_sysmem_high_watermark.label = "系統記憶體高水位線"
emqx_schema.sysmon_session_total_payload_bytes_high_watermark.desc = "觸發限流警報日誌的單會話 total_payload_bytes 閾值。設定為 0 可停用該警報日誌。"
emqx_schema.sysmon_session_total_payload_bytes_high_watermark.label = "總負載位元組數高水位線"
emqx_schema.sysmon_top_db_username.desc = "PostgreSQL 資料庫的使用者名稱"
emqx_schema.sysmon_top_db_username.label = "DB 使用者名稱"
emqx_schema.sysmon_vm_busy_dist_port.desc = "啟用後，當用於叢集接點之間 RPC 的連線過忙時，會觸發一條帶有 <code>busy_dist_port</code> 關鍵字的 warning 級別日誌。\n同時還會發布一條主題為 <code>$SYS/sysmon/busy_dist_port</code> 的 MQTT 系統訊息。"
emqx_schema.sysmon_vm_busy_dist_port.label = "啟用分散式連接埠過忙監控"
emqx_schema.sysmon_vm_busy_port.desc = "當一個系統介面（例如 TCP socket）過忙，會觸發一條帶有 <code>busy_port</code> 關鍵字的 warning 級別的日誌。\n同時還會發布一條主題為 <code>$SYS/sysmon/busy_port</code> 的 MQTT 系統訊息。"
emqx_schema.sysmon_vm_busy_port.label = "啟用連接埠過忙監控"
emqx_schema.sysmon_vm_large_heap.desc = "啟用後，當一個 Erlang 行程申請了大量記憶體，系統會觸發一條帶有 <code>large_heap</code> 關鍵字的\nwarning 級別日誌。同時還會發布一條主題為 <code>$SYS/sysmon/busy_dist_port</code> 的 MQTT 系統訊息。"
emqx_schema.sysmon_vm_large_heap.label = "啟用大 heap 監控"
emqx_schema.sysmon_vm_long_gc.desc = "當系統檢測到某個 Erlang 行程垃圾回收佔用過長時間，會觸發一條帶有 <code>long_gc</code> 關鍵字的日誌。\n同時還會發布一條主題為 <code>$SYS/sysmon/long_gc</code> 的 MQTT 系統訊息。"
emqx_schema.sysmon_vm_long_gc.label = "啟用長垃圾回收監控"
emqx_schema.sysmon_vm_long_schedule.desc = "啟用後，如果 Erlang VM 排程器出現某個任務佔用時間過長時，會觸發一條帶有 'long_schedule' 關鍵字的日誌。\n同時還會發布一條主題為 <code>$SYS/sysmon/long_schedule</code> 的 MQTT 系統訊息。"
emqx_schema.sysmon_vm_long_schedule.label = "啟用長排程監控"
emqx_schema.sysmon_vm_process_check_interval.desc = "定期行程限制檢查的時間間隔。"
emqx_schema.sysmon_vm_process_check_interval.label = "行程限制檢查時間"
emqx_schema.sysmon_vm_process_high_watermark.desc = "在發出相應警報之前，本地節點上可以同時存在多少行程的閾值（以行程百分比表示）。"
emqx_schema.sysmon_vm_process_high_watermark.label = "行程數高水位線"
emqx_schema.sysmon_vm_process_low_watermark.desc = "在清除相應警報之前，本地節點上可以同時存在多少行程的閾值（以行程百分比表示）。"
emqx_schema.sysmon_vm_process_low_watermark.label = "行程數低水位線"
emqx_schema.topic_predicate.desc = "在給定主題（或主題過濾器）上評估的謂詞，以決定規則是否適用。\n\n定義了以下主題謂詞：\n\n* `{ equals = \"t/foo/bar\" }`\n\n    給定主題或主題過濾器與值完全相等。\n\n* `{ matches = \"t/foo/#\" }`\n\n    測試給定主題過濾器是否有效匹配值中的主題過濾器。\n\n    請注意，匹配主題過濾器到主題過濾器可能會產生不尋常的結果。例如，給定主題過濾器 `t/foo/#` 謂詞 `{ matches = \"t/foo/+\" }` 評估為 _true_。"
emqx_schema.topic_predicate.label = "主題謂詞"
emqx_schema.zones.desc = "<code>zone</code> 是按<code>name</code> 分組的一組設定。\n對於靈活的設定對映，可以將 <code>name</code> 設定為監聽器的 <code>zone</code> 設定。\n注：名為 <code>default</code> 的內建區域是自動建立的，無法刪除。"
emqx_schema_registry_http_api.deleted.desc = "已刪除。"
emqx_schema_registry_http_api.deleted.label = "已刪除"
emqx_schema_registry_http_api.desc_param_path_schema_name.desc = "Schema 的名稱。"
emqx_schema_registry_http_api.desc_param_path_schema_name.label = "Schema 名稱"
emqx_schema_registry_http_api.desc_schema_registry_api_delete.desc = "刪除一個 schema。"
emqx_schema_registry_http_api.desc_schema_registry_api_delete.label = "刪除 schema"
emqx_schema_registry_http_api.desc_schema_registry_api_get.desc = "透過名稱取得一個 schema。"
emqx_schema_registry_http_api.desc_schema_registry_api_get.label = "取得 schema"
emqx_schema_registry_http_api.desc_schema_registry_api_list.desc = "列出所有已註冊的 schema。"
emqx_schema_registry_http_api.desc_schema_registry_api_list.label = "列出 schema"
emqx_schema_registry_http_api.desc_schema_registry_api_post.desc = "註冊一個新的 schema。"
emqx_schema_registry_http_api.desc_schema_registry_api_post.label = "註冊 schema"
emqx_schema_registry_http_api.desc_schema_registry_api_put.desc = "更新一個現有的 schema。"
emqx_schema_registry_http_api.desc_schema_registry_api_put.label = "更新 schema"
