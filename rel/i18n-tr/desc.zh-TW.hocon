emqx_cluster_link_api.update_config_failed.desc = "更新設定失敗。"
emqx_cluster_link_api.update_config_failed.label = "更新設定失敗"
emqx_cluster_link_schema.clientid.desc = "可選的基礎 MQTT 用戶端 ID，用於連線到遠端 EMQX 叢集。如果省略，將使用本地的 `cluster.name`。EMQX 在互相連線的叢集之間維持多個連線，因此基礎用戶端 ID 會自動新增不同的字尾。"
emqx_cluster_link_schema.clientid.label = "基礎用戶端 ID"
emqx_cluster_link_schema.enable.desc = "啟用或停用叢集連線。預設情況下啟用連線，停用允許停止連線而無需移除其設定。連線必須在兩個叢集上啟用才能正常工作。停用連線也應在兩個叢集上進行，以釋放所有相關資源。"
emqx_cluster_link_schema.enable.label = "啟用"
emqx_cluster_link_schema.link.desc = "叢集連線設定"
emqx_cluster_link_schema.link.label = "叢集連線"
emqx_cluster_link_schema.link_name.desc = "連線（遠端）叢集名稱。必須與遠端叢集中設定的 `cluster.name` 值完全相同。不得與本地的 cluster.name 相同。所有設定的叢集連線名稱必須唯一。"
emqx_cluster_link_schema.link_name.label = "連線的叢集名稱"
emqx_cluster_link_schema.links.desc = "已連線的 EMQX 叢集列表。"
emqx_cluster_link_schema.links.label = "連線的叢集"
emqx_cluster_link_schema.max_inflight.desc = "MQTT 協定的最大待處理（已傳送但未確認）訊息數。"
emqx_cluster_link_schema.max_inflight.label = "最大待處理訊息"
emqx_cluster_link_schema.password.desc = "用於連線到遠端 EMQX 叢集的 MQTT 密碼（可選）。<br/>\n如需從檔案載入密碼而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為密碼使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_cluster_link_schema.password.label = "密碼"
emqx_cluster_link_schema.pool_size.desc = "將向連線的 EMQX broker 發布訊息的 MQTT 用戶端池的大小。"
emqx_cluster_link_schema.pool_size.label = "連線池大小"
emqx_cluster_link_schema.retry_interval.desc = "在未收到 ACK 的情況下，MQTT 橋接器重試傳送 QoS1/QoS2 訊息的延遲。"
emqx_cluster_link_schema.retry_interval.label = "重試間隔"
emqx_cluster_link_schema.server.desc = "遠端 EMQX broker 的 MQTT 主機和連接埠。\n可以提供以逗號分隔的 `host[:port]` 地址列表。\n該連結的每個連線會依次優先選用其中一個地址，無法連線時故障轉移到其他地址。"
emqx_cluster_link_schema.server.label = "MQTT 伺服器"
emqx_cluster_link_schema.ssl.desc = "用於連線到遠端 EMQX 叢集的 SSL 設定。"
emqx_cluster_link_schema.ssl.label = "SSL 選項"
emqx_cluster_link_schema.tcp_opts.desc = "用於出站叢集鏈路 MQTT 連線的 TCP socket 選項。\n所有欄位均為可選；未設定的欄位將保留 OS / `gen_tcp` 預設值。"
emqx_cluster_link_schema.tcp_opts.label = "TCP 選項"
emqx_cluster_link_schema.topics.desc = "將由連線的遠端 EMQX broker 轉發到本地 broker 的 MQTT 主題。只有當本地 EMQX 有匹配的訂閱者時，訊息才會被轉發。\n支援萬用字元。將一側的主題列表設定為空可以建立單向連線：具有空主題的一側不會接收遠端訊息，但可以根據連線另一側設定的主題將相關訊息轉發給其連線的對端。"
emqx_cluster_link_schema.topics.label = "主題"
emqx_cluster_link_schema.username.desc = "用於連線到遠端 EMQX 叢集的 MQTT 使用者名稱（可選）。"
emqx_cluster_link_schema.username.label = "使用者名稱"
emqx_coap_api.client_bad_response.desc = "用戶端回傳了無效的 CoAP 回覆"
emqx_coap_api.client_bad_response.label = "用戶端回應無效"
emqx_coap_api.client_not_found.desc = "未找到用戶端錯誤"
emqx_coap_api.client_not_found.label = "未找到用戶端"
emqx_coap_api.client_not_response_timeout.desc = "等待用戶端回應逾時"
emqx_coap_api.client_not_response_timeout.label = "用戶端未回應逾時"
emqx_coap_api.content_type.desc = "Payload 類型"
emqx_coap_api.message_id.desc = "訊息 ID"
emqx_coap_api.method.desc = "請求 Method 類型"
emqx_coap_api.missing_required_parameter.desc = "缺少必需參數"
emqx_coap_api.payload.desc = "Payload 內容"
emqx_coap_api.response_code.desc = "應答碼"
emqx_coap_api.send_coap_request.desc = "傳送 CoAP 訊息到指定用戶端"
emqx_coap_api.send_coap_request.label = "傳送 CoAP 請求"
emqx_coap_api.timeout.desc = "回應逾時"
emqx_coap_api.token.desc = "訊息 Token, 可以為空"
emqx_coap_schema.coap.desc = "CoAP 閘道設定。\n使用此閘道將 CoAP 裝置連線到 EMQX MQTT 訊息系統。\n協定參考：RFC 7252 和 CoAP Pub/Sub 草案：\nhttps://core-wg.github.io/coap-pubsub/draft-ietf-core-pubsub.html"
emqx_coap_schema.coap_blockwise.desc = "大負載傳輸設定。\n分塊傳輸將一個大負載拆分為更小的 CoAP 塊。\n除非遇到負載大小或丟包問題，否則使用預設值即可。"
emqx_coap_schema.coap_blockwise_enable.desc = "啟用大負載的分塊傳輸。\n除非所有負載都很小且固定，否則保持啟用。"
emqx_coap_schema.coap_blockwise_exchange_lifetime.desc = "臨時分塊狀態的保留時長。\n過短可能導致慢速傳輸中斷；過長會佔用更多記憶體。"
emqx_coap_schema.coap_blockwise_max_block_size.desc = "每個 CoAP 塊的大小（位元組）。\n較大的值：更少的資料包，但丟包時重傳代價更高。\n較小的值：更多的資料包，但丟包影響更小。"
emqx_coap_schema.coap_blockwise_max_body_size.desc = "重組後的最終負載最大大小。\n超過此大小的訊息將被拒絕以保護記憶體。"
emqx_coap_schema.coap_connection_required.desc = "用戶端是否必須維護連線上下文。\n  - false（預設）：無狀態請求/回應。\n  - true：必須建立、認證並保持用戶端會話。\n僅在裝置流程依賴連線狀態時啟用。"
emqx_coap_schema.coap_heartbeat.desc = "已連線用戶端的最小心跳間隔。\n僅在 <code>connection_required = true</code> 時使用。\n如果心跳間隔大於此值，會話可能被視為離線。"
emqx_coap_schema.coap_notify_type.desc = "轉發已觀察主題訊息時使用的 CoAP 訊息類型。<br/>\n  - non：傳送 NON（更快，無需 ACK）<br/>\n  - con：傳送 CON（可靠，需要 ACK）<br/>\n  - qos：根據 MQTT QoS 自動對映（QoS 0 -> NON，QoS 1/2 -> CON）"
emqx_coap_schema.coap_publish_qos.desc = "CoAP 發布請求未提供 <code>qos</code> 時的預設 MQTT QoS。<br/>\n  - qos0 | qos1 | qos2：使用固定 QoS<br/>\n  - coap：根據訊息類型推導（NON -> qos0，CON -> qos1）"
emqx_coap_schema.coap_subscribe_qos.desc = "CoAP 訂閱請求未提供 <code>qos</code> 時的預設 MQTT QoS。<br/>\n  - qos0 | qos1 | qos2：使用固定 QoS<br/>\n  - coap：根據訊息類型推導（NON -> qos0，CON -> qos1）"
emqx_conf_schema.audit_file_handler_path.desc = "稽核紀錄檔案的名稱。"
emqx_conf_schema.audit_file_handler_path.label = "稽核紀錄檔名"
emqx_conf_schema.audit_handler_level.desc = "稽核紀錄處理程序處理的日誌級別。<br/>\n- 處理時間超過 3 秒的請求將被記錄為 <code>warning</code> 級別日誌。<br/>\n- HTTP 狀態碼在 200-300 之間的 GET 請求記錄為<code>debug</code>日誌。<br/>\n- HTTP 狀態碼在 200-300 之間的非 GET 請求記錄為<code>info</code>日誌。<br/>\n- HTTP 狀態碼在 300-400 之間的請求記錄為<code>warning</code>日誌。<br/>\n- HTTP 狀態碼在 400-500 之間的請求記錄為<code>error</code>日誌。<br/>\n- 預設為 info 級別。"
emqx_conf_schema.audit_handler_level.label = "日誌級別"
emqx_conf_schema.audit_log_cache_size.desc = "將最新的 N 條日誌記錄儲存在資料庫中，以便 `/audit` HTTP API 過濾和檢索日誌資料。\n清理冗餘日誌記錄的間隔保持在 10~20 秒之間。"
emqx_conf_schema.audit_log_cache_size.label = "快取大小"
emqx_conf_schema.audit_log_ignore_high_frequency_request.desc = "忽略高頻請求以避免淹沒稽核紀錄，例如發布/訂閱踢出 http API 請求將被忽略。"
emqx_conf_schema.audit_log_ignore_high_frequency_request.label = "忽略高頻請求"
emqx_conf_schema.authorization.desc = "授權（ACL）。EMQX 支援完整的用戶端存取控制（ACL）。"
emqx_conf_schema.authorization.label = "授權"
emqx_conf_schema.cluster_autoclean.desc = "指定多久之後從叢集中移除離線節點。"
emqx_conf_schema.cluster_autoclean.label = "自動刪除離線節點時間"
emqx_conf_schema.cluster_autoheal.desc = "叢集腦裂自動恢復機制開關。"
emqx_conf_schema.cluster_autoheal.label = "節點腦裂自動修復機制"
emqx_conf_schema.cluster_call_cleanup_interval.desc = "清理過期交易的時間間隔"
emqx_conf_schema.cluster_call_cleanup_interval.label = "清理間隔"
emqx_conf_schema.cluster_call_max_history.desc = "叢集間呼叫最多保留的歷史記錄數。只用於排錯時檢視。"
emqx_conf_schema.cluster_call_max_history.label = "最大歷史記錄"
emqx_conf_schema.cluster_call_retry_interval.desc = "當叢集間呼叫出錯時，多長時間重試一次。"
emqx_conf_schema.cluster_call_retry_interval.label = "重試時間間隔"
emqx_conf_schema.cluster_discovery_strategy.desc = "叢集節點發現方式。可選值為:\n- manual: 使用 <code>emqx ctl cluster</code> 命令管理叢集。<br/>\n- static: 設定靜態節點。設定幾個固定的節點，新節點透過連線固定節點中的某一個來加入叢集。<br/>\n- dns: 使用 DNS A 記錄的方式發現節點。<br/>\n- etcd: 使用 etcd 發現節點。<br/>\n- k8s: 使用 Kubernetes API 發現節點。"
emqx_conf_schema.cluster_discovery_strategy.label = "叢集服務發現策略"
emqx_conf_schema.cluster_dns_name.desc = "指定 DNS A 記錄的名字。emqx 會透過存取這個 DNS A 記錄來取得 IP 地址列表。\n當<code>cluster.discovery_strategy</code> 為 <code>dns</code> 時有效。"
emqx_conf_schema.cluster_dns_name.label = "DNS 名稱"
emqx_conf_schema.cluster_dns_record_type.desc = "DNS 記錄類型。"
emqx_conf_schema.cluster_dns_record_type.label = "DNS 記錄類型"
emqx_conf_schema.cluster_etcd_node_ttl.desc = "指定 etcd 中節點資訊的過期時間。\n當 cluster.discovery_strategy 為 etcd 時，此設定項才有效。"
emqx_conf_schema.cluster_etcd_node_ttl.label = "Etcd 節點過期時間"
emqx_conf_schema.cluster_etcd_prefix.desc = "指定 etcd 路徑的字首。每個節點在 etcd 中都會建立一個路徑:\nv2/keys/<prefix>/<cluster.name>/<node.name> <br/>\n當 cluster.discovery_strategy 為 etcd 時，此設定項才有效。"
emqx_conf_schema.cluster_etcd_prefix.label = "Etcd 路徑字首"
emqx_conf_schema.cluster_etcd_server.desc = "指定 etcd 服務的地址。如有多個服務使用逗號 , 分隔。\n當 cluster.discovery_strategy 為 etcd 時，此設定項才有效。"
emqx_conf_schema.cluster_etcd_server.label = "Etcd 伺服器地址"
emqx_conf_schema.cluster_etcd_ssl.desc = "當使用 TLS 連線 etcd 時的設定選項。\n當 cluster.discovery_strategy 為 etcd 時，此設定項才有效。"
emqx_conf_schema.cluster_etcd_ssl.label = "Etcd SSL 選項"
emqx_conf_schema.cluster_k8s_address_type.desc = "當使用 k8s 方式叢集時，address_type 用來從 Kubernetes 介面的應答裡取得什麼形式的 Host 列表。\n指定 <code>cluster.k8s.address_type</code> 為 <code>ip</code>，則將從 Kubernetes 介面中取得叢集中其他節點\n的 IP 地址。"
emqx_conf_schema.cluster_k8s_address_type.label = "K8s 地址類型"
emqx_conf_schema.cluster_k8s_apiserver.desc = "指定 Kubernetes API Server。如有多個 Server 使用逗號 , 分隔。\n當 cluster.discovery_strategy 為 k8s 時，此設定項才有效。"
emqx_conf_schema.cluster_k8s_apiserver.label = "K8s 服務地址"
emqx_conf_schema.cluster_k8s_namespace.desc = "當使用 k8s 方式並且 cluster.k8s.address_type 指定為 dns 類型時，\n可設定 emqx 節點名的命名空間。與 cluster.k8s.suffix 一起使用用以拼接得到節點名列表。"
emqx_conf_schema.cluster_k8s_namespace.label = "K8s 命名空間"
emqx_conf_schema.cluster_k8s_service_name.desc = "指定 Kubernetes 中 EMQX 的服務名。\n當 cluster.discovery_strategy 為 k8s 時，此設定項才有效。"
emqx_conf_schema.cluster_k8s_service_name.label = "K8s 服務別名"
emqx_conf_schema.cluster_k8s_suffix.desc = "當使用 k8s 方式並且 cluster.k8s.address_type 指定為 dns 類型時，可設定 emqx 節點名的字尾。\n與 cluster.k8s.namespace 一起使用用以拼接得到節點名列表。"
emqx_conf_schema.cluster_k8s_suffix.label = "K8s 字首"
emqx_conf_schema.cluster_name.desc = "EMQX 叢集的友好名稱。\n注意：叢集名稱只能包含 `a-z`、`A-Z`、`0-9`、`_`、`-` 中的字元，並且第一個字元必須是 `a-z` 或 `A-Z`，\n否則您將無法將其設定為叢集連線的對等叢集。"
emqx_conf_schema.cluster_name.label = "叢集名稱"
emqx_conf_schema.cluster_proto_dist.desc = "分散式 Erlang 叢集協定類型。可選值為:<br/>\n- inet_tcp: 使用 IPv4 <br/>\n- inet_tls: 使用 TLS，需要配合 <code>etc/ssl_dist.conf</code> 一起使用。<br/>\n- inet6_tcp: IPv6 TCP <br/>\n- inet6_tls: IPv6 TLS， 與 <code>etc/ssl_dist.conf</code> 配合使用。"
emqx_conf_schema.cluster_proto_dist.label = "叢集內部通訊協定"
emqx_conf_schema.cluster_quic_lb_mode.desc = "QUIC stack 負載均衡模式\n- 0: 停用 (預設)\n- 1: server_ip\n- 2: server_id_fixed\n- N：當 N > 2 時，使用 server_id_fixed 且 server_id 為 N\n- IfName：當 IfName 為字串時，server_id 將設定為 IfName 介面上的第一個 IP 地址，僅支援 IPv4。"
emqx_conf_schema.cluster_quic_lb_mode.label = " QUIC stack 負載均衡模式 "
emqx_conf_schema.cluster_static_seeds.desc = "叢集中的 EMQX 節點名稱列表，\n指定固定的節點列表，多個節點間使用逗號 , 分隔。\n當 cluster.discovery_strategy 為 static 時，此設定項才有效。\n適合於節點數量較少且固定的叢集。"
emqx_conf_schema.cluster_static_seeds.label = "叢集靜態節點"
emqx_conf_schema.common_handler_chars_limit.desc = "設定單個日誌訊息的最大長度。 如果超過此長度，則日誌訊息將被截斷。最小可設定的長度為 100。\n注意：如果日誌格式為 JSON，限制字元長度可能會導致截斷不完整的 JSON 資料。"
emqx_conf_schema.common_handler_chars_limit.label = "單條日誌長度限制"
emqx_conf_schema.common_handler_drop_mode_qlen.desc = "當緩衝的日誌事件數大於此值時，新的日誌事件將被丟棄。起到過載保護的功能。\n為了使過載保護演算法正常工作必須要：<code> sync_mode_qlen =< drop_mode_qlen =< flush_qlen </code> 且 drop_mode_qlen > 1\n要停用某些模式，請執行以下操作。\n- 如果 sync_mode_qlen 被設定為 0，所有的日誌事件都被同步處理。也就是說，非同步日誌被停用。\n- 如果 sync_mode_qlen 被設定為與 drop_mode_qlen 相同的值，同步模式被停用。也就是說，處理程式總是以非同步模式執行，除非呼叫 drop 或 flushing。\n- 如果 drop_mode_qlen 被設定為與 flush_qlen 相同的值，則 drop 模式被停用，永遠不會發生。"
emqx_conf_schema.common_handler_drop_mode_qlen.label = "進入丟棄模式的佇列長度"
emqx_conf_schema.common_handler_enable.desc = "啟用此日誌處理程序。"
emqx_conf_schema.common_handler_enable.label = "啟用日誌處理程序"
emqx_conf_schema.common_handler_flush_qlen.desc = "如果緩衝日誌事件的數量增長大於此閾值，則會發生沖刷（刪除）操作。 日誌處理程序會丟棄緩衝的日誌訊息。\n來緩解自身不會由於記憶體瀑漲而影響其它業務行程。日誌內容會提醒有多少事件被刪除。"
emqx_conf_schema.common_handler_flush_qlen.label = "沖刷閾值"
emqx_conf_schema.common_handler_formatter.desc = "選擇日誌格式類型。 <code>text</code> 用於純文字，<code>json</code> 用於結構化日誌記錄。"
emqx_conf_schema.common_handler_formatter.label = "日誌格式類型"
emqx_conf_schema.common_handler_level.desc = "目前日誌處理程序的日誌級別。\n預設為 warning 級別。"
emqx_conf_schema.common_handler_level.label = "日誌級別"
emqx_conf_schema.common_handler_max_depth.desc = "Erlang 內部格式日誌格式化和 Erlang 行程訊息佇列檢查的最大深度。"
emqx_conf_schema.common_handler_max_depth.label = "最大深度"
emqx_conf_schema.common_handler_single_line.desc = "如果設定為 true，則單行列印日誌。 否則，日誌訊息可能跨越多行。"
emqx_conf_schema.common_handler_single_line.label = "單行模式"
emqx_conf_schema.common_handler_supervisor_reports.desc = "Supervisor 報告的類型。預設為 error 類型。<br/>\n  - <code>error</code>：僅記錄 Erlang 行程中的錯誤。\n  - <code>progress</code>：除了 error 資訊外，還需要記錄行程啟動的詳細資訊。"
emqx_conf_schema.common_handler_supervisor_reports.label = "報告類型"
emqx_conf_schema.common_handler_sync_mode_qlen.desc = "只要緩衝的日誌事件的數量低於這個值，所有的日誌事件都會被非同步處理。\n這意味著，日誌落地速度不會影響正常的業務行程，因為它們不需要等待日誌處理程序的回應。\n如果訊息佇列的增長超過了這個值，處理程式開始同步處理日誌事件。也就是說，傳送事件的用戶端行程必須等待回應。\n當處理程式將訊息佇列減少到低於 sync_mode_qlen 閾值的水平時，非同步操作就會恢復。\n預設為 100 條資訊，當等待的日誌事件大於 100 條時，就開始同步處理日誌。"
emqx_conf_schema.common_handler_sync_mode_qlen.label = "進入非同步模式的佇列長度"
emqx_conf_schema.common_handler_time_offset.desc = "日誌中的時間戳使用的時間偏移量。\n可選值為：\n  - <code>system</code>: 本地系統使用的時區偏移量\n  - <code>utc</code>: 0 時區的偏移量\n  - <code>+-[hh]:[mm]</code>: 自訂偏移量，例如 \"-02:00\" 或者 \"+00:00\"\n預設值為本地系統的時區偏移量：<code>system</code>。"
emqx_conf_schema.common_handler_time_offset.label = "時間偏移量"
emqx_conf_schema.common_handler_timestamp_format.desc = "選擇時間戳格式：\n- `auto`：自動選擇最佳格式。`epoch` 給 JSON 日誌 `rfc3339` 給自由文字格式。\n- `epoch`： 微秒精度的 Unix epoch 整形值。\n- `rfc3339`： 遵從 RFC3339 規範的字串格式。"
emqx_conf_schema.common_handler_timestamp_format.label = "時間戳格式"
emqx_conf_schema.db_backend.desc = "設定後端資料庫驅動，預設值為 <code>rlog</code> 它適用於大規模的叢集。\n<code>mnesia</code> 是備選資料庫，適合中小叢集。"
emqx_conf_schema.db_backend.label = "內建資料庫"
emqx_conf_schema.db_default_bootstrap_batch_size.desc = "在引導過程中，從核心節點向複製節點推送的內建資料庫表記錄的批次數量。\n引導是在當新的複製節點新增到叢集中或現有的複製節點重新連線到核心節點時發生的。\n增加此值可能會大大縮短複製節點的啟動時間，特別是在 EMQX 叢集互連網路延遲較高且 EMQX 內建資料庫儲存大量資料（例如訂閱量很高時）的情況下\n預設值為 500。"
emqx_conf_schema.db_default_bootstrap_batch_size.label = "預設引導批次大小"
emqx_conf_schema.db_default_shard_transport.desc = "定義用於推送交易日誌的預設傳輸。<br/>\n這可以在 <code>db.shard_transports</code> 中基於每個分片被覆寫。\n<code>gen_rpc</code> 使用 <code>gen_rpc</code> 庫，\n<code>distr</code> 使用 Erlang 發行版。"
emqx_conf_schema.db_default_shard_transport.label = "交易日誌傳輸預設協定"
emqx_conf_schema.db_role.desc = "選擇節點的角色。<br/>\n<code>core</code> 節點提供資料的永續性，並負責寫入。建議將核心節點放置在不同的機架或不同的可用區。<br/>\n<code>replicant</code> 節點是臨時工作節點。 從叢集中刪除它們，不影響資料庫冗餘<br/>\n建議複製節點多於核心節點。<br/>\n注意：該參數僅在設定<code>backend</code>時生效到 <code>rlog</code>。"
emqx_conf_schema.db_role.label = "資料庫角色"
emqx_conf_schema.db_rpc_module.desc = "叢集間推送交易日誌到複製節點使用的協定。"
emqx_conf_schema.db_rpc_module.label = "RPC 協定"
emqx_conf_schema.db_shard_transports.desc = "允許為每個 shard 下的交易日誌複製操作的傳輸方法進行調優。<br/>\n<code>gen_rpc</code> 使用 <code>gen_rpc</code> 庫，\n<code>distr</code> 使用 Erlang 自帶的 rpc 庫。<br/>如果未指定，\n預設是使用 <code>db.default_shard_transport</code> 中設定的值。"
emqx_conf_schema.db_shard_transports.label = "交易日誌傳輸協定"
emqx_conf_schema.db_tlog_push_mode.desc = "同步模式下，核心節點等待複製節點的確認資訊，然後再傳送下一條交易日誌。"
emqx_conf_schema.db_tlog_push_mode.label = "Tlog 推送模式"
emqx_conf_schema.desc_audit_log_handler.desc = "將日誌時間輸出到檔案的稽核紀錄處理程序。"
emqx_conf_schema.desc_audit_log_handler.label = "稽核紀錄處理程序"
emqx_conf_schema.desc_authorization.desc = "授權相關"
emqx_conf_schema.desc_authorization.label = "授權"
emqx_conf_schema.desc_cluster.desc = "EMQX 節點可以組成一個叢集，以提高總容量。<br/> 這裡指定了節點之間如何連線。"
emqx_conf_schema.desc_cluster.label = "叢集"
emqx_conf_schema.desc_cluster_call.desc = "叢集呼叫功能的選項。"
emqx_conf_schema.desc_cluster_call.label = "叢集呼叫"
emqx_conf_schema.desc_cluster_dns.desc = "DNS SRV 記錄服務發現。"
emqx_conf_schema.desc_cluster_dns.label = "DNS SRV 記錄服務發現"
emqx_conf_schema.desc_cluster_etcd.desc = "使用 'etcd' 服務的服務發現。"
emqx_conf_schema.desc_cluster_etcd.label = "'etcd' 服務的服務發現"
emqx_conf_schema.desc_cluster_k8s.desc = "Kubernetes 服務發現。"
emqx_conf_schema.desc_cluster_k8s.label = "Kubernetes 服務發現"
emqx_conf_schema.desc_cluster_static.desc = "靜態節點服務發現。新節點透過連線一個節點來加入叢集。"
emqx_conf_schema.desc_cluster_static.label = "靜態節點服務發現"
emqx_conf_schema.desc_console_handler.desc = "日誌處理程序將日誌事件列印到 EMQX 控制台。"
emqx_conf_schema.desc_console_handler.label = "控制台處理程序"
emqx_conf_schema.desc_db.desc = "內建資料庫的設定。"
emqx_conf_schema.desc_db.label = "資料庫"
emqx_conf_schema.desc_durable_timers.desc = "持久化定時器的設定。\n持久化定時器用於排程即使建立它們的節點關閉也應發生的動作。"
emqx_conf_schema.desc_durable_timers.label = "持久化定時器"
emqx_conf_schema.desc_log.desc = "EMQX 支援多個日誌處理器，包括一個控制台處理器和多個檔案處理器。\n預設情況下，EMQX 在 Docker 環境或控制台/前台模式下執行時會輸出日誌到控制台，\n否則會將日誌輸出到檔案 `${EMQX_LOG_DIR}/emqx.log.N`。\n對於高階設定，您可以在此部分找到更多參數。"
emqx_conf_schema.desc_log.label = "日誌"
emqx_conf_schema.desc_log_burst_limit.desc = "短時間內產生的大量日誌事件可能會導致問題，例如：\n  - 日誌檔案變得非常大\n  - 日誌檔案輪換過快，有用資訊被覆寫\n  - 對系統的整體效能影響\n\n日誌突發限制功能可以暫時停用日誌記錄以避免這些問題。"
emqx_conf_schema.desc_log_burst_limit.label = "日誌突發限制"
emqx_conf_schema.desc_log_file_handler.desc = "日誌處理程序將日誌事件列印到檔案。"
emqx_conf_schema.desc_log_file_handler.label = "檔案日誌處理程序"
emqx_conf_schema.desc_log_overload_kill.desc = "日誌過載終止，具有過載保護功能。當日志處理程序使用過多記憶體，或者快取的日誌訊息過多時該功能被啟用。<br/>\n檢測到過載時，日誌處理程序將終止，並在冷卻期後重新啟動。"
emqx_conf_schema.desc_log_overload_kill.label = "日誌過載保護"
emqx_conf_schema.desc_log_rotation.desc = "預設情況下，日誌儲存在 `./log` 目錄（用於從 zip 檔案安裝）或 `/var/log/emqx`（用於二進位制安裝）。<br/>\n這部分設定，控制每個日誌處理程序保留的檔案數量。"
emqx_conf_schema.desc_log_rotation.label = "日誌輪換"
emqx_conf_schema.desc_log_throttling.desc = "日誌限流功能透過在設定的時間視窗內丟棄除第一個事件外的所有事件，來減少可能氾濫的日誌事件數量。\n如果 `console` 或 `file` 日誌級別設定為 debug，則自動停用限流。"
emqx_conf_schema.desc_log_throttling.label = "日誌限流"
emqx_conf_schema.desc_node.desc = "節點名稱、Cookie、設定檔、資料目錄和 Erlang 虛擬機器（BEAM）啟動參數。"
emqx_conf_schema.desc_node.label = "節點"
emqx_conf_schema.desc_rpc.desc = "EMQX 使用 <code>gen_rpc</code> 庫來實現跨節點通訊。<br/>\n大多數情況下，預設的設定應該可以工作，但如果你需要做一些效能最佳化或者實驗，可以嘗試調整這些參數。"
emqx_conf_schema.desc_rpc.label = "RPC"
emqx_conf_schema.dirty_io_schedulers.desc = "轉換為 Erlang VM 的 `+SDio` 標誌，設定要建立的髒 I/O 排程器執行緒數。\n\n當設定為 `auto`（預設）時，EMQX 根據 `node.schedulers` 推導此值：\n當 `node.schedulers` 解析為大於 2 的值時為 8（歷史上的固定預設值），否則為 4。\n髒 I/O 排程器執行緒執行阻塞式 I/O 任務（檔案操作和部分 NIF），因此小型節點仍保留足夠的執行緒來並行處理阻塞呼叫，同時無需承擔完整預設值帶來的執行緒記憶體開銷。\n\n設定為正整數可覆寫推匯出的值。"
emqx_conf_schema.dirty_io_schedulers.label = "Erlang 髒 I/O 排程器"
emqx_conf_schema.dist_buffer_size.desc = "Erlang 分散式緩衝區的繁忙閾值，單位是 KB。"
emqx_conf_schema.dist_buffer_size.label = "Erlang 分散式緩衝區的繁忙閾值(KB)"
emqx_conf_schema.dist_connect_options.desc = "Erlang 分發連接埠的連線選項，用於效能調優。\n定義連線其他分散式 Erlang 節點時要使用的一組額外 socket 選項。\n參見 https://www.erlang.org/doc/apps/kernel/gen_tcp.html#connect/4"
emqx_conf_schema.dist_connect_options.label = "Erlang 分發連接埠連線選項"
emqx_conf_schema.dist_listen_options.desc = "Erlang 分發監聽連接埠選項，用於效能調優。\n定義為分散式 Erlang 節點開啟監聽 socket 時要使用的一組額外 socket 選項。\n參見 https://www.erlang.org/doc/apps/kernel/gen_tcp.html#listen/2"
emqx_conf_schema.dist_listen_options.label = "Erlang 分發監聽連接埠選項"
emqx_conf_schema.durable_timer_batch_size.desc = "指定用於讀取 `timers` 持久儲存的批處理大小。"
emqx_conf_schema.durable_timer_batch_size.label = "持久定時器批處理大小"
emqx_conf_schema.durable_timer_heartbeat_interval.desc = "節點心跳間隔指定節點在 `timers` 持久儲存中記錄其存在的頻率。\n此設定應在叢集中的所有節點上相同。"
emqx_conf_schema.durable_timer_heartbeat_interval.label = "心跳間隔"
emqx_conf_schema.durable_timer_missed_heartbeats.desc = "如果節點未能達到此數量的心跳，其對等節點將認為它已關閉。"
emqx_conf_schema.durable_timer_missed_heartbeats.label = "錯過的心跳"
emqx_conf_schema.durable_timer_retry_interval.desc = "如果節點未能從持久儲存中取得定時器，它將在此間隔後重試。"
emqx_conf_schema.durable_timer_retry_interval.label = "持久定時器重試間隔"
emqx_conf_schema.log_audit_handler.desc = "稽核紀錄檔案處理程序"
emqx_conf_schema.log_audit_handler.label = "稽核紀錄處理程序"
emqx_conf_schema.log_burst_limit_enable.desc = "啟用日誌限流保護機制。"
emqx_conf_schema.log_burst_limit_enable.label = "日誌限流保護"
emqx_conf_schema.log_burst_limit_max_count.desc = "在 `window_time` 間隔內處理的最大日誌事件數。 達到限制後，將丟棄連續事件，直到 `window_time` 結束。"
emqx_conf_schema.log_burst_limit_max_count.label = "日誌事件數"
emqx_conf_schema.log_burst_limit_window_time.desc = "參考 <code>max_count</code>。"
emqx_conf_schema.log_burst_limit_window_time.label = "視窗時間"
emqx_conf_schema.log_file_handler_file.desc = "日誌檔案路徑及名字。"
emqx_conf_schema.log_file_handler_file.label = "日誌檔名字"
emqx_conf_schema.log_file_handler_max_size.desc = "此參數控制日誌檔案輪換。 `infinity` 意味著日誌檔案將無限增長，否則日誌檔案將在達到 `max_size`（以位元組為單位）時進行輪換。\n與 rotation count 配合使用。如果 counter 為 10，則是 10 個檔案輪換。"
emqx_conf_schema.log_file_handler_max_size.label = "日誌檔案輪換大小"
emqx_conf_schema.log_file_handlers.desc = "輸出到檔案的日誌處理程序列表"
emqx_conf_schema.log_file_handlers.label = "檔案日誌處理程序"
emqx_conf_schema.log_overload_kill_enable.desc = "日誌處理程序過載時為保護自己節點其它的業務能正常，強制殺死日誌處理程序。"
emqx_conf_schema.log_overload_kill_enable.label = "日誌處理程序過載保護"
emqx_conf_schema.log_overload_kill_mem_size.desc = "日誌處理程序允許使用的最大記憶體。"
emqx_conf_schema.log_overload_kill_mem_size.label = "日誌處理程序允許使用的最大記憶體"
emqx_conf_schema.log_overload_kill_qlen.desc = "允許的最大佇列長度。"
emqx_conf_schema.log_overload_kill_qlen.label = "最大佇列長度"
emqx_conf_schema.log_overload_kill_restart_after.desc = "處理程序停止後，會在該延遲時間後自動重新啟動。除非該值設定為 <code>infinity</code>，這會阻止任何後續的重啟。"
emqx_conf_schema.log_overload_kill_restart_after.label = "處理程序重啟延遲"
emqx_conf_schema.log_root.desc = "EMQX 支援兩種主要的日誌處理程序：file 和 console，另有一個專門設計用於始終將日誌定向到檔案的 audit 處理程序。\n系統的預設日誌處理行為可以透過環境變數 `EMQX_DEFAULT_LOG_HANDLER` 設定，它接受以下設定：\n\n- file：將日誌輸出僅定向到檔案。\n- console：將日誌輸出僅定向到控制台。\n\n值得注意的是，當透過 systemd 的 emqx.service 檔案啟動 EMQX 時，EMQX_DEFAULT_LOG_HANDLER 被設定為 file。\n在 systemd 啟動之外的場景中，console 作為預設的日誌處理程序。"
emqx_conf_schema.log_root.label = "日誌"
emqx_conf_schema.log_rotation_count.desc = "輪換的最大日誌檔案數。"
emqx_conf_schema.log_rotation_count.label = "最大日誌檔案數"
emqx_conf_schema.log_rotation_enable.desc = "啟用日誌輪換功能。啟動後生成日誌檔案字尾會加上對應的索參數字，例如：log/emqx.log.1。\n系統會預設生成<code>*.siz/*.idx</code>用於記錄日誌位置，請不要手動修改這兩個檔案。"
emqx_conf_schema.log_rotation_enable.label = "日誌輪換"
emqx_conf_schema.log_throttling.desc = "日誌限流設定。"
emqx_conf_schema.log_throttling.label = "日誌限流"
emqx_conf_schema.log_throttling_time_window.desc = "此設定控制限流訊息的日誌記錄行為，包括但不限於像 'authorization_permission_denied' 這樣的訊息。\n在每個定義的時間視窗內，只有一個限流訊息的實例會被記錄，以防止日誌氾濫。\n在每個時間視窗結束時，將生成一個摘要日誌，詳細說明該期間內任何限流訊息的發生。\n重要的是，此設定的最短有效時間視窗為 1 秒（1s）。\n如果指定的值低於 1s，則會自動調整為 1s。"
emqx_conf_schema.log_throttling_time_window.label = "日誌限流時間視窗"
emqx_conf_schema.max_ets_tables.desc = "Erlang ETS 表的最大數量"
emqx_conf_schema.max_ets_tables.label = "Erlang 表的最大數量"
emqx_conf_schema.max_ports.desc = "轉換為 Erlang VM 的 `+Q` 標誌。\n指定此 Erlang 系統允許同時開啟的最大連接埠數（檔案、socket 等）。\n\n當設定為 `auto`（預設）時，EMQX 會根據可用邏輯 CPU 數自動調整限制，每個核心 65536 個連接埠，最多 8 核；超過 8 核的主機將回退到固定的 1048576 連接埠限制。\n\n注意：執行時選擇的實際限制可能大於此處設定的數值。\n在大多數情況下，為了提高內部效率，VM 會將該值向上取整為下一個 2 的冪。\n\nEMQX 會自動將 Erlang 行程限制（`+P` 標誌）設定為該值的 2 倍，因此使用者只需設定 `max_ports`。2 倍比例可滿足 TLS/QUIC 連線的需求，因為每個連線使用兩個 Erlang 行程。\n對應的 `+P` 標誌用於控制 Erlang 行程的最大數量。\n\n可以從儀表板節點監控標籤頁中觀察到有效值。"
emqx_conf_schema.max_ports.label = "Erlang 連接埠和行程限制"
emqx_conf_schema.node_applications.desc = "當新 EMQX 加入叢集時，應重啟的 Erlang 應用程式的列表。"
emqx_conf_schema.node_applications.label = "應用"
emqx_conf_schema.node_backtrace_depth.desc = "錯誤資訊中列印的最大堆疊層數"
emqx_conf_schema.node_backtrace_depth.label = "最大堆疊導數"
emqx_conf_schema.node_broker_pool_size.desc = "emqx_broker 池中的工作行程數量。增加此值可能會因增強並行性而提高效能\n， 尤其在 EMQX 叢集的互連網路延遲較高時。\n預設值為 Erlang 排程程式的數量（CPU 核心數）* 2。"
emqx_conf_schema.node_broker_pool_size.label = "節點 broker 池大小"
emqx_conf_schema.node_channel_cleanup_batch_size.desc = "通道清理批處理的大小。 如果 EMQX 叢集互連網路延遲較高，\n減小此值以及增加 node.generic_pool_size\n可能會在大量用戶端突然斷開連線時提高效能。\n預設值為 100000。"
emqx_conf_schema.node_channel_cleanup_batch_size.label = "節點通道清理批處理大小"
emqx_conf_schema.node_cookie.desc = "分散式 Erlang 叢集使用的 cookie 值。叢集間保持一致"
emqx_conf_schema.node_cookie.label = "節點 Cookie"
emqx_conf_schema.node_crash_dump_bytes.desc = "限制崩潰檔案的大小，當崩潰時節點記憶體太大，\n如果為了儲存現場，需要全部存到崩潰檔案中，此處限制最多能儲存多大的檔案。\n如果超過此限制，崩潰轉儲將被截斷。如果設定為 0，系統不會嘗試寫入崩潰轉儲檔案。"
emqx_conf_schema.node_crash_dump_bytes.label = "崩潰檔案最大大小"
emqx_conf_schema.node_crash_dump_file.desc = "設定 Erlang crash_dump 檔案的儲存路徑和檔名。預設為 <code>log/erl_crash.YYYY.MM.DD.HH.MM.SS.dump</code>。\n時間戳是在 EMQX 啟動時生成的。"
emqx_conf_schema.node_crash_dump_file.label = "節點崩潰時的 Dump 檔案"
emqx_conf_schema.node_crash_dump_seconds.desc = "該設定給出了執行時系統允許花費的寫入崩潰轉儲的秒數。當給定的秒數已經過去，執行時系統將被終止。<br/>\n- 如果設定為 0 秒，執行時會立即終止，不會嘗試寫入崩潰轉儲檔案。<br/>\n- 如果設定為一個正數 S，節點會等待 S 秒來完成崩潰轉儲檔案，然後用 SIGALRM 訊號終止執行時系統。<br/>\n- 如果設定為一個負值導致執行時系統的終止等待無限期地直到崩潰轉儲檔案已經完全寫入。"
emqx_conf_schema.node_crash_dump_seconds.label = "儲存崩潰檔案最長時間"
emqx_conf_schema.node_data_dir.desc = "節點資料存放目錄，可能會自動建立的子目錄如下：<br/>\n- `mnesia/<node_name>`。EMQX 的內建資料庫目錄。例如，`mnesia/emqx@127.0.0.1`。<br/>\n如果節點要被重新命名（例如，`emqx@10.0.1.1`）。舊目錄應該首先被刪除。<br/>\n- `configs`。在啟動時生成的設定，以及叢集/本地覆寫的設定。<br/>\n- `patches`: 熱補丁檔案將被放在這裡。<br/>\n- `trace`: 日誌追蹤檔案。<br/>\n\n**注意**: 一個資料 dir 不能被兩個或更多的 EMQX 節點同時使用。"
emqx_conf_schema.node_data_dir.label = "節點資料目錄"
emqx_conf_schema.node_default_listener_address.desc = "用於未顯式指定地址的監聽器繫結，即形如 <code>bind = 1883</code> 的純連接埠繫結。適用於 MQTT 監聽器、\n閘道監聽器以及儀表板 HTTP 監聽器。顯式的 <code>IP:port</code> 繫結始終優先。<br/>\n有效取值：<br/>\n- <code>loopback</code>：繫結 127.0.0.1。當儀表板啟用 inet6 選項時，改為繫結 ::1。<br/>\n- <code>nodename</code>：取 Erlang 節點名中 @ 之後的主機部分。如果它是 IP 地址，則直接繫結；否則在啟動時解析，\n繫結第一個 IPv4 地址，若未解析出 IPv4 地址則繫結第一個 IPv6 地址。<br/>\n- <code>all</code>：繫結 0.0.0.0，即所有 IPv4 網路介面。<br/>\n- 字面 IPv4 或 IPv6 地址，例如 <code>192.168.1.10</code> 或 <code>::1</code>。在多數系統上，地址 <code>::</code>\n同時接受 IPv4 和 IPv6 連線；具體由作業系統的 bindv6only 設定決定。<br/>\n- 主機名，例如 <code>broker1.example.com</code>，與節點名主機部分一樣在啟動時解析。<br/>\n未設定時，由安全設定檔決定預設地址：legacy 繫結所有網路介面，hardened 繫結迴環地址。EMQX 僅在啟動時讀取該值；\n修改後需重啟節點。"
emqx_conf_schema.node_default_listener_address.label = "預設監聽地址"
emqx_conf_schema.node_dist_bind_address.desc = "指定用於 Erlang 分散式通訊的 IP 地址。\n這應為 IP 地址（例如 IPv4 的 \"192.168.1.100\" 或 IPv6 的 \"::1\"）。\n設定後，Erlang 分散式通訊將繫結到指定的 IP 地址。\n注意：如果使用 IPv6 地址，必須將 <code>cluster.proto_dist</code> 設定為 <code>inet6_tcp</code>。"
emqx_conf_schema.node_dist_bind_address.label = "分散式繫結地址"
emqx_conf_schema.node_dist_net_ticktime.desc = "系統調優參數，此設定將覆寫 vm.args 檔案裡的 -kernel net_ticktime 參數。當一個節點持續無回應多久之後，認為其已經宕機並斷開連線。"
emqx_conf_schema.node_dist_net_ticktime.label = "節點間心跳間隔"
emqx_conf_schema.node_etc_dir.desc = "<code>etc</code> 存放目錄"
emqx_conf_schema.node_etc_dir.label = "Etc 目錄"
emqx_conf_schema.node_generic_pool_size.desc = "emqx_pool 中的工作行程數。增加此值可能會透過增強並行性提高效能，\n特別是當 EMQX 叢集互連網路延遲較高時。\n預設值為 Erlang 排程器（CPU 核心數）的數量。"
emqx_conf_schema.node_generic_pool_size.label = "節點通用池大小"
emqx_conf_schema.node_global_gc_interval.desc = "全域垃圾回收的週期性執行間隔。設定為 <code>disabled</code> 可停用此功能。<br/>僅當 EMQX 的記憶體使用持續增長且明顯超過正常水平，並且手動觸發垃圾回收確實能釋放大量記憶體時，才建議使用此功能作為臨時解決方案。"
emqx_conf_schema.node_global_gc_interval.label = "全域垃圾回收"
emqx_conf_schema.node_name.desc = "節點名。格式為 \\<name>@\\<host>。其中 <host> 可以是 IP 地址，也可以是 FQDN。\n詳見 http://erlang.org/doc/reference_manual/distributed.html。"
emqx_conf_schema.node_name.label = "節點名"
emqx_conf_schema.node_tls_server_session_ticket_lifetime.desc = "伺服器傳送的會話票據的生命週期，以秒為單位。伺服器不得使用超過 604800 秒（7 天）的值。預設值為 7200 秒（2 小時）。"
emqx_conf_schema.node_tls_server_session_ticket_lifetime.label = "TLS 伺服器會話票據生命週期"
emqx_conf_schema.node_tls_server_session_tickets_amount.desc = "在成功握手或恢復後，伺服器傳送的會話票據數量。必須大於 0。預設值為 1。\n\nEMQX 僅支援無狀態會話票據。設定較大的數量會增加資源使用，尤其是在監聽器 SSL 選項中啟用 <code>stateless_with_cert</code> 時，會增加網路頻寬使用，因為每個票據都包含憑證資訊。"
emqx_conf_schema.node_tls_server_session_tickets_amount.label = "TLS 伺服器會話票據數量"
emqx_conf_schema.node_tls_stateless_tickets_seed.desc = "用於生成 TLS 1.3 無狀態會話票據的金鑰種子。必須是長度不少於 16 位元組的字串。\n\n如果設定為空字串（預設），無論監聽器 SSL 選項中的 <code>session_tickets</code> 設定如何，都不會生成會話票據。\n\n重要提示：\n\n- 此設定無法在執行時更改。更改後需要重啟節點以使設定生效。\n- 叢集中的所有節點必須設定相同的金鑰，以確保會話票據在叢集中正常工作。\n- 該金鑰應保持機密和安全，因為它用於加密會話票據。"
emqx_conf_schema.node_tls_stateless_tickets_seed.label = "TLS 無狀態票據種子"
emqx_conf_schema.process_limit.desc = "覆寫 Erlang `+P`（最大行程數）標誌。\n預設情況下，EMQX 會從 `max_ports`（2 倍）推導此值，適用於絕大多數工作負載。僅當該設定嚴格大於推導值時才會生效；較小的值會被忽略，以確保行程表不會小於連接埠表。"
emqx_conf_schema.process_limit.label = "Erlang 行程限制"
emqx_conf_schema.rpc_async_batch_size.desc = "非同步模式下，傳送的批次訊息的最大數量。"
emqx_conf_schema.rpc_async_batch_size.label = "非同步模式下的批次訊息數量"
emqx_conf_schema.rpc_authentication_timeout.desc = "遠端節點認證的逾時時間。"
emqx_conf_schema.rpc_authentication_timeout.label = "RPC 認證逾時時間"
emqx_conf_schema.rpc_cacertfile.desc = "驗證 <code>rpc.certfile</code> 的 CA 憑證檔案的路徑。<br/>\n注意：叢集中所有節點的憑證必須使用同一個 CA 簽發。"
emqx_conf_schema.rpc_cacertfile.label = "RPC CA 憑證檔案"
emqx_conf_schema.rpc_call_receive_timeout.desc = "同步 RPC 的回覆逾時時間。"
emqx_conf_schema.rpc_call_receive_timeout.label = "RPC 呼叫接收逾時時間"
emqx_conf_schema.rpc_certfile.desc = "TLS 憑證檔案的路徑，用於驗證叢集節點的身分。\n只有當 <code>rpc.driver</code> 設定為 <code>ssl</code> 時，此設定才會生效。"
emqx_conf_schema.rpc_certfile.label = "RPC 憑證檔案"
emqx_conf_schema.rpc_client_num.desc = "設定該節點與每個遠端節點之間發起的最大 RPC 通訊通道數量。"
emqx_conf_schema.rpc_client_num.label = "RPC TCP 用戶端數量"
emqx_conf_schema.rpc_connect_timeout.desc = "建立 RPC 連線的逾時時間。"
emqx_conf_schema.rpc_connect_timeout.label = "RPC 連線逾時時間"
emqx_conf_schema.rpc_driver.desc = "叢集間通訊使用的傳輸協定。"
emqx_conf_schema.rpc_driver.label = "RPC 驅動"
emqx_conf_schema.rpc_ipv6_only.desc = "此設定僅在 <code>rpc.listen_address</code> 被分配了一個 IPv6 地址時有效。\n如果設定為 <code>true</code>，RPC 用戶端將僅使用 IPv6 進行連線。\n否則，即使伺服器位於 IPv6 上，用戶端也可能選擇 IPv4。"
emqx_conf_schema.rpc_ipv6_only.label = "僅使用 IPv6"
emqx_conf_schema.rpc_keyfile.desc = "<code>rpc.certfile</code> 的私鑰檔案的路徑。<br/>\n注意：此檔案內容是私鑰，所以需要設定權限為 600。"
emqx_conf_schema.rpc_keyfile.label = "RPC 私鑰檔案"
emqx_conf_schema.rpc_listen_address.desc = "指示 RPC 伺服器監聽的 IP 地址。例如，使用 <code>\"0.0.0.0\"</code> 表示 IPv4 或 <code>\"::\"</code> 表示 IPv6。"
emqx_conf_schema.rpc_listen_address.label = "RPC 監聽 IP 地址"
emqx_conf_schema.rpc_mode.desc = "在 <code>sync</code> 模式下，傳送端等待接收端的 ack 訊號。"
emqx_conf_schema.rpc_mode.label = "RPC 模式"
emqx_conf_schema.rpc_port_discovery.desc = "<code>manual</code>: 透過 <code>server_port</code> 來發現連接埠。\n<br/><code>stateless</code>: 使用無狀態的方式來發現連接埠，使用如下演算法。如果節點名稱是 <code>\nemqxN@127.0.0.1</code>, N 是一個數字，那麼監聽連接埠就是 5370 + N。\n注意：當 port_discovery 設定為 manual 時，server_port 設定將不起作用。"
emqx_conf_schema.rpc_port_discovery.label = "RPC 連接埠發現策略"
emqx_conf_schema.rpc_send_timeout.desc = "傳送 RPC 請求的逾時時間。"
emqx_conf_schema.rpc_send_timeout.label = "RPC 傳送逾時時間"
emqx_conf_schema.rpc_server_port.desc = "RPC 本地服務使用的監聽連接埠。<br/>\n請注意，此設定僅在 rpc.port_discovery 設定為手動時生效。"
emqx_conf_schema.rpc_server_port.label = "RPC 伺服器連接埠"
emqx_conf_schema.rpc_socket_buffer.desc = "TCP 調節參數。使用者模式套接字緩衝區大小。"
emqx_conf_schema.rpc_socket_buffer.label = "RPC 套接字緩衝區大小"
emqx_conf_schema.rpc_socket_keepalive_count.desc = "對應 TCP_KEEPCNT socket 選項。指定在放棄連線並終止連線之前傳送的最大 TCP keepalive 探測次數，如果未從另一端收到回應，則終止連線。"
emqx_conf_schema.rpc_socket_keepalive_count.label = "RPC Socket Keepalive 次數"
emqx_conf_schema.rpc_socket_keepalive_idle.desc = "對應 TCP_KEEPIDLE socket 選項。指定在 TCP 開始傳送 keepalive 探測包之前，連線需要保持空閒的時間（以秒為單位）。"
emqx_conf_schema.rpc_socket_keepalive_idle.label = "RPC Socket Keepalive 空閒時間"
emqx_conf_schema.rpc_socket_keepalive_interval.desc = "對應 TCP_KEEPINTVL socket 選項。指每次 keepalive 探測之間的時間間隔（以秒為單位）。"
emqx_conf_schema.rpc_socket_keepalive_interval.label = "RPC Socket Keepalive 間隔"
emqx_conf_schema.rpc_socket_recbuf.desc = "TCP 調節參數。TCP 接收緩衝區大小。"
emqx_conf_schema.rpc_socket_recbuf.label = "RPC 套接字接收緩衝區大小"
emqx_conf_schema.rpc_socket_sndbuf.desc = "TCP 調節參數。TCP 傳送緩衝區大小。"
emqx_conf_schema.rpc_socket_sndbuf.label = "RPC 套接字傳送緩衝區大小"
emqx_conf_schema.schedulers.desc = "轉換為 Erlang VM 的 `+S` 標誌，同時設定總排程器數和線上排程器數。\n\n當設定為 `auto`（預設）時，EMQX 使用實際可供 VM 使用的邏輯處理器數量（Linux 上為 `sched_getaffinity`），因此使用 `--cpuset-cpus` 或 k8s CPU 請求限制的容器不會生成無法並行執行的排程器 OS 執行緒。\n\n設定為正整數可覆寫自動檢測值。\n當你希望為同一主機上的非 EMQX 工作預留 CPU 餘量，或將排程器數量限制在可用 CPU 數以下時，該設定很有用。"
emqx_conf_schema.schedulers.label = "Erlang 排程器"
emqx_conf_schema_types.bytesize.desc = "表示位元組數量的字串，例如：<code>10B</code>、<code>640kb</code>、<code>4MB</code>、<code>1GB</code>。單位採用二進位制標準，即 1MB 等於 1024KB。單位不區分大小寫，例如 1kb 等於 1KB。"
emqx_conf_schema_types.duration.desc = "表示時間持續的字串，例如：<code>10s</code>、<code>2.5m</code>、<code>1h30m</code>、<code>1W2D</code> 或 <code>2345ms</code>，其中 <code>ms</code> 是最小單位。每個設定項都有其自己的最小精度。設定值中超過精度的部分將被忽略。\n\n例如，如果一個類型為 <code>Duration(s)</code> 的設定項被設定為 <code>1200ms</code>，則最終有效值將是 <code>1s</code> 而不是 <code>1.2s</code>。\n\nDuration 等同於 Duration(ms)。單位部分不區分大小寫。"
emqx_conf_schema_types.secret.desc = "包含一些敏感資訊的字串，例如密碼。當金鑰以 <code>file://</code> 開頭時，字串的其餘部分將被解釋為包含金鑰本身的檔案路徑：檔案的整個內容（除了任何尾隨的空白字元）都被視為金鑰值。注意：在叢集中，所有 EMQX 節點在使用 <code>file://</code> 金鑰之前應該具有相同的檔案。"
emqx_conf_schema_types.template.desc = "用於`${.path.to.var}`樣式值插值的字串，其中開頭的點是可選的。語法`${.}`表示取值整個物件（包含所有欄位）。"
emqx_connector_aggregator_schema.container.desc = "設定包含聚合事件的上傳檔案格式的設定。"
emqx_connector_aggregator_schema.container.label = "聚合事件容器"
emqx_connector_aggregator_schema.container_csv.desc = "記錄（事件）將被聚合並作為 CSV 檔案上傳。"
emqx_connector_aggregator_schema.container_csv.label = "CSV 容器"
emqx_connector_aggregator_schema.container_csv_column_order.desc = "事件欄位將在生成的 CSV 檔案中按此順序排列為列。<br/>\n無論此設定如何，生成的 CSV 都將包含所有聚合事件的欄位，但所有未在此明確提及的列將在此處列出的列之後按字典順序排列。"
emqx_connector_aggregator_schema.container_csv_column_order.label = "CSV 列順序"
emqx_connector_aggregator_schema.container_json_lines.desc = "記錄（事件）將被聚合並且作為 [JSON Lines](https://jsonlines.org/) 檔案上傳。"
emqx_connector_aggregator_schema.container_json_lines.label = "JSON Lines 容器"
emqx_connector_aggregator_schema.container_parquet.desc = "使用 [Parquet](https://parquet.apache.org/docs/) 編碼資料檔案。"
emqx_connector_aggregator_schema.container_parquet.label = "Parquet 資料檔案"
emqx_connector_aggregator_schema.container_parquet_max_row_group_bytes.desc = "行組重新整理時的大小。行組重新整理的實際觸發使用緩衝資料大小的估計，因為實際輸出可能與原始輸入資料大小不同。"
emqx_connector_aggregator_schema.container_parquet_max_row_group_bytes.label = "Parquet 最大行組位元組數"
emqx_connector_aggregator_schema.parquet_default_compression.desc = "用於壓縮 Parquet 行組中的資料頁的預設演算法。"
emqx_connector_aggregator_schema.parquet_default_compression.label = "Parquet 預設壓縮"
emqx_connector_aggregator_schema.parquet_schema.desc = "用於 Parquet 檔案的 Schema，採用 Avro 格式。"
emqx_connector_aggregator_schema.parquet_schema.label = "Parquet Schema (Avro)"
emqx_connector_aggregator_schema.parquet_schema_avro_inline.desc = "內聯定義的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline.label = "內聯"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_def.desc = "JSON 格式的 Avro Schema 定義。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_def.label = "Schema 定義"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_type.desc = "內聯定義的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_inline_type.label = "類型"
emqx_connector_aggregator_schema.parquet_schema_avro_ref.desc = "儲存在 Schema Registry 中的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref.label = "Schema Registry 引用"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_name.desc = "儲存在 Schema Registry 中的 Avro Schema 名稱。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_name.label = "Schema 名稱"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_type.desc = "儲存在 Schema Registry 中的 Avro Schema。"
emqx_connector_aggregator_schema.parquet_schema_avro_ref_type.label = "類型"
emqx_connector_api.cannot_delete_connector_with_active_rules.desc = "無法刪除連接器，因為該連接器定義了活動規則。"
emqx_connector_api.cannot_delete_connector_with_active_rules.label = "無法刪除具有活動規則的連接器"
emqx_connector_api.connector_already_exists.desc = "連接器已存在。"
emqx_connector_api.connector_already_exists.label = "連接器已存在"
emqx_connector_api.connector_not_found.desc = "未找到連接器。"
emqx_connector_api.connector_not_found.label = "未找到連接器"
emqx_connector_api.connector_not_found_or_invalid_operation.desc = "未找到連接器或無效操作。"
emqx_connector_api.connector_not_found_or_invalid_operation.label = "未找到連接器或無效操作"
emqx_connector_api.connector_or_node_not_found.desc = "未找到連接器或節點或無效操作。"
emqx_connector_api.connector_or_node_not_found.label = "未找到連接器或節點"
emqx_connector_api.connector_test_failed.desc = "連接器測試失敗。"
emqx_connector_api.connector_test_failed.label = "連接器測試失敗"
emqx_connector_api.desc_api1.desc = "列出所有建立的連接器。"
emqx_connector_api.desc_api1.label = "列出所有連接器"
emqx_connector_api.desc_api2.desc = "透過類型和名稱建立一個新的連接器。"
emqx_connector_api.desc_api2.label = "建立連接器"
emqx_connector_api.desc_api3.desc = "透過 id 取得一個連接器。"
emqx_connector_api.desc_api3.label = "取得連接器"
emqx_connector_api.desc_api4.desc = "透過 id 更新一個連接器。"
emqx_connector_api.desc_api4.label = "更新連接器"
emqx_connector_api.desc_api5.desc = "透過 id 刪除一個連接器。"
emqx_connector_api.desc_api5.label = "刪除連接器"
emqx_connector_api.desc_api7.desc = "在叢集的所有節點上啟動連接器。"
emqx_connector_api.desc_api7.label = "叢集連接器操作"
emqx_connector_api.desc_api8.desc = "在特定節點上啟動連接器。"
emqx_connector_api.desc_api8.label = "節點連接器操作"
emqx_connector_api.desc_api9.desc = "測試建立一個新的連接器。"
emqx_connector_api.desc_api9.label = "測試連接器建立"
