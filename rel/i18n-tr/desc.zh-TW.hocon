emqx_mgmt_api_trace.trace_log_size.label = "日誌檔案大小"
emqx_mgmt_api_trace.trace_name.desc = "日誌追蹤的唯一名字。只允許使用小寫字母 a-z、大寫字母 A-Z、數字 0-9 和下劃線 '_'。"
emqx_mgmt_api_trace.trace_name.label = "日誌追蹤唯一名字"
