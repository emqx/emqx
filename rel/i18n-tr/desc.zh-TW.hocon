emqx_mgmt_api_clients.since.desc = "僅包含在此時間（UNIX 紀元時間，秒級精度）之後過期的會話。"
emqx_mgmt_api_clients.since.label = "起始時間"
emqx_mgmt_api_clients.subscribe.desc = "強制 broker 代表指定用戶端新增訂閱。\n訂閱會直接安裝在用戶端通道中，並在通道生命週期內持續存在，就像用戶端發起的 SUBSCRIBE 一樣。\n該操作按設計繞過 MQTT 授權（ACL）規則：REST API key / 儀表板角色才是授權邊界，而不是 broker 的 `authorization` 設定。"
emqx_mgmt_api_clients.subscribe.label = "訂閱"
emqx_mgmt_api_clients.subscribe_g.desc = "強制 broker 代表指定用戶端在一次請求中新增多個訂閱。\n每個訂閱都會直接安裝在用戶端通道中，並在通道生命週期內持續存在，就像用戶端發起的 SUBSCRIBE 一樣。\n該操作按設計繞過 MQTT 授權（ACL）規則：REST API key / 儀表板角色才是授權邊界，而不是 broker 的 `authorization` 設定。"
emqx_mgmt_api_clients.subscribe_g.label = "批次訂閱"
emqx_mgmt_api_clients.subscriptions_cnt.desc = "該用戶端已建立的訂閱數量。"
emqx_mgmt_api_clients.subscriptions_cnt.label = "訂閱數量"
emqx_mgmt_api_clients.subscriptions_max.desc = "該用戶端允許的最大訂閱數量。"
emqx_mgmt_api_clients.subscriptions_max.label = "最大訂閱數"
emqx_mgmt_api_clients.topic.desc = "主題名稱。"
emqx_mgmt_api_clients.topic.label = "主題名稱"
emqx_mgmt_api_clients.total_payload_bytes.desc = "記憶體會話訊息佇列（mqueue）和未確認訊息（inflight）視窗中保留的 MQTT 負載位元組數"
emqx_mgmt_api_clients.total_payload_bytes.label = "總負載位元組數"
emqx_mgmt_api_clients.unsubscribe.desc = "強制 broker 代表指定用戶端移除訂閱。\n該操作按設計繞過 MQTT 授權（ACL）規則：REST API key / 儀表板角色才是授權邊界，而不是 broker 的 `authorization` 設定。"
emqx_mgmt_api_clients.unsubscribe.label = "取消訂閱"
emqx_mgmt_api_clients.unsubscribe_g.desc = "強制 broker 代表指定用戶端在一次請求中移除多個訂閱。\n該操作按設計繞過 MQTT 授權（ACL）規則：REST API key / 儀表板角色才是授權邊界，而不是 broker 的 `authorization` 設定。"
emqx_mgmt_api_clients.unsubscribe_g.label = "批次取消訂閱"
