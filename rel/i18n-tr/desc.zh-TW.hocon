emqx_streams_schema.auto_create_lastvalue.desc = "最後值訊息流自動建立的設定"
emqx_streams_schema.auto_create_lastvalue.label = "自動建立最後值設定"
emqx_streams_schema.auto_create_regular.desc = "常規訊息流自動建立的設定"
emqx_streams_schema.auto_create_regular.label = "自動建立常規設定"
emqx_streams_schema.data_retention_period.desc = "訊息佇列中資料保留的時間段。"
emqx_streams_schema.data_retention_period.label = "資料保留期"
emqx_streams_schema.enable.desc = "啟用訊息流功能。"
emqx_streams_schema.enable.label = "啟用訊息流"
emqx_streams_schema.gc_interval.desc = "訊息流清理過期訊息的間隔。"
emqx_streams_schema.gc_interval.label = "GC 間隔"
emqx_streams_schema.is_lastvalue.desc = "指示訊息流是否具有最後值語義。最後值語義意味著訊息覆寫同一主題中具有相同流鍵的先前訊息。"
emqx_streams_schema.is_lastvalue.label = "是否為最後值"
emqx_streams_schema.key_expression.desc = "用於確定最後值訊息佇列中訊息鍵的表示式。"
emqx_streams_schema.key_expression.label = "鍵表示式"
emqx_streams_schema.max_shard_message_bytes.desc = "訊息流中分片的最大位元組數。分片數量在持久儲存設定中為所有訊息流設定。注意，此限制不考慮複製因子。因此，訊息流的總位元組限制為 `n_shards * replication_factor * max_shard_message_bytes`。"
emqx_streams_schema.max_shard_message_bytes.label = "最大分片訊息位元組數"
emqx_streams_schema.max_shard_message_count.desc = "訊息流中分片的最大訊息數。分片數量在持久儲存設定中為所有訊息流設定。訊息流的總計數限制為 `n_shards * max_shard_message_count`。"
emqx_streams_schema.max_shard_message_count.label = "最大分片訊息數"
emqx_streams_schema.max_stream_count.desc = "可以建立的最大訊息流數量。"
emqx_streams_schema.max_stream_count.label = "最大流數量"
emqx_streams_schema.name.desc = "訊息流的名稱。"
emqx_streams_schema.name.label = "名稱"
emqx_streams_schema.read_max_unacked.desc = "當 DS 緩衝區已滿時，停止向訊息流用戶端傳遞訊息的閾值。"
emqx_streams_schema.read_max_unacked.label = "讀取最大未確認"
emqx_streams_schema.regular_stream_retention_period.desc = "常規訊息流中訊息的最大保留期。"
emqx_streams_schema.regular_stream_retention_period.label = "常規流保留期"
emqx_streams_schema.stream_individual_limits.desc = "單個訊息流的位元組大小和計數限制。"
emqx_streams_schema.stream_individual_limits.label = "訊息流限制"
emqx_streams_schema.streams.desc = "訊息流的全域設定。"
emqx_streams_schema.streams.label = "訊息流設定"
