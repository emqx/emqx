emqx_schema_registry_http_api.example_confluent.desc = "Confluent 的外部 Schema Registry 請求範例。"
emqx_schema_registry_http_api.example_confluent.label = "Confluent 範例"
emqx_schema_registry_http_api.external_registry_create.desc = "建立外部 schema registry"
emqx_schema_registry_http_api.external_registry_create.label = "建立外部 Registry"
emqx_schema_registry_http_api.external_registry_delete.desc = "刪除外部 schema registry"
emqx_schema_registry_http_api.external_registry_delete.label = "刪除外部 Registry"
