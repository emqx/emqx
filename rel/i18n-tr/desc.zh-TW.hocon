emqx_bridge_gcp_pubsub.pubsub_topic.desc = "GCP PubSub 主題。可以是主題名稱（在所設定服務帳號的專案中解析），也可以是形如 `projects/<project-id>/topics/<topic-name>` 的完整主題路徑，後者可以引用與服務帳號不同的 GCP 專案中的主題。在後一種情況下，必須為該服務帳號授予該主題上相應的 Pub/Sub 權限。"
emqx_bridge_gcp_pubsub.pubsub_topic.label = "GCP PubSub 主題"
