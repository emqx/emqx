emqx_bridge_greptimedb_connector.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>\n主機條目的格式如下：主機名[:連接埠]。<br/>\n如果未指定 [:連接埠]，則使用 GreptimeDB 的預設連接埠 8086。"
emqx_bridge_greptimedb_connector.server.label = "伺服器主機"
