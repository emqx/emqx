emqx_authn_api.param_position.desc = "認證器在鏈中的位置。可能的值是 'front', 'rear', 'before:{other_authenticator_id}', 'after:{other_authenticator_id}'"
emqx_authn_api.param_position.label = "認證器在鏈中的位置"
emqx_authn_api.param_user_id.desc = "使用者 ID，根據設定的帳號類型不同，可以是 username 或 clientid"
emqx_authn_api.param_user_id.label = "使用者 ID"
emqx_authn_api.user_deleted.desc = "使用者已刪除"
emqx_authn_api.user_deleted.label = "使用者已刪除"
emqx_authn_cinfo_schema.check.desc = "對用戶端資訊進行的檢查。\n它定義了一個匹配條件，並在條件為 `true` 時回傳結果。\n如果所有檢查都被跳過，則回傳預設結果 `ignore`。"
emqx_authn_cinfo_schema.check.label = "用戶端資訊檢查"
emqx_authn_cinfo_schema.checks.desc = "對用戶端資訊執行的一組檢查。\n如果所有檢查都被跳過，則回傳預設結果 `ignore`。\n`ignore` 結果表示將認證流程交由鏈中的下一個認證器處理。"
emqx_authn_cinfo_schema.checks.label = "用戶端資訊檢查列表"
emqx_authn_cinfo_schema.cinfo.desc = "基於用戶端資訊（如使用者名稱、用戶端ID、\n用戶端屬性以及從 TLS 憑證提取的資料）進行用戶端認證。"
emqx_authn_cinfo_schema.cinfo.label = "用戶端資訊認證"
emqx_authn_cinfo_schema.is_match.desc = "一個 Variform 表示式或表示式陣列，用於評估一組從用戶端資訊派生的預繫結變數。\n支援的變數：\n- `username`: 用戶端的使用者名稱。\n- `password`：用戶端的密碼。\n- `clientid`: 用戶端的 ID。\n- `client_attrs.*`: 用戶端的屬性。\n- `peerhost`: 用戶端的 IP 地址。\n- `cert_subject`: TLS 憑證的主題。\n- `cert_common_name`: TLS 憑證通用名稱。\n- `zone`：用戶端連線所使用監聽器所屬的設定區域。\n\n如果所有表示式的結果都是字串值 `'true'`，則從此認證器回傳對應的 `result`。\n如果任一表示式的結果不是 `'true'`，則跳過目前檢查。\n例如：若希望確保用戶端 ID 與其 TLS 憑證的通用名稱始終一致，可使用表示式 `str_eq(clientid, cert_common_name)`。"
emqx_authn_cinfo_schema.is_match.label = "匹配條件"
emqx_authn_cinfo_schema.result.desc = "當匹配條件為 `true` 時回傳的結果。\n支援的結果：\n- `ignore`: 將身分驗證交由鏈中的下一個認證器處理。\n- `allow`: 允許用戶端連線。\n- `deny`: 拒絕用戶端連線。"
emqx_authn_cinfo_schema.result.label = "結果"
emqx_authn_http_schema.allowed_hosts.desc = "允許模板化 URL 主機名解析到的主機名列表。\n每個條目可以是精確主機名（如 <code>auth.example.com</code>），也可以是萬用字元模式（如 <code>*.auth.example.com</code>），用於匹配該字尾下的任意主機名。\n當 URL 主機名包含模板佔位符時，必須設定此列表；只有渲染後的主機名匹配列表中的某個條目時才會發起請求，否則認證失敗。\n當 URL 主機名為字面主機名時，此設定無效。"
emqx_authn_http_schema.allowed_hosts.label = "允許的主機名"
emqx_authn_http_schema.body.desc = "HTTP 請求體。"
emqx_authn_http_schema.body.label = "請求體"
emqx_authn_http_schema.get.desc = "使用 HTTP Server 作為認證服務的認證器的設定項 (使用 GET 請求)。"
emqx_authn_http_schema.headers.desc = "HTTP Headers 列表"
emqx_authn_http_schema.headers.label = "請求標頭"
emqx_authn_http_schema.headers_no_content_type.desc = "HTTP Headers 列表 (無 <code>content-type</code>) 。"
emqx_authn_http_schema.headers_no_content_type.label = "請求標頭(無 content-type)"
emqx_authn_http_schema.hostname_resolution.desc = "<code>url</code> 中認證伺服器主機名的解析方式。\n<code>static</code>：主機名固定；請求透過設定時建立的持久連線池傳送，pipelining 相關選項生效。\n<code>dynamic</code>：每次請求時解析主機名；當 URL 主機名包含模板佔位符時必須使用此方式。請求使用短生命週期的按請求連線，因此 <code>enable_pipelining</code> 和 <code>max_inactive</code> 不生效；<code>pool_size</code> 限制可保留複用的空閒連線數量。"
emqx_authn_http_schema.hostname_resolution.label = "主機名解析方式"
emqx_authn_http_schema.method.desc = "HTTP 請求方法。"
emqx_authn_http_schema.method.label = "請求方法"
emqx_authn_http_schema.pool_size.desc = "到認證伺服器的連線數上限。\n當 <code>hostname_resolution</code> 為 <code>static</code> 時，此值為持久連線池的大小（必須至少為 1）。\n當 <code>hostname_resolution</code> 為 <code>dynamic</code> 時，此值限制可在請求間保留複用的空閒連線數量；設定為 <code>0</code> 可完全停用連線複用。"
emqx_authn_http_schema.pool_size.label = "連線池大小"
emqx_authn_http_schema.post.desc = "使用 HTTP Server 作為認證服務的認證器的設定項 (使用 POST 請求)。"
emqx_authn_http_schema.request_timeout.desc = "HTTP 請求逾時時長。"
emqx_authn_http_schema.request_timeout.label = "請求逾時"
emqx_authn_http_schema.url.desc = "認證 HTTP 伺服器地址。\n主機名部分可包含模板佔位符，例如 <code>https://${client_attrs.tns}.auth.example.com/authn</code>；此時必須將 <code>hostname_resolution</code> 設定為 <code>dynamic</code> 並設定 <code>allowed_hosts</code>，每個請求將透過按請求建立的連線傳送到渲染後的主機，而不是透過固定連線池。"
emqx_authn_http_schema.url.label = "URL"
emqx_authn_jwt_schema.acl_claim_name.desc = "用於取得 ACL 規則的 JWT 宣告名稱。"
emqx_authn_jwt_schema.acl_claim_name.label = "ACL 宣告名稱"
emqx_authn_jwt_schema.algorithm.desc = "JWT 簽名演算法，支援 HMAC (設定為 <code>hmac-based</code>）和 RSA、ECDSA (設定為 <code>public-key</code>)。"
emqx_authn_jwt_schema.algorithm.label = "JWT 簽名演算法"
emqx_authn_jwt_schema.cacertfile.desc = "包含 PEM 編碼的 CA 憑證的檔案的路徑。"
emqx_authn_jwt_schema.cacertfile.label = "CA 憑證檔案"
emqx_authn_jwt_schema.certfile.desc = "包含使用者憑證的檔案的路徑。"
emqx_authn_jwt_schema.certfile.label = "憑證檔案"
emqx_authn_jwt_schema.disconnect_after_expire.desc = "在 token 過期後斷開用戶端連線。"
emqx_authn_jwt_schema.disconnect_after_expire.label = "過期後斷開連結"
emqx_authn_jwt_schema.enable.desc = "啟用/停用 SSL。"
emqx_authn_jwt_schema.enable.label = "啟用/停用 SSL"
emqx_authn_jwt_schema.endpoint.desc = "JWKS 端點， 它是一個以 JWKS 格式回傳服務端的公鑰集的只讀端點。"
emqx_authn_jwt_schema.endpoint.label = "JWKS 端點"
emqx_authn_jwt_schema.from.desc = "指定用戶端連線請求中 JWT 的位置。"
emqx_authn_jwt_schema.from.label = "JWT 的位置"
emqx_authn_jwt_schema.jwks_headers.desc = "JWKS 請求中需要傳送的 HTTP 請求標頭列表。"
emqx_authn_jwt_schema.jwks_headers.label = "HTTP 請求標頭"
emqx_authn_jwt_schema.jwt_hmac.desc = "用於認證的 JWT 使用 HMAC 演算法簽發時的設定。"
emqx_authn_jwt_schema.jwt_jwks.desc = "用於認證的 JWTs 需要從 JWKS 端點取得時的設定。"
emqx_authn_jwt_schema.jwt_public_key.desc = "用於認證的 JWT 使用 RSA 或 ECDSA 演算法簽發時的設定。"
emqx_authn_jwt_schema.keyfile.desc = "包含 PEM 編碼的使用者私鑰的檔案的路徑。"
emqx_authn_jwt_schema.keyfile.label = "私鑰檔案"
emqx_authn_jwt_schema.max_fail_count.desc = "在快取金鑰失效之前，連續 JWKS 重新整理失敗的最大次數。"
emqx_authn_jwt_schema.max_fail_count.label = "最大失敗次數"
emqx_authn_jwt_schema.on_missing_jwt.desc = "當設定的 JWT 憑證欄位缺失時採取的動作。使用 <code>deny</code> 立即拒絕認證，或使用 <code>ignore</code> 跳過此認證器並讓認證鏈繼續。"
emqx_authn_jwt_schema.on_missing_jwt.label = "JWT 缺失時"
emqx_authn_jwt_schema.public_key.desc = "用於驗證 JWT 的公鑰。"
emqx_authn_jwt_schema.public_key.label = "公鑰"
emqx_authn_jwt_schema.refresh_interval.desc = "JWKS 重新整理間隔。"
emqx_authn_jwt_schema.refresh_interval.label = "JWKS 重新整理間隔"
emqx_authn_jwt_schema.secret.desc = "使用 HMAC 演算法時用於驗證 JWT 的金鑰"
emqx_authn_jwt_schema.secret.label = "Secret"
emqx_authn_jwt_schema.secret_base64_encoded.desc = "金鑰是否為 base64 編碼。"
emqx_authn_jwt_schema.secret_base64_encoded.label = "金鑰是否為 Base64 編碼"
emqx_authn_jwt_schema.server_name_indication.desc = "伺服器名稱指示（SNI）。"
emqx_authn_jwt_schema.server_name_indication.label = "伺服器名稱指示"
emqx_authn_jwt_schema.ssl.desc = "SSL 選項。"
emqx_authn_jwt_schema.ssl.label = "SSL 選項"
emqx_authn_jwt_schema.use_jwks.desc = "是否使用 JWKS。"
emqx_authn_jwt_schema.use_jwks.label = "是否使用 JWKS"
emqx_authn_jwt_schema.verify.desc = "指定握手過程中是否驗證對端憑證。"
emqx_authn_jwt_schema.verify.label = "驗證"
emqx_authn_jwt_schema.verify_claims.desc = "需要驗證的自訂宣告列表，是一個由名稱/值對組成的列表。指定一個鍵(Key)來查詢 JWT 中對應的宣告(Claim)，並提供一個預期值(Expected Value)來與宣告的實際值進行比較，以確保只有滿足特定條件的 JWT 才能被接受和使用。\n例如要求 JWT 中的特定宣告(如 clientid)的值必須與目前連線的用戶端 ID 相匹配。\n預期值可以使用以下佔位符：\n- <code>${username}</code>: 將在執行時被替換為用戶端連線時使用的使用者名稱\n- <code>${clientid}</code>: 將在執行時被替換為用戶端連線時使用的用戶端 ID\n身分認證將確認 JWT 中的宣告值（從密碼欄位中取得）與 <code>verify_claims</code> 中要求的內容是否匹配。"
emqx_authn_jwt_schema.verify_claims.label = "自訂宣告檢查"
emqx_authn_kerberos_schema.principal.desc = "伺服器的 Kerberos 主體。\n例如： <code>mqtt/emqx-cluster-1.example.com@MY_REALM.EXAMPLE.COM</code>。\n注意：所使用的領域需要在 EMQX 節點的預設設定檔 krb5.conf（通常位於 `/etc`）中設定。"
emqx_authn_kerberos_schema.principal.label = "Kerberos 主體"
emqx_authn_ldap_schema.acl_ttl_attribute.desc = "指示使用哪個屬性來表示 ACL TTL。"
emqx_authn_ldap_schema.acl_ttl_attribute.label = "ACL TTL 屬性"
emqx_authn_ldap_schema.bind_method.desc = "透過 LDAP 繫結操作進行認證。"
emqx_authn_ldap_schema.bind_password.desc = "繫結密碼的模板。"
emqx_authn_ldap_schema.bind_password.label = "繫結密碼"
emqx_authn_ldap_schema.clientid_override_attribute.desc = "指示哪個屬性用於表示 clientid 覆寫值。"
emqx_authn_ldap_schema.clientid_override_attribute.label = "ClientIdOverride 屬性"
emqx_authn_ldap_schema.hash_method.desc = "透過將本地密碼與經過由`密碼屬性`指定的演算法加密的密碼進行比對來進行認證。"
emqx_authn_ldap_schema.is_superuser_attribute.desc = "指示哪個屬性用於表示使用者是否為超級使用者。"
emqx_authn_ldap_schema.is_superuser_attribute.label = "是否為超級使用者屬性"
emqx_authn_ldap_schema.ldap.desc = "使用 LDAP 作為認證資料來源的認證器的設定項。"
emqx_authn_ldap_schema.method.desc = "認證方式。"
emqx_authn_ldap_schema.method_type.desc = "認證方式類型。"
emqx_authn_ldap_schema.password_attribute.desc = "指示哪個屬性用於表示使用者密碼。"
emqx_authn_ldap_schema.password_attribute.label = "密碼屬性"
emqx_authn_ldap_schema.query_timeout.desc = "LDAP 查詢的逾時時間。"
emqx_authn_ldap_schema.query_timeout.label = "查詢逾時"
emqx_authn_mnesia_schema.bootstrap_file.desc = "引導檔案將使用者匯入內建資料庫。\n對於資料庫中已存在的使用者 ID，不會重複匯入。\n檔案內容格式由 `bootstrap_type` 決定。"
emqx_authn_mnesia_schema.bootstrap_file.label = "引導檔案路徑"
emqx_authn_mnesia_schema.bootstrap_type.desc = "指定引導檔案的內容類型。\n\n- **`plain`**:\n  - 所需資料欄位： `user_id`, `password`, `is_superuser`\n  - `user_id`: 可以是用戶端 ID 或使用者名稱，具體取決於內建資料庫認證的 `user_id_type` 設定。\n  - `password`: 使用者的明文密碼。\n  - `is_superuser`: 布林值，使用者是否為管理員。\n\n- **`hash`**:\n  - 所需資料欄位 `user_id`,`password_hash`,`salt`,`is_superuser`\n  - 定義與 `plain` 類型相似，為提高安全性增加了 `password_hash` 和 `salt`。\n\n內容可以是 CSV 或 JSON 格式。\n\n這是一個 CSV 範例：`user_id,password_hash,salt,is_superuser\\nmy_user,b6c743545a7817ae8c8f624371d5f5f0373234bb0ff36b8ffbf19bce0e06ab75,de1024f462fb83910fd13151bd4bd235,true`\n\nJSON 內容應解碼為物件陣列，例如：`[{\"user_id\": \"my_user\",\"password\": \"s3cr3tp@ssw0rd\",\"is_superuser\": true}]`.\n\n`password_hash` 的雜湊字串取決於內容資料庫認證機制中 `password_hash_algorithm` 的設定。例如，如果設定為 `password_hash_algorithm {name = sha256, salt_position = suffix}`，則在雜湊之前將 salt 新增到密碼中。等效的 Python 表示式為： `hashlib.sha256(password + salt).hexdigest()`."
emqx_authn_mnesia_schema.builtin_db.desc = "使用內建資料庫作為認證資料來源的認證器的設定項。"
emqx_authn_mnesia_schema.user_id_type.desc = "指定認證時使用 `clientid` 還是 `username`。"
emqx_authn_mnesia_schema.user_id_type.label = "帳號類型"
emqx_authn_mongodb_schema.clientid_override_field.desc = "定義用戶端 clientid 覆寫的文件欄位。"
emqx_authn_mongodb_schema.clientid_override_field.label = "ClientId 覆寫欄位"
emqx_authn_mongodb_schema.collection.desc = "儲存認證資料的集合。"
emqx_authn_mongodb_schema.collection.label = "集合"
emqx_authn_mongodb_schema.filter.desc = "在查詢中定義篩選條件的條件表示式。\n篩選器支援如下佔位符：\n- <code>${username}</code>: 將在執行時被替換為用戶端連線時使用的使用者名稱\n- <code>${clientid}</code>: 將在執行時被替換為用戶端連線時使用的用戶端 ID"
emqx_authn_mongodb_schema.filter.label = "過濾器"
emqx_authn_mongodb_schema.is_superuser_field.desc = "定義使用者是否具有超級使用者權限的欄位。"
emqx_authn_mongodb_schema.is_superuser_field.label = "超級使用者欄位"
emqx_authn_mongodb_schema.password_hash_field.desc = "儲存密碼雜湊值欄位。"
emqx_authn_mongodb_schema.password_hash_field.label = "密碼雜湊欄位"
emqx_authn_mongodb_schema.replica-set.desc = "使用 MongoDB (Replica Set) 作為認證資料來源的認證器的設定項。"
emqx_authn_mongodb_schema.salt_field.desc = "用於儲存鹽值的欄位。"
emqx_authn_mongodb_schema.salt_field.label = "鹽值欄位"
emqx_authn_mongodb_schema.sharded-cluster.desc = "使用 MongoDB (Sharded Cluster) 作為認證資料來源的認證器的設定項。"
emqx_authn_mongodb_schema.single.desc = "使用 MongoDB (Standalone) 作為認證資料來源的認證器的設定項。"
emqx_authn_mysql_schema.mysql.desc = "使用 MySQL 作為認證資料來源的認證器的設定項。"
emqx_authn_mysql_schema.query.desc = "用於查詢密碼雜湊等用於認證的資料的 SQL 語句。"
emqx_authn_mysql_schema.query.label = "查詢 SQL"
emqx_authn_mysql_schema.query_timeout.desc = "SQL 查詢的逾時時間。"
emqx_authn_mysql_schema.query_timeout.label = "查詢逾時"
emqx_authn_password_hashing.bcrypt.desc = "BCRYPT 密碼雜湊演算法的設定。"
emqx_authn_password_hashing.bcrypt.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_name.desc = "對於 BCRYPT 密碼雜湊，必須將名稱設定為 'bcrypt'"
emqx_authn_password_hashing.bcrypt_name.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_rw.desc = "bcrypt 密碼雜湊演算法的設定（用於具有寫入能力的資料庫後端）。"
emqx_authn_password_hashing.bcrypt_rw.label = "BCRYPT"
emqx_authn_password_hashing.bcrypt_salt_rounds.desc = "BCRYPT 密碼生成的工作因子。"
emqx_authn_password_hashing.bcrypt_salt_rounds.label = "鹽輪數"
emqx_authn_password_hashing.dk_length.desc = "PBKDF2 演算法派生金鑰的位元組長度。"
emqx_authn_password_hashing.dk_length.label = "派生金鑰長度"
emqx_authn_password_hashing.pbkdf2.desc = "PBKDF2 密碼雜湊演算法的設定。"
emqx_authn_password_hashing.pbkdf2.label = "PBKDF2"
emqx_authn_password_hashing.pbkdf2_iterations.desc = "PBKDF2 演算法的迭代次數。較高的值提供更好的安全性，但需要更多計算。"
emqx_authn_password_hashing.pbkdf2_iterations.label = "PBKDF2 迭代"
emqx_authn_password_hashing.pbkdf2_mac_fun.desc = "指定在 PBKDF2 演算法中使用哪個 HMAC 函式。注意，自 5.8.3 版本以來，不再支援 md4、md5、ripemd160。"
emqx_authn_password_hashing.pbkdf2_mac_fun.label = "PBKDF2 MAC 函式"
emqx_authn_password_hashing.pbkdf2_name.desc = "對於 PBKDF2 密碼雜湊，必須將名稱設定為 'pbkdf2'"
emqx_authn_password_hashing.pbkdf2_name.label = "PBKDF2"
emqx_authn_password_hashing.salt_position.desc = "PLAIN、SHA、SHA256 和 SHA512 演算法的鹽位置。"
emqx_authn_password_hashing.salt_position.label = "鹽位置"
emqx_authn_password_hashing.simple.desc = "簡單演算法（如 PLAIN、SHA、SHA256 和 SHA512）的設定。"
emqx_authn_password_hashing.simple.label = "簡單演算法"
emqx_authn_password_hashing.type_ro.desc = "密碼雜湊驗證的選項。"
emqx_authn_password_hashing.type_ro.label = "密碼雜湊選項"
emqx_authn_password_hashing.type_rw.desc = "密碼雜湊建立和驗證的選項。"
emqx_authn_password_hashing.type_rw.label = "密碼雜湊選項"
emqx_authn_postgresql_schema.postgresql.desc = "使用 PostgreSQL 作為認證資料來源的認證器的設定項。"
emqx_authn_postgresql_schema.query.desc = "用於查詢密碼雜湊等用於認證的資料的 SQL 語句。"
emqx_authn_postgresql_schema.query.label = "查詢 SQL"
emqx_authn_redis_schema.cluster.desc = "使用 Redis (Cluster) 作為認證資料來源的認證器的設定項。"
emqx_authn_redis_schema.cmd.desc = "用於查詢密碼雜湊等用於認證的資料的 Redis 命令，目前僅支援 <code>HGET</code> 與 <code>HMGET</code>。"
emqx_authn_redis_schema.cmd.label = "Redis 命令"
emqx_authn_redis_schema.sentinel.desc = "使用 Redis (Sentinel) 作為認證資料來源的認證器的設定項。"
emqx_authn_redis_schema.single.desc = "使用 Redis (Standalone) 作為認證資料來源的認證器的設定項。"
emqx_authn_schema.authentication_cache.desc = "認證快取設定。"
emqx_authn_schema.authentication_cache.label = "認證快取"
emqx_authn_schema.backend.desc = "後端類型。"
emqx_authn_schema.backend.label = "後端類型"
emqx_authn_schema.enable.desc = "設為 <code>true</code> 或 <code>false</code> 以停用此認證資料來源。"
emqx_authn_schema.enable.label = "啟用"
emqx_authn_schema.failed.desc = "目前資料來源執行查詢失敗次數。"
emqx_authn_schema.failed.label = "查詢失敗次數"
emqx_authn_schema.global_authentication.desc = "預設的 MQTT 監聽器的全域認證設定。\n\n有關每個監聽器的單獨設定，請參閱監聽器設定中的<code>authentication</code>。\n\n此選項可設定為：\n<ul>\n  <li><code>[]</code>: 預設值，允許 *所有* 登入</li>\n  <li>one: 例如 <code>{enable:true,backend:\"built_in_database\",mechanism=\"password_based\"}</code></li>\n  <li>chain: 結構體陣列。</li>\n</ul>\n\n當設定了一個認證鏈時，登入憑據將按照設定的順序檢查後端，直到可以做出'允許'或'拒絕'的決定。\n\n如果在完全走訪認證鏈之後沒有決定，登入將被拒絕。"
emqx_authn_schema.global_authentication.label = "全域認證"
emqx_authn_schema.ignore_backend_failures.desc = "在強化安全設定檔中忽略認證後端失敗，並繼續鏈中的下一個認證器。"
emqx_authn_schema.ignore_backend_failures.label = "忽略後端失敗"
emqx_authn_schema.listener_authentication.desc = "每個監聽器的認證覆寫。\n認證可以是一個單一的認證器實例，也可以是一個認證器鏈，表示為一個陣列\n在對登入進行身分認證（使用者名稱、用戶端 ID 等）時，將按照設定的順序檢查認證器。"
emqx_authn_schema.listener_authentication.label = "每個監聽器的認證覆寫。"
emqx_authn_schema.matched.desc = "目前資料來源執行查詢次數。"
emqx_authn_schema.matched.label = "查詢次數"
emqx_authn_schema.mechanism.desc = "認證方式。"
emqx_authn_schema.mechanism.label = "認證方式"
emqx_authn_schema.metrics.desc = "認證器統計指標。"
emqx_authn_schema.metrics.label = "指標"
emqx_authn_schema.metrics_failed.desc = "在目前認證器中找到需要的認證資訊，並且回傳認證失敗的次數。"
emqx_authn_schema.metrics_failed.label = "認證失敗次數"
emqx_authn_schema.metrics_nomatch.desc = "在目前認證器中沒有找到需要的認證資訊，忽略認證的次數。"
emqx_authn_schema.metrics_nomatch.label = "忽略認證次數"
emqx_authn_schema.metrics_rate.desc = "目前認證器執行速度，次/秒。"
emqx_authn_schema.metrics_rate.label = "認證速度"
emqx_authn_schema.metrics_rate_last5m.desc = "目前認證器在最近 5 分鐘內平均執行速度，單位：次/秒。"
emqx_authn_schema.metrics_rate_last5m.label = "近 5 分鐘內平均認證速度"
emqx_authn_schema.metrics_rate_max.desc = "目前認證器曾經達到的最大認證速度，單位：次/秒。"
emqx_authn_schema.metrics_rate_max.label = "最大認證速度"
emqx_authn_schema.metrics_success.desc = "在目前認證器中找到需要的認證資訊，並且實例回傳認證成功的次數。"
emqx_authn_schema.metrics_success.label = "認證成功次數"
emqx_authn_schema.metrics_total.desc = "目前認證器執行認證的總次數。"
emqx_authn_schema.metrics_total.label = "認證總次數"
emqx_authn_schema.node.desc = "節點名稱。"
emqx_authn_schema.node.label = "節點名稱"
emqx_authn_schema.node_error.desc = "節點上的錯誤資訊。"
emqx_authn_schema.node_error.label = "節點錯誤資訊"
emqx_authn_schema.node_metrics.desc = "每個節點上認證器的統計指標。"
emqx_authn_schema.node_metrics.label = "節點指標"
emqx_authn_schema.node_status.desc = "每個節點上資料來源的狀態。"
emqx_authn_schema.node_status.label = "節點資料來源狀態"
emqx_authn_schema.precondition.desc = "一個 Variform 表示式，用於評估一組從用戶端資訊派生的預繫結變數。\n\n支援的變數：\n- `username`：用戶端的使用者名稱\n- `password`：用戶端的密碼\n- `clientid`：用戶端的 ID\n- `client_attrs.*`：用戶端的屬性\n- `cert_common_name`：用戶端 TLS 憑證的主題欄位\n- `cert_subject`：用戶端 TLS 憑證的通用名稱（CN）\n- `peersni`：TLS 用戶端傳送的 SNI（伺服器名稱指示）\n- `listener`：監聽器 ID（例如 `tcp:default`）\n- `zone`：關聯的設定區域。\n\n表示式必須評估為字串值 'true'，此認證器才會被呼叫。\n如果表示式評估為其他值，則跳過此認證器。\n\n範例：\n- 僅在用戶端從監聽器 `ssl:letsencryt` 連線時呼叫：\n  `str_eq(listener, 'ssl:letsencryt')`\n- 如果使用者名稱為空則跳過：\n  `not(is_empty_val(username))`\n- 僅在密碼存在且區域為 'zone1' 時呼叫：\n  `iif(is_empty_val(password), false, str_eq(zone, 'zone1'))`\n\n在 EMQX 文件中查詢有關 Variform 表示式的更多資訊。"
emqx_authn_schema.precondition.label = "前置條件"
emqx_authn_schema.rate.desc = "目前資料來源執行查詢速度，單位：次/秒。"
