emqx_bridge_confluent_producer.bootstrap_hosts.desc = "逗號分隔的 Confluent Kafka 命名空間主機名 <code>host[:port]</code> ，用於引導用戶端。  預設連接埠號為 9092。"
emqx_bridge_confluent_producer.bootstrap_hosts.label = "引導伺服器"
emqx_bridge_confluent_producer.bridge_v2_type.desc = "動作的類型"
emqx_bridge_confluent_producer.bridge_v2_type.label = "動作類型"
emqx_bridge_confluent_producer.buffer_memory_overload_protection.desc = "當緩衝模式設定為<code>memory</code>時適用。在高記憶體壓力下，EMQX 將丟棄舊的緩衝訊息。注意：此設定僅在 Linux 上有效。"
emqx_bridge_confluent_producer.buffer_memory_overload_protection.label = "記憶體過載保護"
emqx_bridge_confluent_producer.buffer_mode.desc = "訊息緩衝模式。\n\n<code>memory</code>：在記憶體中緩衝所有訊息。如果 EMQX 節點重啟，這些訊息將會遺失。\n<code>disk</code>：在磁碟上緩衝所有訊息。磁碟上的訊息能夠在 EMQX 節點重啟後保留。\n<code>hybrid</code>：首先在記憶體中緩衝訊息，當達到一定限制（參見<code>segment_bytes</code>設定瞭解更多資訊）時，開始將訊息轉移到磁碟。像<code>memory</code>模式一樣，如果 EMQX 節點重啟，這些訊息將會遺失。"
emqx_bridge_confluent_producer.buffer_mode.label = "緩衝模式"
emqx_bridge_confluent_producer.buffer_per_partition_limit.desc = "每個 Confluent 分割區允許緩衝的位元組數。當超出此限制時，舊訊息將被丟棄以換取新訊息的緩衝空間。"
emqx_bridge_confluent_producer.buffer_per_partition_limit.label = "分割區緩衝限制"
emqx_bridge_confluent_producer.buffer_segment_bytes.desc = "當緩衝模式設定為<code>disk</code>或<code>hybrid</code>時適用。\n此值用於指定每個磁碟緩衝檔案的大小。"
emqx_bridge_confluent_producer.buffer_segment_bytes.label = "分段檔案位元組數"
emqx_bridge_confluent_producer.compression.desc = "壓縮方法。"
emqx_bridge_confluent_producer.compression.label = "壓縮"
emqx_bridge_confluent_producer.config_enable.desc = "啟用（是）或停用（否）此動作。"
emqx_bridge_confluent_producer.config_enable.label = "是否啟用"
emqx_bridge_confluent_producer.connect_timeout.desc = "TCP 連線建立的最長等待時間（包括啟用認證時的認證時間）。"
emqx_bridge_confluent_producer.connect_timeout.label = "連線逾時"
