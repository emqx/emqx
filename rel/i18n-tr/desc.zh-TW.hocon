emqx_bridge_greptimedb.write_syntax.desc = "GreptimeDB gRPC 協定寫入資料點的設定。寫入語法是一種文字格式，提供了資料點的測量、標籤集、欄位集和時間戳，並支援佔位符，與 InfluxDB 行協定相同。\n參見 [InfluxDB 2.3 行協定](https://docs.influxdata.com/influxdb/v2.3/reference/syntax/line-protocol/) 和\n[GreptimeDB 1.8 行協定](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\n簡而言之:<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n請注意，整數值的佔位符必須用字尾 `i` 註解。例如 `${payload.int_value}i`。"
emqx_bridge_greptimedb.write_syntax.label = "寫入語法"
emqx_bridge_greptimedb_connector.connector_ts_column.desc = "如果定義了，指定一個自訂時間戳列名，該列將在查詢時出現。"
emqx_bridge_greptimedb_connector.connector_ts_column.label = "自訂時間戳列名"
