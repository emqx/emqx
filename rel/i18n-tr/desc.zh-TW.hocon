emqx_mgmt_api_clients.get_sessions_count.desc = "取得叢集中的會話總數。\n預設情況下，僅包括那些未過期的會話。\n如果 broker.session_history_retain 設定為大於 0 秒的持續時間，\n這個計數也將包括在指定保留時間內過期的會話。\n透過指定 since 參數，它可以回傳在指定時間內過期的會話數。"
emqx_mgmt_api_clients.get_sessions_count.label = "會話數量統計"
emqx_mgmt_api_clients.gte_connected_at.desc = "按大於或等於的方法搜尋用戶端連線建立時間，格式為 RFC3339 或時間戳（毫秒）。"
emqx_mgmt_api_clients.gte_connected_at.label = "GTE 連線時間"
emqx_mgmt_api_clients.gte_created_at.desc = "按大於或等於的方法搜尋用戶端會話建立時間，格式為 RFC3339 或時間戳（毫秒）。"
emqx_mgmt_api_clients.gte_created_at.label = "GTE 建立時間"
