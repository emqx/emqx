emqx_dashboard_api.delete_mfa.label = "刪除 MFA"
emqx_dashboard_api.delete_user_api.desc = "刪除 Dashboard 使用者"
emqx_dashboard_api.delete_user_api.label = "刪除 Dashboard 使用者"
emqx_dashboard_api.license.desc = "EMQX 授權類型。可為 opensource 或 enterprise"
emqx_dashboard_api.list_user_scopes_api.desc = "列出儀表板登入使用者可能擁有的所有 scope 名稱及其描述，幷包含 `admin_only` 標誌以指示該 scope 是否僅限管理員角色。\n回傳給任何已認證的登入使用者——此端點用於填充儀表板 UI 的 scope 選擇器，本身不要求特定 scope。"
emqx_dashboard_api.list_user_scopes_api.label = "列出儀表板使用者 scope"
