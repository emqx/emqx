emqx_mgmt_api_trace.payload_encode.desc = "確定追蹤檔案中負載格式的格式。<br/>\n`text`：基於文字的協定或純文字協定。\n當負載為 JSON 編碼時推薦使用。<br/>\n`hex`：二進位制十六進位制編碼。\n當負載為自訂二進位制協定時推薦使用。<br/>\n`hidden`：負載被模糊化為 `******`"
emqx_mgmt_api_trace.payload_encode.label = "負載編碼"
emqx_mgmt_api_trace.payload_limit.desc = "確定將在追蹤檔案中列印的負載的最大位元組數。<br/>\n截斷部分將在追蹤檔案中顯示為 '...'。<br/>\n僅當 `payload_encode` 為 `hex` 或 `text` 時有效<br/>\n`0`：無限制<br/>\n預設值為 1024 位元組"
emqx_mgmt_api_trace.payload_limit.label = "負載限制"
emqx_mgmt_api_trace.provided_configuration_invalid.desc = "提供的設定無效。"
