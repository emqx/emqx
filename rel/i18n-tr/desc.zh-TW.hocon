emqx_mgmt_api_clients.mountpoint.label = "掛載點"
emqx_mgmt_api_clients.mqueue_dropped.desc = "由於佇列長度超限，被訊息佇列丟棄的訊息數量。"
emqx_mgmt_api_clients.mqueue_dropped.label = "訊息佇列丟棄數"
emqx_mgmt_api_clients.mqueue_len.desc = "目前傳送緩衝佇列（send-buffer queue）的長度。"
emqx_mgmt_api_clients.mqueue_len.label = "訊息佇列長度"
