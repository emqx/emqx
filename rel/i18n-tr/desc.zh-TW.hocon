emqx_schema_validation_schema.check_sql_type.desc = "使用規則引擎的 SQL 語法驗證訊息，此語法與規則引擎中的語法一致，但需省略 FROM 子句。任何生成值的 SQL 語句表示驗證成功；如果沒有回傳值，則驗證失敗。例如，語句 <code>SELECT payload.foo + payload.bar as sum WHERE sum > 0</code> 用於驗證欄位 foo 和 bar 的和為正數。"
emqx_schema_validation_schema.check_sql_type.label = "SQL schema 檢查"
