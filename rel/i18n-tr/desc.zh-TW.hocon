emqx_dashboard_api.login_api.desc = "登入成功後回傳 Dashboard 認證 Token。"
emqx_dashboard_api.login_api.label = "取得 Dashboard 認證權杖"
emqx_dashboard_api.login_failed401.desc = "登入失敗。MFA 權杖錯誤或缺失，或使用者名稱或密碼錯誤"
emqx_dashboard_api.login_failed_response400.desc = "登入失敗。使用者名稱或密碼錯誤"
