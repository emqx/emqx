emqx_mgmt_api_alarms.list_alarms_api.label = "列出警報"
emqx_mgmt_api_alarms.message.desc = "警報訊息，以人類可讀的方式描述警報內容。"
emqx_mgmt_api_alarms.name.desc = "警報名稱，用於區分不同的警報。"
emqx_mgmt_api_alarms.node.desc = "觸發此警報的節點名稱。"
emqx_mgmt_api_api_keys.api_key_desc.desc = "API key 字串，用作 Basic 認證中的使用者名稱。"
emqx_mgmt_api_api_keys.api_key_desc.label = "API Key"
emqx_mgmt_api_api_keys.api_key_list.desc = "檢視 API 金鑰列表"
emqx_mgmt_api_api_keys.api_key_list.label = "API 金鑰列表"
emqx_mgmt_api_api_keys.api_key_scopes_list.desc = "列出所有可用的 API key scope。此 API 只能使用 bearer token 請求。"
emqx_mgmt_api_api_keys.api_key_scopes_list.label = "列出 API key scope"
emqx_mgmt_api_api_keys.api_key_scopes_request.desc = "授予此 API key 的作用域名稱列表。每個作用域是穩定的功能類別（例如 connections、publish、monitoring）。建立時若省略，伺服器會採用角色預設值——administrator/viewer 獲得所有管理作用域，publisher 僅獲得 `publish`。字面字串 `unset` 或與角色預設值相同的列表表示“無顯式作用域策略”：該 key 將不儲存作用域列表，並跟隨角色預設值（這使得用戶端可以不加修改地重新提交讀取回傳的值）。傳送顯式空列表 `[]` 可建立拒絕所有的 key（僅可存取如 `/status` 等匿名端點）。"
emqx_mgmt_api_api_keys.api_key_scopes_request.label = "API key scope（請求）"
emqx_mgmt_api_api_keys.api_key_scopes_response.desc = "授予此 API key 的作用域名稱列表。每個作用域是穩定的功能類別（例如 connections、publish、monitoring）。字面字串 `unset` 是為不含顯式作用域列表的記錄呈現的哨兵值（包括使用等價於 unset 的作用域建立或更新的記錄，以及從不支援作用域功能的版本升級而來的記錄）；執行時會對這類記錄回退到角色預設值，用戶端應將其視為“無顯式作用域策略”。空列表 `[]` 表示拒絕所有（僅可存取如 `/status` 等匿名端點）。"
emqx_mgmt_api_api_keys.api_key_scopes_response.label = "API key scope（回應）"
emqx_mgmt_api_api_keys.api_secret_desc.desc = "API secret 字串，用作 Basic 認證中的密碼。僅在建立時回傳，之後無法取回。"
emqx_mgmt_api_api_keys.api_secret_desc.label = "API Secret"
emqx_mgmt_api_api_keys.create_new_api_key.desc = "建立一個新的 API 金鑰"
emqx_mgmt_api_api_keys.create_new_api_key.label = "建立 API 金鑰"
emqx_mgmt_api_api_keys.created_at_desc.desc = "API key 建立時間（ISO 8601 / epoch second）。"
emqx_mgmt_api_api_keys.created_at_desc.label = "建立時間"
emqx_mgmt_api_api_keys.delete_api_key.desc = "指定 API 金鑰 ID 進行刪除"
emqx_mgmt_api_api_keys.delete_api_key.label = "刪除指定 API 金鑰"
emqx_mgmt_api_api_keys.enable_desc.desc = "API key 是否啟用。停用的 key 在認證時會被拒絕。"
emqx_mgmt_api_api_keys.enable_desc.label = "啟用"
emqx_mgmt_api_api_keys.expired_at_desc.desc = "過期時間。可為 ISO 8601 時間戳 / epoch second，或 `infinity` 表示永不過期。"
emqx_mgmt_api_api_keys.expired_at_desc.label = "過期時間"
emqx_mgmt_api_api_keys.expired_desc.desc = "API key 是否已過期。只讀；由 `expired_at` 派生。"
emqx_mgmt_api_api_keys.expired_desc.label = "已過期"
emqx_mgmt_api_api_keys.get_api_key.desc = "指定 API 金鑰 ID 取得詳情"
emqx_mgmt_api_api_keys.get_api_key.label = "取得 API 金鑰詳情"
emqx_mgmt_api_api_keys.name_format.desc = "API key 名稱。必須以字母開頭，可包含字母、數字、連字元和下劃線。長度 1-256 個字元。模式：^[A-Za-z]+[A-Za-z0-9-_]*$"
emqx_mgmt_api_api_keys.name_format.label = "名稱"
emqx_mgmt_api_api_keys.name_not_found.desc = "指定名稱的 API key 不存在。"
emqx_mgmt_api_api_keys.name_not_found.label = "名稱未找到"
emqx_mgmt_api_api_keys.name_pattern.desc = "^[A-Za-z]+[A-Za-z0-9-_]*$"
emqx_mgmt_api_api_keys.name_pattern.label = "名稱模式"
emqx_mgmt_api_api_keys.namespace_field.desc = "用於限定此 API key 的命名空間。這是將命名空間編碼在 `role` 字串中（`ns:<namespace>::<role>`）的替代方式。當兩種形式同時提供時必須一致，否則請求會被拒絕。若為全域（非命名空間）API key，請省略。"
emqx_mgmt_api_api_keys.namespace_field.label = "命名空間"
emqx_mgmt_api_api_keys.role.desc = "該 API 的角色。命名空間角色寫作 `ns:<namespace>::<role>`。`multi_tenancy.deny_namespaces` 中列出的命名空間名稱（預設為 `global`、`undefined`、`null`、`none`）不可使用。"
emqx_mgmt_api_api_keys.role.label = "角色"
emqx_mgmt_api_api_keys.scope_info_desc.desc = "該作用域涵蓋範圍的可讀描述。"
emqx_mgmt_api_api_keys.scope_info_desc.label = "Scope 描述"
emqx_mgmt_api_api_keys.scope_info_name.desc = "Scope 名稱：API 端點功能類別的穩定識別碼。"
emqx_mgmt_api_api_keys.scope_info_name.label = "Scope 名稱"
emqx_mgmt_api_api_keys.scopes_response_scopes.desc = "所有可用 scope 及其名稱與描述。"
emqx_mgmt_api_api_keys.scopes_response_scopes.label = "可用 scope"
emqx_mgmt_api_api_keys.update_api_key.desc = "指定 API 金鑰 ID 進行更新"
emqx_mgmt_api_api_keys.update_api_key.label = "更新指定 API 金鑰"
emqx_mgmt_api_banned.as.desc = "封鎖方式，可以透過用戶端 ID、使用者名稱或者 IP 地址等方式進行封鎖。"
emqx_mgmt_api_banned.as.label = "封鎖方式"
