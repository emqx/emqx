emqx_bridge_gcp_pubsub.producer_attributes.label = "屬性模版"
emqx_bridge_gcp_pubsub.producer_ordering_key.desc = "特定 GCP PubSub 訊息的排序鍵模板。如果解析值未定義或為空字串，則從訊息中省略排序鍵屬性。"
