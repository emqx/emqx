emqx_bridge_v2_schema.mqtt_topic.desc = "MQTT 主題或主題過濾器作為資料來源（動作輸入）。 如果規則動作用作資料來源，則應將此設定留空，否則訊息將在遠端系統中重複。"
emqx_bridge_v2_schema.mqtt_topic.label = "源 MQTT 主題"
emqx_bridge_v2_schema.undefined_vars_as_null.desc = "寫入資料庫時，將未定義的變數視為 NULL。\n啟用此選項時，如果模板中使用了未定義的變數（如 ${var}），它們將被替換為 \"NULL\"，而不是字串 \"undefined\"。如果此選項未啟用（預設），則可能插入字串 \"undefined\"。\n如果可能，此選項應始終設定為 `true`；預設值 `false` 僅用於確保向後相容性。"
emqx_bridge_v2_schema.undefined_vars_as_null.label = "定義變數作為 Null"
emqx_cluster_link_api.cluster_link_not_found.desc = "未找到叢集連結。"
