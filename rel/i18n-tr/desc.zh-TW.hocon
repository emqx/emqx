emqx_authz_file_schema.path.desc = "包含 ACL 規則的檔案路徑。\n如果該檔案在啟動 EMQX 節點之前已經設定好，\n只要 EMQX 有讀取權限，它可以放置在任何位置。\n即，EMQX 將把它視為只讀。\n\n如果規則集是從 EMQX Dashboard 或 HTTP API 建立或更新的，\n將建立一個新檔案並放置在 EMQX 的 data_dir 中的 authz 子目錄下，\n舊檔案將不再使用。"
emqx_authz_file_schema.path.label = "路徑"
emqx_authz_file_schema.rules.desc = "授權規則。"
emqx_authz_file_schema.rules.label = "規則"
emqx_authz_http_schema.allowed_hosts.desc = "允許模板化 URL 主機名解析到的主機名列表。\n每個條目可以是精確主機名（如 <code>auth.example.com</code>），也可以是萬用字元模式（如 <code>*.auth.example.com</code>），用於匹配該字尾下的任意主機名。\n當 URL 主機名包含模板佔位符時，必須設定此列表；只有渲染後的主機名匹配列表中的某個條目時才會發起請求，否則授權檢查失敗。\n當 URL 主機名為字面主機名時，此設定無效。"
emqx_authz_http_schema.allowed_hosts.label = "允許的主機名"
emqx_authz_http_schema.body.desc = "HTTP 請求體"
emqx_authz_http_schema.body.label = "請求體"
emqx_authz_http_schema.headers.desc = "HTTP Headers 列表"
emqx_authz_http_schema.headers.label = "請求標頭"
emqx_authz_http_schema.headers_no_content_type.desc = "HTTP Headers 列表 (無 <code>content-type</code>) 。"
emqx_authz_http_schema.headers_no_content_type.label = "請求標頭(無 content-type)"
emqx_authz_http_schema.hostname_resolution.desc = "<code>url</code> 中授權伺服器主機名的解析方式。\n<code>static</code>：主機名固定；請求透過設定時建立的持久連線池傳送，pipelining 相關選項生效。\n<code>dynamic</code>：每次請求時解析主機名；當 URL 主機名包含模板佔位符時必須使用此方式。請求使用短生命週期的按請求連線，因此 <code>enable_pipelining</code> 和 <code>max_inactive</code> 不生效；<code>pool_size</code> 限制可保留複用的空閒連線數量。"
emqx_authz_http_schema.hostname_resolution.label = "主機名解析方式"
emqx_authz_http_schema.http_get.desc = "使用外部 HTTP 伺服器授權(GET 請求)。"
emqx_authz_http_schema.http_get.label = "http_get"
emqx_authz_http_schema.http_post.desc = "使用外部 HTTP 伺服器授權(POST 請求)。"
emqx_authz_http_schema.http_post.label = "http_post"
emqx_authz_http_schema.method.desc = "HTTP 請求方法"
emqx_authz_http_schema.method.label = "請求方法"
emqx_authz_http_schema.pool_size.desc = "到授權伺服器的連線數上限。\n當 <code>hostname_resolution</code> 為 <code>static</code> 時，此值為持久連線池的大小（必須至少為 1）。\n當 <code>hostname_resolution</code> 為 <code>dynamic</code> 時，此值限制可在請求間保留複用的空閒連線數量；設定為 <code>0</code> 可完全停用連線複用。"
emqx_authz_http_schema.pool_size.label = "連線池大小"
emqx_authz_http_schema.request_timeout.desc = "HTTP 請求逾時。"
emqx_authz_http_schema.request_timeout.label = "請求逾時"
emqx_authz_http_schema.url.desc = "授權伺服器地址。\n主機名部分可包含模板佔位符，例如 <code>https://${client_attrs.tns}.auth.example.com/authz</code>；此時必須將 <code>hostname_resolution</code> 設定為 <code>dynamic</code> 並設定 <code>allowed_hosts</code>，每個請求將透過按請求建立的連線傳送到渲染後的主機，而不是透過固定連線池。"
emqx_authz_http_schema.url.label = "URL"
emqx_authz_ldap_schema.acl_rule_attribute.desc = "指示使用哪個屬性來表示 JSON 編碼的 ACL 規則。"
emqx_authz_ldap_schema.acl_rule_attribute.label = "ACL 規則屬性"
emqx_authz_ldap_schema.all_attribute.desc = "表示使用哪個屬性來表示允許`發布`和`訂閱`的主題列表。"
emqx_authz_ldap_schema.all_attribute.label = "所有屬性"
emqx_authz_ldap_schema.ldap_struct.desc = "LDAP 授權設定"
emqx_authz_ldap_schema.ldap_struct.label = "LDAP 授權"
emqx_authz_ldap_schema.publish_attribute.desc = "表示使用哪個屬性來表示允許`發布`的主題列表。"
emqx_authz_ldap_schema.publish_attribute.label = "發布屬性"
emqx_authz_ldap_schema.query_timeout.desc = "LDAP 查詢逾時。"
emqx_authz_ldap_schema.query_timeout.label = "查詢逾時"
emqx_authz_ldap_schema.subscribe_attribute.desc = "表示使用哪個屬性來表示允許`訂閱`的主題列表。"
emqx_authz_ldap_schema.subscribe_attribute.label = "訂閱屬性"
emqx_authz_mnesia_schema.builtin_db.desc = "使用內建資料庫 (mnesia) 進行授權。"
emqx_authz_mnesia_schema.builtin_db.label = "內建資料庫"
emqx_authz_mnesia_schema.max_rules.desc = "每個用戶端/使用者的最大規則數。請注意，隨著規則數量的增加，效能可能會下降。"
emqx_authz_mongodb_schema.collection.desc = "包含授權資料的 `MongoDB` 集合。"
emqx_authz_mongodb_schema.collection.label = "集合"
emqx_authz_mongodb_schema.filter.desc = "定義查詢中篩選條件的條件表示式。\n篩選器支援以下佔位符<br/>\n - <code>${username}</code>：在連線時將用用戶端使用的 <code>使用者名稱</code> 替換<br/>\n - <code>${clientid}</code>：在連線時將用用戶端使用的 <code>用戶端 ID</code> 替換"
emqx_authz_mongodb_schema.filter.label = "過濾器"
emqx_authz_mongodb_schema.limit.desc = "限制取得的記錄數量。"
emqx_authz_mongodb_schema.limit.label = "授權記錄限制"
emqx_authz_mongodb_schema.mongo_rs.desc = "使用 MongoDB 授權（副本集模式）"
emqx_authz_mongodb_schema.mongo_rs.label = "mongo_rs"
emqx_authz_mongodb_schema.mongo_sharded.desc = "使用 MongoDB 授權（分片叢集模式）。"
emqx_authz_mongodb_schema.mongo_sharded.label = "mongo_sharded"
emqx_authz_mongodb_schema.mongo_single.desc = "使用 MongoDB 授權（單實例）。"
emqx_authz_mongodb_schema.mongo_single.label = "mongo_single"
emqx_authz_mongodb_schema.skip.desc = "跳過的授權記錄數量。"
emqx_authz_mongodb_schema.skip.label = "跳過的授權記錄數"
emqx_authz_mysql_schema.mysql.desc = "使用 MySQL 資料庫進行授權。"
emqx_authz_mysql_schema.mysql.label = "mysql"
emqx_authz_mysql_schema.query.desc = "用於檢索授權資料的資料庫查詢。"
emqx_authz_mysql_schema.query.label = "查詢"
emqx_authz_postgresql_schema.postgresql.desc = "使用 PostgreSQL 資料庫進行授權。"
emqx_authz_postgresql_schema.postgresql.label = "postgresql"
emqx_authz_postgresql_schema.query.desc = "用於檢索授權資料的資料庫查詢。"
emqx_authz_postgresql_schema.query.label = "查詢"
emqx_authz_redis_schema.cmd.desc = "用於檢索授權資料的資料庫查詢。"
emqx_authz_redis_schema.cmd.label = "命令"
emqx_authz_redis_schema.compatibility_mode.desc = "Redis ACL 相容模式。設定為 `v4` 以接受舊版 ACL 值 `1|2|3` 和佔位符 `%u/%c`。"
emqx_authz_redis_schema.compatibility_mode.label = "相容模式"
emqx_authz_redis_schema.redis_cluster.desc = "使用 Redis 叢集進行授權。"
emqx_authz_redis_schema.redis_cluster.label = "redis_cluster"
emqx_authz_redis_schema.redis_sentinel.desc = "使用 Redis Sentinel 進行授權。"
emqx_authz_redis_schema.redis_sentinel.label = "redis_sentinel"
emqx_authz_redis_schema.redis_single.desc = "使用單個 Redis 實例進行授權。"
emqx_authz_redis_schema.redis_single.label = "redis_single"
emqx_authz_schema.allow.desc = "認證成功的次數。"
emqx_authz_schema.allow.label = "認證成功的次數"
emqx_authz_schema.authorization.desc = "與用戶端授權相關的設定。"
emqx_authz_schema.authorization.label = "授權"
emqx_authz_schema.authz_latency_buckets.desc = "用於統計總授權延遲的直方圖指標分桶。"
emqx_authz_schema.authz_latency_buckets.label = "總授權延遲指標分桶"
emqx_authz_schema.deny.desc = "認證失敗的次數。"
emqx_authz_schema.deny.label = "認證失敗的次數"
emqx_authz_schema.enable.desc = "設定為 <code>true</code> 或 <code>false</code> 來停用此 ACL 提供者"
emqx_authz_schema.enable.label = "啟用"
emqx_authz_schema.failed.desc = "查詢失敗的次數"
emqx_authz_schema.failed.label = "失敗"
emqx_authz_schema.ignore.desc = "鑑權查詢被忽略的次數。 每當授權源嘗試授權請求但不適用，或遇到錯誤且結果無法確定時，此計數器會增加。"
emqx_authz_schema.ignore.label = "忽略"
emqx_authz_schema.ignore_backend_failures.desc = "啟用後，即使目前安全設定檔會拒絕授權，也會忽略授權後端失敗。"
emqx_authz_schema.ignore_backend_failures.label = "忽略後端失敗"
emqx_authz_schema.matched.desc = "此資源被查詢的次數"
emqx_authz_schema.matched.label = "匹配"
emqx_authz_schema.metrics.desc = "資源的指標"
emqx_authz_schema.metrics.label = "指標"
emqx_authz_schema.metrics_total.desc = "觸發授權規則的總次數。"
emqx_authz_schema.metrics_total.label = "授權規則觸發的總次數"
emqx_authz_schema.node.desc = "節點名稱。"
emqx_authz_schema.node.label = "節點名稱"
emqx_authz_schema.node_error.desc = "節點上產生的錯誤。"
emqx_authz_schema.node_error.label = "節點產生的錯誤"
emqx_authz_schema.node_metrics.desc = "每個節點上授權器的統計指標。"
emqx_authz_schema.node_metrics.label = "節點指標"
emqx_authz_schema.node_status.desc = "每個節點上資料來源的狀態。"
emqx_authz_schema.node_status.label = "節點資料來源狀態"
emqx_authz_schema.nomatch.desc = "沒有匹配到任何授權規則的次數。"
emqx_authz_schema.nomatch.label = "沒有匹配到任何授權規則的次數"
emqx_authz_schema.precondition.desc = "在呼叫此授權源之前，使用用戶端和請求資訊評估的 Variform 表示式。\n\n支援的用戶端變數包括：\n- `username`：用戶端的使用者名稱\n- `clientid`：用戶端的 client ID\n- `client_attrs.*`：用戶端屬性\n- `cert_common_name`：用戶端 TLS 憑證中的通用名稱（CN）\n- `cert_subject`：用戶端 TLS 憑證中的 Subject 欄位\n- `peersni`：TLS 用戶端傳送的 SNI（Server Name Indication）\n- `listener`：監聽器 ID（如 `tcp:default`）\n- `zone`：關聯的設定區。\n\n支援的請求變數包括：\n- `action`：授權動作，取值為 `publish` 或 `subscribe`\n- `topic`：正在授權的主題\n\n當表示式評估結果不為 true 時，將跳過該授權源。\n\n範例：\n- 僅在 publish 授權時呼叫：\n  `str_eq(action, 'publish')`\n- 僅當主題匹配用戶端作用域的主題過濾器時呼叫：\n  `topic_match(topic, topic_join([clientid, '#']))`"
emqx_authz_schema.precondition.label = "前置條件"
emqx_authz_schema.rate.desc = "命中速率，單位：次/秒。"
emqx_authz_schema.rate.label = "速率"
emqx_authz_schema.rate_last5m.desc = "5 分鐘內平均命中速率，單位：次/秒。"
emqx_authz_schema.rate_last5m.label = "5 分鐘內速率"
emqx_authz_schema.rate_max.desc = "最大命中速率，單位：次/秒。"
emqx_authz_schema.rate_max.label = "最大速率"
emqx_authz_schema.sources.desc = "<br/>\n授權（ACL）資料提供者的陣列。\n它被設計為一個陣列，而不是雜湊對映，因此可以\n將源按順序排列形成存取控制鏈。<br/>\n\n在授權 '發布' 或 '訂閱' 操作時，設定的\n源會按順序檢查。在檢查 ACL 源時，\n如果未找到用戶端（透過使用者名稱或用戶端 ID 識別），\n則繼續檢查下一個源。一旦回傳 '允許' 或 '拒絕' 決定，\n立即停止檢查。<br/>\n\n如果在任何源中都未找到用戶端，\n則應用 'authorization.no_match' 中設定的預設操作。<br/>\n\n注意：\n源元素由它們的 '類型' 識別。\n不允許設定兩個或更多相同類型的源。"
emqx_authz_schema.sources.label = "資料來源"
emqx_authz_schema.status.desc = "資料來源狀態。"
emqx_authz_schema.status.label = "資料來源狀態"
emqx_authz_schema.success.desc = "請求成功次數。"
emqx_authz_schema.success.label = "成功"
emqx_authz_schema.topic_template_allow.desc = "控制插入到授權主題模板中的用戶端可控值是否可以包含 MQTT 主題過濾字元。"
emqx_authz_schema.topic_template_allow.label = "主題模板允許的字元"
emqx_authz_schema.topic_template_allow_hash.desc = "允許在插入到授權主題模板的值中包含井號（<code>#</code>）。"
emqx_authz_schema.topic_template_allow_hash.label = "允許井號"
emqx_authz_schema.topic_template_allow_plus.desc = "允許在插入到授權主題模板的值中包含加號（<code>+</code>）。"
emqx_authz_schema.topic_template_allow_plus.label = "允許加號"
emqx_authz_schema.topic_template_allow_slash.desc = "允許在插入到授權主題模板的值中包含斜槓字元（<code>/</code>）。"
emqx_authz_schema.topic_template_allow_slash.label = "允許斜槓"
emqx_authz_schema.type.desc = "資料後端類型"
emqx_authz_schema.type.label = "類型"
emqx_auto_subscribe_api.list_auto_subscribe_api.desc = "取得自動訂閱主題列表"
emqx_auto_subscribe_api.list_auto_subscribe_api.label = "取得自動訂閱主題列表"
emqx_auto_subscribe_api.update_auto_subscribe_api.desc = "更新自動訂閱主題列表"
emqx_auto_subscribe_api.update_auto_subscribe_api.label = "更新自動訂閱主題"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.desc = "超出自動訂閱主題列表長度限制"
emqx_auto_subscribe_api.update_auto_subscribe_api_response409.label = "超出自動訂閱主題列表長度限制"
emqx_auto_subscribe_schema.auto_subscribe.desc = "裝置成功登入後，透過預定義的訂閱表示法自動為裝置完成訂閱。支援使用佔位符。"
emqx_auto_subscribe_schema.auto_subscribe.label = "自動訂閱"
emqx_auto_subscribe_schema.nl.desc = "預設值為 0。\nMQTT v3.1.1：如果你訂閱了自己發布的主題，你將收到所有自己發布的訊息。\nMQTT v5：如果在訂閱時將此選項設定為 1，伺服器將不會將你發布的訊息轉發給你。"
emqx_auto_subscribe_schema.nl.label = "No Local"
emqx_auto_subscribe_schema.qos.desc = "預設值 0。訊息服務品質。\n至多一次（0）\n至少一次（1）\n恰好一次（2）"
emqx_auto_subscribe_schema.qos.label = "QoS"
emqx_auto_subscribe_schema.rap.desc = "預設值為 0。此選項用於指定伺服器在向用戶端轉發訊息時是否保留 RETAIN 標記，而且此選項不影響保留訊息中的 RETAIN 標記。因此，當選項 Retain As Publish 設定為 0 時，用戶端將直接根據訊息中的 RETAIN 標記來區分這是普通的轉發訊息還是保留訊息，而不是判斷此訊息是否為訂閱後首次收到的訊息（轉發的訊息可能在保留訊息之前傳送，這取決於不同 broker 的具體實現）。"
emqx_auto_subscribe_schema.rap.label = "Retain As Publish"
emqx_auto_subscribe_schema.rh.desc = "預設值為 0。此選項用於指定用戶端建立訂閱時，伺服器是否向用戶端轉發保留的訊息。\n當 Retain Handling 等於 0 時，只要用戶端成功訂閱，伺服器就會傳送保留訊息。\n當 Retain Handling 等於 1 時，如果用戶端成功訂閱並且此前不存在此訂閱，伺服器傳送保留訊息。畢竟，有時用戶端重新發起訂閱只是為了改變 QoS，並不意味著它想再次接收保留的訊息。\n當 Retain Handling 等於 2 時，即使用戶端成功訂閱，伺服器也不會傳送保留訊息。"
emqx_auto_subscribe_schema.rh.label = "Retain Handling"
emqx_auto_subscribe_schema.topic.desc = "主題名稱，支援佔位符。例如：client/${clientid}/username/${username}/host/${host}/port/${port}\n為必填欄位，且不能為空字串。"
emqx_auto_subscribe_schema.topic.label = "主題"
emqx_bridge_alloydb_action_schema.action_parameters.desc = "動作的參數集。"
emqx_bridge_alloydb_action_schema.action_parameters.label = "動作參數"
emqx_bridge_alloydb_action_schema.alloydb.desc = "將傳入事件追加到 Google AlloyDB 的動作。"
emqx_bridge_alloydb_action_schema.alloydb.label = "上傳到 Google AlloyDB"
emqx_bridge_alloydb_action_schema.parameters.desc = "動作特定參數。"
emqx_bridge_alloydb_action_schema.parameters.label = "參數"
emqx_bridge_alloydb_connector_schema.config_connector.desc = "連線到 Google AlloyDB 的連接器設定。"
emqx_bridge_alloydb_connector_schema.config_connector.label = "Google AlloyDB 連接器設定"
emqx_bridge_aws_timestream_action_schema.action_parameters.desc = "動作的參數集。"
emqx_bridge_aws_timestream_action_schema.action_parameters.label = "AWS Timestream 動作參數"
emqx_bridge_aws_timestream_action_schema.aws_timestream.desc = "將傳入事件追加到 AWS Timestream 的動作。"
emqx_bridge_aws_timestream_action_schema.aws_timestream.label = "上傳到 AWS Timestream 用於 InfluxDB"
emqx_bridge_aws_timestream_connector_schema.config_connector.desc = "連線到 AWS Timestream 用於 InfluxDB 的設定。"
emqx_bridge_aws_timestream_connector_schema.config_connector.label = "AWS Timestream 連接器設定"
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.desc = "設定了聚合上傳模式的動作參數集。"
emqx_bridge_azure_blob_storage_action_schema.aggreg_parameters.label = "Azure Blob Storage 聚合上傳模式動作參數"
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.desc = "用於聚合上傳的 Azure Blob Storage blob 名稱模板。<br/>\n  模板可以包含以下變數的佔位符：\n  <ul>\n  <li><code>${action}</code>: 動作名稱（必需）。</li>\n  <li><code>${node}</code>: 執行上傳的 EMQX 節點名稱（必需）。</li>\n  <li><code>${datetime.{format}}</code>: 聚合開始的日期和時間，格式根據 <code>{format}</code> 字串指定（必需）：\n      <ul>\n      <li><code>${datetime.rfc3339utc}</code>：RFC3339 格式的 UTC 日期和時間，</li>\n      <li><code>${datetime.rfc3339}</code>：RFC3339 格式的本地時區日期和時間，</li>\n      <li><code>${datetime.unix}</code>：Unix 時間戳，</li>\n      <li><code>${datetime.YYYY}</code>、<code>${datetime.MM}</code>、<code>${datetime.DD}</code>：零填充的年、月、日（UTC），</li>\n      <li><code>${datetime.hh}</code>、<code>${datetime.mm}</code>、<code>${datetime.ss}</code>：零填充的時、分、秒（UTC），</li>\n      <li><code>${datetime.DOY}</code>：零填充的一年中的第幾天 001-366（UTC）。</li>\n      </ul>\n      每個日期/時間部分權杖可帶顯式時區字首：<code>utc</code>（與無字首相同）或 <code>local</code>（EMQX 節點系統時區）。範例：<code>${datetime.local.YYYY}</code>、<code>${datetime.utc.hh}</code>。不接受其他時區。\n      Hive 分割區佈局範例：<code>year=${datetime.YYYY}/month=${datetime.MM}/day=${datetime.DD}/hour=${datetime.hh}/${action}_${node}_N${sequence}.json</code>。\n  </li>\n  <li><code>${datetime_until.{format}}</code>：聚合結束的日期和時間，包含相同的格式選項。</li>\n  <li><code>${sequence}</code>：同一時間間隔內聚合上傳的序列號（必需）。</li>\n  </ul>\n  所有其他佔位符都被視為無效。注意，如果模板中缺少標記為必需的佔位符，它們將作為路徑字尾新增到 Azure Blob Storage blob 名稱中。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_blob_template.label = "Azure Blob Storage blob 名稱模版"
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.desc = "Azure Blob Storage 容器名稱。不支援使用模版。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_container_name.label = "Azure Blob Storage 容器名稱"
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.desc = "啟用基於時間的事件聚合，並將其作為單個物件上傳到 Azure Blob Storage 服務。"
emqx_bridge_azure_blob_storage_action_schema.aggregated_mode.label = "Azure Blob Storage 聚合上傳"
emqx_bridge_azure_blob_storage_action_schema.aggregation.desc = "控制聚合上傳過程的參數集。"
emqx_bridge_azure_blob_storage_action_schema.aggregation.label = "Aggregation 參數"
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.desc = "在上傳之前，將事件聚合為單個物件的時間長度。"
emqx_bridge_azure_blob_storage_action_schema.aggregation_interval.label = "時間間隔"
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.desc = "每個聚合物件允許的記錄（事件）數量。每次聚合上傳包含的事件不會超過該數量，但可以少於該數量。<br/>\n  如果事件速率足夠高，則在同一時間間隔內可能會有多個聚合上傳。這些上傳將具有不同但連續的序列號，它們將成為 Azure Blob Storage blob 名稱的一部分。"
emqx_bridge_azure_blob_storage_action_schema.aggregation_max_records.label = "最大記錄數"
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.desc = "將傳入事件上傳到 Azure Blob Storage 服務的動作。"
emqx_bridge_azure_blob_storage_action_schema.azure_blob_storage.label = "上傳到 Azure Blob Storage"
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.desc = "Azure Blob Storage blob 名稱。"
emqx_bridge_azure_blob_storage_action_schema.direct_blob_template.label = "Blob 名稱"
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.desc = "Azure Blob Storage 容器名稱。"
emqx_bridge_azure_blob_storage_action_schema.direct_container_template.label = "容器名稱"
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.desc = "要上傳的 Azure Blob Storage blob 的內容。支援使用模板。"
emqx_bridge_azure_blob_storage_action_schema.direct_content_template.label = "Azure Blob Storage Blob 內容"
emqx_bridge_azure_blob_storage_action_schema.direct_mode.desc = "啟用將事件作為單獨物件上傳到 Azure Blob Storage 服務。"
emqx_bridge_azure_blob_storage_action_schema.direct_mode.label = "Azure Blob Storage 直接上傳"
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.desc = "直接上傳模式的動作參數集。動作支援 Azure Blob Storage 容器名稱、blob 名稱和 blob 內容的模板。"
emqx_bridge_azure_blob_storage_action_schema.direct_parameters.label = "Azure Blob Storage 直接上傳模式動作參數"
emqx_bridge_azure_blob_storage_action_schema.parameters.desc = "一系列動作單數。"
emqx_bridge_azure_blob_storage_action_schema.parameters.label = "Azure Blob Storage 動作參數"
emqx_bridge_azure_blob_storage_connector_schema.account_key.desc = "Azure Blob Storage 服務的存取金鑰。"
emqx_bridge_azure_blob_storage_connector_schema.account_key.label = "存取金鑰"
emqx_bridge_azure_blob_storage_connector_schema.account_name.desc = "Azure Blob Storage 服務的帳戶名稱。"
emqx_bridge_azure_blob_storage_connector_schema.account_name.label = "帳戶名稱"
emqx_bridge_azure_blob_storage_connector_schema.config_connector.desc = "用來連線 Azure Blob Storage 服務的連接器設定。"
emqx_bridge_azure_blob_storage_connector_schema.config_connector.label = "Azure Blob Storage 連接器設定"
emqx_bridge_azure_event_grid_connector_schema.config_connector.desc = "連線到 Azure Event Grid 的連接器設定。"
emqx_bridge_azure_event_grid_connector_schema.config_connector.label = "Azure Event Grid 連接器設定"
emqx_bridge_azure_event_grid_hybrid_schema.action_config.desc = "將傳入事件追加到 Azure Event Grid 的動作。"
emqx_bridge_azure_event_grid_hybrid_schema.action_config.label = "匯入到 Azure Event Grid"
emqx_bridge_azure_event_grid_hybrid_schema.source_config.desc = "從 Azure Event Grid 接收傳入事件的源。"
emqx_bridge_azure_event_grid_hybrid_schema.source_config.label = "從 Azure Event Grid 消費"
emqx_bridge_azure_event_hub.actions.desc = "一個動作的設定項"
emqx_bridge_azure_event_hub.actions.label = "動作設定"
emqx_bridge_azure_event_hub.allow_auto_topic_creation.desc = "設定為 true 以允許透過後設資料取得請求自動建立主題。"
emqx_bridge_azure_event_hub.allow_auto_topic_creation.label = "允許自動建立主題"
emqx_bridge_azure_event_hub.auth_sasl_mechanism.desc = "SASL 認證機制"
emqx_bridge_azure_event_hub.auth_sasl_mechanism.label = "認證機制"
emqx_bridge_azure_event_hub.auth_sasl_password.desc = "用於連線 Azure Event Hubs 的連線字串。應為命名空間共享存取策略的 \"連線字串-主鍵\"。"
emqx_bridge_azure_event_hub.auth_sasl_password.label = "連線字串"
emqx_bridge_azure_event_hub.auth_username_password.desc = "基於使用者名稱/密碼進行認證"
emqx_bridge_azure_event_hub.auth_username_password.label = "使用者名稱/密碼認證"
emqx_bridge_azure_event_hub.authentication.desc = "認證設定"
emqx_bridge_azure_event_hub.authentication.label = "認證"
emqx_bridge_azure_event_hub.bootstrap_hosts.desc = "逗號分隔的 Azure Event Hubs Kafka 命名空間主機名 <code>host[:port]</code> ，用於引導用戶端。  預設連接埠號為 9093。"
emqx_bridge_azure_event_hub.bootstrap_hosts.label = "主機列表"
emqx_bridge_azure_event_hub.bridge_v2_type.desc = "動作的類型。"
emqx_bridge_azure_event_hub.bridge_v2_type.label = "動作類型"
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.desc = "當緩衝模式設定為<code>memory</code>時適用。\n在記憶體壓力較高時，EMQX 會丟棄舊的緩衝訊息。\n高記憶體閾值由設定項 <code>sysmon.os.sysmem_high_watermark</code> 定義。\n注意：此設定僅在 Linux 上有效。"
emqx_bridge_azure_event_hub.buffer_memory_overload_protection.label = "記憶體過載保護"
emqx_bridge_azure_event_hub.buffer_mode.desc = "訊息快取模式。\n\n<code>memory</code>: 將所有訊息快取在記憶體中。如果 EMQX 節點重新啟動，訊息將遺失。\n<code>disk</code>: 將訊息快取在磁碟上，確保它們在 EMQX 節點重新啟動時仍然存在。\n<code>hybrid</code>: 訊息最初在記憶體中快取。當它們達到一定限制時 (更多詳細資訊請參考 <code>segment_bytes</code> 設定)，它們會逐漸轉移到磁碟上。與 <code>memory</code> 模式類似，如果 EMQX 節點重新啟動，訊息將遺失。"
emqx_bridge_azure_event_hub.buffer_mode.label = "快取模式"
emqx_bridge_azure_event_hub.buffer_per_partition_limit.desc = "每個 Azure Event Hubs 分割區允許緩衝的位元組數。當超出此限制時，將丟棄較舊的訊息以為新訊息的緩衝騰出空間。"
emqx_bridge_azure_event_hub.buffer_per_partition_limit.label = "分割區緩衝限制"
emqx_bridge_azure_event_hub.buffer_segment_bytes.desc = "適用於緩衝模式設定為<code>disk</code>或<code>hybrid</code>。\n此設定指定儲存在磁碟上的每個緩衝檔案的大小。"
emqx_bridge_azure_event_hub.buffer_segment_bytes.label = "分段檔案位元組數"
emqx_bridge_azure_event_hub.compression.desc = "壓縮方法"
emqx_bridge_azure_event_hub.compression.label = "壓縮"
emqx_bridge_azure_event_hub.config_enable.desc = "啟用 (是) 或 停用 (否) 該動作。"
emqx_bridge_azure_event_hub.config_enable.label = "是否啟用"
emqx_bridge_azure_event_hub.connect_timeout.desc = "TCP 連線建立的最長等待時間（包括如果已啟用身分認證則包括身分認證時間）"
emqx_bridge_azure_event_hub.connect_timeout.label = "連線逾時"
emqx_bridge_azure_event_hub.connector_type.desc = "連接器類型"
emqx_bridge_azure_event_hub.connector_type.label = "連接器類型"
emqx_bridge_azure_event_hub.desc_config.desc = "Azure Event Hubs 資料橋接設定項。"
emqx_bridge_azure_event_hub.desc_config.label = "Azure Event Hubs 資料橋接設定項"
emqx_bridge_azure_event_hub.desc_name.desc = "橋接名稱，作為橋接的一個可讀描述。"
emqx_bridge_azure_event_hub.desc_name.label = "橋接名稱"
emqx_bridge_azure_event_hub.desc_type.desc = "動作的類型。"
emqx_bridge_azure_event_hub.desc_type.label = "動作類型"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.desc = "Azure Event Hubs 標頭值的編碼模式。<br/>\n - None: 僅將二進位制值新增到 Azure Event Hubs 標頭;<br/>\n - JSON: 僅將 JSON 值新增到 Azure Event Hubs 標頭，並在傳送前將其編碼為 JSON 字串。"
emqx_bridge_azure_event_hub.kafka_header_value_encode_mode.label = "Azure Event Hubs 標頭值編碼模式"
emqx_bridge_azure_event_hub.kafka_headers.desc = "為Azure Event Hubs 標頭提供一個佔位符。例如：<code>${pub_props}</code>。<br/>\n注意，佔位符的值必須是一個物件：\n<code>{\"foo\": \"bar\"}</code>\n或者是一組鍵值對：\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_azure_event_hub.kafka_headers.label = "Azure Event Hubs 標頭"
emqx_bridge_azure_event_hub.kafka_message.desc = "呈現 Azure Event Hubs 訊息的模版。"
emqx_bridge_azure_event_hub.kafka_message.label = "Azure Event Hubs 訊息模版"
emqx_bridge_azure_event_hub.kafka_message_key.desc = "用於呈現 Azure Event Hubs 訊息鍵的模版。如果模板呈現為空值（即在規則引擎上下文中沒有此類資料欄位），則使用 Azure Event Hubs 的 NULL（而不是空字串）。"
emqx_bridge_azure_event_hub.kafka_message_key.label = "訊息鍵"
emqx_bridge_azure_event_hub.kafka_message_timestamp.desc = "要使用哪個時間戳。時間戳需為毫秒精度的 Unix 時間戳，可以採用字串格式，例如 <code>1661326462115</code> 或 <code>'1661326462115'</code>。 當未找到此模板的所需資料欄位，或者找到的資料不是有效的整數時，將使用目前系統時間戳。"
emqx_bridge_azure_event_hub.kafka_message_timestamp.label = "訊息時間戳"
emqx_bridge_azure_event_hub.kafka_message_value.desc = "用於呈現 Azure Event Hubs 訊息值的模版。如果模板呈現為空值（即在規則引擎上下文中沒有此類資料欄位），則使用 Azure Event Hubs 的 NULL（而不是空字串）。"
emqx_bridge_azure_event_hub.kafka_message_value.label = "訊息值"
emqx_bridge_azure_event_hub.kafka_producer.desc = "Azure Event Hubs 生產者設定。"
emqx_bridge_azure_event_hub.kafka_producer.label = "Azure Event Hubs 生產者"
emqx_bridge_azure_event_hub.kafka_topic.desc = "Event Hubs 的名稱。支援使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_azure_event_hub.kafka_topic.label = "Event Hubs 名稱"
emqx_bridge_azure_event_hub.max_batch_age.desc = "訊息在生產者緩衝區中停留的最長時間，超過該時間後訊息將被丟棄而不再傳送到 Azure Event Hubs。\n只有當一個訊息批次中的所有訊息在緩衝區中的停留時間都超過該時長時，該批次才會被丟棄；這既適用於仍在排隊的訊息（包括連線斷開期間），也適用於連線遺失時正在等待確認的訊息。\n每條被丟棄的訊息都會計入 <code>dropped.expired</code> 指標。\n設定為 <code>infinity</code> 時，訊息永不過期（將一直保留直到傳送，或緩衝區溢位）。"
emqx_bridge_azure_event_hub.max_batch_age.label = "最長批次存留時間"
emqx_bridge_azure_event_hub.max_batch_bytes.desc = "在 Azure Event Hubs 訊息批次中收集的最大位元組數。"
emqx_bridge_azure_event_hub.max_batch_bytes.label = "最大批次位元組數"
emqx_bridge_azure_event_hub.max_inflight.desc = "Azure Event Hubs 生產者在接收到 Azure Event Hubs 的確認之前，每個分割區允許傳送的批次的最大數量。較高的值通常意味著更好的吞吐量。然而，當這個值大於1時，可能會有訊息重新排序的風險。"
emqx_bridge_azure_event_hub.max_inflight.label = "飛行視窗"
emqx_bridge_azure_event_hub.max_linger_bytes.desc = "每個分割區生產者在等待期間最多累積的位元組數，達到該值後將停止等待併傳送該批次。"
emqx_bridge_azure_event_hub.max_linger_bytes.label = "最大等待位元組數"
emqx_bridge_azure_event_hub.max_linger_time.desc = "每個分割區生產者為了將更多訊息累積成更大批次而等待的最長時間。\n預設值 `0` 表示不等待（訊息到達後立即傳送），以最佳化訊息延遲。\n如果可以接受少量延遲，建議設定一個等待時間，以幫助降低每秒向 Azure Event Hubs 傳送的請求數。\n一旦累積的資料達到一個完整批次，等待就會提前結束，因此繁忙的生產者不會被額外延遲。\n當緩衝到磁碟時，等待發生在寫入緩衝區之前；此時建議設定至少 `5ms` 以減少磁碟 IOPS。"
emqx_bridge_azure_event_hub.max_linger_time.label = "最長等待時間"
emqx_bridge_azure_event_hub.max_retries.desc = "在 Azure Event Hubs 回傳可重試錯誤（例如分割區 leader 已變更）後，重試傳送訊息批次的最大次數。\n當首次嘗試和所有重試均失敗後，該批次將被丟棄，其中每條訊息都會計入 <code>failed</code> 指標。\n只有當 Azure Event Hubs 明確回傳錯誤碼時重試計數器才會遞增；由連線斷開觸發的重發不會遞增該計數器（這類重發由 <code>max_batch_age</code> 限制）。\n設定為 <code>infinity</code> 時，重試次數不受限制。"
emqx_bridge_azure_event_hub.max_retries.label = "最大重試次數"
emqx_bridge_azure_event_hub.metadata_request_timeout.desc = "從 Azure Event Hubs 取得後設資料時的最長等待時間。"
emqx_bridge_azure_event_hub.metadata_request_timeout.label = "後設資料請求逾時"
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.desc = "用戶端在重新整理 Azure Event Hubs Kafka broker 和主題後設資料之前必須等待的最小時間間隔。設定太小的值可能會給 Azure Event Hubs 增加額外的負載。"
emqx_bridge_azure_event_hub.min_metadata_refresh_interval.label = "後設資料重新整理的最小時間間隔"
emqx_bridge_azure_event_hub.mqtt_topic.desc = "將 MQTT 主題或主題過濾器作為資料來源（動作輸入）。如果使用規則動作作為資料來源，則應將此設定保留為空，否則訊息將在 Azure Event Hubs 中重複。"
emqx_bridge_azure_event_hub.mqtt_topic.label = "源 MQTT 主題"
emqx_bridge_azure_event_hub.partition_count_refresh_interval.desc = "Azure Event Hubs 生產者發現分割區數量增加的時間間隔。\n在 Azure Event Hubs 中增加分割區數量後，EMQX 將開始根據<code>partition_strategy</code>\n在分發訊息時考慮新發現的分割區。"
emqx_bridge_azure_event_hub.partition_count_refresh_interval.label = "分割區數重新整理間隔"
emqx_bridge_azure_event_hub.partition_strategy.desc = "分割區策略是用來指導生產者如何將訊息分配到Azure Event Hubs的各個分割區。\n\n<code>random</code>: 為每條訊息隨機選擇一個分割區。\n<code>key_dispatch</code>: 根據 Azure Event Hubs 訊息鍵的雜湊值將訊息分配到分割區，確保擁有相同鍵的訊息能夠一致地被分配到特定分割區。"
emqx_bridge_azure_event_hub.partition_strategy.label = "分割區策略"
emqx_bridge_azure_event_hub.partitions_limit.desc = "限制為給定主題產生資料的分割區數量。\n特殊值 all_partitions 用於利用主題的所有分割區。\n設定的值大於分割區總數時無效。"
emqx_bridge_azure_event_hub.partitions_limit.label = "最大分割區數"
emqx_bridge_azure_event_hub.producer_buffer.desc = "設定生產者訊息緩衝區。\n\n告訴 Azure Event Hubs 生產者，在 EMQX 需要傳送的訊息多於 Azure Event Hubs 能夠處理的訊息時，或者 Azure Event Hubs 宕機時，如何緩衝訊息。"
emqx_bridge_azure_event_hub.producer_buffer.label = "訊息緩衝區"
emqx_bridge_azure_event_hub.producer_health_check_topic.desc = "專用於更精確的連接器健康檢查的主題名稱。"
emqx_bridge_azure_event_hub.producer_health_check_topic.label = "連接器健康檢查主題"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.desc = "Azure Event Hubs 標頭的鍵。支援格式為${var}的佔位符。"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_key.label = "額外的 Azure Event Hubs 標頭鍵"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.desc = "Azure Event Hubs 標頭的值。支援格式為${var}的佔位符。"
emqx_bridge_azure_event_hub.producer_kafka_ext_header_value.label = "額外的 Azure Event Hubs 標頭值"
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.desc = "請提供更多的 Azure Event Hubs 標頭鍵值對<br/>這裡的鍵值對將與<code>kafka_headers</code>欄位的值合併，然後傳送到 Azure Event Hubs。"
emqx_bridge_azure_event_hub.producer_kafka_ext_headers.label = "額外的 Azure Event Hubs 標頭"
emqx_bridge_azure_event_hub.producer_kafka_opts.desc = "Azure Event Hubs 生產者設定"
emqx_bridge_azure_event_hub.producer_kafka_opts.label = "Azure Event Hubs 生產者"
emqx_bridge_azure_event_hub.producer_opts.desc = "本地的 MQTT 資料來源和 Azure Event Hubs 的橋接設定。"
emqx_bridge_azure_event_hub.producer_opts.label = "MQTT 橋接至 Azure Event Hubs"
emqx_bridge_azure_event_hub.query_mode.desc = "查詢模式。可選'sync/async'，預設為'async'。"
emqx_bridge_azure_event_hub.query_mode.label = "查詢模式"
emqx_bridge_azure_event_hub.reconnect_delay.desc = "連線斷開後，生產者嘗試重新連線到 Azure Event Hubs 之前的延遲時間。\n斷開期間，訊息會繼續在緩衝區中累積，受緩衝區限制和 <code>max_batch_age</code> 約束。"
emqx_bridge_azure_event_hub.reconnect_delay.label = "重連延遲"
emqx_bridge_azure_event_hub.request_timeout.desc = "等待 Azure Event Hubs 對待處理請求作出回應的最長時間。\n超過該時間後，連線被視為失效並會重新建立。\n注意：如果設定得太小，Azure Event Hubs 可能已經接收了某個生產請求但確認被延遲；EMQX 重連後會重發這個已被接受的批次，可能導致訊息重複，並給下游消費者帶來過大的資料量。"
emqx_bridge_azure_event_hub.request_timeout.label = "請求逾時"
emqx_bridge_azure_event_hub.required_acks.desc = "Azure Event Hubs 分割區領導者的確認標準。它確定了在向 EMQX Azure Event Hubs 生產者回送確認前，需要從追隨者分割區獲得的確認等級。\n\n<code>all_isr</code>：要求所有同步副本進行確認。\n<code>leader_only</code>：僅要求分割區領導者的確認。"
emqx_bridge_azure_event_hub.required_acks.label = "所需確認"
emqx_bridge_azure_event_hub.resource_opts.desc = "資源選項。"
emqx_bridge_azure_event_hub.resource_opts.label = "資源選項"
emqx_bridge_azure_event_hub.server_name_indication.desc = "TLS 握手的伺服器名稱指示（SNI）設定。<br/>\n- <code>auto</code>：用戶端將使用<code>\"servicebus.windows.net\"</code>作為SNI。<br/>\n- <code>disable</code>：如果您希望阻止用戶端傳送SNI。<br/>\n- 其他字串值將按原樣傳送。"
emqx_bridge_azure_event_hub.server_name_indication.label = "SNI"
emqx_bridge_azure_event_hub.socket_nodelay.desc = "當設定為'true'時，TCP 緩衝區將盡快傳送。否則，作業系統核心可能會暫時緩衝小的TCP資料包（預設為40毫秒）。"
emqx_bridge_azure_event_hub.socket_nodelay.label = "無延遲"
emqx_bridge_azure_event_hub.socket_opts.desc = "額外的套接字選項。"
emqx_bridge_azure_event_hub.socket_opts.label = "套接字選項"
emqx_bridge_azure_event_hub.socket_receive_buffer.desc = "對套接字接收緩衝區進行微調。預設值已經最佳化以提高吞吐量。"
emqx_bridge_azure_event_hub.socket_receive_buffer.label = "套接字接收緩衝區大小"
emqx_bridge_azure_event_hub.socket_send_buffer.desc = "微調套接字傳送緩衝區。預設值已調整為實現高吞吐量。"
emqx_bridge_azure_event_hub.socket_send_buffer.label = "Socket 傳送緩衝區大小"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.desc = "啟用 Azure Event Hubs 橋接連線的 TCP keepalive 功能。\n該值由三個以逗號分隔的數字組成，格式為 'Idle,Interval,Probes'\n - Idle: 連線在伺服器開始傳送 keepalive 探測之前必須處於空閒狀態的秒數（Linux 預設值為 7200 秒）。\n - Interval: TCP keepalive 探測之間的秒數（Linux 預設值為 75 秒）。\n - Probes: 在放棄並終止連線之前，從另一端未獲得回應時要傳送的 TCP keepalive 探測的最大數量（Linux 預設值為 9 次）。\n例如 \"240,30,5\" 表示：在連線空閒 240 秒後傳送 TCP 保活探測，每隔 30 秒傳送一次，直到收到回應，如果連續遺失 5 個回應，連線應該被關閉。\n預設值： 'none'"
emqx_bridge_azure_event_hub.socket_tcp_keepalive.label = "TCP keepalive 選項"
emqx_bridge_azure_event_hub.ssl_client_opts.desc = "用於 Azure Event Hubs 用戶端的 TLS/SSL 選項。"
emqx_bridge_azure_event_hub.ssl_client_opts.label = "TLS/SSL 選項"
emqx_bridge_azure_event_hub.sync_query_timeout.desc = "此參數定義同步查詢的逾時限制。僅當橋接查詢模式設定為 'sync' 時適用。"
emqx_bridge_azure_event_hub.sync_query_timeout.label = "同步查詢逾時"
