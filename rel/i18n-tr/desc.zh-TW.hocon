emqx_mgmt_api_publish.bad_request_code.desc = "錯誤請求"
emqx_mgmt_api_publish.bad_request_code.label = "錯誤請求程式碼"
emqx_mgmt_api_publish.error_message.desc = "失敗的詳細原因。"
emqx_mgmt_api_publish.message_id.desc = "全域唯一的一個訊息 ID，方便用於關聯和追蹤。"
emqx_mgmt_api_publish.message_properties.desc = "PUBLISH 訊息裡的 Property 欄位。"
emqx_mgmt_api_publish.msg_content_type.desc = "訊息內容類型必須是 UTF-8 編碼的字串。"
emqx_mgmt_api_publish.msg_correlation_data.desc = "關聯資料的識別碼，伺服器必須將關聯資料原封不動地傳送給接收應用訊息的所有的訂閱者。"
emqx_mgmt_api_publish.msg_message_expiry_interval.desc = "訊息過期間隔的識別碼。如果訊息過期間隔已過，而伺服器未能開始向匹配的訂閱者轉發訊息，則必須刪除該訂閱者的訊息副本。"
emqx_mgmt_api_publish.msg_payload_format_indicator.desc = "Payload 格式，0 (0x00) 位元組表示是未指定格式的資料，相當於沒有傳送 Payload 格式指示；1 (0x01) 位元組表示 Payload 是 UTF-8 編碼的字元資料，Payload 中的 UTF-8 資料必須是按照 Unicode 的規範和 RFC 3629 的標準要求進行編碼的。"
emqx_mgmt_api_publish.msg_response_topic.desc = "回應主題的識別碼。回應主題必須是 UTF-8 編碼的，且不得包含萬用字元字元。"
emqx_mgmt_api_publish.msg_user_properties.desc = "指定 MQTT 訊息的 User Property 鍵值對。注意，如果出現重複的鍵，只有最後一個會保留。"
emqx_mgmt_api_publish.payload.desc = "MQTT 訊息體."
emqx_mgmt_api_publish.payload_encoding.desc = "MQTT 訊息體的編碼方式，可以是 <code>base64</code> 或 <code>plain</code>。當設定為 <code>base64</code> 時，訊息在發布前會先被解碼，可以用於發布二進位制等資料。"
emqx_mgmt_api_publish.publish_api.desc = "發布單條資訊。<br/>\n可能的 HTTP 狀態碼如下：<br/>\n200: 訊息被成功傳送到至少一個訂閱。<br/>\n202: 沒有匹配到任何訂閱。<br/>\n400: 訊息編碼錯誤，如非法主題，或 QoS 超出範圍等。<br/>\n503: 服務重啟等過程中導致轉發失敗。"
emqx_mgmt_api_publish.publish_api.label = "發布單條資訊"
emqx_mgmt_api_publish.publish_bulk_api.desc = "批次發布多條訊息。<br/>\n可能的 HTTP 狀態碼如下：<br/>\n200: 所有的訊息都被成功傳送到至少一個訂閱。<br/>\n202: 至少有一個訊息沒有匹配到任何訂閱。<br/>\n400: 至少有一個訊息編碼錯誤，如非法主題，或 QoS 超出範圍等。<br/>\n503: 至少有一個小因為服務重啟的原因導致轉發失敗。<br/>\n\n請求的 Body 或者 Body 中包含的某個訊息無法透過 API 規範的類型檢查時，HTTP 回應的訊息與發布單個訊息的 API\n <code>/publish</code> 是一樣的。\n如果所有的訊息都是合法的，那麼 HTTP 回傳的內容是一個 JSON 陣列，每個元素代表了該訊息轉發的狀態。"
emqx_mgmt_api_publish.publish_bulk_api.label = "批次發布多條訊息"
emqx_mgmt_api_publish.qos.desc = "QoS"
emqx_mgmt_api_publish.reason_code.desc = "MQTT 訊息發布的錯誤碼，這些錯誤碼也是 MQTT 規範中 PUBACK 訊息可能攜帶的錯誤碼。<br/>\n目前支援如下錯誤碼：<br/>\n\n16(0x10)：沒能匹配到任何訂閱；<br/>\n131(0x81)：訊息轉發時發生錯誤，例如 EMQX 服務重啟；<br/>\n144(0x90)：主題名稱非法；<br/>\n151(0x97)：受到了速率限制，或者訊息尺寸過大。全域訊息大小限制可以透過設定項 <code>mqtt.max_packet_size</code> 來進行修改。<br/>\n注意：訊息尺寸的是透過主題和訊息體的位元組數進行估算的，具體發布時所佔用的位元組數可能會稍大於這個估算的值。"
emqx_mgmt_api_publish.retain.desc = "保留訊息，布林型欄位，用於表示該訊息是否是保留訊息。"
emqx_mgmt_api_publish.topic_name.desc = "主題"
