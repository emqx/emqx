emqx_otel_sampler_api.white_list_type.label = "白名單類型"
emqx_otel_schema.client_connect_disconnect.desc = "啟用/停用在設定的取樣比率下，所有用戶端的連線/斷開連線事件的後台追蹤。"
emqx_otel_schema.client_connect_disconnect.label = "追蹤用戶端連線/斷開連線"
emqx_otel_schema.client_messaging.desc = "啟用/停用在設定的取樣比率和追蹤級別下，所有用戶端的訊息傳輸事件的後台追蹤。"
emqx_otel_schema.client_messaging.label = "追蹤訊息傳輸事件"
emqx_otel_schema.client_subscribe_unsubscribe.desc = "啟用/停用在設定的取樣比率下，所有用戶端的訂閱/取消訂閱事件的後台追蹤。"
emqx_otel_schema.client_subscribe_unsubscribe.label = "追蹤用戶端訂閱/取消訂閱"
emqx_otel_schema.clientid_match_rules_max.desc = "用戶端 ID 匹配白名單的最大長度。"
emqx_otel_schema.clientid_match_rules_max.label = "用戶端 ID 匹配白名單的最大數量"
emqx_otel_schema.cluster_identifier.desc = "新增到 Span 的屬性中的一個屬性值。屬性鍵為 cluster.id\n通常，設定一個簡單且易於識別的名稱，或者使用叢集名稱來識別不同的 EMQX 叢集。"
emqx_otel_schema.cluster_identifier.label = "叢集識別碼"
emqx_otel_schema.dynatrace_auth.desc = "與 Dynatrace 整合時使用的認證方式。"
emqx_otel_schema.dynatrace_auth.label = "認證"
emqx_otel_schema.dynatrace_oauth2.desc = "使用 OAuth2 用戶端憑證進行認證"
emqx_otel_schema.dynatrace_oauth2.label = "OAuth2"
emqx_otel_schema.dynatrace_oauth2_resource.desc = "簽發 OAuth2 權杖時使用的資源。"
emqx_otel_schema.dynatrace_oauth2_resource.label = "資源"
emqx_otel_schema.e2e_tracing_options.desc = "端到端追蹤選項。"
emqx_otel_schema.e2e_tracing_options.label = "端到端追蹤選項"
emqx_otel_schema.enable.desc = "啟用或停用 open telemetry 指標"
emqx_otel_schema.enable.label = "啟用"
emqx_otel_schema.exporter_endpoint.desc = "匯出器將要傳送 Open Telemetry 訊號資料的目標 URL。必須顯式指定連接埠。"
emqx_otel_schema.exporter_endpoint.label = "匯出器端點"
emqx_otel_schema.exporter_headers.desc = "與 OpenTelemetry 訊號資料一起傳送的 HTTP 標頭。\n標頭是一個以標頭名稱為鍵的對映。"
emqx_otel_schema.exporter_headers.label = "匯出器標頭"
emqx_otel_schema.exporter_protocol.desc = "OpenTelemetry 匯出器的傳輸協定。\n僅支援 `grpc`。該匯出器無法傳送到 OTLP/HTTP 端點。"
emqx_otel_schema.exporter_protocol.label = "匯出器協定"
emqx_otel_schema.exporter_ssl.desc = "Open Telemetry 匯出器的 SSL 設定"
emqx_otel_schema.exporter_ssl.label = "SSL 選項"
emqx_otel_schema.exporting_timeout.desc = "Open Telemetry訊號匯出執行被取消之前可以執行的時間。"
emqx_otel_schema.exporting_timeout.label = "匯出逾時"
emqx_otel_schema.follow_traceparent.desc = "啟用/停用，是否透過 User-Property 跟隨用戶端傳遞的 traceparent。"
emqx_otel_schema.follow_traceparent.label = "跟隨 Traceparent"
emqx_otel_schema.max_queue_size.desc = "最大佇列大小。達到此大小後，Open Telemetry 訊號將被丟棄。"
emqx_otel_schema.max_queue_size.label = "最大佇列大小"
emqx_otel_schema.msg_trace_level.desc = "訊息發布過程中的所有訊息交換的追蹤級別。\n- 0：將記錄訊息發布過程中的基本事件作為 Span。\n 包括 'client.connect'、'client.authz'、'message.route'、'message.forward'、'message.handle_forward'、'broker.publish'。\n- 1：除了基本事件外，\n 事件 'broker.puback'、'client.puback'、'broker.pubrec'、'client.pubrec' 將作為 Span 記錄。\n 也就是 QoS1 或 QoS2 訊息互動中的第一個回應資料包。\n- 2：除了級別 1 的事件外，\n 事件 'broker.pubrel'、'client.pubrel'、'broker.pubcomp'、'client.pubcomp' 將作為 Span 記錄。"
emqx_otel_schema.msg_trace_level.label = "訊息追蹤級別"
emqx_otel_schema.opentelemetry.desc = "Open Telemetry 工具包設定"
emqx_otel_schema.opentelemetry.label = "Open Telemetry"
emqx_otel_schema.opentelemetry_dynatrace.desc = "與 Dynatrace 的 OpenTelemetry 整合。"
emqx_otel_schema.opentelemetry_dynatrace.label = "Dynatrace"
emqx_otel_schema.opentelemetry_type.desc = "OpenTelemetry 整合類型。"
emqx_otel_schema.opentelemetry_type.label = "類型"
emqx_otel_schema.otel_exporter.desc = "Open Telemetry 匯出器"
emqx_otel_schema.otel_exporter.label = "匯出器"
emqx_otel_schema.otel_log_handler_level.desc = "Open Telemetry 日誌處理器的日誌級別。"
emqx_otel_schema.otel_log_handler_level.label = "日誌級別"
emqx_otel_schema.otel_logs.desc = "Open Telemetry 日誌設定。如果啟用，EMQX 將安裝一個日誌處理器，根據 Open Telemetry 日誌資料模型格式化事件，並將它們匯出到設定的 Open Telemetry 收集器或後端。"
emqx_otel_schema.otel_logs.label = "Open Telemetry 日誌"
emqx_otel_schema.otel_metrics.desc = "Open Telemetry 指標設定。"
emqx_otel_schema.otel_metrics.label = "Open Telemetry 指標"
emqx_otel_schema.otel_traces.desc = "Open Telemetry 追蹤設定。"
emqx_otel_schema.otel_traces.label = "Open Telemetry 追蹤"
emqx_otel_schema.sample_ratio.desc = "列出事件類型的後台追蹤取樣比率。"
emqx_otel_schema.sample_ratio.label = "取樣比率"
emqx_otel_schema.scheduled_delay.desc = "兩次連續匯出 Open Telemetry 訊號之間的延遲間隔。"
emqx_otel_schema.scheduled_delay.label = "計劃延遲間隔"
emqx_otel_schema.topic_match_rules_max.desc = "基於主題匹配的白名單最大長度。"
emqx_otel_schema.topic_match_rules_max.label = "最大主題匹配白名單數量"
emqx_otel_schema.trace_all.desc = "如果啟用，將追蹤所有發布的訊息，如果無法從訊息中提取追蹤 ID，則生成新的追蹤 ID。\n否則，只追蹤帶有追蹤上下文的訊息。預設停用。\n注意：改設定只有當 `追蹤模式` 設定為 `legacy` 的時候才生效。"
emqx_otel_schema.trace_all.label = "追蹤全部"
emqx_otel_schema.trace_filter.desc = "Open Telemetry 追蹤過濾器設定"
emqx_otel_schema.trace_filter.label = "追蹤過濾器"
emqx_otel_schema.trace_mode.desc = "OpenTelemetry 追蹤模式。\n- legacy: 使用舊的追蹤方法，只追蹤訊息發布和傳遞。\n Span 名稱將與 5.9 之前的版本相容。\n- e2e: 端到端追蹤模式。所有用戶端行為都將被追蹤：\n - 連線和斷開連線\n - 訂閱和取消訂閱\n - 訊息事件，如 PUBLISH、PUBACK、PUBREL 等。\n 啟用後（對於每種事件類型），將對所有用戶端進行後台追蹤，按設定的取樣比例進行。\n 更多詳情見 Dashboard 或 API 文件。\n 從 Dashboard 中，您還可以為一組用戶端或主題在後台追蹤的基礎上新增額外的追蹤白名單。"
emqx_otel_schema.trace_mode.label = "追蹤模式"
emqx_otel_schema.trace_rule_engine.desc = "按設定的取樣比例，為所有用戶端啟用或停用規則引擎執行的後台追蹤。"
emqx_otel_schema.trace_rule_engine.label = "規則引擎追蹤"
emqx_plugins_api_endpoint.gateway_desc.desc = "對此端點的請求將傳遞到外掛實現。有關請求和回應詳情，請參閱外掛文件。"
emqx_plugins_api_endpoint.gateway_desc.label = "外掛 API 閘道"
emqx_plugins_schema.api_endpoint.desc = "外掛 API 端點轉發設定。"
emqx_plugins_schema.api_endpoint.label = "外掛 API 端點"
emqx_plugins_schema.api_endpoint_timeout.desc = "外掛 API 回呼處理的請求逾時。"
emqx_plugins_schema.api_endpoint_timeout.label = "外掛 API 逾時"
emqx_plugins_schema.check_interval.desc = "檢查間隔：檢查叢集中外掛的狀態是否一致，<br/>\n如果連續 3 次檢查結果不一致，則報警。"
emqx_plugins_schema.enable.desc = "設定為“true”以啟用此外掛。"
emqx_plugins_schema.enable.label = "啟用"
emqx_plugins_schema.install_dir.desc = "外掛安裝包的目錄，出於安全考慮，該目錄應該值允許 <code>emqx</code>，或用於執行 EMQX 服務的使用者擁有寫入權限。"
emqx_plugins_schema.install_dir.label = "安裝目錄"
emqx_plugins_schema.max_decompressed_size.desc = "外掛包解壓後所有檔案的最大總大小（位元組）。\n解壓後超過該值的外掛包將被拒絕。"
emqx_plugins_schema.max_decompressed_size.label = "最大解壓大小"
emqx_plugins_schema.max_extraction_time_ms.desc = "解壓外掛包所允許的最長時間。\n超過該時間的解壓操作將被中止。<br/>\n從叢集中其他節點複製外掛包時，該值也用作 RPC 逾時時間。"
emqx_plugins_schema.max_extraction_time_ms.label = "最長解壓時間"
emqx_plugins_schema.max_file_count.desc = "外掛包中允許包含的最大檔案條目數。"
emqx_plugins_schema.max_file_count.label = "最大檔案數"
emqx_plugins_schema.max_package_size.desc = "外掛包檔案（<code>.tar.gz</code>）的最大大小（位元組）。\n超過該值的上傳和叢集複製將被拒絕。"
emqx_plugins_schema.max_package_size.label = "最大外掛包大小"
emqx_plugins_schema.max_path_depth.desc = "外掛包中檔案條目的最大目錄深度。"
emqx_plugins_schema.max_path_depth.label = "最大路徑深度"
emqx_plugins_schema.name_vsn.desc = "外掛的名稱{name}-{version}。<br/>\n它應該與外掛的發布包名稱一致，如 my_plugin-0.1.0。"
emqx_plugins_schema.name_vsn.label = "名稱-版本"
emqx_plugins_schema.package_limits.desc = "寫入和解壓外掛包時應用的資源限制。<br/>\n這些限制可保護節點，避免過大、高壓縮比或目錄層級過深的外掛 tarball 造成影響。"
emqx_plugins_schema.package_limits.label = "外掛包限制"
emqx_plugins_schema.plugins.desc = "管理 EMQX 外掛。<br/>\n外掛可以是 EMQX 安裝包中的一部分，也可以是一個獨立的安裝包。<br/>\n獨立安裝的外掛稱為“外部外掛”。"
emqx_plugins_schema.plugins.label = "外掛"
emqx_plugins_schema.state.desc = "描述外掛的狀態"
emqx_plugins_schema.state.label = "外掛狀態"
emqx_plugins_schema.states.desc = "一組外掛的狀態。外掛將按照定義的順序啟動"
emqx_plugins_schema.states.label = "外掛啟動順序及狀態"
emqx_postgresql.application_name.desc = "用於 PostgreSQL 連線的應用名稱。此值會顯示在 PostgreSQL 活動檢視和日誌中。長度必須為 1 到 63 位元組，且不能包含零位元組。"
emqx_postgresql.application_name.label = "應用名稱"
emqx_postgresql.config_connector.desc = "PostgreSQL 連接器的設定。"
emqx_postgresql.config_connector.label = "PostgreSQL 連接器設定"
emqx_postgresql.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>\n一個主機條目的格式為：Host[:Port]。<br/>\n如果沒有指定 [:Port]，將使用 PostgreSQL 預設連接埠 5432。"
emqx_postgresql.server.label = "伺服器主機"
emqx_postgresql_connector_schema.application_name.desc = "用於 PostgreSQL 連線的應用名稱。此值會顯示在 PostgreSQL 活動檢視和日誌中。長度必須為 1 到 63 位元組，且不能包含零位元組。"
emqx_postgresql_connector_schema.application_name.label = "應用名稱"
emqx_postgresql_connector_schema.config_connector.desc = "PostgreSQL 連接器的設定。"
emqx_postgresql_connector_schema.config_connector.label = "PostgreSQL 連接器設定"
emqx_postgresql_connector_schema.server.desc = "用於連線的 IPv4 或 IPv6 地址或主機名。<br/>\n一個主機條目具有以下格式：Host[:Port]。<br/>\n如果未指定 [:Port]，將使用 PostgreSQL 預設連接埠5432。"
emqx_postgresql_connector_schema.server.label = "伺服器主機"
emqx_prometheus_api.get_prom_auth_data.desc = "取得 AuthN、AuthZ 和 Banned 的 Prometheus 指標"
emqx_prometheus_api.get_prom_auth_data.label = "Auth 的 Prometheus 指標"
emqx_prometheus_api.get_prom_conf_info.desc = "取得 Prometheus 設定資訊"
emqx_prometheus_api.get_prom_conf_info.label = "取得 Prometheus 設定資訊"
emqx_prometheus_api.get_prom_data.desc = "取得 Prometheus 資料"
emqx_prometheus_api.get_prom_data.label = "取得 Prometheus 資料"
emqx_prometheus_api.get_prom_data_integration_data.desc = "取得資料整合的 Prometheus 指標"
emqx_prometheus_api.get_prom_data_integration_data.label = "資料整合的 Prometheus 指標"
emqx_prometheus_api.get_prom_message_transformation.desc = "取得訊息驗證的 Prometheus 指標"
emqx_prometheus_api.get_prom_message_transformation.label = "訊息驗證的 Prometheus 指標"
emqx_prometheus_api.get_prom_schema_validation.desc = "取得 Schema 驗證的 Prometheus 指標."
emqx_prometheus_api.get_prom_schema_validation.label = "Schema 驗證 Prometheus 指標"
emqx_prometheus_api.get_prom_topic_metrics.desc = "取得主題指標集合（v2）的 Prometheus 指標。每個集合的計數器以集合名稱作為標籤暴露為 Prometheus gauges。"
emqx_prometheus_api.get_prom_topic_metrics.label = "主題指標集合的 Prometheus 指標"
emqx_prometheus_api.mode_parameter.desc = "指標格式模式。\n\n`node`：\n回傳本地節點的指標。如果未指定 `mode`，這是預設行為。\n\n`all_nodes_aggregated`：\n回傳所有節點的指標。\n如果可能，計算所有節點指標的算術和或邏輯和。\n\n`all_nodes_unaggregated`：\n回傳所有節點的指標，指標未聚合。\n回傳結果中將包含節點名稱，以指示某些指標是在某個節點上回傳的。"
emqx_prometheus_api.mode_parameter.label = "模式參數"
emqx_prometheus_api.ns_stats.desc = "取得 Prometheus 命名空間指標"
emqx_prometheus_api.ns_stats.label = "命名空間 Prometheus 指標"
emqx_prometheus_api.qp_namespace.desc = "用於按命名空間篩選指標的查詢參數。"
emqx_prometheus_api.qp_namespace.label = "命名空間過濾"
emqx_prometheus_api.update_prom_conf_info.desc = "更新 Prometheus 設定"
emqx_prometheus_api.update_prom_conf_info.label = "更新 Prometheus 設定"
emqx_prometheus_schema.collectors.desc = "虛擬機器的內部高階指標最初是停用的\n通常只在效能測試期間啟用。\n啟用它們將增加 CPU 負載。"
emqx_prometheus_schema.enable_basic_auth.desc = "啟用或停用 Prometheus 抓取 API 的認證（basic 或 bearer），不影響 Push Gateway。\n從 6.3.0 起預設值為 `true`，因此 `/api/v5/prometheus/*` 下的抓取端點需要憑據。\n設定為 `false` 時，端點無需認證即可存取，與 6.3.0 之前的行為一致。"
emqx_prometheus_schema.headers.desc = "推送到 Push Gateway 的 HTTP Headers 列表。<br/>\n例如，<code> { Authorization = \"some-authz-tokens\"}</code>"
emqx_prometheus_schema.interval.desc = "資料推送間隔"
emqx_prometheus_schema.job_name.desc = "推送到 Push Gateway 的 Job 名稱。可用變數為：<br/>\n- ${cluster_name}: EMQX 叢集的名稱。<br/>\n- ${name}: EMQX 節點的名稱。<br/>\n- ${host}: EMQX 節點主機名。\n例如，當 EMQX 節點名為 <code>emqx@127.0.0.1</code> 則 name 變數的值為 <code>emqx</code>，host 變數的值為 <code>127.0.0.1</code>。<br/>\n預設值為: <code>${name}/instance/${name}~${host}</code>"
emqx_prometheus_schema.latency_buckets.desc = "用於延遲直方圖分桶的逗號分隔時間時長值。"
emqx_prometheus_schema.latency_buckets.label = "延遲直方圖分桶"
emqx_prometheus_schema.legacy_deprecated_setting.desc = "自5.4.0版本起棄用。"
emqx_prometheus_schema.legacy_enable.desc = "自5.4.0版本起棄用，改用 `prometheus.push_gateway.url`。"
emqx_prometheus_schema.legacy_headers.desc = "自5.4.0版本起棄用，改用 `prometheus.push_gateway.headers`。"
emqx_prometheus_schema.legacy_interval.desc = "自5.4.0版本起棄用，改用 `prometheus.push_gateway.interval`。"
emqx_prometheus_schema.legacy_job_name.desc = "自5.4.0版本起棄用，改用 `prometheus.push_gateway.job_name`。"
emqx_prometheus_schema.legacy_mnesia_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.mnesia`。"
emqx_prometheus_schema.legacy_push_gateway_server.desc = "自5.4.0版本起棄用，改用 `prometheus.push_gateway.url`。"
emqx_prometheus_schema.legacy_vm_dist_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.vm_dist`。"
emqx_prometheus_schema.legacy_vm_memory_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.vm_memory`。"
emqx_prometheus_schema.legacy_vm_msacc_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.vm_msacc`。"
emqx_prometheus_schema.legacy_vm_statistics_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.vm_statistics`。"
emqx_prometheus_schema.legacy_vm_system_info_collector.desc = "自5.4.0版本起棄用，改用 `prometheus.collectors.vm_system_info`。"
emqx_prometheus_schema.mnesia_collector.desc = "開啟或關閉 Mnesia 採集器, 使用 mnesia:system_info/1 收集 Mnesia 相關指標"
emqx_prometheus_schema.namespaced_metrics_limiter.desc = "命名空間指標抓取端點的速率限制選項。"
emqx_prometheus_schema.namespaced_metrics_limiter.label = "限制器"
emqx_prometheus_schema.namespaced_metrics_limiter_rate.desc = "從所有命名空間請求資料時的最大請求速率。對特定命名空間的請求不受速率限制。"
emqx_prometheus_schema.namespaced_metrics_limiter_rate.label = "速率"
emqx_prometheus_schema.prometheus.desc = "預設啟用 EMQX 的 Prometheus 抓取端點。\n從 6.3.0 開始，抓取端點預設需要認證；可設定 `prometheus.enable_basic_auth = false` 恢復此前無需認證的行為。\n可以使用如下 `curl` 命令檢查端點：\n`curl -f -u <api-key>:<api-secret> \"127.0.0.1:18083/api/v5/prometheus/stats\"`。"
emqx_prometheus_schema.prometheus.label = "Prometheus"
emqx_prometheus_schema.push_gateway.desc = "Push Gateway 是可選的，如果 Prometheus 要抓取 EMQX，則不應設定。"
emqx_prometheus_schema.push_gateway_enable.desc = "啟用或停用 Pushgateway。"
emqx_prometheus_schema.push_gateway_method.desc = "推送指標到 Pushgateway 的 HTTP 方法。可選項如下：<br/>\n - <code>put</code>: 所有在 URL 中指定分組鍵的指標會被透過 PUT 推送的指標替換。<br/>\n - <code>post</code>: POST 方法與 PUT 方法完全相同，但僅替換與新推送的指標同名的指標。<br/>\n預設值為 <code>put</code>。"
emqx_prometheus_schema.push_gateway_url.desc = "Pushgateway 伺服器的 URL。Push Gateway 是可選的，如果 Prometheus 要抓取 EMQX，則不應設定。"
emqx_prometheus_schema.recommend_setting.desc = "推薦的設定"
emqx_prometheus_schema.vm_dist_collector.desc = "開啟或關閉 VM 分佈採集器，收集 Erlang 分佈機制中涉及的套接字和行程的資訊。"
emqx_prometheus_schema.vm_memory_collector.desc = "開啟或關閉 VM 記憶體採集器, 使用 erlang:memory/0 收集 Erlang 虛擬機器動態分配的記憶體資訊，同時提供基本的 (D)ETS 統計資訊"
emqx_prometheus_schema.vm_msacc_collector.desc = "開啟或關閉 VM msacc 採集器, 使用 erlang:statistics(microstate_accounting) 收集微狀態計數指標"
emqx_prometheus_schema.vm_statistics_collector.desc = "開啟或關閉 VM 統計採集器, 使用 erlang:statistics/1 收集 Erlang VM 相關指標"
emqx_prometheus_schema.vm_system_info_collector.desc = "開啟或關閉 VM 系統資訊採集器, 使用 erlang:system_info/1 收集 Erlang VM 相關指標"
emqx_psk_schema.chunk_size.desc = "將 PSK 檔案匯入到內建資料時每個塊的大小"
emqx_psk_schema.enable.desc = "是否開啟 TLS PSK 支援"
emqx_psk_schema.init_file.desc = "如果設定了初始化檔案，EMQX 將在啟動時從初始化檔案中匯入 PSK 資訊到內建資料庫中。\n這個檔案需要按行進行組織，每一行必須遵守如下格式: <code>PSKIdentity:SharedSecret</code>\n例如: <code>mydevice1:c2VjcmV0</code>"
emqx_psk_schema.psk_authentication.desc = "此設定用於啟用 TLS-PSK 身分驗證。\n\nPSK 是 “Pre-Shared Keys” 的縮寫。\n\n注意: 確保 SSL 監聽器僅啟用了 'tlsv1.2'，並且設定了 PSK 密碼套件，例如 'RSA-PSK-AES256-GCM-SHA384' 或 'ECDHE-PSK-CHACHA20-POLY1305'。\n\n可以透過檢視監聽器中的 SSL 選項，瞭解更多詳細資訊。\n\n可以透過設定 'init_file' 來設定初始化的 ID 和 金鑰"
emqx_psk_schema.separator.desc = "PSK 檔案中 <code>PSKIdentity</code> 和 <code>SharedSecret</code> 之間的分隔符"
emqx_redis.cluster.desc = "Cluster 模式。當 Redis 伺服器在叢集模式下執行時必須設定為'cluster'。"
emqx_redis.cluster.label = "Cluster 模式"
emqx_redis.database.desc = "Redis 資料庫 ID。"
emqx_redis.database.label = "資料庫 ID"
emqx_redis.redis_cluster_connector.desc = "叢集模式下的 Redis 連接器。"
emqx_redis.redis_cluster_connector.label = "Redis 叢集連接器"
emqx_redis.redis_sentinel_connector.desc = "Sentinel 模式下的 Redis 連接器。"
emqx_redis.redis_sentinel_connector.label = "Redis Sentinel 連接器"
emqx_redis.redis_single_connector.desc = "Single 模式下的 Redis 連接器。"
emqx_redis.redis_single_connector.label = "Redis Single 連接器"
emqx_redis.sentinel.desc = "Sentinel 模式。 當 Redis 伺服器在 Senitel 模式下執行時必須設定為 'sentinel' 。"
emqx_redis.sentinel.label = "Sentinel 模式"
emqx_redis.sentinel_desc.desc = "Redis sentinel 模式下的叢集名稱。"
emqx_redis.sentinel_desc.label = "Cluster 名稱"
emqx_redis.sentinel_password.desc = "用於與 Redis Sentinel 認證的密碼。當 Sentinel 不要求認證時請留空。"
emqx_redis.sentinel_password.label = "Sentinel 密碼"
emqx_redis.sentinel_username.desc = "用於與 Redis Sentinel 認證的使用者名稱。當 Sentinel 不要求 ACL 使用者名稱認證時請留空。"
emqx_redis.sentinel_username.label = "Sentinel 使用者名稱"
emqx_redis.server.desc = "將要連線的 IPv4 或 IPv6 地址，或者主機名。主機名具有以下形式：Host[:Port]。如果未指定 [:Port]，則使用 Redis 預設連接埠 6379。"
emqx_redis.server.label = "伺服器地址"
emqx_redis.servers.desc = "叢集將要連線的節點列表。 節點之間用逗號分隔，如：Node[,Node]。每個節點的設定為：將要連線的 IPv4 或 IPv6 地址或主機名。主機名具有以下形式：Host[:Port]。如果未指定 [:Port]，則使用 Redis 預設連接埠 6379。"
emqx_redis.servers.label = "伺服器列表"
emqx_redis.single.desc = "Single 模式。 當 Redis 伺服器在 Single 模式下執行時必須設定為 'single' 。"
emqx_redis.single.label = "Single 模式"
emqx_resource_schema.batch_size.desc = "最大批次請求大小。如果設為 1，則無批處理。"
emqx_resource_schema.batch_size.label = "最大批次請求大小"
emqx_resource_schema.batch_time.desc = "在較低訊息率情況下嘗試累積批次輸出時的最長等待間隔，以提高資源的利用率。"
emqx_resource_schema.batch_time.label = "批次等待最長間隔"
emqx_resource_schema.buffer_seg_bytes.desc = "當快取模式是 <code>volatile_offload</code> 時適用。該設定用於指定快取到磁碟上的檔案的大小。"
emqx_resource_schema.buffer_seg_bytes.label = "快取檔案大小"
emqx_resource_schema.creation_opts.desc = "資源啟動相關的選項。"
emqx_resource_schema.creation_opts.label = "資源啟動選項"
emqx_resource_schema.dispatch_strategy.desc = "當查詢未設定顯式 pick key 時的分發策略。預設值 <code>per_clientid</code> 保持現有行為。設定為 <code>random</code> 可將此類查詢分散到多個工作行程。"
emqx_resource_schema.dispatch_strategy.label = "分發策略"
emqx_resource_schema.enable_batch.desc = "啟用批次模式。"
emqx_resource_schema.enable_batch.label = "啟用批次模式"
emqx_resource_schema.enable_queue.desc = "啟用磁碟快取佇列（僅對 egress 方向橋接有用）。"
emqx_resource_schema.enable_queue.label = "啟用磁碟快取佇列"
emqx_resource_schema.health_check_interval.desc = "健康檢查間隔。"
emqx_resource_schema.health_check_interval.label = "健康檢查間隔"
emqx_resource_schema.health_check_interval_jitter.desc = "一個均勻的隨機延遲將被新增到健康檢查間隔中，以便來自同一 Connector 的動作和源在不同的時刻開始它們的健康檢查。"
emqx_resource_schema.health_check_interval_jitter.label = "健康檢查間隔抖動"
emqx_resource_schema.health_check_timeout.desc = "健康檢查逾時。如果健康檢查呼叫回傳結果的時間超過此時間，則資源被視為斷開連線。"
emqx_resource_schema.health_check_timeout.label = "健康檢查逾時"
emqx_resource_schema.inflight_window.desc = "請求飛行佇列視窗大小。當請求模式為非同步時，如果需要嚴格保證來自同一 MQTT 用戶端的訊息有序，則必須將此值設為 1。"
emqx_resource_schema.inflight_window.label = "請求飛行佇列視窗"
emqx_resource_schema.max_buffer_bytes.desc = "每個快取 worker 允許使用的最大位元組數。"
emqx_resource_schema.max_buffer_bytes.label = "快取佇列最大長度"
emqx_resource_schema.query_mode.desc = "請求模式。可選 '同步/非同步'，預設為'非同步'模式。"
emqx_resource_schema.query_mode.label = "請求模式"
emqx_resource_schema.request_ttl.desc = "從請求進入緩衝區的時刻開始，如果請求在指定的時間內仍然停留在緩衝區中，或者已經傳送但沒有及時收到回應或確認，該請求將被視為過期。"
emqx_resource_schema.request_ttl.label = "請求 TTL（生存時間）"
emqx_resource_schema.resource_opts.desc = "資源相關的選項。"
emqx_resource_schema.resource_opts.label = "資源選項"
emqx_resource_schema.resume_interval.desc = "在傳送失敗後嘗試重傳飛行視窗中的請求的時間間隔。"
emqx_resource_schema.resume_interval.label = "重試時間間隔"
emqx_resource_schema.start_after_created.desc = "是否在建立資源後立即啟動資源。"
emqx_resource_schema.start_after_created.label = "建立後立即啟動"
emqx_resource_schema.start_timeout.desc = "在回覆資源建立請求前等待資源進入健康狀態的時間。"
emqx_resource_schema.start_timeout.label = "啟動逾時時間"
emqx_resource_schema.worker_pool_size.desc = "快取佇列 worker 數量。僅對 egress 類型的橋接有意義。當橋接僅有 ingress 方向時，可設定為 0，否則必須大於 0。"
emqx_resource_schema.worker_pool_size.label = "快取池大小"
emqx_retainer_api.config_content.desc = "設定內容"
emqx_retainer_api.config_not_found.desc = "設定不存在"
emqx_retainer_api.delete_matching_api.desc = "刪除對應的訊息"
emqx_retainer_api.delete_matching_api.label = "刪除對應的訊息"
emqx_retainer_api.delete_messages.desc = "刪除所有保留訊息"
emqx_retainer_api.delete_messages.label = "刪除保留訊息"
emqx_retainer_api.from_clientid.desc = "發布者用戶端 ID"
emqx_retainer_api.from_username.desc = "發布者使用者名稱"
emqx_retainer_api.get_config_api.desc = "檢視設定內容"
emqx_retainer_api.get_config_api.label = "檢視設定內容"
emqx_retainer_api.list_retained_api.desc = "檢視保留訊息列表"
emqx_retainer_api.list_retained_api.label = "檢視保留訊息列表"
emqx_retainer_api.lookup_api.desc = "不支援主題萬用字元"
emqx_retainer_api.lookup_api.label = "指定主題檢視保留訊息"
emqx_retainer_api.message_detail.desc = "訊息詳情"
emqx_retainer_api.message_not_exist.desc = "訊息不存在"
emqx_retainer_api.msgid.desc = "訊息 ID"
emqx_retainer_api.payload.desc = "訊息內容"
emqx_retainer_api.publish_at.desc = "訊息傳送時間, RFC 3339 格式"
emqx_retainer_api.qos.desc = "QoS"
emqx_retainer_api.query_match_topic.desc = "主題過濾器，支援萬用字元，省略此項以匹配所有訊息。"
emqx_retainer_api.retained_list.desc = "保留訊息列表"
emqx_retainer_api.topic.desc = "主題"
emqx_retainer_api.unsupported_backend.desc = "不支援的後端"
emqx_retainer_api.update_config_failed.desc = "設定更新失敗"
emqx_retainer_api.update_config_success.desc = "設定更新成功"
emqx_retainer_api.update_retainer_api.desc = "更新設定"
emqx_retainer_api.update_retainer_api.label = "更新設定"
emqx_retainer_schema.allow_never_expire.desc = "如果為 true，設定為永不過期的保留訊息（即 `Message-Expiry-Interval = 0`）將不會受到過期時間覆寫的影響。此設定僅在 `msg_expiry_interval_override` 設定時生效。"
emqx_retainer_schema.backend.desc = "保留訊息的儲存後端"
emqx_retainer_schema.backends.desc = "用於儲存保留訊息的外部後端。"
emqx_retainer_schema.batch_deliver_limiter.desc = "（已棄用）保留訊息投遞的限流器名稱。\n限流器可以用來防止短時間內向用戶端傳送太多的訊息，從而避免過多的訊息導致用戶端佇列堵塞甚至崩潰。\n這個名稱需要是指向 `limiter.batch` 下的一個真實存在的限流器。\n如果這個欄位為空，則不使用限流器。"
emqx_retainer_schema.batch_deliver_number.desc = "批次派發時每批的數量。0 代表一次性全部派發"
emqx_retainer_schema.batch_read_number.desc = "從儲存讀取訊息時的批次大小。設定為 0 與設定為 1000 的效果相同。"
emqx_retainer_schema.delivery_rate.desc = "傳送保留訊息的最大速率"
emqx_retainer_schema.enable.desc = "是否開啟訊息保留功能"
emqx_retainer_schema.flow_control.desc = "流控設定"
emqx_retainer_schema.index_specs.desc = "保留索引規範：正序整數陣列列表。\n每個陣列指定一個索引。索引規範中的數字是主題中的基於 1 的單詞位置。指定位置的單詞將用於索引。<br/>\n例如，擁有 <code>[2, 4]</code> 索引可以最佳化 <code>+/X/+/Y/...</code> 主題萬用字元訂閱。"
emqx_retainer_schema.max_payload_size.desc = "允許儲存的保留訊息的最大大小。EMQX 將拒絕儲存超過此大小的保留訊息，並輸出包含關鍵字 'retain_failed_for_payload_size_exceeded_limit' 的錯誤日誌。\n\n0 表示保留訊息大小不受限制。"
emqx_retainer_schema.max_publish_rate.desc = "發布保留訊息的最大速率。超過該限制發布的訊息會被傳遞，但不會作為保留訊息儲存。"
emqx_retainer_schema.max_retained_messages.desc = "訊息保留的數量上限。0 表示無限"
emqx_retainer_schema.mnesia_config.desc = "儲存保留訊息的內部資料庫設定。"
emqx_retainer_schema.mnesia_config_storage_type.desc = "選擇訊息是存放在磁碟還是記憶體中"
emqx_retainer_schema.mnesia_config_type.desc = "後端類型"
emqx_retainer_schema.mnesia_enable.desc = "啟用內建的 Mnesia 後端。"
emqx_retainer_schema.msg_clear_interval.desc = "訊息清理間隔。0 代表不進行清理"
emqx_retainer_schema.msg_clear_limit.desc = "每次在 `msg_clear_interval` 期間清除的過期訊息數量上限。設定合理的限制可以防止清理過程執行時間過長並消耗過多資源。"
emqx_retainer_schema.msg_expiry_interval.desc = "訊息保留時間。0 代表永久保留"
emqx_retainer_schema.msg_expiry_interval_override.desc = "如果設定了此值，它將優先於任何在保留的 MQTT 訊息中指定的 `Message-Expiry-Interval` 屬性，從而允許訊息在必要時更早過期。此覆寫設定僅適用於垃圾回收過程：它不會影響正在寫入的訊息的過期時間，也不會影響在迭代過程中已經寫入的訊息的過期時間。因此，當覆寫時，可能會被垃圾回收的訊息在訂閱保留主題時仍然可見。"
emqx_retainer_schema.retainer.desc = "與處理 `PUBLISH` 包相關的設定，其中 `retain` 標誌設定為 1。"
emqx_retainer_schema.stop_publish_clear_msg.desc = "當 PUBLISH 訊息的保留標誌被設定且有效載荷為空時，是否繼續發布訊息。\n參見：\nhttp://docs.oasis-open.org/mqtt/mqtt/v3.1.1/os/mqtt-v3.1.1-os.html#_Toc398718038"
emqx_rewrite_api.list_topic_rewrite_api.desc = "列出全部主題重寫規則"
emqx_rewrite_api.list_topic_rewrite_api.label = "列出全部主題重寫規則"
emqx_rewrite_api.update_topic_rewrite_api.desc = "更新全部主題重寫規則"
emqx_rewrite_api.update_topic_rewrite_api.label = "更新全部主題重寫規則"
emqx_rewrite_api.update_topic_rewrite_api_response400.desc = "錯誤請求"
emqx_rewrite_api.update_topic_rewrite_api_response400.label = "錯誤的請求"
emqx_rewrite_api.update_topic_rewrite_api_response413.desc = "超出主題重寫規則數量上限"
emqx_rewrite_api.update_topic_rewrite_api_response413.label = "超出主題重寫規則數量上限"
emqx_rule_api_schema.alarm_activated_at.desc = "警報啟用時間。"
emqx_rule_api_schema.alarm_activated_at.label = "警報啟用時間"
emqx_rule_api_schema.alarm_deactivated_at.desc = "警報解除時間。"
emqx_rule_api_schema.alarm_deactivated_at.label = "警報解除時間"
emqx_rule_api_schema.alarm_details.desc = "警報的附加詳情。"
emqx_rule_api_schema.alarm_details.label = "警報詳情"
emqx_rule_api_schema.alarm_message.desc = "警報訊息。"
emqx_rule_api_schema.alarm_message.label = "警報訊息"
emqx_rule_api_schema.alarm_name.desc = "警報名稱。"
emqx_rule_api_schema.alarm_name.label = "警報名稱"
