emqx_schema_validation_schema.desc_validation.label = "驗證"
emqx_schema_validation_schema.failure_action.desc = "如果驗證失敗，將如何處理。\n\n  <code>drop</code>：違規訊息將被直接丟棄，不進行進一步處理。\n  <code>disconnect</code>：訊息不會被發布，發布用戶端將被斷開連線。\n  <code>ignore</code>：僅記錄和追蹤失敗，不採取其他行動。"
emqx_schema_validation_schema.failure_action.label = "驗證失敗操作"
emqx_schema_validation_schema.log_failure_at.desc = "將以哪種日誌級別記錄驗證失敗。"
emqx_schema_validation_schema.log_failure_at.label = "失敗日誌級別"
emqx_schema_validation_schema.name.desc = "此驗證的名稱。在所有驗證中必須唯一。只能使用字母、數字和下劃線的組合，且不能以數字或下劃線開頭。"
emqx_schema_validation_schema.name.label = "名稱"
emqx_schema_validation_schema.strategy.desc = "驗證如何判定檢查是否成功。\n\n  <code>all_pass</code>：所有檢查都會執行且必須全部透過。\n  <code>any_pass</code>：任一檢查透過即可。遇到第一個成功即停止。"
emqx_schema_validation_schema.strategy.label = "策略"
emqx_schema_validation_schema.topics.desc = "此驗證規則應驗證的單個主題過濾器或主題過濾器列表。"
emqx_schema_validation_schema.topics.label = "主題（過濾器）"
