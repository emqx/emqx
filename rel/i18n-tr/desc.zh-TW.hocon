emqx_dashboard_monitor_api.validation_succeeded_rate.label = "驗證成功速率"
emqx_dashboard_schema.backlog.desc = "排隊等待連線的佇列的最大長度。"
emqx_dashboard_schema.backlog.label = "排隊長度"
emqx_dashboard_schema.bind.desc = "將監聽器繫結到指定的地址和連接埠號，例如 127.0.0.1:18083。\n如果僅設定連接埠號（例如 18083），則相當於繫結到所有地址 0.0.0.0。\n如果 bind 設定為 0，則停用監聽器。"
emqx_dashboard_schema.bind.label = "監聽地址與連接埠"
emqx_dashboard_schema.bootstrap_users_file.desc = "已廢棄，請使用 api_key.bootstrap_file。"
emqx_dashboard_schema.bootstrap_users_file.label = "初始化使用者列表（已廢棄）"
emqx_dashboard_schema.cors.desc = "CORS（Cross-Origin Resource Sharing，跨域資源共享）允許伺服器回應來自任何來源（域名、協定或連接埠）的請求，啟用後允許另一個域名下的服務直接透過 JavaScript 呼叫 EMQX REST API。"
emqx_dashboard_schema.cors.label = "CORS"
emqx_dashboard_schema.default_mfa.desc = "Dashboard 的預設多重身分認證（MFA）設定。\n當設定為 `none` 時，可在 Dashboard 為每個使用者單獨啟用 MFA。\n如果設定為 `{mechanism = totp}`，使用者在首次登入時將自動初始化一個隨機的 TOTP 金鑰。"
emqx_dashboard_schema.default_mfa.label = "預設 MFA 設定"
emqx_dashboard_schema.default_password.desc = "用於初始化 admin 使用者資料庫記錄的密碼。\n注意：在初始化（第一次啟動）後更改預設密碼將不起作用。\n一旦初始化完成，預設密碼 public 必須儘快透過 Dashboard 或 CLI 更改。"
emqx_dashboard_schema.default_password.label = "預設密碼"
emqx_dashboard_schema.default_username.desc = "Dashboard 的預設使用者名稱，僅在首次啟動 EMQX 之前設定有效。"
emqx_dashboard_schema.default_username.label = "預設使用者名稱"
emqx_dashboard_schema.desc_dashboard.desc = "EMQX Dashboard 設定。"
emqx_dashboard_schema.desc_dashboard.label = "Dashboard"
emqx_dashboard_schema.desc_http.desc = "Dashboard 監聽器的設定（plaintext）。"
emqx_dashboard_schema.desc_http.label = "HTTP"
emqx_dashboard_schema.desc_https.desc = "Dashboard 監聽器的設定（TLS）。"
emqx_dashboard_schema.desc_https.label = "HTTPS"
emqx_dashboard_schema.desc_listeners.desc = "Dashboard 監聽器設定。"
emqx_dashboard_schema.desc_listeners.label = "監聽器"
emqx_dashboard_schema.http_listener_settings.desc = "HTTP 監聽器的設定。"
emqx_dashboard_schema.http_listener_settings.label = "HTTP 監聽器設定"
emqx_dashboard_schema.https_listener_settings.desc = "HTTPS 監聽器的設定。"
emqx_dashboard_schema.https_listener_settings.label = "HTTPS 監聽器設定"
emqx_dashboard_schema.hwmark_expire_time.desc = "指定高水位線指標的過期間隔，例如會話歷史高水位線 (`sessions_hist_hwmark`)。\n高水位線在設定的持續時間內有效。\n當它過期時，系統會掃描到目前為止記錄的值，並將高水位線更新為觀察到的最高值。\n注意：時間不得超過 7 天 (`7d`)"
emqx_dashboard_schema.hwmark_expire_time.label = "高水位線過期時間"
emqx_dashboard_schema.i18n_lang.desc = "設定 Swagger 文件與設定項說明的語言，可為 en、zh 或 zh-TW，預設為 en。"
emqx_dashboard_schema.i18n_lang.label = "Swagger API 預設語言"
emqx_dashboard_schema.inet6.desc = "啟用 IPv6， 如果機器不支援 IPv6，請關閉此選項，否則會導致 Dashboard 無法使用。"
emqx_dashboard_schema.inet6.label = "IPv6"
emqx_dashboard_schema.ipv6_v6only.desc = "當開啟 inet6 功能的同時停用 IPv4-to-IPv6 對映。該設定僅在 inet6 功能開啟時有效。"
emqx_dashboard_schema.ipv6_v6only.label = "IPv6 only"
emqx_dashboard_schema.listener_enable.desc = "忽略或啟用該監聽器。"
emqx_dashboard_schema.listener_enable.label = "啟用監聽器"
emqx_dashboard_schema.listeners.desc = "Dashboard 監聽器設定。監聽器必須有唯一的連接埠號和 IP 地址的組合。\n例如，可以透過指定 IP 地址 0.0.0.0 來監聽機器上給定連接埠上的所有設定的 IP 地址。\n或者，可以為每個監聽器指定唯一的 IP 地址，但使用相同的連接埠。"
emqx_dashboard_schema.listeners.label = "監聽器"
emqx_dashboard_schema.max_connections.desc = "同時處理的最大連線數。"
emqx_dashboard_schema.max_connections.label = "最大連線數"
emqx_dashboard_schema.mfa_mechanism.desc = "多重身分認證（MFA）機制。"
emqx_dashboard_schema.mfa_mechanism.label = "MFA 機制"
emqx_dashboard_schema.mfa_settings.desc = "多重身分認證（MFA）設定。"
emqx_dashboard_schema.mfa_settings.label = "MFA 設定"
emqx_dashboard_schema.num_acceptors.desc = "TCP 協定的 Socket acceptor 池大小, 通常設定為 CPU 核數"
emqx_dashboard_schema.num_acceptors.label = "Acceptor 數量"
emqx_dashboard_schema.password_expired_time.desc = "使用者密碼的過期時間。預設值 `0` 表示密碼永不過期。"
emqx_dashboard_schema.password_login.desc = "選擇儀表板本地使用者登入接受舊版密碼請求，還是 SCRAM 挑戰-回應。"
emqx_dashboard_schema.password_login.label = "Dashboard 密碼登入模式"
emqx_dashboard_schema.proxy_header.desc = "啟用 Proxy 協定以提取用戶端連線的原始資訊，要求使用了 Proxy 伺服器並且 Proxy 伺服器也啟用 Proxy 協定。注意：一旦開啟了這個功能，就無法再處理普通的 HTTP 請求。"
emqx_dashboard_schema.proxy_header.label = "啟用 Proxy 協定"
emqx_dashboard_schema.sample_interval.desc = "Dashboard 中圖表指標的時間間隔。必須小於 60，且被 60 的整除，預設為 10s。"
emqx_dashboard_schema.send_timeout.desc = "傳送回應內容的逾時時間。"
emqx_dashboard_schema.send_timeout.label = "傳送逾時時間"
emqx_dashboard_schema.ssl_listener_settings.desc = "Dashboard HTTPS 監聽器的 TLS 設定。"
emqx_dashboard_schema.ssl_listener_settings.label = "SSL 監聽器設定"
emqx_dashboard_schema.ssl_options.desc = "Dashboard 監聽器的 SSL/TLS 選項。"
emqx_dashboard_schema.ssl_options.label = "SSL 選項"
emqx_dashboard_schema.swagger_support.desc = "啟用或停用對 Swagger API 文件的支援。"
emqx_dashboard_schema.swagger_support.label = "Swagger 支援"
emqx_dashboard_schema.token_expired_time.desc = "登入成功回傳的 JWT token 過期時間，預設為 60 分鐘。"
emqx_dashboard_schema.token_expired_time.label = "登入過期時間"
emqx_dashboard_schema.unsuccessful_login_interval.desc = "累計不成功登入嘗試次數的時間間隔。"
emqx_dashboard_schema.unsuccessful_login_interval.label = "不成功登入累計時間間隔"
emqx_dashboard_schema.unsuccessful_login_lock_duration.desc = "在達到最大不成功登入嘗試次數後，使用者被鎖定的時間。"
emqx_dashboard_schema.unsuccessful_login_lock_duration.label = "登入鎖定持續時間"
emqx_dashboard_schema.unsuccessful_login_max_attempts.desc = "允許使用者的不成功登入嘗試的最大次數。\n在設定的時間間隔內達到此次數後，使用者將被禁止登入一段時間。"
emqx_dashboard_schema.unsuccessful_login_max_attempts.label = "不成功登入最大嘗試次數"
emqx_dashboard_schema_api.get_schema.desc = "取得指定名稱的 Schema JSON。\n注意：僅用於 EMQX Dashboard。"
emqx_dashboard_schema_api.get_schema.label = "取得 Schema"
emqx_dashboard_schema_api.schema_json_response.desc = "指定名稱的 JSON Schema。"
emqx_dashboard_schema_api.schema_json_response.label = "Schema JSON 回應"
emqx_dashboard_sso_api.backend_name.desc = "後端名稱"
emqx_dashboard_sso_api.backend_name.label = "後端名稱"
emqx_dashboard_sso_api.backend_name_in_qs.desc = "查詢字串中的 SSO 後端名稱。"
emqx_dashboard_sso_api.backend_name_in_qs.label = "後端名稱（查詢）"
emqx_dashboard_sso_api.backend_not_found.desc = "操作失敗。後端不存在"
emqx_dashboard_sso_api.bad_request.desc = "錯誤請求。SSO code 無效或已過期。"
