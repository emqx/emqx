emqx_bridge_snowflake_aggregated_action_schema.proxy_config_host.label = "Proxy 主機"
emqx_bridge_snowflake_aggregated_action_schema.proxy_config_port.desc = "連線時使用的 Proxy 連接埠。"
emqx_bridge_snowflake_aggregated_action_schema.proxy_config_port.label = "Proxy 連接埠"
