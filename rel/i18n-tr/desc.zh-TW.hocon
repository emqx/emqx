emqx_bridge_http_connector.body.label = "HTTP 請求體"
emqx_bridge_http_connector.connect_timeout.desc = "連線到 HTTP 伺服器的逾時時間。"
emqx_bridge_http_connector.connect_timeout.label = "連線逾時"
emqx_bridge_http_connector.enable_pipelining.desc = "一個正整數。是否連續傳送 HTTP 請求，當設定為1時，意味著在傳送每個 HTTP 請求後，需要等待伺服器回傳，然後繼續傳送下一個請求。"
emqx_bridge_http_connector.enable_pipelining.label = "HTTP 流水線"
