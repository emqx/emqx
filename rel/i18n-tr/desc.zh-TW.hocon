emqx_bridge_confluent_producer.desc_config.label = "Confluent 動作設定"
emqx_bridge_confluent_producer.desc_name.desc = "動作名稱，用作動作的可讀描述。"
emqx_bridge_confluent_producer.desc_name.label = "動作名稱"
emqx_bridge_confluent_producer.desc_type.desc = "動作的類型"
emqx_bridge_confluent_producer.desc_type.label = "動作類型"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.desc = "Confluent 標頭值編碼模式<br/>\n - None：僅向 Confluent 標頭新增二進位制值；<br/>\n - JSON：僅向 Confluent 標頭新增 JSON 值，並在傳送前將其編碼為 JSON 字串。"
emqx_bridge_confluent_producer.kafka_header_value_encode_mode.label = "Confluent 標頭值編碼模式"
emqx_bridge_confluent_producer.kafka_headers.desc = "提供用作 Confluent 標頭的佔位符<br/>\n例如<code>${pub_props}</code><br/>\n注意，佔位符的值必須是物件：\n<code>{\"foo\": \"bar\"}</code>\n或鍵值對陣列：\n<code>[{\"key\": \"foo\", \"value\": \"bar\"}]</code>"
emqx_bridge_confluent_producer.kafka_headers.label = "Confluent 標頭"
emqx_bridge_confluent_producer.kafka_message.desc = "呈現 Confluent 訊息的模版。"
emqx_bridge_confluent_producer.kafka_message.label = "Confluent 訊息模版"
emqx_bridge_confluent_producer.kafka_message_key.desc = "用於呈現 Confluent 訊息鍵的模版。如果模板呈現為空值（即在規則引擎上下文中沒有此類資料欄位），則使用 Confluent 的 NULL（而不是空字串）。"
emqx_bridge_confluent_producer.kafka_message_key.label = "訊息鍵"
emqx_bridge_confluent_producer.kafka_message_timestamp.desc = "使用哪個時間戳。時間戳應為毫秒級 Unix 紀元時間，可以是字串格式，例如<code>1661326462115</code>或<code>'1661326462115'</code>。當找不到所需資料欄位或找到的資料不是有效的整數時，將使用目前系統時間戳。"
emqx_bridge_confluent_producer.kafka_message_timestamp.label = "訊息時間戳"
emqx_bridge_confluent_producer.kafka_message_value.desc = "用於呈現 Confluent 訊息鍵的模版。如果模板呈現為空值（即在規則引擎上下文中沒有此類資料欄位），則使用 Confluent 的 NULL（而不是空字串）。"
emqx_bridge_confluent_producer.kafka_message_value.label = "訊息值"
emqx_bridge_confluent_producer.kafka_producer.desc = "Confluent 生產者設定。"
emqx_bridge_confluent_producer.kafka_producer.label = "Confluent 生產者"
emqx_bridge_confluent_producer.kafka_topic.desc = "事件中心名稱。支援使用模版（例如：`t-${payload.t}`）。"
emqx_bridge_confluent_producer.kafka_topic.label = "事件中心名稱"
emqx_bridge_confluent_producer.max_batch_age.desc = "訊息在生產者緩衝區中停留的最長時間，超過該時間後訊息將被丟棄而不再傳送到 Confluent。\n只有當一個訊息批次中的所有訊息在緩衝區中的停留時間都超過該時長時，該批次才會被丟棄；這既適用於仍在排隊的訊息（包括連線斷開期間），也適用於連線遺失時正在等待確認的訊息。\n每條被丟棄的訊息都會計入 <code>dropped.expired</code> 指標。\n設定為 <code>infinity</code> 時，訊息永不過期（將一直保留直到傳送成功，或緩衝區溢位）。"
emqx_bridge_confluent_producer.max_batch_age.label = "最長批次存留時間"
emqx_bridge_confluent_producer.max_batch_bytes.desc = "最大 Confluent 訊息批次位元組數。大多數 Kafka 環境的預設最低值是 1 MB，EMQX 的預設值比 1 MB 更小是因為需要補償 Kafka 訊息編碼所需要的額外位元組（尤其是當每條訊息都很小的情況下）。當單個訊息的大小超過該限制時，它仍然會被傳送，（相當於該批次中只有單個訊息）。"
emqx_bridge_confluent_producer.max_batch_bytes.label = "最大批次位元組數"
emqx_bridge_confluent_producer.max_inflight.desc = "Confluent 生產者在接收到 Confluent 的確認之前，每個分割區允許傳送的批次的最大數量。較高的值通常意味著更好的吞吐量。然而，當這個值大於1時，可能會有訊息重新排序的風險。"
emqx_bridge_confluent_producer.max_inflight.label = "飛行視窗"
emqx_bridge_confluent_producer.max_linger_bytes.desc = "每個分割區生產者在等待期間最多累積的位元組數，達到該值後將停止等待併傳送該批次。"
emqx_bridge_confluent_producer.max_linger_bytes.label = "最大等待位元組數"
emqx_bridge_confluent_producer.max_linger_time.desc = "每個分割區生產者為了將更多訊息累積成更大批次而等待的最長時間。\n預設值 `0` 表示不等待（訊息到達後立即傳送），以最佳化訊息延遲。\n如果可以接受少量延遲，建議設定一個等待時間，以幫助降低每秒向 Confluent 傳送的請求數。\n一旦累積的資料達到一個完整批次，等待就會提前結束，因此繁忙的生產者不會被額外延遲。\n當緩衝到磁碟時，等待發生在寫入緩衝區之前；此時建議設定至少 `5ms` 以減少磁碟 IOPS。"
emqx_bridge_confluent_producer.max_linger_time.label = "最長等待時間"
emqx_bridge_confluent_producer.max_retries.desc = "在 Confluent 回傳可重試錯誤（例如分割區 leader 已變更）後，重試傳送訊息批次的最大次數。\n當首次嘗試和所有重試均失敗後，該批次將被丟棄，其中每條訊息都會計入 <code>failed</code> 指標。\n只有當 Confluent 明確回傳錯誤碼時重試計數器才會遞增；由連線斷開觸發的重發不會遞增該計數器（這類重發由 <code>max_batch_age</code> 限制）。\n設定為 <code>infinity</code> 時，重試次數不受限制。"
emqx_bridge_confluent_producer.max_retries.label = "最大重試次數"
emqx_bridge_confluent_producer.metadata_request_timeout.desc = "從 Confluent 取得後設資料的最長等待時間。"
emqx_bridge_confluent_producer.metadata_request_timeout.label = "後設資料請求逾時"
emqx_bridge_confluent_producer.min_metadata_refresh_interval.desc = "用戶端重新整理 Confluent Kafka broker 和主題後設資料的最短時間間隔。設定過小的值可能會給 Confluent 增加額外的負載。"
emqx_bridge_confluent_producer.min_metadata_refresh_interval.label = "最小後設資料重新整理間隔"
emqx_bridge_confluent_producer.mqtt_topic.desc = "將 MQTT 主題或主題過濾器作為資料來源（動作輸入）。如果使用規則動作作為資料來源，則應將此設定保留為空，否則訊息將在 Confluent 中重複。"
emqx_bridge_confluent_producer.mqtt_topic.label = "源 MQTT 主題"
emqx_bridge_confluent_producer.oauth_client_credentials_client_id.desc = "用於從 OAuth 伺服器請求權杖的用戶端 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_client_id.label = "OAuth 用戶端 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_client_secret.desc = "用於從 OAuth 伺服器請求權杖的用戶端金鑰。"
emqx_bridge_confluent_producer.oauth_client_credentials_client_secret.label = "OAuth 用戶端金鑰"
emqx_bridge_confluent_producer.oauth_client_credentials_endpoint_uri.desc = "生成存取權杖的 OAuth 權杖端點的 URI。"
emqx_bridge_confluent_producer.oauth_client_credentials_endpoint_uri.label = "OAuth 權杖端點 URI"
emqx_bridge_confluent_producer.oauth_client_credentials_extensions.desc = "如果需要，指定要傳遞到 SASL 握手的擴充套件。"
emqx_bridge_confluent_producer.oauth_client_credentials_extensions.label = "SASL 擴充套件"
emqx_bridge_confluent_producer.oauth_client_credentials_grant_type.desc = "OAuth 授權類型"
emqx_bridge_confluent_producer.oauth_client_credentials_grant_type.label = "OAuth 授權類型"
emqx_bridge_confluent_producer.oauth_client_credentials_identity_pool_id.desc = "連線時在 SASL 擴充套件中使用的 Confluent 身分池 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_identity_pool_id.label = "身分池 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_logical_cluster.desc = "連線時在 SASL 擴充套件中使用的 Confluent 叢集 ID。"
emqx_bridge_confluent_producer.oauth_client_credentials_logical_cluster.label = "邏輯叢集 ID"
emqx_bridge_confluent_producer.oauth_client_credentials_mechanism.desc = "SASL 認證機制"
emqx_bridge_confluent_producer.oauth_client_credentials_mechanism.label = "SASL 認證機制"
emqx_bridge_confluent_producer.oauth_client_credentials_scope.desc = "如果需要，指定在請求 OAuth 存取權杖時提供的 `scope`。"
emqx_bridge_confluent_producer.oauth_client_credentials_scope.label = "OAuth 請求作用域"
emqx_bridge_confluent_producer.partition_count_refresh_interval.desc = "Confluent 生產者發現分割區數量增加的時間間隔。\n在 Confluent 中增加分割區數量後，EMQX 將開始根據<code>partition_strategy</code>\n在分發訊息時考慮新發現的分割區。"
emqx_bridge_confluent_producer.partition_count_refresh_interval.label = "分割區數重新整理間隔"
emqx_bridge_confluent_producer.partition_strategy.desc = "分割區策略是用來指導生產者如何將訊息分配到 Confluent 的各個分割區。\n\n<code>random</code>: 為每條訊息隨機選擇一個分割區。\n<code>key_dispatch</code>: 根據 Confluent 訊息鍵的雜湊值將訊息分配到分割區，確保擁有相同鍵的訊息能夠一致地被分配到特定分割區。"
emqx_bridge_confluent_producer.partition_strategy.label = "分割區策略"
emqx_bridge_confluent_producer.partitions_limit.desc = "限制為給定主題產生資料的分割區數量。\n特殊值 all_partitions 用於利用主題的所有分割區。\n設定的值如果大於分割區總數則無效。"
emqx_bridge_confluent_producer.partitions_limit.label = "最大分割區數"
emqx_bridge_confluent_producer.producer_buffer.desc = "設定生產者訊息緩衝區。\n\n在 EMQX 有更多訊息需要傳送而 Confluent 跟不上時，或者 Confluent 宕機時，告訴 Confluent 生產者如何緩衝訊息。"
emqx_bridge_confluent_producer.producer_buffer.label = "訊息緩衝"
emqx_bridge_confluent_producer.producer_health_check_topic.desc = "專用於更精確的連接器健康檢查的主題名稱。"
emqx_bridge_confluent_producer.producer_health_check_topic.label = "連接器健康檢查主題"
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.desc = "Confluent 標頭的鍵。支援${var}格式的佔位符。"
emqx_bridge_confluent_producer.producer_kafka_ext_header_key.label = "額外的 Confluent 標頭鍵"
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.desc = "Confluent 標頭的值。支援${var}格式的佔位符。"
emqx_bridge_confluent_producer.producer_kafka_ext_header_value.label = "額外的 Confluent 標頭值"
emqx_bridge_confluent_producer.producer_kafka_ext_headers.desc = "請提供更多的 Confluent 標頭鍵值對<br/>\n這裡的鍵值對將與<code>kafka_headers</code>欄位的值結合後傳送給 Confluent。"
emqx_bridge_confluent_producer.producer_kafka_ext_headers.label = "更多的 Confluent 標頭"
emqx_bridge_confluent_producer.producer_kafka_opts.desc = "Confluent 生產者設定。"
emqx_bridge_confluent_producer.producer_kafka_opts.label = "Confluent 生產者"
emqx_bridge_confluent_producer.producer_opts.desc = "本地 MQTT 資料來源和 Confluent 動作設定。"
emqx_bridge_confluent_producer.producer_opts.label = "MQTT 到 Confluent"
emqx_bridge_confluent_producer.query_mode.desc = "查詢模式。可選'sync/async'，預設'async'。"
emqx_bridge_confluent_producer.query_mode.label = "查詢模式"
emqx_bridge_confluent_producer.reconnect_delay.desc = "連線斷開後，生產者嘗試重新連線到 Confluent 之前的延遲時間。\n斷開期間，訊息會繼續在緩衝區中累積，受緩衝區限制和 <code>max_batch_age</code> 約束。"
emqx_bridge_confluent_producer.reconnect_delay.label = "重連延遲"
emqx_bridge_confluent_producer.request_timeout.desc = "等待 Confluent 對待處理請求作出回應的最長時間。\n超過該時間後，連線被視為失效並會重新建立。\n注意：如果設定得太小，Confluent 可能已經接收了某個生產請求但確認被延遲；EMQX 重連後會重發這個已被接受的批次，可能導致訊息重複，並給下游消費者帶來過大的資料量。"
emqx_bridge_confluent_producer.request_timeout.label = "請求逾時"
emqx_bridge_confluent_producer.required_acks.desc = "Confluent 分割區領導者的確認標準。它確定了在向 EMQX Confluent 生產者回送確認前，需要從追隨者分割區獲得的確認等級。\n\n<code>all_isr</code>：要求所有同步副本進行確認。\n<code>leader_only</code>：僅要求分割區領導者的確認。"
emqx_bridge_confluent_producer.required_acks.label = "所需確認"
emqx_bridge_confluent_producer.resource_opts.desc = "資源選項。"
emqx_bridge_confluent_producer.resource_opts.label = "資源選項"
emqx_bridge_confluent_producer.server_name_indication.desc = "TLS 握手的伺服器名稱指示（SNI）設定。<br/>\n- <code>auto</code>：用戶端將使用<code>\"servicebus.windows.net\"</code>作為 SNI。<br/>\n- <code>disable</code>：如果您不希望用戶端傳送 SNI。<br/>\n- 其他字串值將按原樣傳送。"
emqx_bridge_confluent_producer.server_name_indication.label = "SNI"
emqx_bridge_confluent_producer.socket_nodelay.desc = "當設定為'true'時，TCP 緩衝區將儘可能快地傳送。否則，作業系統核心可能會暫時緩衝小的 TCP 資料包（預設40毫秒）。"
emqx_bridge_confluent_producer.socket_nodelay.label = "無延遲"
emqx_bridge_confluent_producer.socket_opts.desc = "額外的套接字選項。"
emqx_bridge_confluent_producer.socket_opts.label = "套接字選項"
emqx_bridge_confluent_producer.socket_receive_buffer.desc = "微調套接字接收緩衝區。為實現高吞吐量，預設值已調整。"
emqx_bridge_confluent_producer.socket_receive_buffer.label = "套接字接收緩衝區大小"
emqx_bridge_confluent_producer.socket_send_buffer.desc = "微調套接字傳送緩衝區。為實現高吞吐量，預設值已調整。"
emqx_bridge_confluent_producer.socket_send_buffer.label = "套接字傳送緩衝區大小"
emqx_bridge_confluent_producer.socket_tcp_keepalive.desc = "啟用 TCP keepalive。\n值為三個逗號分隔的數字，格式為 'Idle,Interval,Probes'\n - Idle：連線需要空閒的秒數，伺服器才開始傳送 keep-alive 探測包（Linux 預設 7200）。\n - Interval：TCP keep-alive 探測包之間的秒數（Linux 預設 75）。\n - Probes：在放棄並關閉連線之前，最多傳送的 TCP keep-alive 探測包數（Linux 預設 9）。\n例如 \"240,30,5\" 表示：在連線空閒 240 秒後傳送 TCP keepalive 探測，每隔 30 秒傳送一次，直到收到回應，如果連續遺失 5 個回應，連線應該被關閉。\n預設：'none'"
emqx_bridge_confluent_producer.socket_tcp_keepalive.label = "TCP keepalive 選項"
emqx_bridge_confluent_producer.ssl_client_opts.desc = "Confluent 用戶端的 TLS/SSL 選項。"
emqx_bridge_confluent_producer.ssl_client_opts.label = "TLS/SSL 選項"
emqx_bridge_confluent_producer.sync_query_timeout.desc = "此參數定義同步查詢的逾時限制。僅在動作查詢模式設定為'sync'時適用。"
emqx_bridge_confluent_producer.sync_query_timeout.label = "同步查詢逾時"
emqx_bridge_couchbase_action_schema.couchbase.desc = "將傳入事件上傳到 Couchbase 服務的動作。"
emqx_bridge_couchbase_action_schema.couchbase.label = "上傳到 Couchbase"
emqx_bridge_couchbase_action_schema.max_retries.desc = "傳送請求時發生錯誤的最大重試次數。"
emqx_bridge_couchbase_action_schema.max_retries.label = "最大重試次數"
emqx_bridge_couchbase_action_schema.parameters.desc = "動作的參數集。"
emqx_bridge_couchbase_action_schema.parameters.label = "Couchbase 動作參數"
emqx_bridge_couchbase_action_schema.sql.desc = "SQL 模版。"
emqx_bridge_couchbase_action_schema.sql.label = "SQL 模版"
emqx_bridge_couchbase_connector_schema.config_connector.desc = "用於連線 Couchbase 服務的連接器設定。"
emqx_bridge_couchbase_connector_schema.config_connector.label = "Couchbase 連接器設定"
emqx_bridge_couchbase_connector_schema.connect_timeout.desc = "連線到 HTTP 伺服器時的逾時時間。"
emqx_bridge_couchbase_connector_schema.connect_timeout.label = "連線逾時"
emqx_bridge_couchbase_connector_schema.password.desc = "存取 Couchbase 服務的密碼。"
emqx_bridge_couchbase_connector_schema.password.label = "密碼"
emqx_bridge_couchbase_connector_schema.pipelining.desc = "一個正整數，表示是否連續傳送 HTTP 請求。當設定為 1 時，表示每次傳送 HTTP 請求後，需要等待伺服器回傳再繼續傳送下一個請求。"
emqx_bridge_couchbase_connector_schema.pipelining.label = "HTTP 流水線"
emqx_bridge_couchbase_connector_schema.pool_size.desc = "指定與 Couchbase 服務對接時連線池中可以維持的併發連線數。"
emqx_bridge_couchbase_connector_schema.pool_size.label = "連線池大小"
emqx_bridge_couchbase_connector_schema.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>\n  主機條目的格式為：`Host[:Port]`。`Host[:Port]`.<br/>\n  如果未指定 `[:Port]`，則使用 Couchbase 預設的查詢服務連接埠 8093。"
emqx_bridge_couchbase_connector_schema.server.label = "伺服器地址"
emqx_bridge_couchbase_connector_schema.username.desc = "存取 Couchbase 服務的使用者名稱。"
emqx_bridge_couchbase_connector_schema.username.label = "使用者名稱"
emqx_bridge_datalayers.action_parameters_arrow_flight.desc = "使用 Arrow Flight 驅動的特定附加參數"
emqx_bridge_datalayers.action_parameters_arrow_flight.label = "動作參數"
emqx_bridge_datalayers.action_parameters_influx.desc = "使用 Influx Line Protocol 的特定附加參數"
emqx_bridge_datalayers.action_parameters_influx.label = "動作參數"
emqx_bridge_datalayers.connector.desc = "Datalayers 連接器設定"
emqx_bridge_datalayers.connector.label = "Datalayers 連接器"
emqx_bridge_datalayers.datalayers_action.desc = "用於與 Datalayers 連接器互動的動作。"
emqx_bridge_datalayers.datalayers_action.label = "Datalayers 動作"
emqx_bridge_datalayers.desc_config.desc = "Datalayers 資料整合的設定"
emqx_bridge_datalayers.desc_config.label = "Datalayers 資料整合設定"
emqx_bridge_datalayers.desc_name.desc = "資料整合的名稱。"
emqx_bridge_datalayers.desc_name.label = "資料整合名稱"
emqx_bridge_datalayers.desc_type.desc = "資料整合的類型。"
emqx_bridge_datalayers.desc_type.label = "資料整合類型"
emqx_bridge_datalayers.sql_template.desc = "SQL 模板"
emqx_bridge_datalayers.sql_template.label = "SQL 模板"
emqx_bridge_datalayers.write_syntax.desc = "用於寫入資料點的 InfluxDB 行協定設定。這是一種基於文字的格式，提供資料點的測量、標籤集、欄位集和時間戳，並支援佔位符。\n詳見 [InfluxDB 1.8 行協定](https://docs.influxdata.com/influxdb/v1.8/write_protocols/line_protocol_tutorial/) <br/>\n簡短說明：<br/>\n```\n<measurement>[,<tag_key>=<tag_value>[,<tag_key>=<tag_value>]] <field_key>=<field_value>[,<field_key>=<field_value>] [<timestamp>]\n```\n請注意，整數值的佔位符必須帶有字尾 `i`。 例如 `${payload.int_value}i`。"
emqx_bridge_datalayers.write_syntax.label = "寫入語法"
emqx_bridge_datalayers_connector.database.desc = "Datalayers 資料庫"
emqx_bridge_datalayers_connector.database.label = "資料庫"
emqx_bridge_datalayers_connector.datalayers_api.desc = "Datalayers 協定。"
emqx_bridge_datalayers_connector.datalayers_api.label = "HTTP API 協定"
emqx_bridge_datalayers_connector.datalayers_parameters.desc = "特定於此 Datalayers 連接器類型的參數集。"
emqx_bridge_datalayers_connector.datalayers_parameters.label = "Datalayers 特定參數"
emqx_bridge_datalayers_connector.driver_type.desc = "用於與 Datalayers 服務通訊的驅動程式。"
emqx_bridge_datalayers_connector.driver_type.label = "驅動類型"
emqx_bridge_datalayers_connector.enable_prepared.desc = "啟用 Datalayers 連接器的預準備語句。\n注意：此參數僅在 <code>driver_type</code> 設定為 <code>arrow_flight</code> 時生效。"
emqx_bridge_datalayers_connector.enable_prepared.label = "啟用預準備語句"
emqx_bridge_datalayers_connector.password.desc = "Datalayers 密碼。"
emqx_bridge_datalayers_connector.password.label = "密碼"
emqx_bridge_datalayers_connector.pool_size.desc = "連線池的大小，指向橋接目標服務的連線池大小。"
emqx_bridge_datalayers_connector.pool_size.label = "連線池大小"
emqx_bridge_datalayers_connector.precision.desc = "Datalayers 時間精度。"
emqx_bridge_datalayers_connector.precision.label = "時間精度"
emqx_bridge_datalayers_connector.server.desc = "要連線的 IPv4 或 IPv6 地址或主機名。<br/>\n主機條目的格式為：`Host[:Port]`.<br/>\n如果未指定 `[:Port]`，則使用 Datalayers 的預設連接埠 8361。"
emqx_bridge_datalayers_connector.server.label = "伺服器地址"
emqx_bridge_datalayers_connector.username.desc = "Datalayers 使用者名稱。"
emqx_bridge_datalayers_connector.username.label = "使用者名稱"
emqx_bridge_disk_log_action_schema.action_parameters.desc = "該操作的一組參數。"
emqx_bridge_disk_log_action_schema.action_parameters.label = "磁碟日誌操作參數"
emqx_bridge_disk_log_action_schema.disk_log.desc = "將接收到的事件追加到本地迴圈日誌檔案（JSON 行格式）中的操作。"
emqx_bridge_disk_log_action_schema.disk_log.label = "追加到日誌檔案"
emqx_bridge_disk_log_action_schema.parameters.desc = "動作特定參數。"
emqx_bridge_disk_log_action_schema.parameters.label = "參數"
emqx_bridge_disk_log_action_schema.template.desc = "要寫入的 JSON 物件的內容，支援使用模板。"
emqx_bridge_disk_log_action_schema.template.label = "內容"
emqx_bridge_disk_log_action_schema.write_mode.desc = "日誌是同步寫入還是非同步寫入磁碟。"
emqx_bridge_disk_log_action_schema.write_mode.label = "寫入模式"
emqx_bridge_disk_log_connector_schema.config_connector.desc = "磁碟日誌連接器的設定。"
emqx_bridge_disk_log_connector_schema.config_connector.label = "磁碟日誌連接器設定"
emqx_bridge_disk_log_connector_schema.filepath.desc = "要寫入日誌檔案的基礎路徑。實際日誌檔案的格式為 `filepath.N`， 其中 `N` 的範圍為 `1..max_file_number`。當啟用基於時間的輪換（`rotation.period`）時，還會在副檔名前插入目前週期的日期戳：當 `filepath = /var/log/emqx/mqtt-trace.log` 時，檔名形如 `mqtt-trace-2026062400.log.N`。目前使用的檔案可以透過查詢修改時間最新的檔案來確定。請注意，EMQX 應用程式使用者必須對該目錄具有寫入權限，因為該目錄還包含額外的內部使用檔案（副檔名為 .siz 和 .idx）。"
emqx_bridge_disk_log_connector_schema.filepath.label = "日誌檔案路徑"
emqx_bridge_disk_log_connector_schema.max_file_number.desc = "最大日誌檔案數量。當啟用基於時間的輪換（`rotation.period`）時，此限制分別應用於每個輪換週期的檔案集合。當達到最大檔案數量且需要進行新一輪日誌輪轉時，日誌將回卷：最舊檔案的內容會被丟棄，該檔案將被重用為新的目前日誌檔案。"
emqx_bridge_disk_log_connector_schema.max_file_number.label = "最大檔案數量"
emqx_bridge_disk_log_connector_schema.max_file_size.desc = "目前正在寫入的日誌檔案的最大大小。至少會向每個日誌檔案寫入一條日誌，因此如果單條日誌條目超過該值，則最終檔案大小可能會超過此最大值。"
emqx_bridge_disk_log_connector_schema.max_file_size.label = "最大檔案大小"
emqx_bridge_disk_log_connector_schema.rotation.desc = "在日曆週期（天或小時）邊界輪換到一組新日誌檔案的相關設定，檔名中會編碼該週期的日期，並可清理舊週期的檔案。"
emqx_bridge_disk_log_connector_schema.rotation.label = "基於時間的輪換"
emqx_bridge_disk_log_connector_schema.rotation_period.desc = "設定為 `day` 或 `hour` 時，連接器會在每個週期邊界啟用一組新的日誌檔案，並在副檔名前插入該週期的日期戳（`YYYYMMDDHH`）：當 `filepath = /var/log/emqx/mqtt-trace.log` 時，`hour` 的檔名形如 `mqtt-trace-2026062413.log.N`，`day` 的檔名形如 `mqtt-trace-2026062400.log.N`（按天的日期戳小時部分始終為 `00`，因此之後修改 `period` 時檔名格式保持不變）。`.N` 字尾（`N` 的範圍為 `1..max_file_number`）來自底層的回捲日誌，始終存在；每個週期的檔案集合還包含 `.idx` 和 `.siz` 記帳檔案。在一個週期內，檔案仍會按大小（`max_file_size`）輪換，因此請按最壞情況的週期規劃 `max_file_size × max_file_number` 的容量，以免因週期內回捲而遺失資料。週期邊界在連接器的健康檢查時鐘上檢測，因此新週期的檔案會在邊界之後的 `health_check_interval` 內出現。設定為 `none`（預設）時，僅使用基於大小的輪換。"
emqx_bridge_disk_log_connector_schema.rotation_period.label = "輪換週期"
emqx_bridge_disk_log_connector_schema.rotation_retention_period.desc = "保留此前輪換週期檔案的時長。每次週期輪換後，早於該時長的帶日期戳日誌檔案（包括其 `.idx` 和 `.siz` 記帳檔案）將被刪除。預設值 `infinity` 表示永久保留。當 `period` 為 `none` 時無效。"
emqx_bridge_disk_log_connector_schema.rotation_retention_period.label = "保留時長"
emqx_bridge_disk_log_connector_schema.rotation_timezone.desc = "用於確定週期邊界和日期戳的時區。可為 `UTC`（預設）、`local`（伺服器本地時間），或固定的 UTC 偏移量，如 `+02:00`。"
emqx_bridge_disk_log_connector_schema.rotation_timezone.label = "輪換時區"
