emqx_bridge_tablestore.desc_measurement.label = "度量名稱"
emqx_bridge_tablestore.desc_meta_update_model.desc = "時間序列後設資料的更新模式。可以是以下之一：\n- MUM_NORMAL: 正常模式。當以此模式傳送訊息時，如果時間序列後設資料不存在，Tablestore 將動態建立後設資料。\n- MUM_IGNORE: 不更新後設資料。當以此模式傳送訊息時，Tablestore 將不會嘗試建立時間序列後設資料。\n預設為 MUM_NORMAL。"
emqx_bridge_tablestore.desc_meta_update_model.label = "後設資料更新模式"
emqx_bridge_tablestore.desc_probe_table_name.desc = "用於健康檢查探測連通性的現有時序表名稱。未設定時，健康檢查將回退為列出所有時序表。"
emqx_bridge_tablestore.desc_probe_table_name.label = "探測表名稱"
emqx_bridge_tablestore.desc_table_name.desc = "序列表名稱。 可以是靜態值或佔位符，如 `${payload.table_name}`。"
emqx_bridge_tablestore.desc_table_name.label = "表名"
emqx_bridge_tablestore.desc_tags.desc = "標籤。標籤鍵和值可以是靜態字串或佔位符，如 `${payload.tag_key}` 和 `${payload.tag_value}`。"
emqx_bridge_tablestore.desc_tags.label = "標籤"
emqx_bridge_tablestore.desc_timestamp.desc = "欄位的微秒時間戳。\n可以是靜態值或佔位符，如 `${payload.microsecond_timestamp}`。\n如果未提供或設定為 `NOW`，則 EMQX 寫入 Tablestore 時的毫秒時間戳將被使用。"
emqx_bridge_tablestore.desc_timestamp.label = "時間戳"
emqx_bridge_tablestore.pool_size.desc = "連線池大小。"
emqx_bridge_tablestore.pool_size.label = "連線池大小"
emqx_bridge_tablestore.storage_model_type.desc = "儲存模型類型。可以是 `timeseries` 或 `order`。"
emqx_bridge_tablestore.storage_model_type.label = "儲存模型類型"
emqx_bridge_tablestore.tablestore_action.desc = "與 Tablestore 連接器互動的動作。"
emqx_bridge_tablestore.tablestore_action.label = "Tablestore 動作"
emqx_bridge_tablestore.tablestore_fields.desc = "Tablestore 欄位。"
emqx_bridge_tablestore.tablestore_fields.label = "Tablestore 欄位"
emqx_bridge_tablestore.tablestore_fields_column.desc = "欄位的列名。可以是靜態值或佔位符，如 `${payload.column}`。"
emqx_bridge_tablestore.tablestore_fields_column.label = "列"
emqx_bridge_tablestore.tablestore_fields_isbinary.desc = "是否嘗試將二進位制值寫為 `binary` 類型。預設為 `false`，表示將二進位制值寫為字串。\n可以是靜態值或佔位符，如 `${payload.is_binary}`。"
emqx_bridge_tablestore.tablestore_fields_isbinary.label = "是否為二進位制"
emqx_bridge_tablestore.tablestore_fields_isint.desc = "是否嘗試將數值寫為 `integer` 類型。預設為 `false`，表示將整數寫為浮動數。\n可以是靜態值或佔位符，如 `${payload.is_int}`。"
emqx_bridge_tablestore.tablestore_fields_isint.label = "是否為整數"
emqx_bridge_tablestore.tablestore_fields_value.desc = "欄位的值。可以是靜態值或佔位符，如 `${payload.value}`。"
emqx_bridge_tablestore.tablestore_fields_value.label = "值"
