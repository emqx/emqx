emqx_schema_registry_schema.avro_type.label = "Apache Avro"
emqx_schema_registry_schema.confluent_schema_registry.desc = "Confluent 外部 Schema Registry 設定。"
emqx_schema_registry_schema.confluent_schema_registry.label = "Confluent Schema Registry"
emqx_schema_registry_schema.confluent_schema_registry_auth.desc = "存取外部 registry 的認證選項。"
emqx_schema_registry_schema.confluent_schema_registry_auth.label = "認證"
emqx_schema_registry_schema.confluent_schema_registry_auth_basic.desc = "使用基本認證方法存取外部 registry。"
emqx_schema_registry_schema.confluent_schema_registry_auth_basic.label = "基本認證"
emqx_schema_registry_schema.confluent_schema_registry_auth_basic_password.desc = "基本認證方法的密碼。"
emqx_schema_registry_schema.confluent_schema_registry_auth_basic_password.label = "密碼"
emqx_schema_registry_schema.confluent_schema_registry_auth_basic_username.desc = "基本認證方法的使用者名稱。"
