emqx_bridge_oracle.sid.desc = "Oracle 資料庫系統識別碼名稱"
emqx_bridge_oracle.sid.label = "Oracle 資料庫系統識別碼"
emqx_bridge_oracle.sql_template.desc = "SQL 模板。模板字串可以包含訊息後設資料和有效載荷欄位的佔位符。佔位符的插入不需要任何檢查和特殊格式化，因此必須確保插入的數值格式化和轉義正確。模板字串可以包含佔位符模板字串可以包含訊息後設資料和有效載荷欄位的佔位符。這些佔位符被插入所以必須確保插入的值的格式正確。因此，確保插入的值格式化和轉義正確是非常重要的。模板字串可以包含佔位符模板字串可以包含訊息後設資料和有效載荷欄位的佔位符。這些佔位符被插入所以必須確保插入的值的格式正確。確保插入的值被正確地格式化和轉義。"
emqx_bridge_oracle.sql_template.label = "SQL 模板"
emqx_bridge_pgsql.action_parameters.desc = "特定於 PostgreSQL 動作的參數設定"
emqx_bridge_pgsql.action_parameters.label = "動作參數"
emqx_bridge_pgsql.config_enable.desc = "啟用/停用橋接"
emqx_bridge_pgsql.config_enable.label = "啟用/停用橋接"
emqx_bridge_pgsql.desc_config.desc = "PostgreSQL 橋接設定"
emqx_bridge_pgsql.desc_config.label = "PostgreSQL 橋接設定"
emqx_bridge_pgsql.desc_name.desc = "橋接名字"
emqx_bridge_pgsql.desc_name.label = "橋接名字"
emqx_bridge_pgsql.desc_type.desc = "Bridge 類型"
emqx_bridge_pgsql.desc_type.label = "橋接類型"
emqx_bridge_pgsql.pgsql_action.desc = "PostgreSQL 動作的設定"
emqx_bridge_pgsql.pgsql_action.label = "PostgreSQL 動作設定"
emqx_bridge_pgsql.sql_template.desc = "SQL 模板"
emqx_bridge_pgsql.sql_template.label = "SQL 模板"
emqx_bridge_pulsar.auth_basic.desc = "基本認證的參數。"
emqx_bridge_pulsar.auth_basic.label = "基本認證參數"
emqx_bridge_pulsar.auth_basic_password.desc = "基本認證密碼，即 `username:password` 認證字串中的 `password` 部分。<br/>\n如需從檔案載入密碼而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為密碼使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_bridge_pulsar.auth_basic_password.label = "密碼"
emqx_bridge_pulsar.auth_basic_username.desc = "基本認證使用者名稱。"
emqx_bridge_pulsar.auth_basic_username.label = "使用者名稱"
emqx_bridge_pulsar.auth_token.desc = "Token 認證的參數。"
emqx_bridge_pulsar.auth_token.label = "Token 認證參數"
emqx_bridge_pulsar.auth_token_jwt.desc = "JWT 認證 token。<br/>\n如需從檔案載入 token 而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為 token 使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_bridge_pulsar.auth_token_jwt.label = "JWT"
emqx_bridge_pulsar.authentication.desc = "認證參數。"
emqx_bridge_pulsar.authentication.label = "認證"
emqx_bridge_pulsar.buffer_memory_overload_protection.desc = "快取模式是 <code>memory</code> 或 <code>hybrid</code> 時適用。當系統處於高記憶體壓力時，從佇列中丟棄舊的訊息以減緩記憶體增長。注意，該設定僅在 Linux 系統中有效。"
emqx_bridge_pulsar.buffer_memory_overload_protection.label = "記憶體過載保護"
emqx_bridge_pulsar.buffer_mode.desc = "訊息快取模式。\n<code>memory</code>: 所有的訊息都快取在記憶體裡。如果 EMQX 服務重啟，快取的訊息會遺失。\n<code>disk</code>: 快取到磁碟上。EMQX 重啟後會繼續傳送重啟前未傳送完成的訊息。\n<code>hybrid</code>: 先將訊息快取在記憶體中，當記憶體中的訊息堆積超過一定限制（設定項 <code>segment_bytes</code> 描述了該限制）後，後續的訊息會快取到磁碟上。與 <code>memory</code> 模式一樣，如果 EMQX 服務重啟，快取的訊息會遺失。"
emqx_bridge_pulsar.buffer_mode.label = "快取模式"
emqx_bridge_pulsar.buffer_per_partition_limit.desc = "為每個 Pulsar 分割區設定的最大快取位元組數。當超過這個上限之後，老的訊息會被丟棄，為新的訊息騰出空間。"
emqx_bridge_pulsar.buffer_per_partition_limit.label = "Pulsar 分割區快取上限"
emqx_bridge_pulsar.buffer_segment_bytes.desc = "當快取模式是 <code>disk</code> 或 <code>hybrid</code> 時適用。該設定用於指定快取到磁碟上的檔案的大小。"
emqx_bridge_pulsar.buffer_segment_bytes.label = "快取檔案大小"
emqx_bridge_pulsar.config_connector.desc = "Pulsar 連接器設定。"
emqx_bridge_pulsar.config_connector.label = "Pulsar 連接器"
emqx_bridge_pulsar.config_enable.desc = "啟用（true）或停用（false）該 Pulsar 資料橋接。"
emqx_bridge_pulsar.config_enable.label = "啟用或停用"
emqx_bridge_pulsar.connect_timeout.desc = "建立 TCP 連線時的最長等待時長（若啟用認證，這個等待時長也包含完成認證所需時間）。"
emqx_bridge_pulsar.connect_timeout.label = "連線逾時時間"
emqx_bridge_pulsar.connector_resource_opts.desc = "Pulsar 連接器資源選項。"
emqx_bridge_pulsar.connector_resource_opts.label = "資源選項"
emqx_bridge_pulsar.desc_name.desc = "動作名稱，可讀的識別碼。"
emqx_bridge_pulsar.desc_name.label = "動作名稱"
emqx_bridge_pulsar.desc_type.desc = "橋接類型"
emqx_bridge_pulsar.desc_type.label = "橋接類型"
emqx_bridge_pulsar.producer_batch_size.desc = "在一個 Pulsar 訊息中批處理的單個請求的最大數量。"
emqx_bridge_pulsar.producer_batch_size.label = "批次大小"
emqx_bridge_pulsar.producer_buffer.desc = "設定訊息快取的相關參數。\n\n當 EMQX 需要傳送的訊息超過 Pulsar 處理能力，或者當 Pulsar 臨時下線時，EMQX 內部會將訊息快取起來。"
emqx_bridge_pulsar.producer_buffer.label = "訊息快取"
emqx_bridge_pulsar.producer_compression.desc = "壓縮方法。"
emqx_bridge_pulsar.producer_compression.label = "壓縮"
emqx_bridge_pulsar.producer_max_batch_bytes.desc = "最大訊息批次位元組數。大多數 Pulsar 環境的預設最低值是 5 MB，EMQX 的預設值比 5 MB 更小是因為需要補償 Pulsar 訊息編碼所需要的額外位元組（尤其是當每條訊息都很小的情況下）。當單個訊息的大小超過該限制時，它仍然會被傳送，（相當於該批次中只有單個訊息）。"
emqx_bridge_pulsar.producer_max_batch_bytes.label = "最大批次位元組數"
emqx_bridge_pulsar.producer_pulsar_topic.desc = "Pulsar 主題名稱"
emqx_bridge_pulsar.producer_pulsar_topic.label = "Pulsar 主題名稱"
emqx_bridge_pulsar.producer_retention_period.desc = "當沒有連線到 Pulsar broker 時，資訊將被緩衝的時間。 較長的時間意味著將使用更多的記憶體/磁碟"
emqx_bridge_pulsar.producer_retention_period.label = "保留期"
emqx_bridge_pulsar.producer_send_buffer.desc = "TCP socket 的傳送快取調優。預設值是針對高吞吐量的一個推薦值。"
emqx_bridge_pulsar.producer_send_buffer.label = "Socket 傳送快取大小"
emqx_bridge_pulsar.producer_strategy.desc = "設定訊息發布時應該如何選擇 Pulsar 分割區。\n\n<code>random</code>: 為每個訊息隨機選擇一個分割區。\n<code>roundrobin</code>: 依次為每條資訊挑選可用的生產商。\n<code>key_dispatch</code>: 將一批資訊中的第一條資訊的 Pulsar 資訊金鑰雜湊到一個分割區編號。"
emqx_bridge_pulsar.producer_strategy.label = "分割區選擇策略"
emqx_bridge_pulsar.pulsar_producer_struct.desc = "Pulsar 橋接設定"
emqx_bridge_pulsar.pulsar_producer_struct.label = "Pulsar 橋接設定"
emqx_bridge_pulsar.servers.desc = "以逗號分隔的 <code>scheme://host[:port]</code> 格式的 Pulsar URL 列表，支援的 scheme 有 <code>pulsar://</code> （預設）和<code>pulsar+ssl://</code>。預設的連接埠是 6650。"
emqx_bridge_pulsar.servers.label = "服務員"
emqx_bridge_pulsar_pubsub_schema.action_parameters.desc = "針對動作的詳細設定。"
emqx_bridge_pulsar_pubsub_schema.action_parameters.label = "動作"
emqx_bridge_pulsar_pubsub_schema.producer_key_template.desc = "渲染 Pulsar 訊息鍵的模板。"
emqx_bridge_pulsar_pubsub_schema.producer_key_template.label = "訊息的鍵"
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.desc = "生產者在必須等待回執之前可以傳送到每個分割區的最大訊息批次數。\n設定更高的數字可以提高吞吐量。"
emqx_bridge_pulsar_pubsub_schema.producer_max_inflight.label = "最大 Inflight"
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.desc = "渲染 Pulsar 訊息的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_message_opts.label = "Pulsar 訊息模版"
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.desc = "渲染 Pulsar 訊息的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_pulsar_message.label = "Pulsar 訊息模版"
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.desc = "同步發布時等待從 Pulsar 接收回執的最長等待時間。"
emqx_bridge_pulsar_pubsub_schema.producer_sync_timeout.label = "同步發布逾時"
emqx_bridge_pulsar_pubsub_schema.producer_value_template.desc = "渲染 Pulsar 訊息值的模版。"
emqx_bridge_pulsar_pubsub_schema.producer_value_template.label = "訊息的值"
emqx_bridge_pulsar_pubsub_schema.publisher_action.desc = "發布訊息到 Pulsar 主題。"
emqx_bridge_pulsar_pubsub_schema.publisher_action.label = "發布動作"
emqx_bridge_quasardb_action_schema.action_parameters.desc = "動作的參數集合。"
emqx_bridge_quasardb_action_schema.action_parameters.label = "QuasarDB 動作參數"
emqx_bridge_quasardb_action_schema.health_check_table.desc = "用於動作健康檢查的表名。目前無法直接從 SQL 推斷表名。若設定此值，將在動作健康檢查期間使用 `SHOW TABLE <table>` 語句探測表是否存在。"
emqx_bridge_quasardb_action_schema.health_check_table.label = "用於健康檢查的表名"
emqx_bridge_quasardb_action_schema.quasardb.desc = "將傳入事件追加到 QuasarDB 的動作。"
emqx_bridge_quasardb_action_schema.quasardb.label = "上傳到 QuasarDB"
emqx_bridge_quasardb_action_schema.sql.desc = "用於插入資料的 SQL。支援 `${clientid}` 等佔位符變數。\n動作會在渲染佔位符之前驗證 `INSERT INTO ... VALUES (...)` 結構。\n動作會根據值所在的 SQL 上下文對值進行加引號和轉義。\n對於數字、`NULL` 和時間戳值，請使用不加引號的佔位符。\n文字值會自動加引號。使用單引號可強制佔位符保持為文字。\n這種加引號的形式也可將佔位符與靜態字串內容組合在一起。\n時間戳值必須使用 QuasarDB 文件中說明的時間戳格式。\nQuasarDB 查詢 API 不支援包含 `NUL` 的值。"
emqx_bridge_quasardb_action_schema.sql.label = "SQL"
emqx_bridge_quasardb_connector_schema.cluster_public_key.desc = "叢集公鑰（如有）。"
emqx_bridge_quasardb_connector_schema.cluster_public_key.label = "叢集公鑰"
emqx_bridge_quasardb_connector_schema.config_connector.desc = "連線到 QuasarDB 的連接器設定。"
emqx_bridge_quasardb_connector_schema.config_connector.label = "QuasarDB 連接器設定"
emqx_bridge_quasardb_connector_schema.connect_timeout.desc = "與伺服器建立連線的逾時時間。"
emqx_bridge_quasardb_connector_schema.connect_timeout.label = "連線逾時"
emqx_bridge_quasardb_connector_schema.dsn.desc = "ODBC 資料來源名稱，通常定義在 `/etc/odbc.ini`。"
emqx_bridge_quasardb_connector_schema.dsn.label = "ODBC 資料來源名稱"
emqx_bridge_quasardb_connector_schema.password.desc = "使用者金鑰（如有）。"
emqx_bridge_quasardb_connector_schema.password.label = "密碼"
emqx_bridge_quasardb_connector_schema.pool_size.desc = "連線池大小。"
emqx_bridge_quasardb_connector_schema.pool_size.label = "連線池大小"
emqx_bridge_quasardb_connector_schema.uri.desc = "要連線的伺服器 URI。例如：`qdb://127.0.0.1:2836`。"
emqx_bridge_quasardb_connector_schema.uri.label = "伺服器 URI"
emqx_bridge_quasardb_connector_schema.username.desc = "使用者名稱（如有）。"
emqx_bridge_quasardb_connector_schema.username.label = "使用者名稱"
emqx_bridge_rabbitmq.config_enable.desc = "啟用或停用橋接"
emqx_bridge_rabbitmq.config_enable.label = "啟用或停用橋接"
emqx_bridge_rabbitmq.desc_config.desc = "RabbitMQ 橋接設定"
emqx_bridge_rabbitmq.desc_config.label = "RabbitMQ 橋接設定"
emqx_bridge_rabbitmq.desc_name.desc = "橋接名稱"
emqx_bridge_rabbitmq.desc_name.label = "橋接名稱"
emqx_bridge_rabbitmq.desc_type.desc = "橋接類型"
emqx_bridge_rabbitmq.desc_type.label = "橋接類型"
emqx_bridge_rabbitmq_connector_schema.auto_reconnect.desc = "如果連線遺失，嘗試重新連線到 RabbitMQ 伺服器的間隔。"
emqx_bridge_rabbitmq_connector_schema.auto_reconnect.label = "自動重新連線"
emqx_bridge_rabbitmq_connector_schema.config_connector.desc = "RabbitMQ 連接器的設定。"
emqx_bridge_rabbitmq_connector_schema.config_connector.label = "RabbitMQ 連接器設定"
emqx_bridge_rabbitmq_connector_schema.connector_resource_opts.desc = "連接器資源選項。"
emqx_bridge_rabbitmq_connector_schema.connector_resource_opts.label = "連接器資源選項"
emqx_bridge_rabbitmq_connector_schema.delivery_mode.desc = "發布到 RabbitMQ 的訊息的傳遞模式。非持久化傳遞模式（1）適用於不需要在 RabbitMQ 重啟後保持的訊息，而持久化傳遞模式（2）用於必須在 RabbitMQ 重啟後仍然存在的訊息。"
emqx_bridge_rabbitmq_connector_schema.delivery_mode.label = "訊息傳遞模式"
emqx_bridge_rabbitmq_connector_schema.exchange.desc = "訊息將被傳送到的 RabbitMQ 交換機的名稱。支援使用模版（例如：`e-${payload.e}`）。"
emqx_bridge_rabbitmq_connector_schema.exchange.label = "交換機"
emqx_bridge_rabbitmq_connector_schema.exchange_type.desc = "RabbitMQ 交換機類型 (direct, fanout, 或 topic)."
emqx_bridge_rabbitmq_connector_schema.exchange_type.label = "交換機類型"
emqx_bridge_rabbitmq_connector_schema.heartbeat.desc = "向 RabbitMQ 伺服器傳送心跳訊息的間隔。"
emqx_bridge_rabbitmq_connector_schema.heartbeat.label = "心跳"
emqx_bridge_rabbitmq_connector_schema.password.desc = "用於與 RabbitMQ 伺服器進行認證的密碼。"
emqx_bridge_rabbitmq_connector_schema.password.label = "密碼"
emqx_bridge_rabbitmq_connector_schema.payload_template.desc = "在傳送訊息到 RabbitMQ 之前格式化訊息 payload 的模板。例如 ${field1.sub_field} 的模板佔位符將被相應欄位的值替換。如果留空，整個輸入訊息將被用作 payload，格式化為 JSON 文字。這種行為等同於將 ${.} 指定為 payload 模板。"
emqx_bridge_rabbitmq_connector_schema.payload_template.label = "Payload 模版"
emqx_bridge_rabbitmq_connector_schema.pool_size.desc = "連線池的大小"
emqx_bridge_rabbitmq_connector_schema.pool_size.label = "連線池大小"
emqx_bridge_rabbitmq_connector_schema.port.desc = "當 servers 中的地址未顯式指定 `:Port` 時使用的預設連接埠（預設 5672）。"
emqx_bridge_rabbitmq_connector_schema.port.label = "連接埠"
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.desc = "使用發布者確認時，等待 RabbitMQ 確認訊息發布的逾時時間。"
emqx_bridge_rabbitmq_connector_schema.publish_confirmation_timeout.label = "發布確認逾時時間"
emqx_bridge_rabbitmq_connector_schema.routing_key.desc = "用於將訊息路由到 RabbitMQ 交換機中正確佇列的路由鍵。支援使用模版，（例如：`k-${payload.r}`）。"
emqx_bridge_rabbitmq_connector_schema.routing_key.label = "路由鍵"
emqx_bridge_rabbitmq_connector_schema.servers.desc = "用於連線故障切換的 RabbitMQ 節點列表，以逗號分隔，格式為 `Host[:Port][,Host2:Port]`。<br/>\n也接受 `server` 欄位作為別名。<br/>\n當省略 `[:Port]` 時，使用 `port` 的值（預設 5672）。"
emqx_bridge_rabbitmq_connector_schema.servers.label = "伺服器列表"
emqx_bridge_rabbitmq_connector_schema.timeout.desc = "等待連線建立的逾時時間。"
emqx_bridge_rabbitmq_connector_schema.timeout.label = "連線逾時"
emqx_bridge_rabbitmq_connector_schema.username.desc = "用於與 RabbitMQ 伺服器進行認證的使用者名稱。"
emqx_bridge_rabbitmq_connector_schema.username.label = "使用者名稱"
emqx_bridge_rabbitmq_connector_schema.virtual_host.desc = "連線到 RabbitMQ 伺服器時使用的虛擬主機。"
emqx_bridge_rabbitmq_connector_schema.virtual_host.label = "虛擬主機"
emqx_bridge_rabbitmq_connector_schema.wait_for_publish_confirmations.desc = "一個布林值，指示在使用發布者確認時是否等待 RabbitMQ 確認訊息發布。"
emqx_bridge_rabbitmq_connector_schema.wait_for_publish_confirmations.label = "等待發布確認"
emqx_bridge_rabbitmq_pubsub_schema.action_parameters.desc = "動作設定定義了此動作輸出如何將訊息傳送到遠端 RabbitMQ broker。"
emqx_bridge_rabbitmq_pubsub_schema.action_parameters.label = "動作參數"
emqx_bridge_rabbitmq_pubsub_schema.headers_template.desc = "訊息標頭的模板。"
emqx_bridge_rabbitmq_pubsub_schema.headers_template.label = "標頭模板"
emqx_bridge_rabbitmq_pubsub_schema.key_value.desc = "鍵值模板對。"
emqx_bridge_rabbitmq_pubsub_schema.key_value.label = "鍵值對"
emqx_bridge_rabbitmq_pubsub_schema.key_value_key.desc = "鍵的模板。"
emqx_bridge_rabbitmq_pubsub_schema.key_value_key.label = "鍵"
emqx_bridge_rabbitmq_pubsub_schema.key_value_value.desc = "值的模板。"
emqx_bridge_rabbitmq_pubsub_schema.key_value_value.label = "值"
emqx_bridge_rabbitmq_pubsub_schema.properties_template.desc = "訊息屬性的模板。參見：https://www.rabbitmq.com/docs/publishers#message-properties"
emqx_bridge_rabbitmq_pubsub_schema.properties_template.label = "屬性模板"
emqx_bridge_rabbitmq_pubsub_schema.publisher_action.desc = "動作的設定"
emqx_bridge_rabbitmq_pubsub_schema.publisher_action.label = "動作"
emqx_bridge_rabbitmq_pubsub_schema.source_no_ack.desc = "在從 RabbitMQ broker 消費訊息時是否使用 no_ack 模式。"
