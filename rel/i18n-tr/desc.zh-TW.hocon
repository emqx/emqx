emqx_bridge_rocketmq.key.desc = "用於訊息鍵的值。支援佔位符，例如：`${payload.key}`。"
emqx_bridge_rocketmq.key.label = "鍵"
emqx_bridge_rocketmq.rocketmq_action.desc = "RocketMQ 動作的設定。"
emqx_bridge_rocketmq.rocketmq_action.label = "RocketMQ 動作設定"
emqx_bridge_rocketmq.strategy.desc = "生產者鍵派發策略。可能的值：`key_dispatch`、`roundrobin`。預設是 `roundrobin`。"
emqx_bridge_rocketmq.tag.desc = "用於訊息標籤的值。支援佔位符，例如：`${payload.tag}`。"
emqx_bridge_rocketmq.tag.label = "標籤"
emqx_bridge_rocketmq.template.desc = "模板, 預設為空，為空時將會將整個訊息轉發給 RocketMQ。 <br/>\n            模板可以是任意帶有佔位符的合法字串, 例如:<br/>            ${id}, ${username}, ${clientid}, ${timestamp}<br/>\n            {\"id\" : ${id}, \"username\" : ${username}}"
emqx_bridge_rocketmq.template.label = "模板"
emqx_bridge_rocketmq_connector.access_key.desc = "RocketMQ 伺服器的 `accessKey`。"
emqx_bridge_rocketmq_connector.access_key.label = "AccessKey"
emqx_bridge_rocketmq_connector.refresh_interval.desc = "RocketMQ 主題路由更新間隔。"
emqx_bridge_rocketmq_connector.refresh_interval.label = "主題路由更新間隔"
emqx_bridge_rocketmq_connector.rocketmq_namespace.desc = "如果你正在使用阿里雲的 RocketMQ 服務並且啟用了命名空間，或者您在自己的 RocketMQ 伺服器中設定了命名空間，則必須設定命名空間欄位。對於阿里雲中的 RocketMQ 服務，命名空間就是實例 ID。"
emqx_bridge_rocketmq_connector.rocketmq_namespace.label = "命名空間 / 實例 ID"
emqx_bridge_rocketmq_connector.secret_key.desc = "RocketMQ 伺服器的 `secretKey`。<br/>\n如需從檔案載入金鑰而不是內聯寫入，請使用 <code>file://&lt;path-to-file&gt;</code> 形式；檔案內容（去除末尾空白）將作為金鑰使用。叢集模式下，該檔案必須存在於所有 EMQX 節點。"
emqx_bridge_rocketmq_connector.secret_key.label = "SecretKey"
emqx_bridge_rocketmq_connector.security_token.desc = "RocketMQ 伺服器安全 token"
emqx_bridge_rocketmq_connector.security_token.label = "安全 token"
emqx_bridge_rocketmq_connector.send_buffer.desc = "RocketMQ 驅動的套位元組傳送訊息的緩衝區大小"
emqx_bridge_rocketmq_connector.send_buffer.label = "傳送訊息的緩衝區大小"
emqx_bridge_rocketmq_connector.servers.desc = "將要連線的 IPv4 或 IPv6 地址，或者主機名。<br/>\n主機名具有以下形式：`Host[:Port]`。<br/>\n如果未指定 `[:Port]`，則使用 RocketMQ 預設連接埠 9876。"
emqx_bridge_rocketmq_connector.servers.label = "伺服器地址"
emqx_bridge_rocketmq_connector.sync_timeout.desc = "RocketMQ 驅動同步呼叫的逾時時間。"
emqx_bridge_rocketmq_connector.sync_timeout.label = "同步呼叫逾時時間"
emqx_bridge_rocketmq_connector.topic.desc = "RocketMQ 主題"
emqx_bridge_rocketmq_connector.topic.label = "RocketMQ 主題"
emqx_bridge_s3.config_connector.desc = "設定連線到相容 S3 API 儲存服務的連接器。"
emqx_bridge_s3.config_connector.label = "S3 連接器設定"
emqx_bridge_s3_upload.s3_aggregated_container.desc = "規定包含聚合事件的上傳檔案格式的設定。"
emqx_bridge_s3_upload.s3_aggregated_container.label = "聚合事件容器"
emqx_bridge_s3_upload.s3_aggregated_container_csv.desc = "記錄（事件）將被聚合並上傳為 CSV 檔案。"
emqx_bridge_s3_upload.s3_aggregated_container_csv.label = "CSV 容器"
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.desc = "在此指定的事件欄位將首先作為列出現在生成的 CSV 檔案中。<br/>\nCSV 檔案將包含聚合事件的所有欄位；然而，未在此設定中明確提到的列將按字典順序跟在指定的列之後。"
emqx_bridge_s3_upload.s3_aggregated_container_csv_column_order.label = "CSV 列順序"
emqx_bridge_s3_upload.s3_aggregated_upload_key.desc = "聚合上傳的 S3 物件鍵模板。<br/>\n此模板可以包含以下變數的佔位符：\n<ul>\n<li><code>${action}</code>: 動作名稱（必需）。</li>\n<li><code>${node}</code>: 執行上傳的 EMQX 節點名稱（必需）。</li>\n<li><code>${datetime.{format}}</code>: 聚合開始的日期和時間，按 <code>{format}</code> 字串格式化（必需）：\n    <ul>\n    <li><code>${datetime.rfc3339utc}</code>: RFC3339 格式的 UTC 日期和時間，</li>\n    <li><code>${datetime.rfc3339}</code>: RFC3339 格式的本地時區日期和時間，</li>\n    <li><code>${datetime.unix}</code>: Unix 時間戳，</li>\n    <li><code>${datetime.YYYY}</code>、<code>${datetime.MM}</code>、<code>${datetime.DD}</code>: 零填充的年、月、日（UTC），</li>\n    <li><code>${datetime.hh}</code>、<code>${datetime.mm}</code>、<code>${datetime.ss}</code>: 零填充的時、分、秒（UTC），</li>\n    <li><code>${datetime.DOY}</code>: 零填充的一年中的第幾天 001-366（UTC）。</li>\n    </ul>\n    每個日期/時間部分權杖可帶顯式時區字首：<code>utc</code>（與無字首相同）或 <code>local</code>（EMQX 節點系統時區）。範例：<code>${datetime.local.YYYY}</code>、<code>${datetime.utc.hh}</code>。不接受其他時區。\n    Hive 分割區佈局範例：<code>year=${datetime.YYYY}/month=${datetime.MM}/day=${datetime.DD}/hour=${datetime.hh}/${action}_${node}_N${sequence}.json</code>。\n</li>\n<li><code>${datetime_until.{format}}</code>: 聚合結束的日期和時間，包含相同的格式選項。</li>\n<li><code>${sequence}</code>: 同一時間間隔內聚合上傳的序列號（必需）。</li>\n</ul>\n所有其他佔位符均被視為無效。注意，標記為必需的佔位符如果在模板中缺失，將作為路徑字尾新增到 S3 物件鍵中。"
emqx_bridge_s3_upload.s3_aggregated_upload_key.label = "S3 物件健模版"
emqx_bridge_s3_upload.s3_aggregated_upload_mode.desc = "啟用基於時間的傳入事件聚合，並將它們作為一個單獨的物件上傳到 S3 服務。"
emqx_bridge_s3_upload.s3_aggregated_upload_mode.label = "聚合 S3 上傳"
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.desc = "聚合上傳操作的參數集。"
emqx_bridge_s3_upload.s3_aggregated_upload_parameters.label = "聚合 S3 上傳操作參數"
emqx_bridge_s3_upload.s3_aggregation.desc = "管理聚合過程的參數集。"
emqx_bridge_s3_upload.s3_aggregation.label = "聚合參數"
emqx_bridge_s3_upload.s3_aggregation_interval.desc = "上傳前，事件將在單個物件中聚合的時間長度。"
emqx_bridge_s3_upload.s3_aggregation_interval.label = "時間間隔"
emqx_bridge_s3_upload.s3_aggregation_max_records.desc = "每個聚合物件可以包含的最大記錄（事件）數量。雖然每次上傳不會超過這個限制，但可能包含較少的事件。如果事件發生率很高，在同一時間間隔內可能會有多次聚合上傳，這些上傳將具有不同但連續的序列號，這些序列號將成為 S3 物件鍵的一部分。"
emqx_bridge_s3_upload.s3_aggregation_max_records.label = "最大記錄數"
emqx_bridge_s3_upload.s3_direct_upload_mode.desc = "啟用將事件作為單獨的物件上傳到 S3 服務。"
emqx_bridge_s3_upload.s3_direct_upload_mode.label = "直接 S3 上傳"
emqx_bridge_s3_upload.s3_direct_upload_parameters.desc = "上傳操作的一組參數。操作支援在 S3 儲存桶名稱、物件鍵和物件內容中使用模板。"
emqx_bridge_s3_upload.s3_direct_upload_parameters.label = "直接 S3 上傳操作參數"
emqx_bridge_s3_upload.s3_object_content.desc = "S3 物件的內容。支援模板。"
emqx_bridge_s3_upload.s3_object_content.label = "S3 物件內容"
emqx_bridge_s3_upload.s3_parameters.desc = "上傳操作的一組參數。"
emqx_bridge_s3_upload.s3_parameters.label = "S3 上傳參數"
emqx_bridge_s3_upload.s3_upload.desc = "將傳入事件上傳到 S3 API 相容服務的操作。"
emqx_bridge_s3_upload.s3_upload.label = "上傳到 S3"
