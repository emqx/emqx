emqx_bridge_tablestore.desc_endpoint.label = "端點"
emqx_bridge_tablestore.desc_fields.desc = "欄位。欄位列和欄位值可以是靜態值或佔位符，如 `${payload.column_name}` 和 `${payload.column_value}`。"
