emqx_bridge_kinesis {

config_enable.desc:
"""Enable or disable this action"""

config_enable.label:
"""Enable Or Disable Action"""

desc_config.desc:
"""Configuration for an Amazon Kinesis action."""

desc_config.label:
"""Amazon Kinesis Action Configuration"""

desc_name.desc:
"""Action name."""

desc_name.label:
"""Action Name"""

desc_type.desc:
"""The action type."""

desc_type.label:
"""Action Type"""

pool_size.desc:
"""The pool size."""

pool_size.label:
"""Pool Size"""

payload_template.desc:
"""The template for formatting the outgoing messages.  If undefined, will send all the available context in JSON format."""

payload_template.label:
"""Payload template"""

aws_access_key_id.desc:
"""Access Key ID for connecting to Amazon Kinesis.
If both the Access Key ID and the Secret Access Key are omitted, credentials are obtained from the ECS task role or EC2 instance metadata."""

aws_access_key_id.label:
"""AWS Access Key ID"""

aws_secret_access_key.desc:
"""AWS Secret Access Key for connecting to Amazon Kinesis.
If both the Access Key ID and the Secret Access Key are omitted, credentials are obtained from the ECS task role or EC2 instance metadata."""

aws_secret_access_key.label:
"""AWS Secret Access Key"""

endpoint.desc:
"""The url of Amazon Kinesis endpoint."""

endpoint.label:
"""Amazon Kinesis Endpoint"""

stream_name.desc:
"""The name of the Amazon Kinesis stream to publish messages to.
Kinesis looks up the name in the AWS account of the connector credentials.
Set either this field or <code>stream_arn</code>."""

stream_name.label:
"""Amazon Kinesis Stream"""

stream_arn.desc:
"""The ARN of the Amazon Kinesis stream to publish messages to, for example <code>arn:aws:kinesis:us-east-1:123456789012:stream/my_stream</code>.
Use it for a stream in another AWS account. The owner of the stream must grant access to the connector credentials with a resource-based policy on the stream.
The action health check calls <code>DescribeStreamSummary</code> on the stream, so the policy must allow it together with <code>PutRecord</code> and <code>PutRecords</code>.
Set either this field or <code>stream_name</code>."""

stream_arn.label:
"""Amazon Kinesis Stream ARN"""

partition_key.desc:
"""The Amazon Kinesis Partition Key associated to published message. Placeholders in format of ${var} are supported."""

partition_key.label:
"""Partition key"""

max_retries.desc:
"""Max retry times if an error occurs when sending a request."""

max_retries.label:
"""Max Retries"""

action_parameters.desc:
"""Action specific configuration."""

action_parameters.label:
"""Action"""

kinesis_action.desc:
"""Configuration for Kinesis Action"""

kinesis_action.label:
"""Kinesis Action Configuration"""


config_connector.desc:
"""Configuration for a Kinesis Client."""

config_connector.label:
"""Kinesis Client Configuration"""

}
