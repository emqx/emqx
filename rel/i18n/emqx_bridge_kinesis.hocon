emqx_bridge_kinesis {

config_enable.desc:
"""Enable or disable this action"""

config_enable.label:
"""Enable Or Disable Action"""

desc_config.desc:
"""Configuration for an Amazon Kinesis action."""

desc_config.label:
"""Amazon Kinesis Action Configuration"""

desc_name.desc:
"""Action name."""

desc_name.label:
"""Action Name"""

desc_type.desc:
"""The action type."""

desc_type.label:
"""Action Type"""

pool_size.desc:
"""The pool size."""

pool_size.label:
"""Pool Size"""

payload_template.desc:
"""The template for formatting the outgoing messages.  If undefined, will send all the available context in JSON format."""

payload_template.label:
"""Payload template"""

aws_access_key_id.desc:
"""Access Key ID for connecting to Amazon Kinesis.
If both the Access Key ID and the Secret Access Key are omitted, credentials are obtained from the ECS task role or EC2 instance metadata."""

aws_access_key_id.label:
"""AWS Access Key ID"""

aws_secret_access_key.desc:
"""AWS Secret Access Key for connecting to Amazon Kinesis.
If both the Access Key ID and the Secret Access Key are omitted, credentials are obtained from the ECS task role or EC2 instance metadata."""

aws_secret_access_key.label:
"""AWS Secret Access Key"""

endpoint.desc:
"""The url of Amazon Kinesis endpoint."""

endpoint.label:
"""Amazon Kinesis Endpoint"""

assume_role_arn.desc:
"""The ARN of an IAM role to assume, for example a role in the AWS account that owns the stream.
When set, the connector calls STS <code>AssumeRole</code> with its own credentials, and signs the Kinesis requests with the temporary credentials of the role.
The connector gets new temporary credentials before they expire.
When not set, the connector signs the Kinesis requests with its own credentials."""

assume_role_arn.label:
"""Assume Role ARN"""

assume_role_external_id.desc:
"""The external ID to send in the <code>AssumeRole</code> request.
Set it when the trust policy of the role requires an external ID."""

assume_role_external_id.label:
"""Assume Role External ID"""

sts_endpoint.desc:
"""The URL of the AWS STS endpoint that the connector calls to assume the role.
When not set, the connector uses the regional STS endpoint of the region in the Kinesis endpoint, for example <code>https://sts.us-east-1.amazonaws.com</code> for <code>https://kinesis.us-east-1.amazonaws.com</code>.
Set it when the connector must use a VPC endpoint or a custom endpoint for STS."""

sts_endpoint.label:
"""STS Endpoint"""

stream_name.desc:
"""The Amazon Kinesis Stream to publish messages to."""

stream_name.label:
"""Amazon Kinesis Stream"""

partition_key.desc:
"""The Amazon Kinesis Partition Key associated to published message. Placeholders in format of ${var} are supported."""

partition_key.label:
"""Partition key"""

max_retries.desc:
"""Max retry times if an error occurs when sending a request."""

max_retries.label:
"""Max Retries"""

action_parameters.desc:
"""Action specific configuration."""

action_parameters.label:
"""Action"""

kinesis_action.desc:
"""Configuration for Kinesis Action"""

kinesis_action.label:
"""Kinesis Action Configuration"""


config_connector.desc:
"""Configuration for a Kinesis Client."""

config_connector.label:
"""Kinesis Client Configuration"""

}
