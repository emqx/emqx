emqx_authz_http_schema {

allowed_hosts.desc:
"""List of hostnames the templated URL host is allowed to resolve to.
Each entry is either an exact hostname (e.g. <code>auth.example.com</code>) or a wildcard pattern (e.g. <code>*.auth.example.com</code>) matching any hostname under that suffix.
This list must be configured when the URL host contains template placeholders; a request is made only if the rendered hostname matches one of the entries, otherwise the authorization check fails.
It has no effect when the URL host is a literal hostname."""

allowed_hosts.label:
"""Allowed Hosts"""

request_mode.desc:
"""How HTTP requests to the auth server are made.
<code>auto</code>: use a fixed connection pool when the URL host is a literal hostname, and one-off per-request connections when the URL host contains template placeholders.
<code>one_off</code>: always use one-off per-request connections, even for a literal hostname; no connection pool is maintained and the hostname is resolved for every request."""

request_mode.label:
"""Request Mode"""

method.desc:
"""HTTP method."""

method.label:
"""method"""

body.desc:
"""HTTP request body."""

body.label:
"""Request Body"""

url.desc:
"""URL of the auth server.
The host part may contain template placeholders, e.g. <code>https://${client_attrs.tns}.auth.example.com/authz</code>; in that case <code>allowed_hosts</code> must also be configured, and each request is sent as a one-off HTTP request to the rendered host instead of through the fixed connection pool."""

url.label:
"""URL"""

headers.desc:
"""List of HTTP Headers."""

headers.label:
"""Headers"""

headers_no_content_type.desc:
"""List of HTTP headers (without <code>content-type</code>)."""

headers_no_content_type.label:
"""headers_no_content_type"""

http_post.desc:
"""Authorization using an external HTTP server (via POST requests)."""

http_post.label:
"""http_post"""

request_timeout.desc:
"""HTTP request timeout."""

request_timeout.label:
"""Request Timeout"""

http_get.desc:
"""Authorization using an external HTTP server (via GET requests)."""

http_get.label:
"""http_get"""

}
