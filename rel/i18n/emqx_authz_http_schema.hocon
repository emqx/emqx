emqx_authz_http_schema {

allowed_hosts.desc:
"""List of hostnames the templated URL host is allowed to resolve to.
Each entry is either an exact hostname (e.g. <code>auth.example.com</code>) or a wildcard pattern (e.g. <code>*.auth.example.com</code>) matching any hostname under that suffix.
This list must be configured when the URL host contains template placeholders; a request is made only if the rendered hostname matches one of the entries, otherwise the authorization check fails.
It has no effect when the URL host is a literal hostname."""

allowed_hosts.label:
"""Allowed Hosts"""

hostname_resolution.desc:
"""How the auth server hostname in <code>url</code> is resolved.
<code>static</code>: the hostname is fixed; requests go through a persistent connection pool established at configuration time, and pipelining options apply.
<code>dynamic</code>: the hostname is resolved for every request; required when the URL host contains template placeholders. Requests use short-lived per-request connections, so <code>enable_pipelining</code> and <code>max_inactive</code> do not apply; <code>pool_size</code> limits how many idle connections may be kept for reuse."""

hostname_resolution.label:
"""Hostname Resolution"""

pool_size.desc:
"""Connection limit towards the auth server.
When <code>hostname_resolution</code> is <code>static</code>, this is the size of the persistent connection pool (must be at least 1).
When <code>hostname_resolution</code> is <code>dynamic</code>, this limits how many idle connections may be kept for reuse across requests; set it to <code>0</code> to disable connection reuse entirely."""

pool_size.label:
"""Pool Size"""

method.desc:
"""HTTP method."""

method.label:
"""method"""

body.desc:
"""HTTP request body."""

body.label:
"""Request Body"""

url.desc:
"""URL of the auth server.
The host part may contain template placeholders, e.g. <code>https://${client_attrs.tns}.auth.example.com/authz</code>; in that case <code>hostname_resolution</code> must be set to <code>dynamic</code> and <code>allowed_hosts</code> must be configured, and each request is sent over a per-request connection to the rendered host instead of through the fixed connection pool."""

url.label:
"""URL"""

headers.desc:
"""List of HTTP Headers."""

headers.label:
"""Headers"""

headers_no_content_type.desc:
"""List of HTTP headers (without <code>content-type</code>)."""

headers_no_content_type.label:
"""headers_no_content_type"""

http_post.desc:
"""Authorization using an external HTTP server (via POST requests)."""

http_post.label:
"""http_post"""

request_timeout.desc:
"""HTTP request timeout."""

request_timeout.label:
"""Request Timeout"""

http_get.desc:
"""Authorization using an external HTTP server (via GET requests)."""

http_get.label:
"""http_get"""

}
