emqx_authn_mysql_schema {

mysql.desc:
"""Configuration of authenticator using MySQL as authentication data source."""

query.desc:
"""SQL used to query data for authentication, such as password hash. The query must only read data. EMQX rejects a query that changes data, for example with `INSERT`, `UPDATE` or `DELETE`, and a query that has more than one SQL statement."""

query.label:
"""Query"""

query_timeout.desc:
"""Timeout for the SQL query."""

query_timeout.label:
"""Query Timeout"""

}
