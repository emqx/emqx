emqx_ai_completion_schema {

type.desc:
"""Type of AI provider: OpenAI or Anthropic."""

type.label:
"""AI Provider Type"""

api_key.desc:
"""API key for the AI provider.<br/>
To load the key from a file instead of embedding it inline, use the form <code>file://&lt;path-to-file&gt;</code>; the file's content (with any trailing whitespace stripped) is then used as the key. When clustered, the file must exist on all EMQX nodes."""

api_key.label:
"""API Key"""

provider_name.desc:
"""Name of the provider."""

provider_name.label:
"""Provider Name"""

base_url.desc:
"""Base URL for the AI provider API endpoint."""

base_url.label:
"""Base URL"""

system_prompt.desc:
"""System prompt for the AI completion."""

system_prompt.label:
"""System Prompt"""

model.desc:
"""Model to use for the AI completion."""

model.label:
"""Model"""

anthropic_version.desc:
"""Version of the Anthropic API to use."""

anthropic_version.label:
"""Anthropic Version"""

max_tokens.desc:
"""Maximum number of tokens to generate."""

max_tokens.label:
"""Max Tokens"""

completion_profile_name.desc:
"""Name of the completion profile."""

completion_profile_name.label:
"""Completion Profile Name"""

providers.desc:
"""List of AI provider providers."""

providers.label:
"""Providers"""

completion_profiles.desc:
"""List of AI completion profiles."""

completion_profiles.label:
"""Completion Profiles"""

transport_options.desc:
"""Transport (HTTP) options for the AI provider."""

transport_options.label:
"""Transport Options"""

connect_timeout.desc:
"""Connect timeout to the AI provider."""

connect_timeout.label:
"""Connect Timeout"""

recv_timeout.desc:
"""Receive timeout to the AI provider."""

recv_timeout.label:
"""Receive Timeout"""

checkout_timeout.desc:
"""Timeout for the checkout from connection pool for a request to the AI provider."""

checkout_timeout.label:
"""Checkout Timeout"""

max_connections.desc:
"""Maximum number of simultaneous connections to the AI provider."""

max_connections.label:
"""Max Connections"""

ai.desc:
"""AI functions settings."""

ai.label:
"""AI"""

openai_provider.desc:
"""OpenAI Compatible Provider."""

openai_provider.label:
"""OpenAI Provider"""

anthropic_provider.desc:
"""Anthropic Compatible Provider."""

anthropic_provider.label:
"""Anthropic Provider"""

openai_response_provider.desc:
"""OpenAI Compatible Provider using `response' API."""

openai_response_provider.label:
"""OpenAI `response' Provider"""

openai_decisions_provider.desc:
"""OpenAI compatible provider using the Decisions API."""

openai_decisions_provider.label:
"""OpenAI Decisions Provider"""

openai_completion_profile.desc:
"""AI completion profile for OpenAI."""

openai_completion_profile.label:
"""OpenAI Completion Profile"""

anthropic_completion_profile.desc:
"""AI completion profile for Anthropic."""

anthropic_completion_profile.label:
"""Anthropic Completion Profile"""

openai_response_completion_profile.desc:
"""AI completion profile for OpenAI using `response' API."""

openai_response_completion_profile.label:
"""OpenAI `response' Completion Profile"""

openai_decisions_completion_profile.desc:
"""Completion profile for the OpenAI Decisions API. Use a provider of type `openai_decisions` and configure named questions. The result is a JSON object containing an answers array."""

openai_decisions_completion_profile.label:
"""OpenAI Decisions Completion Profile"""

decision_questions.desc:
"""Questions to evaluate against the input. Configure at least one question. Question names must be unique."""

decision_questions.label:
"""Questions"""

decision_question_type.desc:
"""Question type: predicate, choice, or score."""

decision_question_type.label:
"""Question Type"""

decision_question_name.desc:
"""Unique name that identifies the question in the answers array."""

decision_question_name.label:
"""Question Name"""

decision_instructions.desc:
"""Instructions that define what the question evaluates."""

decision_instructions.label:
"""Instructions"""

decision_choices.desc:
"""Allowed choices. Configure at least one choice. Choice values must be unique."""

decision_choices.label:
"""Choices"""

decision_levels.desc:
"""Score levels ordered from lowest to highest. Configure at least one level. Level indices start at zero."""

decision_levels.label:
"""Score Levels"""

decision_choice_value.desc:
"""String or boolean value returned when this choice is selected."""

decision_choice_value.label:
"""Choice Value"""

decision_option_description.desc:
"""Criteria for selecting this choice or score level."""

decision_option_description.label:
"""Description"""

decision_level_label.desc:
"""Name of the score level."""

decision_level_label.label:
"""Level Label"""

decision_predicate.desc:
"""Question that returns the probability that a condition is true."""

decision_predicate.label:
"""Predicate Question"""

decision_choice.desc:
"""Question that selects one of the configured choices."""

decision_choice.label:
"""Choice Question"""

decision_score.desc:
"""Question that returns a probability-weighted average of the score level indices."""

decision_score.label:
"""Score Question"""

decision_choice_option.desc:
"""Allowed value and optional criteria for a choice question."""

decision_choice_option.label:
"""Choice Option"""

decision_score_level.desc:
"""Label and optional criteria for a score level."""

decision_score_level.label:
"""Score Level"""

}
