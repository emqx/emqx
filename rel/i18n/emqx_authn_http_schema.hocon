emqx_authn_http_schema {

allowed_hosts.desc:
"""List of hostnames the templated URL host is allowed to resolve to.
Each entry is either an exact hostname (e.g. <code>auth.example.com</code>) or a wildcard pattern (e.g. <code>*.auth.example.com</code>) matching any hostname under that suffix.
This list must be configured when the URL host contains template placeholders; a request is made only if the rendered hostname matches one of the entries, otherwise authentication fails.
It has no effect when the URL host is a literal hostname."""

allowed_hosts.label:
"""Allowed Hosts"""

body.desc:
"""HTTP request body."""

body.label:
"""Request Body"""

get.desc:
"""Configuration of authenticator using HTTP Server as authentication service (Using GET request)."""

headers.desc:
"""List of HTTP Headers."""

headers.label:
"""Headers"""

headers_no_content_type.desc:
"""List of HTTP headers (without <code>content-type</code>)."""

headers_no_content_type.label:
"""headers_no_content_type"""

method.desc:
"""HTTP request method."""

method.label:
"""Request Method"""

post.desc:
"""Configuration of authenticator using HTTP Server as authentication service (Using POST request)."""

request_timeout.desc:
"""HTTP request timeout."""

request_timeout.label:
"""Request Timeout"""

url.desc:
"""URL of the HTTP server.
The host part may contain template placeholders, e.g. <code>https://${client_attrs.tns}.auth.example.com/authn</code>; in that case <code>allowed_hosts</code> must also be configured, and each request is sent as a one-off HTTP request to the rendered host instead of through the fixed connection pool."""

url.label:
"""URL"""

}
