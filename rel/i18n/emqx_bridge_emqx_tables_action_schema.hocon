emqx_bridge_emqx_tables_action_schema {
  emqx_tables {
    label: """Ingest to EMQX Tables"""
    desc:
    """Action that takes incoming events and appends them to EMQX Tables."""
  }

  parameters {
    label: "Action Parameters"
    desc: "Set of parameters for the action."
  }

  field_types.desc:
  """Explicit column types used when EMQX Tables auto-creates a target table. Currently only `json2` is supported. The corresponding field in `write_syntax` must contain a JSON object or null; invalid JSON or unsupported JSON documents abort that table's insert batch as an unrecoverable error."""

  field_types.label:
  """Field Types"""
}
