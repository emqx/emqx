emqx_mq_api {

    ## Method descriptions

    message_queues_list {
        desc: "List message queues with pagination."
        label: "List Message Queues"
    }
    message_queues_create {
        desc: "Create a new message queue."
        label: "Create Message Queue"
    }
    message_queues_get {
        desc: "Get message queue."
        label: "Get Message Queue"
    }
    message_queues_update {
        desc: "Update message queue."
        label: "Update Message Queue"
    }
    message_queues_delete {
        desc: "Delete message queue."
        label: "Delete Message Queue"
    }
    message_queues_config_get {
        desc: "Get message queue config."
        label: "Get Message Queue Config"
    }
    message_queues_purge {
        desc: "Purge messages without deleting the queue or its consumer progress. Without `before`, delete all messages stored before the purge. With `before`, stop delivering messages stored before the specified time, and delete them as far as the quota index allows. For limited queues, deletion stops at the nearest earlier quota bucket boundary, so some older messages can stay stored but are not delivered. Purge is refused until all cluster nodes are upgraded. MQTT clients stay connected."
        label: "Purge Message Queue"
    }
    message_queues_config_update {
        desc: "Update message queue config."
        label: "Update Message Queue Config"
    }

    ## Request/Response elements

    bad_cursor {
        desc: "Bad cursor"
    }
    message_queues_delete_success {
        desc: "Message queue deleted successfully"
    }
    message_queues_purge_success {
        desc: "Message queue purged successfully"
    }
    purge_before {
        desc: "Delivery cutoff as an RFC 3339 timestamp or milliseconds since the Unix epoch. Messages stored before it are not delivered. The value must not precede the Unix epoch or be later than the current time. If the value precedes the current delivery cutoff of the queue, the request does nothing. Omit this parameter to purge all messages."
    }
    invalid_purge_before {
        desc: "Invalid purge cutoff timestamp"
    }
    cannot_create_message_queue {
        desc: "Cannot create message queue"
    }
    message_queue_being_deleted {
        desc: "Message queue is being deleted"
    }
    message_queue_not_found {
        desc: "Message queue not found"
    }
    service_unavailable {
        desc: "Service unavailable"
    }
    invalid_message_queue {
        desc: "Invalid message queue"
    }
    invalid_message_queue_config {
        desc: "Invalid message queue config"
    }
    topic_filter {
        desc: "Topic filter"
    }
    name {
        desc: "Message queue name"
    }

message_queues_config_update_success.desc:
"""Message queue configuration updated successfully."""
message_queues_config_update_success.label:
"""Message Queue Config Updated"""

}
