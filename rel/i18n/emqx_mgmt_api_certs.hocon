emqx_mgmt_api_certs {
    global_bundle_list {
        desc: """~
            List all bundles in global namespace.~"""
        label: "List Global Bundles"
    }

    ns_bundle_list {
        desc: """~
            List all bundles in a managed namespace.~"""
        label: "List Managed Namespace Bundles"
    }

    global_file_list {
        desc: """~
            List all files in a global namespace bundle.~"""
        label: "List Files"
    }

    ns_file_list {
        desc: """~
            List all files in a managed namespace bundle.~"""
        label: "List Files"
    }

    global_file_upload {
        desc: """~
            Upload a file to a global namespace bundle.~"""
        label: "Upload File"
    }

    ns_file_upload {
        desc: """~
            Upload a file to a managed namespace bundle.~"""
        label: "Upload File"
    }

    global_trusts_merge {
        desc: """~
            Add CA certificates to the `ca` file of an existing global namespace bundle.
            Certificates already in the file are skipped.
            The current file content is kept, and the new certificates are appended to it.
            Other files in the bundle are not changed.
            Requests which change the same bundle at the same time are not serialized, and one of them may be dropped.
            To confirm the result, repeat the request: it reports `added: 0` when the file already holds every certificate.~"""
        label: "Add Trusted CA Certificates"
    }

    trusts_merge_in {
        desc: """~
            One or more PEM-encoded X.509 certificates.
            The request fails when it holds any other PEM entry, such as a private key.~"""
        label: "CA Certificates"
    }

    trusts_merge_added {
        desc: """~
            Number of certificates added to the `ca` file.~"""
        label: "Added"
    }

    trusts_merge_total {
        desc: """~
            Number of certificates in the `ca` file after the update.~"""
        label: "Total"
    }

    global_trusts_delete {
        desc: """~
            Remove one CA certificate from the `ca` file of a global namespace bundle.
            When no certificate is left, the `ca` file is deleted.
            Deleting the last certificate fails while a configuration refers to the bundle.
            Requests which change the same bundle at the same time are not serialized, and one of them may be dropped.
            To confirm the result, repeat the request: it returns `404` when the certificate is already gone.~"""
        label: "Remove Trusted CA Certificate"
    }

    param_path_fingerprint {
        desc: """~
            SHA-256 fingerprint of the certificate in hexadecimal, for example the output of
            `openssl x509 -noout -fingerprint -sha256`. Colons between bytes are optional.~"""
        label: "Certificate Fingerprint"
    }

    trusted_cert_not_found {
        desc: """~
            Bundle or certificate not found.~"""
        label: "Not Found"
    }

    global_bundle_delete {
        desc: """~
            Delete a global namespace bundle, or a single file in it when the `kind` query parameter is set.
            Deletion is refused while any configuration still references the bundle.~"""
        label: "Delete Bundle"
    }

    ns_bundle_delete {
        desc: """~
            Delete a managed namespace bundle, or a single file in it when the `kind` query parameter is set.
            Deletion is refused while any configuration still references the bundle.~"""
        label: "Delete Bundle"
    }

    pem_cache_clean {
        desc: """~
            Clean the x509 certificate (PEM) cache on all nodes in the cluster:
            cached entries are evicted, and certificate files are re-read from disk
            on the next TLS handshake.
            Equivalent to the CLI command `emqx ctl pem_cache clean all`.~"""
        label: "Clean PEM Cache"
    }

    bundle_not_found {
        desc: """~
            Bundle not found.~"""
        label: "Bundle not found"
    }

    bad_request {
        desc: """~
            Bad request.~"""
        label: "Bad Request"
    }

    internal_error {
        desc: """~
            Internal error.  Generally, indicates a problem with file permissions.~"""
        label: "Internal Error"
    }

    param_path_bundle_name {
        desc: """~
            Bundle name in path parameter.~"""
        label: "Bundle Name"
    }

    param_path_ns {
        desc: """~
            Managed namespace name in path parameter.~"""
        label: "Namespace"
    }

    param_qs_file_kind {
        desc: """~
            File kind in query parameter.~"""
        label: "File Kind"
    }

}
