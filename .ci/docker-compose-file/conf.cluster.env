EMQX_NAME=emqx
EMQX_LICENSE__KEY=evaluation
EMQX_CLUSTER__DISCOVERY_STRATEGY=static
EMQX_CLUSTER__STATIC__SEEDS="[emqx@node1.emqx.io, emqx@node2.emqx.io]"
# The hardened profile (default since 7.0) refuses the default cookie.
# The listener binds need no override: the docker entrypoint sets
# node.default_listener_address=all.
EMQX_NODE__COOKIE=ci-smoke-test-cookie
EMQX_LISTENERS__TCP__HAPROXY__ENABLE=true
EMQX_LISTENERS__TCP__HAPROXY__BIND="0.0.0.0:1885"
EMQX_LISTENERS__TCP__HAPROXY__PROXY_PROTOCOL=true
EMQX_LISTENERS__WS__HAPROXY__ENABLE=true
EMQX_LISTENERS__WS__HAPROXY__BIND="0.0.0.0:8085"
EMQX_LISTENERS__WS__HAPROXY__PROXY_PROTOCOL=true
EMQX_LOG__CONSOLE_HANDLER__ENABLE=true
EMQX_LOG__CONSOLE_HANDLER__LEVEL=debug
