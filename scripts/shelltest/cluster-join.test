# Successful joins return without retrying.
bash -euc 'source test/cluster-join.sh; docker() { echo joined; }; sleep() { echo unexpected-retry; }; join_cluster node2 node1 1'
>>>
joined
>>>= 0

# Expected rejections captured from stderr return without retries or log dumps.
bash -euc 'source test/cluster-join.sh; docker() { echo license-rejection >&2; return 1; }; sleep() { echo unexpected-retry; }; join_cluster node2 node1 1 license-rejection'
>>>
Expected cluster join rejection: license-rejection
>>>= 0

# Successful joins fail a negative test.
bash -euc 'source test/cluster-join.sh; docker() { echo joined; }; join_cluster node2 node1 1 license-rejection'
>>>
joined
ERROR: cluster join succeeded, expected: license-rejection
>>>= 1

# Matching output alone is insufficient when the command succeeds.
bash -euc 'source test/cluster-join.sh; docker() { echo license-rejection; }; join_cluster node2 node1 1 license-rejection'
>>>
license-rejection
ERROR: cluster join succeeded, expected: license-rejection
>>>= 1

# Unrelated failures must not pass a negative test.
bash -euc 'source test/cluster-join.sh; docker() { if [ "$1" = logs ]; then echo container-logs; else echo unrelated-error; return 1; fi; }; join_cluster node2 node1 0 license-rejection'
>>>
unrelated-error
timeout waiting for cluster join to be accepted
container-logs
>>>= 1

# Rejection matching is exact, not a substring or regular expression.
bash -euc 'source test/cluster-join.sh; docker() { if [ "$1" = logs ]; then echo container-logs; else echo license-rejection-extra; return 1; fi; }; join_cluster node2 node1 0 license-rejection'
>>>
license-rejection-extra
timeout waiting for cluster join to be accepted
container-logs
>>>= 1

# Positive tests still retry transient boot failures.
bash -euc 'source test/cluster-join.sh; ready=false; docker() { if "$ready"; then echo joined; else echo booting; return 1; fi; }; sleep() { ready=true; echo retry; }; join_cluster node2 node1 1'
>>>
booting
retry
joined
>>>= 0

# Negative tests also retry boot failures before matching the rejection.
bash -euc 'source test/cluster-join.sh; ready=false; docker() { if "$ready"; then echo license-rejection; else echo booting; fi; return 1; }; sleep() { ready=true; echo retry; }; join_cluster node2 node1 1 license-rejection'
>>>
booting
retry
Expected cluster join rejection: license-rejection
>>>= 0
